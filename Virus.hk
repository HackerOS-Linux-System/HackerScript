[package]
-> name        => HackerScript
-> version     => 0.3
-> using       => 0.3
-> authors     => ["HackerOS-Linux-System <hackeros068@gmail.com>"]
-> description => virus + hackerc, jedna binarka - menedzer pakietow/projektow i transpilator HackerScript -> Rust, statycznie linkujace libs/core i libs/std.

[workspace]
-> members => ["hackerc", "virus", "libs/core", "libs/std"]

[dependencies]
-> std
--> io => "*"
--> fs => "*"

[build]
-> entry => hackerc/cmd/cli.hcs
