pub fun Arr_string_from_list(xs: List<Str>) -> Arr_string [
    let a = Arr_string_new()
    let i = 0
    let n = xs.len()
    while i < n [
        Arr_string_push(a, xs[i].clone())
        i = i + 1
    ]
    end a
]

pub fun Arr_string_to_list(a: Arr_string) -> List<Str> [
    let out: List<Str> = []
    let i = 0
    let n = Arr_string_len(a)
    while i < n [
        out.push(Arr_string_get(a, i))
        i = i + 1
    ]
    end out
]

pub fun Opt_Pt_from_option(o: Option<Pt>) -> Opt_Pt [
