[package]
-> name        => ffi-tests
-> version     => 0.6
-> description => Testy FFI napisane w HackerScript: generator fasady C-ABI (ffi_gen.hcs) i importer stubow (hlib_bind.hcs).
-> authors     => ["HackerOS Team"]
-> license     => MIT
-> lang        => HackerScript
-> using       => 0.6

[layout]
-> cmd => cmd

[build]
-> link => static

[default-build]
-> profile => release
