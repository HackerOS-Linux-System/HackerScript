get <std:string> import <str_join>

!!! hack3rc 0.2 - runtime linkowany z kazdym programem.
!!!
!!! Zawiera: wejscie/wyjscie (log, read_int, exit), panic (kod 101),
!!! napisy, listy oraz KONSERWATYWNY ODSMIECACZ PAMIECI (mark-sweep:
!!! skanuje stos, rejestry i zawartosc obiektow; wspiera wskazniki
!!! wewnetrzne). Obiekty (struct/enum/lista/Option) maja naglowek
!!! {rozmiar, deskryptor, mark}; deskryptor `{rodzaj, slowa, maska}`
!!! (generowany przez kompilator jako `(data ...)`) mowi `hks_clone`,
!!! ktore pola kopiowac gleboko. Zmienne srodowiskowe do diagnostyki:
!!! HKS_GC_STRESS=1 (GC przy kazdej alokacji), HKS_GC_MIN_KB=<n> (prog).
!!!
!!! Tekst C jest zapisywany przez driver do katalogu tymczasowego i
!!! kompilowany przez `cc` razem z plikiem obiektowym z Cranelifta
!!! (to samo `cc` sluzy do linkowania).
fun runtime_c_source() -> Str [
    let l: List<Str> = []
    l.push("#include <stdio.h>")
    l.push("#include <stdlib.h>")
    l.push("#include <stdint.h>")
    l.push("#include <string.h>")
    l.push("#include <ctype.h>")
    l.push("#include <setjmp.h>")
    l.push("extern int64_t hks_entry(void);")
    l.push("void hks_panic_msg(const char *m) { fflush(stdout); fputs(\"hack3rc: panic: \", stderr); fputs(m, stderr); fputc(10, stderr); exit(101); }")
    l.push("void hks_panic_div0(void) { hks_panic_msg(\"dzielenie przez zero\"); }")
    l.push("typedef struct hks_hdr { int64_t size; const int64_t *desc; int64_t mark; int64_t pad; } hks_hdr;")
    l.push("typedef struct hks_list { int64_t len; int64_t cap; int64_t *data; } hks_list;")
    l.push("static hks_hdr **hks_objs; static size_t hks_nobjs, hks_capobjs;")
    l.push("static size_t hks_since_gc, hks_threshold = 8u << 20, hks_min_threshold = 8u << 20;")
    l.push("static int hks_stress;")
    l.push("static void *hks_stack_base;")
    l.push("static hks_hdr **hks_mst; static size_t hks_mn, hks_mcap;")
    l.push("static int hks_cmp_hdr(const void *a, const void *b) { hks_hdr *x = *(hks_hdr *const *)a, *y = *(hks_hdr *const *)b; return x < y ? -1 : (x > y); }")
    l.push("static hks_hdr *hks_find(uintptr_t w) {")
    l.push("    size_t lo = 0, hi = hks_nobjs;")
    l.push("    while (lo < hi) { size_t mid = (lo + hi) / 2; if ((uintptr_t)(hks_objs[mid] + 1) <= w) lo = mid + 1; else hi = mid; }")
    l.push("    if (lo == 0) return 0;")
    l.push("    hks_hdr *h = hks_objs[lo - 1];")
    l.push("    uintptr_t s = (uintptr_t)(h + 1);")
    l.push("    return (w >= s && w < s + (uintptr_t)h->size) ? h : 0;")
    l.push("}")
    l.push("static void hks_mark_word(uintptr_t w) {")
    l.push("    hks_hdr *h = hks_find(w);")
    l.push("    if (h && !h->mark) {")
    l.push("        h->mark = 1;")
    l.push("        if (hks_mn == hks_mcap) { hks_mcap = hks_mcap ? hks_mcap * 2 : 1024; hks_mst = realloc(hks_mst, hks_mcap * sizeof *hks_mst); if (!hks_mst) hks_panic_msg(\"brak pamieci\"); }")
    l.push("        hks_mst[hks_mn++] = h;")
    l.push("    }")
    l.push("}")
    l.push("static void hks_scan(void *lo, void *hi) {")
    l.push("    uintptr_t *p = (uintptr_t *)(((uintptr_t)lo + 7) & ~(uintptr_t)7);")
    l.push("    for (; (void *)(p + 1) <= hi; p++) hks_mark_word(*p);")
    l.push("}")
    l.push("static __attribute__((noinline)) void hks_scan_stack(void) {")
    l.push("    volatile uintptr_t marker = 0;")
    l.push("    hks_scan((void *)&marker, hks_stack_base);")
    l.push("}")
    l.push("void hks_collect(void) {")
    l.push("    jmp_buf jb;")
    l.push("    setjmp(jb);")
    l.push("    qsort(hks_objs, hks_nobjs, sizeof *hks_objs, hks_cmp_hdr);")
    l.push("    hks_mn = 0;")
    l.push("    hks_scan_stack();")
    l.push("    while (hks_mn) { hks_hdr *h = hks_mst[--hks_mn]; hks_scan(h + 1, (char *)(h + 1) + h->size); }")
    l.push("    size_t j = 0, live = 0;")
    l.push("    for (size_t i = 0; i < hks_nobjs; i++) {")
    l.push("        hks_hdr *h = hks_objs[i];")
    l.push("        if (h->mark) { h->mark = 0; hks_objs[j++] = h; live += (size_t)h->size + sizeof(hks_hdr); }")
    l.push("        else free(h);")
    l.push("    }")
    l.push("    hks_nobjs = j;")
    l.push("    hks_since_gc = 0;")
    l.push("    hks_threshold = live > hks_min_threshold ? live : hks_min_threshold;")
    l.push("    (void)jb;")
    l.push("}")
    l.push("static void *hks_alloc_raw(int64_t size, const int64_t *desc) {")
    l.push("    if (size < 8) size = 8;")
    l.push("    if (hks_stress || hks_since_gc >= hks_threshold) hks_collect();")
    l.push("    hks_hdr *h = calloc(1, sizeof(hks_hdr) + (size_t)size);")
    l.push("    if (!h) hks_panic_msg(\"brak pamieci\");")
    l.push("    h->size = size; h->desc = desc;")
    l.push("    if (hks_nobjs == hks_capobjs) { hks_capobjs = hks_capobjs ? hks_capobjs * 2 : 4096; hks_objs = realloc(hks_objs, hks_capobjs * sizeof *hks_objs); if (!hks_objs) hks_panic_msg(\"brak pamieci\"); }")
    l.push("    hks_objs[hks_nobjs++] = h;")
    l.push("    hks_since_gc += (size_t)size + sizeof(hks_hdr);")
    l.push("    return h + 1;")
    l.push("}")
    l.push("void *hks_alloc(int64_t size, const int64_t *desc) { return hks_alloc_raw(size, desc); }")
    l.push("static const int64_t hks_desc_list_val[3] = {1, 0, 0};")
    l.push("static const int64_t hks_desc_list_ptr[3] = {1, 1, 0};")
    l.push("void *hks_list_new(int64_t is_ptr) { return hks_alloc_raw((int64_t)sizeof(hks_list), is_ptr ? hks_desc_list_ptr : hks_desc_list_val); }")
    l.push("int64_t hks_list_len(hks_list *l) { return l->len; }")
    l.push("int64_t *hks_list_slot(hks_list *l, int64_t i) {")
    l.push("    if (i < 0 || i >= l->len) {")
    l.push("        char b[96]; snprintf(b, sizeof b, \"indeks %lld poza zakresem (dlugosc %lld)\", (long long)i, (long long)l->len);")
    l.push("        hks_panic_msg(b);")
    l.push("    }")
    l.push("    return &l->data[i];")
    l.push("}")
    l.push("int64_t *hks_list_push(hks_list *l) {")
    l.push("    if (l->len == l->cap) {")
    l.push("        int64_t nc = l->cap ? l->cap * 2 : 4;")
    l.push("        int64_t *nd = hks_alloc_raw(nc * 8, 0);")
    l.push("        if (l->len) memcpy(nd, l->data, (size_t)l->len * 8);")
    l.push("        l->data = nd; l->cap = nc;")
    l.push("    }")
    l.push("    return &l->data[l->len++];")
    l.push("}")
    l.push("int64_t *hks_list_pop(hks_list *l) { return l->len ? &l->data[--l->len] : 0; }")
    l.push("void hks_list_clear(hks_list *l) { if (l->len) memset(l->data, 0, (size_t)l->len * 8); l->len = 0; }")
    l.push("int64_t hks_list_contains_i(hks_list *l, int64_t v) { for (int64_t i = 0; i < l->len; i++) if (l->data[i] == v) return 1; return 0; }")
    l.push("int64_t hks_list_contains_s(hks_list *l, const char *v) { for (int64_t i = 0; i < l->len; i++) if (strcmp((const char *)(intptr_t)l->data[i], v) == 0) return 1; return 0; }")
    l.push("int64_t *hks_list_remove(hks_list *l, int64_t i) {")
    l.push("    if (i < 0 || i >= l->len) {")
    l.push("        char b[96]; snprintf(b, sizeof b, \"indeks %lld poza zakresem (dlugosc %lld)\", (long long)i, (long long)l->len);")
    l.push("        hks_panic_msg(b);")
    l.push("    }")
    l.push("    int64_t v = l->data[i];")
    l.push("    memmove(&l->data[i], &l->data[i + 1], (size_t)(l->len - i - 1) * 8);")
    l.push("    l->len--; l->data[l->len] = v;")
    l.push("    return &l->data[l->len];")
    l.push("}")
    l.push("int64_t *hks_list_insert(hks_list *l, int64_t i) {")
    l.push("    if (i < 0 || i > l->len) {")
    l.push("        char b[96]; snprintf(b, sizeof b, \"indeks %lld poza zakresem (dlugosc %lld)\", (long long)i, (long long)l->len);")
    l.push("        hks_panic_msg(b);")
    l.push("    }")
    l.push("    hks_list_push(l);")
    l.push("    memmove(&l->data[i + 1], &l->data[i], (size_t)(l->len - 1 - i) * 8);")
    l.push("    l->data[i] = 0;")
    l.push("    return &l->data[i];")
    l.push("}")
    l.push("void hks_list_reverse(hks_list *l) { for (int64_t i = 0, j = l->len - 1; i < j; i++, j--) { int64_t t = l->data[i]; l->data[i] = l->data[j]; l->data[j] = t; } }")
    l.push("static int hks_cmp_i64(const void *a, const void *b) { int64_t x = *(const int64_t *)a, y = *(const int64_t *)b; return x < y ? -1 : (x > y); }")
    l.push("void hks_list_sort_i(hks_list *l) { if (l->len > 1) qsort(l->data, (size_t)l->len, 8, hks_cmp_i64); }")
    l.push("void *hks_clone(void *p) {")
    l.push("    if (!p) return 0;")
    l.push("    hks_hdr *h = (hks_hdr *)p - 1;")
    l.push("    const int64_t *d = h->desc;")
    l.push("    if (!d) return p;")
    l.push("    if (d[0] == 1) {")
    l.push("        hks_list *l = (hks_list *)p;")
    l.push("        hks_list *n = (hks_list *)hks_list_new(d[1]);")
    l.push("        if (l->len) {")
    l.push("            n->data = hks_alloc_raw(l->len * 8, 0);")
    l.push("            n->cap = l->len; n->len = l->len;")
    l.push("            memcpy(n->data, l->data, (size_t)l->len * 8);")
    l.push("            if (d[1]) for (int64_t i = 0; i < n->len; i++) n->data[i] = (int64_t)(intptr_t)hks_clone((void *)(intptr_t)n->data[i]);")
    l.push("        }")
    l.push("        return n;")
    l.push("    }")
    l.push("    int64_t *q = (int64_t *)hks_alloc_raw(h->size, d);")
    l.push("    memcpy(q, p, (size_t)h->size);")
    l.push("    for (int64_t i = 0; i < d[1]; i++) if ((d[2] >> i) & 1) q[i] = (int64_t)(intptr_t)hks_clone((void *)(intptr_t)q[i]);")
    l.push("    return q;")
    l.push("}")
    l.push("static void hks_fmt_f(char *b, size_t n, double v) {")
    l.push("    if (v != v) { snprintf(b, n, \"NaN\"); return; }")
    l.push("    if (v - v != 0) { snprintf(b, n, v > 0 ? \"inf\" : \"-inf\"); return; }")
    l.push("    for (int p = 15; p <= 17; p++) { snprintf(b, n, \"%.*g\", p, v); if (strtod(b, 0) == v) break; }")
    l.push("}")
    l.push("static const char *hks_dup(const char *s) { size_t n = strlen(s); char *r = hks_alloc_raw((int64_t)n + 1, 0); memcpy(r, s, n + 1); return r; }")
    l.push("const char *hks_str_concat(const char *a, const char *b) {")
    l.push("    size_t la = strlen(a), lb = strlen(b);")
    l.push("    char *r = hks_alloc_raw((int64_t)(la + lb + 1), 0);")
    l.push("    memcpy(r, a, la); memcpy(r + la, b, lb); r[la + lb] = 0;")
    l.push("    return r;")
    l.push("}")
    l.push("int64_t hks_str_eq(const char *a, const char *b) { return strcmp(a, b) == 0; }")
    l.push("int64_t hks_str_len(const char *a) { return (int64_t)strlen(a); }")
    l.push("int64_t hks_str_contains(const char *a, const char *b) { return strstr(a, b) != 0; }")
    l.push("int64_t hks_str_starts_with(const char *a, const char *b) { return strncmp(a, b, strlen(b)) == 0; }")
    l.push("int64_t hks_str_ends_with(const char *a, const char *b) { size_t la = strlen(a), lb = strlen(b); return lb <= la && memcmp(a + la - lb, b, lb) == 0; }")
    l.push("int64_t hks_str_find(const char *a, const char *b) { const char *p = strstr(a, b); return p ? (int64_t)(p - a) : -1; }")
    l.push("const char *hks_str_to_upper(const char *a) { size_t n = strlen(a); char *r = hks_alloc_raw((int64_t)n + 1, 0); for (size_t i = 0; i <= n; i++) r[i] = (char)toupper((unsigned char)a[i]); return r; }")
    l.push("const char *hks_str_to_lower(const char *a) { size_t n = strlen(a); char *r = hks_alloc_raw((int64_t)n + 1, 0); for (size_t i = 0; i <= n; i++) r[i] = (char)tolower((unsigned char)a[i]); return r; }")
    l.push("const char *hks_str_trim(const char *a) { size_t n = strlen(a), s = 0; while (s < n && isspace((unsigned char)a[s])) s++; while (n > s && isspace((unsigned char)a[n - 1])) n--; char *r = hks_alloc_raw((int64_t)(n - s) + 1, 0); memcpy(r, a + s, n - s); r[n - s] = 0; return r; }")
    l.push("const char *hks_str_repeat(const char *a, int64_t k) { size_t n = strlen(a); if (k < 0) k = 0; char *r = hks_alloc_raw((int64_t)(n * (size_t)k) + 1, 0); for (int64_t i = 0; i < k; i++) memcpy(r + (size_t)i * n, a, n); r[n * (size_t)k] = 0; return r; }")
    l.push("const char *hks_str_from_i(int64_t v) { char b[32]; snprintf(b, sizeof b, \"%lld\", (long long)v); return hks_dup(b); }")
    l.push("const char *hks_str_from_f(double v) { char b[40]; hks_fmt_f(b, sizeof b, v); return hks_dup(b); }")
    l.push("const char *hks_str_from_b(int64_t v) { return v ? \"true\" : \"false\"; }")
    l.push("void hks_print_i(int64_t v) { printf(\"%lld\", (long long)v); }")
    l.push("void hks_print_f(double v) { char b[40]; hks_fmt_f(b, sizeof b, v); fputs(b, stdout); }")
    l.push("void hks_print_b(int64_t v) { fputs(v ? \"true\" : \"false\", stdout); }")
    l.push("void hks_print_s(const char *s) { fputs(s, stdout); }")
    l.push("void hks_print_sp(void) { putchar(32); }")
    l.push("void hks_print_nl(void) { putchar(10); }")
    l.push("int64_t hks_abs(int64_t v) { return v < 0 ? (int64_t)(0 - (uint64_t)v) : v; }")
    l.push("int64_t hks_read_int(void) { long long v = 0; if (scanf(\"%lld\", &v) != 1) return 0; return (int64_t)v; }")
    l.push("void hks_exit(int64_t c) { fflush(stdout); exit((int)c); }")
    l.push("int main(void) {")
    l.push("    volatile int64_t base = 0;")
    l.push("    const char *e;")
    l.push("    hks_stack_base = (void *)&base;")
    l.push("    if ((e = getenv(\"HKS_GC_STRESS\")) && *e && *e != '0') hks_stress = 1;")
    l.push("    if ((e = getenv(\"HKS_GC_MIN_KB\")) && *e) { hks_min_threshold = (size_t)strtoull(e, 0, 10) * 1024; hks_threshold = hks_min_threshold; }")
    l.push("    int64_t r = hks_entry();")
    l.push("    fflush(stdout);")
    l.push("    return (int)r;")
    l.push("}")
    end str_join(l, "\n") + "\n"
]
