include <work:hackerc::lexer>
include <work:hackerc::ast_nodes>
include <work:hackerc::parser>
include <work:hackerc::diagnostics>
include <work:hack3rc::lower>
include <work:hack3rc::backend>
include <work:hack3rc::runtime>
get <std:io> import <file_readable>
get <std:fs> import <create_dir_ok::remove_dir_all_ok::copy_file_ok>
get <std:string> import <str_join::str_split::str_contains::str_to_int::str_ends_with::str_starts_with::str_trim>

!!! hack3rc 0.1 - kompilator AOT podzbioru HackerScript do natywnych
!!! plikow wykonywalnych (Cranelift). Caly kod zrodlowy to HackerScript:
!!!   lower.hcs   - analiza typow + lowering AST -> IR
!!!   backend.hcs - Cranelift (blok `native {Rust}` w pliku .hcs)
!!!   runtime.hcs - minimalny runtime (log/read_int/exit/panic)
!!!   main.hcs    - CLI i driver (ten plik)
!!! Dokumentacja: docs/HACK3RC.md

struct Opts [
    input: Str,
    out: Str,
    emit: Str,
    run: Bool,
    opt: Str,
    cc: Str,
    target: Str,
    runner: Str,
    keep: Bool,
    check: Bool,
    dump_clif: Bool
]

fun usage() -> Str [
    let l: List<Str> = []
    l.push("hack3rc 0.2.0 - kompilator AOT HackerScript (Cranelift)")
    l.push("")
    l.push("uzycie: hack3rc <plik.hcs> [opcje]")
    l.push("")
    l.push("  -o <plik>         plik wynikowy (domyslnie: nazwa zrodla bez .hcs)")
    l.push("  --run             zbuduj i od razu uruchom (kod wyjscia = kod programu)")
    l.push("  --check           tylko analiza (bez generowania kodu)")
    l.push("  --emit <co>       exe (domyslnie) | obj | ir")
    l.push("  -O0 | -O1 | -O2   poziom optymalizacji Cranelift (domyslnie -O1)")
    l.push("  --target <cel>    architektura docelowa: aarch64 | riscv64 | s390x | x86_64")
    l.push("                    albo pelny triple (domyslnie: host); cross-kompilacja")
    l.push("  --cc <polecenie>  linker/kompilator C dla celu, np. \"clang\" albo \"zig cc -target aarch64-linux\"")
    l.push("                    (domyslnie: cc, a dla innego celu <arch>-linux-gnu-gcc)")
    l.push("  --runner <pol.>   uruchamiacz dla --run z innym celem (domyslnie: qemu-<arch> -L /usr/<arch>-linux-gnu)")
    l.push("  --keep-temps      nie usuwaj katalogu tymczasowego (<wynik>.hks-tmp)")
    l.push("  --dump-clif       wypisz Cranelift IR na stderr")
    l.push("  --version, -h     wersja / pomoc")
    end str_join(l, "\n")
]

!!! Przetwarza argv -> Opts. Blad zwracany jest w polu `emit` jako
!!! tekst zaczynajacy sie od '!'.
fun parse_args(argv: List<Str>) -> Opts [
    let o = Opts("", "", "exe", false, "speed", "", "", "", false, false, false)
    let i = 0
    while i < argv.len() [
        let a = argv[i].clone()
        if a == "-o" [
            if i + 1 >= argv.len() [
                o.emit = "!opcja -o wymaga argumentu"
                end o
            ]
            o.out = argv[i + 1].clone()
            i = i + 1
        ] elif a == "--emit" [
            if i + 1 >= argv.len() [
                o.emit = "!opcja --emit wymaga argumentu (exe|obj|ir)"
                end o
            ]
            o.emit = argv[i + 1].clone()
            i = i + 1
        ] elif a == "--cc" [
            if i + 1 >= argv.len() [
                o.emit = "!opcja --cc wymaga argumentu"
                end o
            ]
            o.cc = argv[i + 1].clone()
            i = i + 1
        ] elif a == "--target" [
            if i + 1 >= argv.len() [
                o.emit = "!opcja --target wymaga argumentu"
                end o
            ]
            o.target = argv[i + 1].clone()
            i = i + 1
        ] elif a == "--runner" [
            if i + 1 >= argv.len() [
                o.emit = "!opcja --runner wymaga argumentu"
                end o
            ]
            o.runner = argv[i + 1].clone()
            i = i + 1
        ] elif a == "--run" [
            o.run = true
        ] elif a == "--check" [
            o.check = true
        ] elif a == "--keep-temps" [
            o.keep = true
        ] elif a == "--dump-clif" [
            o.dump_clif = true
        ] elif a == "-O0" [
            o.opt = "none"
        ] elif a == "-O1" [
            o.opt = "speed"
        ] elif a == "-O2" [
            o.opt = "speed_and_size"
        ] elif str_starts_with(a.clone(), "-") [
            o.emit = "!nieznana opcja '" + a + "'"
            end o
        ] else [
            if o.input != "" [
                o.emit = "!podano wiecej niz jeden plik wejsciowy"
                end o
            ]
            o.input = a
        ]
        i = i + 1
    ]
    end o
]

!!! ---------------------------------------------------------------
!!! Cele (cross-kompilacja)
!!! ---------------------------------------------------------------

fun split_words(s: Str) -> List<Str> [
    let out: List<Str> = []
    let cur = ""
    let i = 0
    while i < s.len() [
        let c = s.char_at(i)
        if c == " " [
            if cur != "" [
                out.push(cur)
                cur = ""
            ]
        ] else [
            cur = cur + c
        ]
        i = i + 1
    ]
    if cur != "" [
        out.push(cur)
    ]
    end out
]

!!! Skrot -> pelny triple (Linux GNU); pelny triple zostaje bez zmian.
fun expand_target(t: Str) -> Str [
    if t == "x86_64" [
        end "x86_64-unknown-linux-gnu"
    ]
    if t == "aarch64" or t == "arm64" [
        end "aarch64-unknown-linux-gnu"
    ]
    if t == "riscv64" [
        end "riscv64gc-unknown-linux-gnu"
    ]
    if t == "s390x" [
        end "s390x-unknown-linux-gnu"
    ]
    end t
]

!!! Architektura = pierwszy segment triple'a (riscv64gc -> riscv64).
fun target_arch(t: Str) -> Str [
    let arch = ""
    let i = 0
    while i < t.len() [
        let c = t.char_at(i)
        if c == "-" [
            i = t.len()
        ] else [
            arch = arch + c
        ]
        i = i + 1
    ]
    if str_starts_with(arch.clone(), "riscv64") [
        end "riscv64"
    ]
    end arch
]

fun host_arch() -> Str [
    let uname_args: List<Str> = ["-m"]
    match run_command("uname", uname_args) [
        Ok(out) -> [
            let a = str_trim(out)
            if a == "arm64" [
                end "aarch64"
            ]
            end a
        ]
        Err(_e) -> [
            end "x86_64"
        ]
    ]
]

!!! Domyslny kompilator C dla celu: "cc" dla hosta, inaczej
!!! <arch>-linux-gnu-gcc (pakiety gcc-<arch>-linux-gnu); "" gdy nieznany.
fun default_cc(arch: Str, host: Str) -> Str [
    if arch == host [
        end "cc"
    ]
    if arch == "aarch64" or arch == "riscv64" or arch == "s390x" or arch == "x86_64" [
        end arch + "-linux-gnu-gcc"
    ]
    end ""
]

fun default_runner(arch: Str, host: Str) -> Str [
    if arch == host [
        end ""
    ]
    if arch == "aarch64" or arch == "riscv64" or arch == "s390x" or arch == "x86_64" [
        end "qemu-" + arch + " -L /usr/" + arch + "-linux-gnu"
    ]
    end ""
]

fun fail(msg: Str) -> Int [
    elog("hack3rc: blad: " + msg)
    end 1
]

!!! Glowny przebieg: parsowanie -> analiza/lowering -> Cranelift ->
!!! linkowanie -> (opcjonalnie) uruchomienie. Zwraca kod wyjscia.
fun compile(o: Opts) -> Int [
    if not file_readable(o.input.clone()) [
        end fail("nie znaleziono pliku " + o.input)
    ]
    match read_file(o.input.clone()) [
        Err(e) -> [
            end fail("nie mozna odczytac " + o.input + ": " + e)
        ]
        Ok(source) -> [
            let parsed = parse_checked(source.clone())
            if parsed.errors.len() > 0 [
                log(render_many(source.clone(), o.input.clone(), parsed.errors.clone()))
                end 1
            ]
            let lowered = lower_program(parsed.program, split_lines(source.clone()), o.input.clone())
            if lowered.diags.len() > 0 [
                log(render_many(source.clone(), o.input.clone(), lowered.diags.clone()))
                elog("hack3rc: przerwano - bledow: " + (lowered.diags.len() as Str))
                end 1
            ]
            if o.check [
                log("hack3rc: " + o.input + " OK")
                end 0
            ]
            if o.emit == "ir" [
                log(lowered.ir)
                end 0
            ]
            end build_native(o, lowered.ir)
        ]
    ]
]

fun build_native(o: Opts, ir: Str) -> Int [
    let out: Str = o.out.clone()
    if out == "" [
        out = o.input.clone()
        if str_ends_with(out.clone(), ".hcs") [
            out = out.slice(0, out.len() - 4)
        ] else [
            out = out + ".out"
        ]
    ]
    let tmp = out + ".hks-tmp"
    if not create_dir_ok(tmp.clone()) [
        end fail("nie mozna utworzyc katalogu " + tmp)
    ]
    let obj = tmp + "/prog.o"
    let target = expand_target(o.target.clone())
    let host = host_arch()
    let arch = host.clone()
    if target != "" [
        arch = target_arch(target.clone())
    ]
    let err = cl_emit(ir, obj.clone(), o.opt.clone(), o.dump_clif, target.clone())
    if err != "" [
        if not o.keep [
            remove_dir_all_ok(tmp.clone())
        ]
        end fail("backend Cranelift: " + err)
    ]
    if o.emit == "obj" [
        let obj_out = out + ".o"
        copy_file_ok(obj.clone(), obj_out.clone())
        if not o.keep [
            remove_dir_all_ok(tmp.clone())
        ]
        log("hack3rc: " + obj_out)
        end 0
    ]
    if o.emit != "exe" [
        remove_dir_all_ok(tmp.clone())
        end fail("nieznana wartosc --emit '" + o.emit + "' (exe|obj|ir)")
    ]
    let rt = tmp + "/rt.c"
    write_file(rt.clone(), runtime_c_source())
    let exe = out.clone()
    if o.run and o.out == "" [
        exe = tmp + "/prog"
    ]
    let cc_cmd = o.cc.clone()
    if cc_cmd == "" and (target == "" or str_contains(target.clone(), "linux")) [
        cc_cmd = default_cc(arch.clone(), host.clone())
    ]
    if cc_cmd == "" [
        if not o.keep [
            remove_dir_all_ok(tmp.clone())
        ]
        end fail("brak domyslnego kompilatora C dla celu '" + target + "' - podaj --cc (np. --cc \"zig cc -target ...\")")
    ]
    let cc_words = split_words(cc_cmd.clone())
    let cc_args: List<Str> = []
    let w = 1
    while w < cc_words.len() [
        cc_args.push(cc_words[w].clone())
        w = w + 1
    ]
    cc_args.push("-O2")
    cc_args.push("-o")
    cc_args.push(exe.clone())
    cc_args.push(obj.clone())
    cc_args.push(rt.clone())
    cc_args.push("-lm")
    match run_command(cc_words[0].clone(), cc_args) [
        Err(msg) -> [
            if not o.keep [
                remove_dir_all_ok(tmp.clone())
            ]
            end fail("linkowanie przez '" + cc_cmd + "' nie powiodlo sie:\n" + msg)
        ]
        Ok(_out) -> [
            let unused = 0
        ]
    ]
    let code = 0
    if o.run [
        let runner_cmd = o.runner.clone()
        if runner_cmd == "" [
            runner_cmd = default_runner(arch.clone(), host.clone())
        ]
        if runner_cmd == "" [
            let no_args: List<Str> = []
            code = run_command_inherit(exe.clone(), no_args)
        ] else [
            let rw = split_words(runner_cmd.clone())
            let run_args: List<Str> = []
            let r = 1
            while r < rw.len() [
                run_args.push(rw[r].clone())
                r = r + 1
            ]
            run_args.push(exe.clone())
            code = run_command_inherit(rw[0].clone(), run_args)
        ]
    ] else [
        log("hack3rc: " + exe)
    ]
    if not o.keep [
        remove_dir_all_ok(tmp.clone())
    ]
    end code
]

fun main() [
    let argv = args()
    if argv.len() == 0 [
        log(usage())
        exit(1)
    ]
    if argv[0] == "--version" [
        log("hack3rc 0.2.0")
        exit(0)
    ]
    if argv[0] == "-h" or argv[0] == "--help" [
        log(usage())
        exit(0)
    ]
    let o = parse_args(argv)
    if str_starts_with(o.emit.clone(), "!") [
        let emsg: Str = o.emit.clone()
        exit(fail(emsg.slice(1, emsg.len())))
    ]
    if o.input == "" [
        log(usage())
        exit(1)
    ]
    exit(compile(o))
]
