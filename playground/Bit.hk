[package]
-> name        => playground
-> version     => 0.6
-> description => Checker HackerScript, parser typecheck i diagnostyki, skompilowany do WASM. Budowanie bit build --wasm w tym katalogu.
-> authors     => ["HackerOS Team"]
-> license     => MIT
