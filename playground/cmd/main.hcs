using <0.1>

!!! `playground/cmd/main.hcs` - PRAWDZIWA implementacja silnika
!!! playground (dawniej: `playground/src/lib.rs::parse_source` /
!!! `check_source_inner` / `check_source`, recznie pisany Rust
!!! DUBLUJACY logike, ktora `hackerc` juz ma we WLASNYM
!!! `cli.hcs::cmd_check` - patrz `docs/ROADMAP.md`, "playground: src/
!!! -> cmd/*.hcs"). To jest ZWYKLY plik HackerScript, kompilowany
!!! przez `hackerc build cmd/main.hcs -o target-hcs
!!! --crate-name playground_check --lib` (nowa flaga `--lib` ->
!!! `[lib]\ncrate-type = ["cdylib", "rlib"]` zamiast `[[bin]]`, patrz
!!! `project.hcs::cargo_toml_text`) - DOKLADNIE ten sam front-end
!!! (`lexer`/`parser`/`typecheck`/`diagnostics`) co `hackerc` samo w
!!! sobie, przez `include`, NIE osobna, recznie synchronizowana kopia
!!! (`playground/src/_hks_inc_*.rs` z poprzedniej wersji tego
!!! katalogu BYLY dokladnie taka kopia - stad ich usuniecie).
!!!
!!! Jedyna rzecz, ktorej NIE da sie wyrazic w HackerScript, to sama
!!! GRANICA WASM (alokacja/zwalnianie pamieci linear, `#[no_mangle]
!!! extern "C"`, `unsafe`) - dokladnie TA SAMA klasa problemu co
!!! `cranelift_runtime.rs` (bogate/niskopoziomowe API, ktorego
!!! dzisiejszy `extern "lib"` HackerScript nie potrafi wywolac, patrz
!!! `docs/ROADMAP.md`, sekcja "Backend Cranelift", "Pierwsza proba").
!!! Ta granica zostaje w OSOBNYM, malutkim, recznie pisanym pliku -
!!! `playground/wasm-glue-template.rs` (analogiczny wzorzec do
!!! `hackerc/runtime-templates/cranelift_runtime.rs`) - ktory WOLA
!!! `check_source` wyeksportowane STAD, zamiast (jak poprzednio)
!!! zawierac calą logike checkera w sobie.

include <ast_nodes>
include <parser>
include <typecheck>
include <diagnostics>
include <transpiler>

!!! Twardy limit dlugosci wejscia - zabezpieczenie PRZED znanym
!!! bugiem w recovery parsera dla niektorych skrajnie zdeformowanych
!!! wejsc (petla w obsludze bledu skladni potrafi nie konczyc sie,
!!! patrz `README.md` w tym katalogu, "Znane ograniczenia") -
!!! najprostsza, bezpieczna dla przegladarki ochrona (zamiast
!!! ryzykowac zawieszenie karty). Parytet z `MAX_LEN` w POPRZEDNIEJ
!!! (recznie pisanej) wersji `check_source` w `playground/src/lib.rs`.
const MAX_SOURCE_LEN: Int = 200000

!!! Parytet z `hackerc/cmd/cli.hcs::parse_with_direct`.
fun parse_source(source: Str) -> Program [
    let extraction = extract_direct_blocks(source)
    end parse(extraction.stripped_source)
]

!!! Sprawdza kod zrodlowy HackerScript i zwraca CZYTELNY DLA
!!! CZLOWIEKA raport diagnostyk (tekst z kolorami ANSI, tak samo jak
!!! `hackerc check` w terminalu - `wasm-glue-template.rs` po stronie
!!! JS/przegladarki jest odpowiedzialny za ewentualne usuniecie
!!! kodow ANSI, jesli UI playground ich nie obsluguje). Parytet z
!!! `check_source_inner` + `check_source` (limit dlugosci) z
!!! POPRZEDNIEJ wersji `playground/src/lib.rs`.
fun check_source(source: Str) -> Str [
    if source.len() > MAX_SOURCE_LEN [
        end "playground: kod zrodlowy za dlugi (max " + (MAX_SOURCE_LEN as Str) + " bajtow, dostano " + (source.len() as Str) + ")"
    ]

    let program = parse_source(source)
    let diags = check_program(program, [])

    if diags.len() == 0 [
        end "OK (0 warning(ow))"
    ]

    let report = render_many(source, "playground.hcs", diags.clone())
    let errors = 0
    let i = 0
    let n = diags.len()
    while i < n [
        if diags[i].clone().severity == "error" [
            errors = errors + 1
        ]
        i = i + 1
    ]

    if errors > 0 [
        end report + "\n\n" + (errors as Str) + " blad(ow), " + ((diags.len() - errors) as Str) + " warning(ow)"
    ]
    end report + "\n\nOK (" + (diags.len() as Str) + " warning(ow))"
]

!!! Wersja hackerc, ktorej logike checkera uzywa ten playground -
!!! parytet z `wasm_hackerc_version_major/minor/patch` w POPRZEDNIEJ
!!! wersji `playground/src/lib.rs` - TAM to byly 3 stale liczbowe (bez
!!! alokacji, zeby JS mogl je odczytac wprost jako `u32`); TU to JEDNA
!!! funkcja Str, bo HackerScript nie ma osobnych eksportow-stalych -
!!! `wasm-glue-template.rs` parsuje ja raz przy starcie (patrz jego
!!! komentarz).
fun playground_engine_version() -> Str [
    end "0.2.0"
]

!!! Ten `main()` NIGDY nie jest wywolywany jako punkt wejscia (crate
!!! typu `cdylib`/`rlib` nie ma punktu wejscia w tym sensie) - istnieje
!!! WYLACZNIE zeby PRZESLONIC "ambiguous glob" Rusta: kazdy
!!! wlaczony modul (`_hks_inc_*.rs`) ma WLASNE `main()` (self-test,
!!! patrz komentarz na gorze pliku), a `use crate::_hks_inc_X::*;`
!!! (jedno na modul) importuje je WSZYSTKIE naraz - lokalna definicja
!!! w tym samym module ma pierwszenstwo nad importami `glob` w Rust,
!!! wiec TA funkcja (pusta) wygrywa. Parytet z `pub fn main() {}` w
!!! POPRZEDNIEJ, recznie pisanej wersji `playground/src/lib.rs` -
!!! teraz wyrazone w HackerScript zamiast recznie dopisywane do
!!! wygenerowanego Rusta.
fun main() [
]
