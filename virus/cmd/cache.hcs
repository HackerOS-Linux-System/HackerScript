include <manifest>
get <std:path> import <path_join::path_dirname>
get <std:fs> import <create_dir_ok::remove_dir_all_ok>

const CACHE_DIR_NAME: Str = "cache"

!!! `<projekt>/cache` i jego cztery podkatalogi.
struct CacheDirs [
    root: Str,
    libs: Str,
    source: Str,
    env: Str,
    build: Str
]

!!! Buduje `CacheDirs` dla projektu w `project_root` (NIE tworzy jeszcze
!!! katalogow na dysku - patrz `cache_ensure_all`).
fun cache_dirs_for_project(project_root: Str) -> CacheDirs [
    let root = path_join(project_root, CACHE_DIR_NAME.to_string())
    end CacheDirs(root.clone(), path_join(root.clone(), "libs"), path_join(root.clone(), "source"), path_join(root.clone(), "env"), path_join(root, "build"))
]

!!! Tworzy caly katalog `cache/` (i podkatalogi), jesli nie istnieje -
!!! odpowiednik `virus cache`. `true` = sukces (wszystkie 5 katalogow
!!! utworzone/juz istnialy), `false` = ktorys sie nie udal.
fun cache_ensure_all(cache: CacheDirs) -> Bool [
    let ok1 = create_dir_ok(cache.root)
    let ok2 = create_dir_ok(cache.libs)
    let ok3 = create_dir_ok(cache.source)
    let ok4 = create_dir_ok(cache.env)
    let ok5 = create_dir_ok(cache.build)
    end ok1 and ok2 and ok3 and ok4 and ok5
]

!!! Usuwa caly katalog `cache/` (rekurencyjnie) - `true` = usuniete
!!! (albo juz nie istnialo, patrz uwaga w `remove_dir_all_ok`),
!!! `false` = blad.
fun cache_clean(cache: CacheDirs) -> Bool [
    end remove_dir_all_ok(cache.root)
]

!!! Sciezka do lokalnego cache konkretnej zaleznosci, np.
!!! `cache/libs/pypi/rich` albo `cache/libs/crates/colorize`.
fun cache_lib_path(cache: CacheDirs, source: Str, name: Str) -> Str [
    end path_join(path_join(cache.libs, source), name)
]

!!! Sciezka gdzie powinien wladowac sie pobrany `hackerc` dla danej
!!! wersji. UPROSZCZONE wzgledem oryginalu: ZAWSZE `hackerc` bez
!!! `.exe` - `virus`/`hackerc` w tym repo celuja w Linux (patrz nazwa
!!! projektu wyzej w drzewie, `HackerOS-Linux-System`), platforma
!!! Windows nie jest wspierana przez ten stdlib.
fun cache_hackerc_binary(cache: CacheDirs, version: Str) -> Str [
    end path_join(path_join(cache.env, "hackerc-" + version), "hackerc")
]

!!! Szuka NAJBLIZSZEGO `Virus.hk` zaczynajac od `start` i idac w gore
!!! drzewa katalogow (tak jak `cargo` szuka NAJBLIZSZEGO `Cargo.toml`) -
!!! `none()`, jesli zaden katalog nadrzedny go nie ma (dotarto do
!!! korzenia sciezki). To NIE JEST jeszcze `find_project_root` - to
!!! tylko pierwszy krok (patrz `find_project_root` nizej, ktora
!!! dodatkowo sprawdza, czy ten katalog jest CZLONKIEM jakiegos
!!! workspace polozonego wyzej).
fun find_nearest_manifest_dir(start: Str) -> Option<Str> [
    let dir = start
    while true [
        if path_exists(path_join(dir.clone(), "Virus.hk")) [
            end some(dir)
        ]
        let parent = path_dirname(dir.clone())
        if parent.len() == 0 or parent == dir [
            end none()
        ]
        dir = parent
    ]
    end none()
]

!!! Czy `[workspace] -> members` manifestu w `workspace_dir` (sciezka
!!! bezwzgledna) wymienia `member_dir` (tez sciezka bezwzgledna) - PO
!!! ODWZOROWANIU kazdego wpisu wzgledem `workspace_dir`
!!! (`path_join(workspace_dir, member)`). Manifest, ktorego nie da sie
!!! sparsowac (albo bez sekcji `[workspace]`) po prostu NIE roscii sobie
!!! praw do niczego - `false`, bez bledu (ten sam styl co reszta
!!! modulu cache - blad w odczycie manifestu nigdy nie powinien wysadzic
!!! `virus cache`/`virus build`).
fun workspace_claims_member(workspace_dir: Str, member_dir: Str) -> Bool [
    match parse_manifest_file(path_join(workspace_dir.clone(), "Virus.hk")) [
        Ok(m) -> [
            let i = 0
            let n = m.workspace.members.len()
            while i < n [
                let candidate = path_join(workspace_dir.clone(), m.workspace.members[i].clone())
                if candidate == member_dir [
                    end true
                ]
                i = i + 1
            ]
            end false
        ]
        Err(_e) -> [
            end false
        ]
    ]
]

!!! NAPRAWA BLEDU (0.4): idac w gore od `member_dir` (najblizszy
!!! `Virus.hk` znaleziony przez `find_nearest_manifest_dir`), sprawdza
!!! KAZDEGO przodka - nie tylko bezposredniego rodzica - pod katem
!!! wlasnego `Virus.hk` z sekcja `[workspace]`, ktora roscii sobie
!!! prawa do `member_dir` (przez `workspace_claims_member`, zawsze
!!! wzgledem ORYGINALNEGO `member_dir`, nie jakiejs posredniej
!!! sciezki). Zapamietuje NAJDALSZEGO (najwyzej polozonego) takiego
!!! przodka i zwraca go jako prawdziwy korzen cache'a.
!!!
!!! Przyklad z tego wlasnie repo: dla `member_dir = <repo>/libs/core`
!!! zarowno `<repo>/libs/Virus.hk` ([workspace] -> members =
!!! ["core","std"]) JAK I `<repo>/Virus.hk` ([workspace] -> members =
!!! [..., "libs/core", ...]) rosciila sobie prawa do tego katalogu -
!!! bierzemy TEN DALSZY (`<repo>`), bo to on jest prawdziwym korzeniem
!!! calego drzewa.
!!!
!!! Dlaczego to w ogole byl blad: `virus`/`hackerc` w tym repo maja
!!! WLASNE, osobne pliki `Virus.hk` (hackerc/Virus.hk, virus/Virus.hk,
!!! libs/core/Virus.hk, libs/std/Virus.hk) - to sa jednoczesnie
!!! prawidlowe, samodzielne manifesty (kazdy z nich da sie zbudowac/
!!! sparsowac z osobna) I czlonkowie wiekszego workspace w korzeniu
!!! repo. PRZED ta poprawka, `find_project_root("hackerc/cmd")` (czyli
!!! kazde `virus <cokolwiek>` odpalone z wnetrza `hackerc/`) zatrzymywalo
!!! sie na NAJBLIZSZYM `Virus.hk` (`hackerc/Virus.hk`) i tworzylo
!!! WLASNY `hackerc/cache/` - analogicznie `virus/cache/` z wnetrza
!!! `virus/`, i osobny `cache/` w korzeniu przy odpaleniu stamtad -
!!! TRZY (albo wiecej, liczac libs/core i libs/std) rozne katalogi
!!! `cache/` dla JEDNEGO workspace, zamiast jednego wspolnego (tak jak
!!! `cargo` w workspace ZAWSZE dzieli jeden `target/` w korzeniu,
!!! niezaleznie z ktorego czlonka sie go odpali). Od teraz kazde z tych
!!! miejsc uzywa TEGO SAMEGO, jedynego `<repo>/cache/`.
fun climb_to_workspace_root(member_dir: Str) -> Str [
    let best = member_dir
    let ancestor = path_dirname(best.clone())
    let prev = best.clone()
    while ancestor.len() > 0 and ancestor != prev [
        if path_exists(path_join(ancestor.clone(), "Virus.hk")) [
            if workspace_claims_member(ancestor.clone(), member_dir.clone()) [
                best = ancestor.clone()
            ]
        ]
        prev = ancestor.clone()
        ancestor = path_dirname(ancestor.clone())
    ]
    end best
]

!!! Szuka korzenia PROJEKTU/WORKSPACE zaczynajac od `start` i idac w
!!! gore drzewa katalogow (tak jak `cargo` szuka `Cargo.toml`) -
!!! `none()`, jesli zaden katalog nadrzedny nie ma `Virus.hk` (dotarto
!!! do korzenia sciezki). Od 0.4: to JEDYNY, WSPOLNY korzen `cache/`
!!! dla calego workspace, NIE zawsze po prostu "najblizszy Virus.hk" -
!!! patrz `climb_to_workspace_root` (naprawa duplikujacego sie
!!! `cache/`).
fun find_project_root(start: Str) -> Option<Str> [
    match find_nearest_manifest_dir(start) [
        Some(dir) -> [
            end some(climb_to_workspace_root(dir))
        ]
        None -> [
            end none()
        ]
    ]
]
