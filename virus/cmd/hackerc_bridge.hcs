get <std:path> import <path_join>
get <std:string> import <str_trim>
get <std:process> import <run_command_checked::command_succeeds>
get <std:fs> import <create_dir_ok>
include <cache>
include <progress>

const DEFAULT_HACKERC_VERSION: Str = "1.2"

!!! Nazwa assetu wydania GitHub - dokladnie `hackerc` (BEZ przyrostka
!!! platformy) - te wydania sa dzis buildowane TYLKO dla Linux x86_64
!!! (jak reszta tego stdlib - `virus`/`HackerScript` celuja w
!!! HackerOS-Linux-System, patrz uwagi w innych modulach), wiec jeden
!!! plik na wydanie wystarcza. Przyklad dla wersji "0.0.1":
!!! https://github.com/HackerOS-Linux-System/HackerScript/releases/download/v0.0.1/hackerc
fun hackerc_asset_name() -> Str [
    end "hackerc"
]

fun hackerc_release_url(version: Str) -> Str [
    end "https://github.com/HackerOS-Linux-System/HackerScript/releases/download/v" + version + "/" + hackerc_asset_name()
]

!!! Znajduje binarke `hackerc` do uzycia, w kolejnosci:
!!! 1. zmienna srodowiskowa `HACKERC_BIN`
!!! 2. `cache/env/hackerc-<wersja>/hackerc` (pobrana wczesniej)
!!! 3. `hackerc` w PATH (np. zainstalowany przez `pip install -e ./hackerc`)
!!! Zwykle NIE wywoluj tego bezposrednio - `hackerc_ensure` ponizej robi
!!! to samo, ale przy niepowodzeniu automatycznie POBIERA wersje
!!! zadeklarowana przez `using <wersja>` (patrz tam).
fun hackerc_resolve(cache: CacheDirs, version: Str) -> Result<Str, Str> [
    match env_var("HACKERC_BIN") [
        Some(p) -> [
            end ok(p)
        ]
        None -> [
        ]
    ]

    let cached = cache_hackerc_binary(cache, version.clone())
    if path_exists(cached.clone()) [
        end ok(cached)
    ]

    match run_command("which", ["hackerc"]) [
        Ok(out) -> [
            let trimmed = str_trim(out)
            if trimmed.len() > 0 [
                end ok(trimmed)
            ]
        ]
        Err(_e) -> [
        ]
    ]

    end err("nie znaleziono hackerc (wersja " + version + ")")
]

!!! Pobiera binarke `hackerc` dla `version` z wydania GitHub (patrz
!!! `hackerc_release_url`) do `cache/env/hackerc-<wersja>/hackerc` -
!!! DOKLADNIE to, co plik zrodlowy zaczynajacy sie od `using <wersja>`
!!! deklaruje jako wymagana wersje kompilatora (patrz
!!! `parser.hcs::parse_using`, `manifest.hcs::lang_using`) - to jest
!!! mechanizm ODPOWIADAJACY `rustup toolchain install` w ekosystemie
!!! Rust, tylko zamiast wielu kanalow jest jedna, dokladna wersja per
!!! plik/manifest.
!!!
!!! Uzywa `curl` (jak `virus install`, patrz install.hcs) zamiast
!!! wbudowanego `http_get` - `http_get`/`std:http` obsluguja TYLKO
!!! odpowiedzi tekstowe UTF-8 (patrz libs/std/lib/http.hcs), a binarka
!!! ELF `hackerc` oczywiscie nie jest tekstem. Flaga `--progress-bar`
!!! (`-#`) to WLASNY, NATYWNY pasek postepu `curla` - `run_command`
!!! (builtin) zwraca wynik dopiero PO zakonczeniu procesu, wiec `virus`
!!! sam nie ma dostepu do bajtow strumienia w trakcie pobierania i nie
!!! moze wyrenderowac WLASNEGO paska (`std:term`) dla tej operacji -
!!! patrz "Ograniczenia" w docs/ROADMAP.md.
fun hackerc_download(cache: CacheDirs, version: Str) -> Result<Str, Str> [
    if not command_succeeds("curl", ["--version"]) [
        end err("automatyczne pobieranie hackerc " + version + " wymaga zainstalowanego `curl`. Pobierz recznie: " + hackerc_release_url(version))
    ]

    let dest_dir = path_join(cache.env, "hackerc-" + version)
    if not create_dir_ok(dest_dir) [
        end err("nie mozna utworzyc katalogu " + dest_dir)
    ]
    let dest_bin = cache_hackerc_binary(cache, version.clone())
    let url = hackerc_release_url(version.clone())

    progress_header("using <" + version + "> - hackerc nie znaleziony, pobieram z " + url)
    let user_agent = "virus-hackerscript/0.0.1 (+https://github.com/HackerOS-Linux-System/HackerScript)"
    let curl_args: List<Str> = ["-L", "--fail", "--progress-bar", "-A", user_agent, "-o", dest_bin.clone(), url.clone()]
    match run_command_checked("curl", curl_args) [
        Ok(_out) -> [
        ]
        Err(e) -> [
            end err("nie udalo sie pobrac hackerc " + version + " z " + url + ": " + e)
        ]
    ]

    match run_command("chmod", ["+x", dest_bin.clone()]) [
        Ok(_v) -> [
        ]
        Err(e) -> [
            end err("pobrano hackerc " + version + ", ale nie udalo sie nadac praw wykonywania (chmod +x " + dest_bin + "): " + e)
        ]
    ]

    if not path_exists(dest_bin.clone()) [
        end err("pobrano plik, ale " + dest_bin + " nie istnieje - sprawdz nazwe assetu wydania (`" + hackerc_asset_name() + "`) pod " + url)
    ]
    progress_success("hackerc " + version + " gotowy: " + dest_bin)
    end ok(dest_bin)
]

!!! `hackerc_resolve`, ale przy niepowodzeniu automatycznie WYWOLUJE
!!! `hackerc_download` - to jest funkcja, ktorej powinny uzywac WSZYSTKIE
!!! podkomendy `virus` potrzebujace `hackerc` (`build`/`check`/`lint`/
!!! `fmt`) - wczesniej TYLKO `virus build` probowalo pobierac (patrz
!!! `build_ensure_hackerc` - USUNIETE, przeniesione tutaj), a `check`/
!!! `lint`/`fmt` po prostu sie poddawaly z bledem. Teraz `using <0.1>`
!!! (albo `[package] using` w Virus.hk) NAPRAWDE wystarcza, zeby caly
!!! projekt "po prostu dzialal" na czystej maszynie z samym `curl`.
fun hackerc_ensure(cache: CacheDirs, version: Str) -> Result<Str, Str> [
    match hackerc_resolve(cache.clone(), version.clone()) [
        Ok(path) -> [
            end ok(path)
        ]
        Err(_e) -> [
            end hackerc_download(cache, version)
        ]
    ]
]

!!! `hackerc build <entry> -o <crate_dir> --crate-name <nazwa>` -
!!! generuje PELNY crate Rust (Cargo.toml + src/main.rs + moduly z
!!! get<std/core/virus>). NIE kompiluje - to robi `hackerc_compile_crate`.
fun hackerc_build_crate(hackerc_bin: Str, entry: Str, crate_dir: Str, crate_name: Str) -> Result<Str, Str> [
    end run_command_checked(hackerc_bin, ["build", entry.clone(), "-o", crate_dir.clone(), "--crate-name", crate_name.clone()])
]

!!! `hackerc check <plik>` - diagnostyka bez generowania kodu.
fun hackerc_check_file(hackerc_bin: Str, src: Str) -> Result<Str, Str> [
    end run_command_checked(hackerc_bin, ["check", src.clone()])
]

!!! `hackerc lint <plik>` - tylko warningi (podzbior `check`).
!!! `hackerc lint <plik>` - tylko warningi (podzbior `check`). W
!!! odroznieniu od `hackerc_check_file` (`Result`) zwraca ZAWSZE `Str` -
!!! `hackerc lint` pisze warningi na STDERR nawet przy kodzie wyjscia 0
!!! (sukces), wiec `run_command`/`run_command_checked` (ktore przy
!!! sukcesie zwracaja TYLKO stdout) zgubilyby cala diagnostyke - patrz
!!! `run_command_combined` (get <std:process>).
fun hackerc_lint_file(hackerc_bin: Str, src: Str) -> Str [
    end run_command_combined(hackerc_bin, ["lint", src.clone()])
]

!!! Kompiluje crate wygenerowany przez `hackerc build` (Cargo.toml +
!!! src/) przez `cargo build [--release]`. To jest TOOLCHAIN, nie
!!! menedzer pakietow - `virus` sam nie zarzadza zaleznosciami przez
!!! cargo (patrz install.hcs) - ale bez realnego kompilatora Rust na
!!! maszynie zadnego kodu HackerScript nie da sie uruchomic. Zwraca
!!! sciezke do zbudowanej binarki.
fun hackerc_compile_crate(crate_dir: Str, crate_name: Str, release: Bool) -> Result<Str, Str> [
    if not command_succeeds("cargo", ["--version"]) [
        end err("budowanie wymaga zainstalowanego Rust (cargo) - crate wygenerowany w " + crate_dir + " nie zostal skompilowany. Zainstaluj Rust: https://rustup.rs")
    ]

    let cargo_args: List<Str> = ["build", "--manifest-path", path_join(crate_dir.clone(), "Cargo.toml")]
    if release [
        cargo_args.push("--release")
    ]
    let build_result = run_command_checked("cargo", cargo_args)?

    let profile_dir = "debug"
    if release [
        profile_dir = "release"
    ]
    let built = path_join(path_join(path_join(crate_dir, "target"), profile_dir), crate_name)
    if not path_exists(built.clone()) [
        end err("kompilacja zakonczyla sie (podobno) sukcesem, ale nie znaleziono binarki " + built + " - sprawdz [[bin]].name w Cargo.toml. Wyjscie cargo:\n" + build_result)
    ]
    end ok(built)
]
