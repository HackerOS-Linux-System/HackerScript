[package]
-> name        => HackerScript
-> version     => 0.4
-> description => Workspace jezyka HackerScript: transpilator hackerc, kompilator AOT hack3rc oraz biblioteki core i std, 100% w HackerScript.
-> authors     => ["HackerOS Team"]
-> license     => MIT
-> lang        => HackerScript
-> using       => 0.4

[workspace]
-> members => [hackerc, hack3rc, libs/core, libs/std]

[build]
-> link => static

[default-build]
-> profile => release
