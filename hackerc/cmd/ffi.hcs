include <ast_nodes>
include <project>
include <hlib>
get <std:string> import <str_join::str_replace>

!!! ffi.hcs - `hackerc hlib build --ffi`: fasada C-ABI dla bibliotek HackerScript.
!!!
!!! PO CO: H# (i kazdy inny jezyk spoza HackerScript) nie czyta zrodla `.hcs`, wiec zwykly `.hlib`
!!! HackerScript (artefakt `ast` = tekst `.hcs`) jest dla niego martwy. `--ffi` dobudowuje do `.hlib`
!!! PRAWDZIWY artefakt natywny: statyczna biblioteke (`static_lib`, `lib<nazwa>.a`) z plaskim C-ABI,
!!! plus `manifest.exports` (z polem `api` = symbol C), z ktorych H# syntetyzuje `extern`.
!!!
!!! PODZIAL PRACY: ten plik tylko serializuje AST do prostego tekstu (IR, patrz `ffi_ir`). Caly generator
!!! Rust-a siedzi w `ffi_gen.rs` (testowalny samodzielnie rustc/cargo) i jest wklejany do bloku natywnego
!!! ponizej przez `scripts/ffi_splice.py`. Dokumentacja kontraktu: docs/HLIB_FORMAT.md, sekcja 10.

struct FfiBuildOut [
    ok: Bool,
    message: Str,
    static_lib_path: Str,
    link_libs: Str,
    exports_json: Str
]

fun ffi_plain(s: Str) -> Str [
    end s
]

fun ffi_type_text(t: TypeRef) -> Str [
    match t.generic.clone() [
        Some(inner) -> [
            match t.generic2.clone() [
                Some(inner2) -> [
                    end t.name + "<" + ffi_type_text(inner) + "," + ffi_type_text(inner2) + ">"
                ]
                None -> [
                    end t.name + "<" + ffi_type_text(inner) + ">"
                ]
            ]
        ]
        None -> [
            end t.name
        ]
    ]
]

fun ffi_opt_type_text(t: Option<TypeRef>) -> Str [
    match t.clone() [
        Some(inner) -> [
            end ffi_type_text(inner)
        ]
        None -> [
            end "Int"
        ]
    ]
]

!!! Przecinkowa lista nazw (parametry typowe).
fun ffi_csv(xs: List<Str>) -> Str [
    end str_join(xs, ",")
]

!!! Jedna funkcja/metoda -> linia `F|wlasciciel|param_wlasciciela|nazwa|async|parametry_typowe|p:Typ|...|=Zwracany`.
fun ffi_fun_line(owner: Str, owner_tp: List<Str>, name: Str, params: List<Param>, ret: Option<TypeRef>, tp: List<Str>, is_async: Bool) -> Str [
    let line = "F|" + owner + "|" + ffi_csv(owner_tp) + "|" + name + "|"
    if is_async [
        line = line + "1|"
    ] else [
        line = line + "0|"
    ]
    line = line + ffi_csv(tp)
    let i = 0
    while i < params.len() [
        let p = params[i].clone()
        if p.name == "self" [
            line = line + "|self:self"
        ] else [
            line = line + "|" + p.name + ":" + ffi_opt_type_text(p.type_ref.clone())
        ]
        i = i + 1
    ]
    match ret.clone() [
        Some(rt) -> [
            line = line + "|=" + ffi_type_text(rt)
        ]
        None -> [
            line = line + "|="
        ]
    ]
    end line + "\n"
]

!!! AST calego projektu -> IR (jedna deklaracja na linie).
fun ffi_ir(bodies: List<Stmt>) -> Str [
    let ir = ""
    let i = 0
    let n = bodies.len()
    while i < n [
        match bodies[i].clone() [
            StructDecl(sname, sfields, stp) -> [
                let line = "S|" + sname + "|" + ffi_csv(stp)
                let k = 0
                while k < sfields.len() [
                    let f = sfields[k].clone()
                    line = line + "|" + f.name + ":" + ffi_opt_type_text(f.type_ref.clone())
                    k = k + 1
                ]
                ir = ir + line + "\n"
            ]
            EnumDecl(ename, evariants, etp) -> [
                let line = "E|" + ename + "|" + ffi_csv(etp)
                let k = 0
                while k < evariants.len() [
                    let v = evariants[k].clone()
                    line = line + "|" + v.name
                    if v.fields.len() > 0 [
                        let parts: List<Str> = []
                        let q = 0
                        while q < v.fields.len() [
                            parts.push(ffi_type_text(v.fields[q].clone()))
                            q = q + 1
                        ]
                        line = line + ":" + str_join(parts, ";")
                    ]
                    k = k + 1
                ]
                ir = ir + line + "\n"
            ]
            FunDecl(fname, fparams, fret, fbody, fpub, ftp, fasync) -> [
                ir = ir + ffi_fun_line("", [], fname, fparams, fret, ftp, fasync)
            ]
            ImplDecl(iname, imethods, itp) -> [
                let k = 0
                while k < imethods.len() [
                    match imethods[k].clone() [
                        FunDecl(mname, mparams, mret, mbody, mpub, mtp, masync) -> [
                            ir = ir + ffi_fun_line(iname.clone(), itp.clone(), mname, mparams, mret, mtp, masync)
                        ]
                        _ -> [
                        ]
                    ]
                    k = k + 1
                ]
            ]
            _ -> [
            ]
        ]
        i = i + 1
    ]
    end ir
]

!!! Generator (Rust, zrodlo: ffi_gen.rs). Zwraca "<kod Rust>\u{1}<exports JSON>\u{1}<pominiete>".
fun ffi_generate_native(ir: Str, lib: Str, inst: Str) -> Str [
    let out = ""
    native {Rust} [
        //@@FFI_GEN_BEGIN
        // ffi_gen.rs - generator fasady C-ABI (zrodlo wklejane do bloku Rust w ffi.hcs przez scripts/ffi_splice.py).
        // Wejscie: `ir` (tekst z ffi.hcs), `lib` (nazwa), `inst` (instancjacje generykow, po przecinku).
        // Wyjscie: `out` = <kod Rust>\u{1}<exports JSON>\u{1}<pominiete, po \n>.
        // Uwaga: blok jest wycinany przez zliczanie nawiasow kwadratowych - w calym pliku musza byc zbalansowane.
        #[derive(Clone, Debug, PartialEq)]
        enum Ty { Int, Float, Bool, Str, Unit, List(Box<Ty>), Dict(Box<Ty>, Box<Ty>), Set(Box<Ty>), Opt(Box<Ty>), Res(Box<Ty>, Box<Ty>), Chan(Box<Ty>), Named(String, Vec<Ty>) }

        struct SDecl { name: String, tp: Vec<String>, fields: Vec<(String, Ty)> }
        struct EDecl { name: String, tp: Vec<String>, variants: Vec<(String, Vec<Ty>)> }
        #[derive(Clone)]
        struct FDecl { owner: String, owner_tp: Vec<String>, name: String, is_async: bool, tp: Vec<String>, params: Vec<(String, Ty)>, has_self: bool, ret: Option<Ty> }

        struct Gen {
            lib: String, structs: Vec<SDecl>, enums: Vec<EDecl>, funs: Vec<FDecl>,
            rust: String, exports: Vec<String>, skipped: Vec<String>,
            queue: Vec<Ty>, seen: Vec<String>, done_fns: Vec<String>,
        }

        fn split_top(s: &str, sep: char) -> Vec<String> {
            let mut out = Vec::new();
            let mut depth = 0i32;
            let mut cur = String::new();
            for c in s.chars() {
                if c == '<' { depth += 1; }
                if c == '>' { depth -= 1; }
                if c == sep && depth == 0 { out.push(cur.trim().to_string()); cur = String::new(); } else { cur.push(c); }
            }
            if !cur.trim().is_empty() || !out.is_empty() { out.push(cur.trim().to_string()); }
            out
        }

        fn parse_ty(s: &str) -> Ty {
            let s = s.trim();
            let (name, args) = match s.find('<') {
                Some(i) if s.ends_with('>') => (s[..i].trim().to_string(), split_top(&s[i + 1..s.len() - 1], ',').iter().map(|a| parse_ty(a)).collect::<Vec<Ty>>()),
                _ => (s.to_string(), Vec::new()),
            };
            let one = |a: &Vec<Ty>| Box::new(a.get(0).cloned().unwrap_or(Ty::Unit));
            let two = |a: &Vec<Ty>| Box::new(a.get(1).cloned().unwrap_or(Ty::Unit));
            match name.as_str() {
                "Int" => Ty::Int, "Float" => Ty::Float, "Bool" => Ty::Bool, "Str" => Ty::Str, "" | "Unit" => Ty::Unit,
                "List" => Ty::List(one(&args)), "Set" => Ty::Set(one(&args)), "Option" => Ty::Opt(one(&args)), "Chan" => Ty::Chan(one(&args)),
                "Dict" => Ty::Dict(one(&args), two(&args)), "Result" => Ty::Res(one(&args), two(&args)),
                _ => Ty::Named(name, args),
            }
        }

        fn subst(t: &Ty, names: &[String], args: &[Ty]) -> Ty {
            let b = |x: &Ty| Box::new(subst(x, names, args));
            match t {
                Ty::Named(n, a) if a.is_empty() && names.iter().any(|x| x == n) => {
                    let i = names.iter().position(|x| x == n).unwrap();
                    args.get(i).cloned().unwrap_or(Ty::Unit)
                }
                Ty::Named(n, a) => Ty::Named(n.clone(), a.iter().map(|x| subst(x, names, args)).collect()),
                Ty::List(x) => Ty::List(b(x)), Ty::Set(x) => Ty::Set(b(x)), Ty::Opt(x) => Ty::Opt(b(x)), Ty::Chan(x) => Ty::Chan(b(x)),
                Ty::Dict(k, v) => Ty::Dict(b(k), b(v)), Ty::Res(k, v) => Ty::Res(b(k), b(v)),
                o => o.clone(),
            }
        }

        fn tname(t: &Ty) -> String {
            match t {
                Ty::Int => "Int".into(), Ty::Float => "Float".into(), Ty::Bool => "Bool".into(), Ty::Str => "Str".into(), Ty::Unit => "Unit".into(),
                Ty::List(x) => format!("List_{}", tname(x)), Ty::Set(x) => format!("Set_{}", tname(x)), Ty::Opt(x) => format!("Option_{}", tname(x)),
                Ty::Chan(x) => format!("Chan_{}", tname(x)),
                Ty::Dict(k, v) => format!("Dict_{}_{}", tname(k), tname(v)), Ty::Res(k, v) => format!("Result_{}_{}", tname(k), tname(v)),
                Ty::Named(n, a) => { let mut s = n.clone(); for x in a { s.push('_'); s.push_str(&tname(x)); } s }
            }
        }

        fn rty(t: &Ty) -> String {
            match t {
                Ty::Int => "i64".into(), Ty::Float => "f64".into(), Ty::Bool => "bool".into(), Ty::Str => "String".into(), Ty::Unit => "()".into(),
                Ty::List(x) => format!("Vec<{}>", rty(x)), Ty::Set(x) => format!("std::collections::HashSet<{}>", rty(x)),
                Ty::Opt(x) => format!("Option<{}>", rty(x)), Ty::Chan(x) => format!("HksChan<{}>", rty(x)),
                Ty::Dict(k, v) => format!("std::collections::HashMap<{}, {}>", rty(k), rty(v)),
                Ty::Res(k, v) => format!("Result<{}, {}>", rty(k), rty(v)),
                Ty::Named(n, a) => if a.is_empty() { n.clone() } else { format!("{}<{}>", n, a.iter().map(|x| rty(x)).collect::<Vec<_>>().join(", ")) },
            }
        }

        fn is_scalar(t: &Ty) -> bool { matches!(t, Ty::Int | Ty::Float | Ty::Bool) }
        fn is_handle(t: &Ty) -> bool { !is_scalar(t) && !matches!(t, Ty::Str | Ty::Unit) }
        fn hashable(t: &Ty) -> bool { matches!(t, Ty::Int | Ty::Bool | Ty::Str) }
        fn cty(t: &Ty) -> &'static str {
            match t { Ty::Int => "i64", Ty::Float => "f64", Ty::Bool => "bool", Ty::Str => "*const std::os::raw::c_char", _ => "i64" }
        }
        fn abi_json(t: &Ty) -> String {
            match t {
                Ty::Int => "{\"type\":\"i64\"}".into(), Ty::Float => "{\"type\":\"f64\"}".into(), Ty::Bool => "{\"type\":\"bool\"}".into(),
                Ty::Str => "{\"type\":\"cstr\"}".into(),
                o => format!("{{\"type\":\"opaque\",\"struct_name\":\"{}\"}}", tname(o)),
            }
        }
        fn ident(s: &str) -> String { s.chars().map(|c| if c.is_ascii_alphanumeric() || c == '_' { c } else { '_' }).collect() }

        impl Gen {
            fn find_s(&self, n: &str) -> Option<usize> { self.structs.iter().position(|s| s.name == n) }
            fn find_e(&self, n: &str) -> Option<usize> { self.enums.iter().position(|s| s.name == n) }

            // Czy typ da sie przeniesc przez fasade (rekurencja tylko po skladnikach, nie po polach struktur).
            fn supported(&self, t: &Ty) -> bool {
                match t {
                    Ty::Int | Ty::Float | Ty::Bool | Ty::Str => true,
                    Ty::Unit => false,
                    Ty::List(x) | Ty::Opt(x) | Ty::Chan(x) => self.supported(x),
                    Ty::Set(x) => hashable(x),
                    Ty::Dict(k, v) => hashable(k) && self.supported(v),
                    Ty::Res(a, b) => self.supported(a) && self.supported(b),
                    Ty::Named(n, a) => {
                        let tp = if let Some(i) = self.find_s(n) { self.structs[i].tp.len() } else if let Some(i) = self.find_e(n) { self.enums[i].tp.len() } else { return false };
                        tp == a.len() && a.iter().all(|x| self.supported(x))
                    }
                }
            }

            // zarejestruj typ-uchwyt (jego operacje zostana wygenerowane w `drain`)
            fn reg(&mut self, t: &Ty) {
                if !is_handle(t) { return; }
                let k = tname(t);
                if self.seen.contains(&k) { return; }
                self.seen.push(k);
                self.queue.push(t.clone());
            }

            // ---- konwersje ----
            fn in_ref(&self, t: &Ty, i: usize) -> String {
                match t { Ty::Str => format!("&mut hks_cstr(a{})", i), x if is_handle(x) => format!("hks_ref::<{}>(a{})", rty(x), i), _ => format!("a{}", i) }
            }
            fn in_own(&self, t: &Ty, i: usize) -> String {
                match t { Ty::Str => format!("hks_cstr(a{})", i), x if is_handle(x) => format!("hks_ref::<{}>(a{}).clone()", rty(x), i), _ => format!("a{}", i) }
            }
            fn out_own(&self, t: &Ty, e: &str) -> String {
                match t { Ty::Str => format!("hks_ret_str({})", e), x if is_handle(x) => format!("hks_box({})", e), _ => e.to_string() }
            }
            // `e` ma typ `&mut T`: skalar -> wartosc, Str -> kopia, uchwyt -> wskaznik pozyczony
            fn out_ref(&self, t: &Ty, e: &str) -> String {
                match t { Ty::Str => format!("hks_ret_str(({}).clone())", e), x if is_handle(x) => format!("hks_ptr({})", e), _ => format!("(*{}).clone()", e) }
            }
            fn dflt(&self, t: &Ty) -> String {
                match t { Ty::Float => "0.0".into(), Ty::Bool => "false".into(), Ty::Str => "hks_ret_str(String::new())".into(), _ => "0".into() }
            }

            fn emit(&mut self, name: &str, sig: &str, params: &[Ty], ret: Option<&Ty>, body: &str) {
                for p in params { self.reg(p); }
                if let Some(r) = ret { self.reg(r); }
                let sym = format!("hksffi_{}_{}", self.lib, name);
                let ps: Vec<String> = params.iter().enumerate().map(|(i, p)| format!("a{}: {}", i, cty(p))).collect();
                let mut head = format!("#[no_mangle]\npub unsafe extern \"C\" fn {}({})", sym, ps.join(", "));
                if let Some(r) = ret { head.push_str(&format!(" -> {}", cty(r))); }
                self.rust.push_str(&format!("{} {{\n    {}\n}}\n", head, body));
                let pj: Vec<String> = params.iter().map(|p| abi_json(p)).collect();
                let mut ej = format!("{{\"name\":\"{}\",\"kind\":\"function\",\"signature\":\"{}\",\"params\":[{}]", name, sig, pj.join(","));
                if let Some(r) = ret { ej.push_str(&format!(",\"returns\":{}", abi_json(r))); }
                ej.push_str(&format!(",\"generic\":false,\"is_macro\":false,\"api\":\"{}\"}}", sym));
                self.exports.push(ej);
            }

            // ---- funkcje uzytkownika ----
            fn gen_fn(&mut self, d: &FDecl, owner_args: &[Ty], targs: &[Ty]) {
                let mut names: Vec<String> = d.owner_tp.clone();
                names.extend(d.tp.iter().cloned());
                let mut args: Vec<Ty> = owner_args.to_vec();
                args.extend(targs.iter().cloned());
                if names.len() != args.len() { self.skipped.push(format!("{} (liczba argumentow typowych)", d.name)); return; }
                let self_ty = if d.owner.is_empty() { Ty::Unit } else { Ty::Named(d.owner.clone(), owner_args.to_vec()) };
                let fix = |t: &Ty| -> Ty { let t2 = if let Ty::Named(n, a) = t { if n == "Self" && a.is_empty() { self_ty.clone() } else { t.clone() } } else { t.clone() }; subst(&t2, &names, &args) };
                let mut label = d.name.clone();
                if !d.owner.is_empty() { label = format!("{}_{}", tname(&self_ty), d.name); }
                for t in targs { label.push('_'); label.push_str(&tname(t)); }
                let mut ptys: Vec<Ty> = Vec::new();
                let mut call_args: Vec<String> = Vec::new();
                let mut recv = String::new();
                for (i, (pn, decl)) in d.params.iter().enumerate() {
                    let t = if d.has_self && i == 0 { self_ty.clone() } else { fix(decl) };
                    if !self.supported(&t) { self.skipped.push(format!("{} (parametr `{}` ma typ spoza fasady)", label, pn)); return; }
                    let declared_refable = match decl {
                        Ty::Str | Ty::List(_) | Ty::Dict(_, _) => true,
                        Ty::Named(n, a) => a.is_empty() && !names.contains(n) || !a.is_empty() && (self.find_s(n).is_some() || self.find_e(n).is_some()) || (n == "Self"),
                        _ => false,
                    };
                    if d.has_self && i == 0 { recv = self.in_ref(&t, 0); }
                    else if declared_refable { call_args.push(self.in_ref(&t, i)); }
                    else if is_scalar(&t) { call_args.push(format!("a{}", i)); }
                    else { call_args.push(self.in_own(&t, i)); }
                    ptys.push(t);
                }
                let ret = d.ret.as_ref().map(|r| fix(r));
                if let Some(r) = &ret { if !self.supported(r) { self.skipped.push(format!("{} (typ zwracany spoza fasady)", label)); return; } }
                let turbofish = if d.tp.is_empty() { String::new() } else { format!("::<{}>", targs.iter().map(|t| rty(t)).collect::<Vec<_>>().join(", ")) };
                let mut call = if d.owner.is_empty() {
                    format!("{}{}({})", d.name, turbofish, call_args.join(", "))
                } else if d.has_self {
                    format!("{}.{}{}({})", recv, d.name, turbofish, call_args.join(", "))
                } else if owner_args.is_empty() {
                    format!("{}::{}{}({})", d.owner, d.name, turbofish, call_args.join(", "))
                } else {
                    format!("{}::<{}>::{}{}({})", d.owner, owner_args.iter().map(|t| rty(t)).collect::<Vec<_>>().join(", "), d.name, turbofish, call_args.join(", "))
                };
                if d.is_async { call = format!("hks_block_on({})", call); }
                let body = match &ret {
                    None => format!("{};", call),
                    Some(r) => format!("let r = {};\n    {}", call, self.out_own(r, "r")),
                };
                if self.done_fns.contains(&label) { return; }
                self.done_fns.push(label.clone());
                let sig = format!("fun {}({}){}", label, ptys.iter().map(|t| tname(t)).collect::<Vec<_>>().join(", "), ret.as_ref().map(|r| format!(" -> {}", tname(r))).unwrap_or_default());
                self.emit(&label, &sig, &ptys, ret.as_ref(), &body);
            }

            // ---- operacje na typach-uchwytach ----
            fn ops(&mut self, t: &Ty) {
                let n = tname(t);
                let r = rty(t);
                let me = t.clone();
                let hr = format!("hks_ref::<{}>", r);
                self.emit(&format!("{}_free", n), &format!("fun {}_free(h: {})", n, n), &[me.clone()], None, &format!("hks_free::<{}>(a0);", r));
                self.emit(&format!("{}_clone", n), &format!("fun {}_clone(h: {}) -> {}", n, n, n), &[me.clone()], Some(&me), &format!("hks_box({}(a0).clone())", hr));
                match t {
                    Ty::List(e) => {
                        let e = (**e).clone();
                        self.emit(&format!("{}_new", n), &format!("fun {}_new() -> {}", n, n), &[], Some(&me), &format!("hks_box(Vec::<{}>::new())", rty(&e)));
                        self.emit(&format!("{}_len", n), &format!("fun {}_len(h: {}) -> Int", n, n), &[me.clone()], Some(&Ty::Int), &format!("{}(a0).len() as i64", hr));
                        self.emit(&format!("{}_clear", n), &format!("fun {}_clear(h: {})", n, n), &[me.clone()], None, &format!("{}(a0).clear();", hr));
                        self.emit(&format!("{}_push", n), &format!("fun {}_push(h: {}, v: {})", n, n, tname(&e)), &[me.clone(), e.clone()], None, &format!("{}(a0).push({});", hr, self.in_own(&e, 1)));
                        let get = format!("match {}(a0).get_mut(a1 as usize) {{ Some(x) => {}, None => {} }}", hr, self.out_ref(&e, "x"), self.dflt(&e));
                        self.emit(&format!("{}_get", n), &format!("fun {}_get(h: {}, i: Int) -> {}", n, n, tname(&e)), &[me.clone(), Ty::Int], Some(&e), &get);
                        let set = format!("if let Some(x) = {}(a0).get_mut(a1 as usize) {{ *x = {}; }}", hr, self.in_own(&e, 2));
                        self.emit(&format!("{}_set", n), &format!("fun {}_set(h: {}, i: Int, v: {})", n, n, tname(&e)), &[me.clone(), Ty::Int, e.clone()], None, &set);
                        let ins = format!("let v = {}(a0); let i = (a1 as usize).min(v.len()); v.insert(i, {});", hr, self.in_own(&e, 2));
                        self.emit(&format!("{}_insert", n), &format!("fun {}_insert(h: {}, i: Int, v: {})", n, n, tname(&e)), &[me.clone(), Ty::Int, e.clone()], None, &ins);
                        let pop = format!("match {}(a0).pop() {{ Some(x) => {}, None => {} }}", hr, self.out_own(&e, "x"), self.dflt(&e));
                        self.emit(&format!("{}_pop", n), &format!("fun {}_pop(h: {}) -> {}", n, n, tname(&e)), &[me.clone()], Some(&e), &pop);
                        let rem = format!("let v = {}(a0); if (a1 as usize) < v.len() {{ let x = v.remove(a1 as usize); {} }} else {{ {} }}", hr, self.out_own(&e, "x"), self.dflt(&e));
                        self.emit(&format!("{}_remove", n), &format!("fun {}_remove(h: {}, i: Int) -> {}", n, n, tname(&e)), &[me.clone(), Ty::Int], Some(&e), &rem);
                    }
                    Ty::Opt(e) => {
                        let e = (**e).clone();
                        self.emit(&format!("{}_none", n), &format!("fun {}_none() -> {}", n, n), &[], Some(&me), &format!("hks_box(None::<{}>)", rty(&e)));
                        self.emit(&format!("{}_some", n), &format!("fun {}_some(v: {}) -> {}", n, tname(&e), n), &[e.clone()], Some(&me), &format!("hks_box(Some({}))", self.in_own(&e, 0)));
                        self.emit(&format!("{}_is_some", n), &format!("fun {}_is_some(h: {}) -> Bool", n, n), &[me.clone()], Some(&Ty::Bool), &format!("{}(a0).is_some()", hr));
                        let get = format!("match {}(a0).as_mut() {{ Some(x) => {}, None => {} }}", hr, self.out_ref(&e, "x"), self.dflt(&e));
                        self.emit(&format!("{}_get", n), &format!("fun {}_get(h: {}) -> {}", n, n, tname(&e)), &[me.clone()], Some(&e), &get);
                    }
                    Ty::Res(a, b) => {
                        let (a, b) = ((**a).clone(), (**b).clone());
                        self.emit(&format!("{}_ok", n), &format!("fun {}_ok(v: {}) -> {}", n, tname(&a), n), &[a.clone()], Some(&me), &format!("hks_box(Ok::<{}, {}>({}))", rty(&a), rty(&b), self.in_own(&a, 0)));
                        self.emit(&format!("{}_err", n), &format!("fun {}_err(e: {}) -> {}", n, tname(&b), n), &[b.clone()], Some(&me), &format!("hks_box(Err::<{}, {}>({}))", rty(&a), rty(&b), self.in_own(&b, 0)));
                        self.emit(&format!("{}_is_ok", n), &format!("fun {}_is_ok(h: {}) -> Bool", n, n), &[me.clone()], Some(&Ty::Bool), &format!("{}(a0).is_ok()", hr));
                        let g1 = format!("match {}(a0) {{ Ok(x) => {}, Err(_) => {} }}", hr, self.out_ref(&a, "x"), self.dflt(&a));
                        self.emit(&format!("{}_ok_value", n), &format!("fun {}_ok_value(h: {}) -> {}", n, n, tname(&a)), &[me.clone()], Some(&a), &g1);
                        let g2 = format!("match {}(a0) {{ Err(x) => {}, Ok(_) => {} }}", hr, self.out_ref(&b, "x"), self.dflt(&b));
                        self.emit(&format!("{}_err_value", n), &format!("fun {}_err_value(h: {}) -> {}", n, n, tname(&b)), &[me.clone()], Some(&b), &g2);
                    }
                    Ty::Dict(k, v) => {
                        let (k, v) = ((**k).clone(), (**v).clone());
                        self.emit(&format!("{}_new", n), &format!("fun {}_new() -> {}", n, n), &[], Some(&me), &format!("hks_box(<{}>::new())", r));
                        self.emit(&format!("{}_len", n), &format!("fun {}_len(h: {}) -> Int", n, n), &[me.clone()], Some(&Ty::Int), &format!("{}(a0).len() as i64", hr));
                        self.emit(&format!("{}_clear", n), &format!("fun {}_clear(h: {})", n, n), &[me.clone()], None, &format!("{}(a0).clear();", hr));
                        self.emit(&format!("{}_insert", n), &format!("fun {}_insert(h: {}, k: {}, v: {})", n, n, tname(&k), tname(&v)), &[me.clone(), k.clone(), v.clone()], None, &format!("{}(a0).insert({}, {});", hr, self.in_own(&k, 1), self.in_own(&v, 2)));
                        self.emit(&format!("{}_contains", n), &format!("fun {}_contains(h: {}, k: {}) -> Bool", n, n, tname(&k)), &[me.clone(), k.clone()], Some(&Ty::Bool), &format!("{}(a0).contains_key(&{})", hr, self.in_own(&k, 1)));
                        self.emit(&format!("{}_remove", n), &format!("fun {}_remove(h: {}, k: {}) -> Bool", n, n, tname(&k)), &[me.clone(), k.clone()], Some(&Ty::Bool), &format!("{}(a0).remove(&{}).is_some()", hr, self.in_own(&k, 1)));
                        let get = format!("match {}(a0).get_mut(&{}) {{ Some(x) => {}, None => {} }}", hr, self.in_own(&k, 1), self.out_ref(&v, "x"), self.dflt(&v));
                        self.emit(&format!("{}_get", n), &format!("fun {}_get(h: {}, k: {}) -> {}", n, n, tname(&k), tname(&v)), &[me.clone(), k.clone()], Some(&v), &get);
                        let lk = Ty::List(Box::new(k.clone()));
                        self.emit(&format!("{}_keys", n), &format!("fun {}_keys(h: {}) -> {}", n, n, tname(&lk)), &[me.clone()], Some(&lk), &format!("hks_box({}(a0).keys().cloned().collect::<Vec<{}>>())", hr, rty(&k)));
                        let lv = Ty::List(Box::new(v.clone()));
                        self.emit(&format!("{}_values", n), &format!("fun {}_values(h: {}) -> {}", n, n, tname(&lv)), &[me.clone()], Some(&lv), &format!("hks_box({}(a0).values().cloned().collect::<Vec<{}>>())", hr, rty(&v)));
                    }
                    Ty::Set(e) => {
                        let e = (**e).clone();
                        self.emit(&format!("{}_new", n), &format!("fun {}_new() -> {}", n, n), &[], Some(&me), &format!("hks_box(<{}>::new())", r));
                        self.emit(&format!("{}_len", n), &format!("fun {}_len(h: {}) -> Int", n, n), &[me.clone()], Some(&Ty::Int), &format!("{}(a0).len() as i64", hr));
                        self.emit(&format!("{}_clear", n), &format!("fun {}_clear(h: {})", n, n), &[me.clone()], None, &format!("{}(a0).clear();", hr));
                        self.emit(&format!("{}_insert", n), &format!("fun {}_insert(h: {}, v: {}) -> Bool", n, n, tname(&e)), &[me.clone(), e.clone()], Some(&Ty::Bool), &format!("{}(a0).insert({})", hr, self.in_own(&e, 1)));
                        self.emit(&format!("{}_contains", n), &format!("fun {}_contains(h: {}, v: {}) -> Bool", n, n, tname(&e)), &[me.clone(), e.clone()], Some(&Ty::Bool), &format!("{}(a0).contains(&{})", hr, self.in_own(&e, 1)));
                        self.emit(&format!("{}_remove", n), &format!("fun {}_remove(h: {}, v: {}) -> Bool", n, n, tname(&e)), &[me.clone(), e.clone()], Some(&Ty::Bool), &format!("{}(a0).remove(&{})", hr, self.in_own(&e, 1)));
                        let le = Ty::List(Box::new(e.clone()));
                        self.emit(&format!("{}_items", n), &format!("fun {}_items(h: {}) -> {}", n, n, tname(&le)), &[me.clone()], Some(&le), &format!("hks_box({}(a0).iter().cloned().collect::<Vec<{}>>())", hr, rty(&e)));
                    }
                    Ty::Chan(e) => {
                        let e = (**e).clone();
                        self.emit(&format!("{}_new", n), &format!("fun {}_new(cap: Int) -> {}", n, n), &[Ty::Int], Some(&me), &format!("hks_box(<{}>::new(a0))", r));
                        self.emit(&format!("{}_send", n), &format!("fun {}_send(h: {}, v: {}) -> Bool", n, n, tname(&e)), &[me.clone(), e.clone()], Some(&Ty::Bool), &format!("hks_block_on({}(a0).send({}))", hr, self.in_own(&e, 1)));
                        let oe = Ty::Opt(Box::new(e.clone()));
                        self.emit(&format!("{}_recv", n), &format!("fun {}_recv(h: {}) -> {}", n, n, tname(&oe)), &[me.clone()], Some(&oe), &format!("hks_box(hks_block_on({}(a0).recv()))", hr));
                        self.emit(&format!("{}_close", n), &format!("fun {}_close(h: {})", n, n), &[me.clone()], None, &format!("{}(a0).close();", hr));
                    }
                    Ty::Named(nm, args) => {
                        if let Some(si) = self.find_s(nm) { self.struct_ops(si, t, args); }
                        else if let Some(ei) = self.find_e(nm) { self.enum_ops(ei, t, args); }
                    }
                    _ => {}
                }
            }

            fn struct_ops(&mut self, si: usize, me: &Ty, args: &[Ty]) {
                let n = tname(me);
                let r = rty(me);
                let hr = format!("hks_ref::<{}>", r);
                let tp = self.structs[si].tp.clone();
                let fields: Vec<(String, Ty)> = self.structs[si].fields.iter().map(|(a, b)| (a.clone(), subst(b, &tp, args))).collect();
                let mut ok_fields: Vec<(String, Ty)> = Vec::new();
                let mut all_ok = true;
                for (fname, ft) in &fields {
                    if !self.supported(ft) { all_ok = false; self.skipped.push(format!("{}.{} (pole spoza fasady)", n, fname)); continue; }
                    ok_fields.push((fname.clone(), ft.clone()));
                    let place = format!("&mut {}(a0).{}", hr, fname);
                    let get = if matches!(ft, Ty::Opt(_)) {
                        format!("hks_box(HksOwn::<{}>::hks_own(&{}(a0).{}))", rty(ft), hr, fname)
                    } else if is_handle(ft) {
                        format!("hks_ptr(HksBorrow::<{}>::hks_borrow({}))", rty(ft), place)
                    } else { self.out_ref(ft, &place) };
                    self.emit(&format!("{}_get_{}", n, fname), &format!("fun {}_get_{}(h: {}) -> {}", n, fname, n, tname(ft)), &[me.clone(), ], Some(ft), &get);
                    let val = if is_handle(ft) || matches!(ft, Ty::Str) { format!("HksFrom::hks_from({})", self.in_own(ft, 1)) } else { "a1".to_string() };
                    self.emit(&format!("{}_set_{}", n, fname), &format!("fun {}_set_{}(h: {}, v: {})", n, fname, n, tname(ft)), &[me.clone(), ft.clone()], None, &format!("{}(a0).{} = {};", hr, fname, val));
                }
                if all_ok && !ok_fields.is_empty() {
                    let ptys: Vec<Ty> = ok_fields.iter().map(|(_, t)| t.clone()).collect();
                    let inits: Vec<String> = ok_fields.iter().enumerate().map(|(i, (f, t))| format!("{}: {}", f, if is_scalar(t) { format!("a{}", i) } else { format!("HksFrom::hks_from({})", self.in_own(t, i)) })).collect();
                    let sig = format!("fun {}_new({})", n, ok_fields.iter().map(|(f, t)| format!("{}: {}", f, tname(t))).collect::<Vec<_>>().join(", "));
                    self.emit(&format!("{}_new", n), &sig, &ptys, Some(me), &format!("{{ type T_ = {}; hks_box(T_ {{ {} }}) }}", r, inits.join(", ")));
                }
                // metody `impl`
                let methods: Vec<FDecl> = self.funs.iter().filter(|f| f.owner == self.structs[si].name).cloned().collect();
                for m in methods {
                    if m.tp.is_empty() { let oa = args.to_vec(); self.gen_fn(&m, &oa, &[]); }
                }
            }

            fn enum_ops(&mut self, ei: usize, me: &Ty, args: &[Ty]) {
                let n = tname(me);
                let r = rty(me);
                let hr = format!("hks_ref::<{}>", r);
                let en = self.enums[ei].name.clone();
                let tp = self.enums[ei].tp.clone();
                let variants: Vec<(String, Vec<Ty>)> = self.enums[ei].variants.iter().map(|(a, b)| (a.clone(), b.iter().map(|t| subst(t, &tp, args)).collect())).collect();
                let mut arms: Vec<String> = Vec::new();
                for (i, (vn, vf)) in variants.iter().enumerate() {
                    arms.push(if vf.is_empty() { format!("{}::{} => {}", en, vn, i) } else { format!("{}::{}(..) => {}", en, vn, i) });
                }
                self.emit(&format!("{}_tag", n), &format!("fun {}_tag(h: {}) -> Int", n, n), &[me.clone()], Some(&Ty::Int), &format!("match &*{}(a0) {{ {} }}", hr, arms.join(", ")));
                for (vi, (vn, vf)) in variants.iter().enumerate() {
                    let _ = vi;
                    if vf.iter().any(|t| !self.supported(t)) { self.skipped.push(format!("{}::{} (pole spoza fasady)", n, vn)); continue; }
                    let ctor = if vf.is_empty() { format!("T_::{}", vn) } else {
                        format!("T_::{}({})", vn, vf.iter().enumerate().map(|(i, t)| if is_scalar(t) { format!("a{}", i) } else { format!("HksFrom::hks_from({})", self.in_own(t, i)) }).collect::<Vec<_>>().join(", "))
                    };
                    let sig = format!("fun {}_{}({})", n, vn, vf.iter().map(|t| tname(t)).collect::<Vec<_>>().join(", "));
                    self.emit(&format!("{}_{}", n, vn), &sig, vf, Some(me), &format!("{{ type T_ = {}; hks_box({}) }}", r, ctor));
                    for (fi, ft) in vf.iter().enumerate() {
                        let binds: Vec<String> = (0..vf.len()).map(|k| if k == fi { "x".to_string() } else { "_".to_string() }).collect();
                        let pat = format!("{}::{}({})", en, vn, binds.join(", "));
                        let val = if matches!(ft, Ty::Opt(_)) { format!("hks_box(HksOwn::<{}>::hks_own(&*x))", rty(ft)) }
                            else if is_handle(ft) { format!("hks_ptr(HksBorrow::<{}>::hks_borrow(x))", rty(ft)) }
                            else { self.out_ref(ft, "x") };
                        let body = format!("match {}(a0) {{ {} => {}, _ => {} }}", hr, pat, val, self.dflt(ft));
                        self.emit(&format!("{}_{}_get_{}", n, vn, fi), &format!("fun {}_{}_get_{}(h: {}) -> {}", n, vn, fi, n, tname(ft)), &[me.clone()], Some(ft), &body);
                    }
                }
                let methods: Vec<FDecl> = self.funs.iter().filter(|f| f.owner == en).cloned().collect();
                for m in methods { if m.tp.is_empty() { let oa = args.to_vec(); self.gen_fn(&m, &oa, &[]); } }
            }

            fn drain(&mut self) {
                let mut guard = 0;
                while let Some(t) = self.queue.pop() {
                    guard += 1;
                    if guard > 5000 { self.skipped.push("zbyt wiele typow pochodnych - przerwano".to_string()); break; }
                    self.ops(&t);
                }
            }
        }

        fn support_code() -> String {
            let mut s = String::new();
            s.push_str("// Wygenerowane przez `hackerc hlib build --ffi` - NIE EDYTUJ RECZNIE.\n");
            s.push_str("#![allow(dead_code, unused_imports, unused_mut, unused_variables, non_snake_case, unused_unsafe, clippy::all)]\n");
            s.push_str("use crate::*;\nuse std::os::raw::c_char;\n\n");
            s.push_str("thread_local! {\n    static HKS_RET: std::cell::RefCell<std::ffi::CString> = std::cell::RefCell::new(std::ffi::CString::default());\n}\n\n");
            s.push_str("unsafe fn hks_cstr(p: *const c_char) -> String {\n    if p.is_null() { String::new() } else { std::ffi::CStr::from_ptr(p).to_string_lossy().into_owned() }\n}\n\n");
            s.push_str("fn hks_ret_str(s: String) -> *const c_char {\n    let c = std::ffi::CString::new(s.replace('\\0', \"\")).unwrap_or_default();\n    HKS_RET.with(|r| { *r.borrow_mut() = c; r.borrow().as_ptr() })\n}\n\n");
            s.push_str("fn hks_box<T>(v: T) -> i64 { Box::into_raw(Box::new(v)) as i64 }\n");
            s.push_str("fn hks_ptr<T>(r: &mut T) -> i64 { r as *mut T as i64 }\n");
            s.push_str("unsafe fn hks_ref<'a, T>(h: i64) -> &'a mut T { &mut *(h as *mut T) }\n");
            s.push_str("unsafe fn hks_free<T>(h: i64) { if h != 0 { drop(Box::from_raw(h as *mut T)); } }\n\n");
            s.push_str("// pola rekurencyjne transpiler owija w Box / Option<Box>; te cechy ukrywaja roznice\n");
            s.push_str("trait HksBorrow<T> { fn hks_borrow(&mut self) -> &mut T; }\n");
            s.push_str("impl<T> HksBorrow<T> for T { fn hks_borrow(&mut self) -> &mut T { self } }\n");
            s.push_str("impl<T> HksBorrow<T> for Box<T> { fn hks_borrow(&mut self) -> &mut T { &mut **self } }\n");
            s.push_str("trait HksFrom<T> { fn hks_from(v: T) -> Self; }\n");
            s.push_str("impl<T> HksFrom<T> for T { fn hks_from(v: T) -> T { v } }\n");
            s.push_str("impl<T> HksFrom<T> for Box<T> { fn hks_from(v: T) -> Box<T> { Box::new(v) } }\n");
            s.push_str("impl<T> HksFrom<Option<T>> for Option<Box<T>> { fn hks_from(v: Option<T>) -> Option<Box<T>> { v.map(Box::new) } }\n");
            s.push_str("trait HksOwn<T> { fn hks_own(&self) -> T; }\n");
            s.push_str("impl<T: Clone> HksOwn<T> for T { fn hks_own(&self) -> T { self.clone() } }\n");
            s.push_str("impl<T: Clone> HksOwn<T> for Box<T> { fn hks_own(&self) -> T { (**self).clone() } }\n");
            s.push_str("impl<T: Clone> HksOwn<Option<T>> for Option<Box<T>> { fn hks_own(&self) -> Option<T> { self.as_ref().map(|b| (**b).clone()) } }\n\n");
            s
        }

        // Format IR (linie, pola rozdzielone `|`):
        //   S|Nazwa|T1,T2|pole:Typ|...            E|Nazwa|T1,T2|Wariant:Typ;Typ|Wariant|...
        //   F|Wlasciciel|ParamyWlasciciela|Nazwa|async(0/1)|ParamyTypowe|nazwa:Typ|...|=Zwracany   (Wlasciciel pusty = funkcja wolna)
        //   pierwszy parametr metody z `self` ma typ `self`
        fn generate(ir: &str, lib: &str, inst: &str) -> String {
            let mut g = Gen { lib: ident(lib), structs: vec![], enums: vec![], funs: vec![], rust: String::new(), exports: vec![], skipped: vec![], queue: vec![], seen: vec![], done_fns: vec![] };
            let csv = |s: &str| -> Vec<String> { s.split(',').map(|x| x.trim().to_string()).filter(|x| !x.is_empty()).collect() };
            for line in ir.lines() {
                let p: Vec<&str> = line.split('|').collect();
                if p.is_empty() { continue; }
                match p[0] {
                    "S" if p.len() >= 3 => {
                        let fields = p[3..].iter().filter_map(|f| f.find(':').map(|i| (f[..i].to_string(), parse_ty(&f[i + 1..])))).collect();
                        g.structs.push(SDecl { name: p[1].to_string(), tp: csv(p[2]), fields });
                    }
                    "E" if p.len() >= 3 => {
                        let variants = p[3..].iter().map(|v| match v.find(':') {
                            Some(i) => (v[..i].to_string(), split_top(&v[i + 1..], ';').iter().map(|t| parse_ty(t)).collect::<Vec<_>>()),
                            None => (v.to_string(), vec![]),
                        }).collect();
                        g.enums.push(EDecl { name: p[1].to_string(), tp: csv(p[2]), variants });
                    }
                    "F" if p.len() >= 6 => {
                        let mut params = Vec::new();
                        let mut ret = None;
                        let mut has_self = false;
                        for x in &p[6..] {
                            if let Some(r) = x.strip_prefix('=') { if !r.is_empty() { ret = Some(parse_ty(r)); } continue; }
                            if let Some(i) = x.find(':') {
                                let ty = &x[i + 1..];
                                if ty == "self" { has_self = true; params.push((x[..i].to_string(), Ty::Unit)); } else { params.push((x[..i].to_string(), parse_ty(ty))); }
                            }
                        }
                        g.funs.push(FDecl { owner: p[1].to_string(), owner_tp: csv(p[2]), name: p[3].to_string(), is_async: p[4] == "1", tp: csv(p[5]), params, has_self, ret });
                    }
                    _ => {}
                }
            }
            // 1) typy niegeneryczne
            let plain: Vec<Ty> = g.structs.iter().filter(|s| s.tp.is_empty()).map(|s| Ty::Named(s.name.clone(), vec![])).chain(g.enums.iter().filter(|s| s.tp.is_empty()).map(|s| Ty::Named(s.name.clone(), vec![]))).collect();
            for t in &plain { g.reg(t); }
            let inst_names: Vec<String> = split_top(inst, ',').iter().filter_map(|x| match parse_ty(x) { Ty::Named(n, _) => Some(n), _ => None }).collect();
            for s in g.structs.iter().filter(|s| !s.tp.is_empty() && !inst_names.contains(&s.name)).map(|s| s.name.clone()).collect::<Vec<_>>() { g.skipped.push(format!("{} (generyk - podaj instancje: --ffi-inst \"{}<Int>\")", s, s)); }
            // 2) instancje generykow z `inst`
            let insts: Vec<(String, Vec<Ty>)> = split_top(inst, ',').iter().filter(|x| !x.is_empty()).map(|x| match parse_ty(x) { Ty::Named(n, a) => (n, a), o => (tname(&o), vec![]) }).collect();
            for (n, a) in &insts {
                if g.find_s(n).is_some() || g.find_e(n).is_some() { let t = Ty::Named(n.clone(), a.clone()); if g.supported(&t) { g.reg(&t); } else { g.skipped.push(format!("{} (instancja ma zly typ/arnosc)", tname(&t))); } }
            }
            // 3) funkcje wolne (+ generyczne z instancji)
            let funs = g.funs.clone();
            for f in &funs {
                if !f.owner.is_empty() || f.name == "main" || f.name.starts_with('_') { continue; }
                if f.tp.is_empty() { g.gen_fn(f, &[], &[]); }
                else {
                    let mut any = false;
                    for (n, a) in &insts { if *n == f.name && a.len() == f.tp.len() { g.gen_fn(f, &[], a); any = true; } }
                    if !any { g.skipped.push(format!("{} (funkcja generyczna - podaj instancje: --ffi-inst \"{}<Int>\")", f.name, f.name)); }
                }
            }
            // 4) metody z wlasnymi parametrami typowymi: inst `Wlasciciel.metoda<...>` nie jest wspierane - zglos
            for f in &funs { if !f.owner.is_empty() && !f.tp.is_empty() { g.skipped.push(format!("{}.{} (metoda generyczna)", f.owner, f.name)); } }
            g.drain();
            let mut out = support_code();
            out.push_str(&g.rust);
            format!("{}\u{1}[{}]\u{1}{}", out, g.exports.join(","), g.skipped.join("\n"))
        }
        //@@FFI_GEN_END
        out = generate(&ir, &lib, &inst);
    ]
    end out
]

!!! Czesc `idx` (0 = kod Rust, 1 = exports JSON, 2 = pominiete) wyniku `ffi_generate_native`.
fun ffi_part(res: Str, idx: Int) -> Str [
    let part = ""
    native {Rust} [
        part = res.split('\u{1}').nth(idx as usize).unwrap_or("").to_string();
    ]
    end part
]

fun ffi_sanitize_ident(s: Str) -> Str [
    let out = ""
    let i = 0
    let n = s.len()
    while i < n [
        let c = s.char_at(i)
        let ok = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_"
        if ok [
            out = out + c
        ] else [
            out = out + "_"
        ]
        i = i + 1
    ]
    end out
]

!!! ---------- budowanie ----------

!!! Buduje crate (cargo rustc --release --lib -- --print native-static-libs) i zwraca sciezke do `.a`
!!! oraz liste bibliotek systemowych do dolinkowania (po przecinku).
fun ffi_cargo_build(crate_dir: Str, crate_name: Str, target: Str) -> FfiBuildOut [
    let ok = false
    let message = ""
    let static_lib_path = ""
    let link_libs = ""
    native {Rust} [
        let target_dir = format!("{}/target", crate_dir);
        let mut cmd = std::process::Command::new("cargo");
        cmd.arg("rustc").arg("--release").arg("--lib")
            .arg("--manifest-path").arg(format!("{}/Cargo.toml", crate_dir))
            .arg("--target-dir").arg(&target_dir);
        if !target.is_empty() {
            cmd.arg("--target").arg(&target);
        }
        cmd.arg("--").arg("--print").arg("native-static-libs");
        match cmd.output() {
            Err(e) => { message = format!("nie moge uruchomic cargo: {}", e); }
            Ok(out) => {
                let stderr = String::from_utf8_lossy(&out.stderr).to_string();
                if !out.status.success() {
                    message = format!("cargo rustc nie powiodl sie:\n{}", stderr);
                } else {
                    let file = format!("lib{}.a", crate_name.replace('-', "_"));
                    let path = if target.is_empty() {
                        format!("{}/release/{}", target_dir, file)
                    } else {
                        format!("{}/{}/release/{}", target_dir, target, file)
                    };
                    if std::path::Path::new(&path).is_file() {
                        let mut libs: Vec<String> = Vec::new();
                        for line in stderr.lines() {
                            if let Some(idx) = line.find("native-static-libs:") {
                                for tok in line[idx + "native-static-libs:".len()..].split_whitespace() {
                                    if let Some(name) = tok.strip_prefix("-l") {
                                        let name = name.trim_start_matches("static=").trim_start_matches("dylib=");
                                        if !name.is_empty() && !libs.iter().any(|l| l == name) {
                                            libs.push(name.to_string());
                                        }
                                    }
                                }
                            }
                        }
                        static_lib_path = path;
                        link_libs = libs.join(",");
                        ok = true;
                    } else {
                        message = format!("cargo zakonczyl sie sukcesem, ale brak {}", path);
                    }
                }
            }
        }
    ]
    end FfiBuildOut(ok, message, static_lib_path, link_libs, "")
]

fun ffi_temp_dir(lib_name: Str) -> Str [
    let d = ""
    native {Rust} [
        d = format!("{}/hackerc-ffi-{}-{}", std::env::temp_dir().to_string_lossy(), lib_name, std::process::id());
    ]
    end d
]

!!! `hackerc hlib build --ffi <bundle.hcs> ...` - glowna sciezka. Zwraca kod wyjscia.
fun ffi_build_hlib(src: Str, out_hlib: Str, lib_name: Str, lib_version: Str, sign_key_path: Str, target: Str, keep_dir: Bool, own_version: Str, inst: Str) -> Int [
    let lib = ffi_sanitize_ident(lib_name)
    let crate_name = "hks_" + lib
    let tmp = ffi_temp_dir(lib)
    elog(ffi_plain("hackerc hlib build --ffi:") + " crate fasady w " + tmp)

    let built = build_project(src.clone(), tmp.clone(), none(), none(), none(), crate_name.clone(), true, none(), own_version, dict())
    let wi = 0
    while wi < built.warnings.len() [
        elog(ffi_plain("hackerc hlib build --ffi: uwaga:") + " " + built.warnings[wi])
        wi = wi + 1
    ]

    !!! AST calego projektu (jak Discovery w build_project)
    let disc = Discovery([], dict(), [], own_version, dict())
    disc.resolve(src.clone(), find_libs_root(src.clone()), find_bootstrap_root(src.clone()), find_bit_cache_root(src.clone()))
    let bodies: List<Stmt> = []
    let fi = 0
    while fi < disc.files.len() [
        let df = disc.files[fi].clone()
        let si = 0
        while si < df.program.body.len() [
            bodies.push(df.program.body[si].clone())
            si = si + 1
        ]
        fi = fi + 1
    ]
    let res = ffi_generate_native(ffi_ir(bodies), lib, inst)
    let facade_rust = ffi_part(res.clone(), 0)
    let exports_json = ffi_part(res.clone(), 1)
    let skipped_text = ffi_part(res.clone(), 2)
    if exports_json == "[]" or exports_json == "" [
        elog(ffi_plain("hackerc hlib build --ffi:") + " zadna deklaracja nie nadaje sie do eksportu przez fasade C-ABI")
        end 1
    ]
    if skipped_text != "" [
        elog(ffi_plain("  pominieto:") + "\n" + skipped_text)
    ]

    let facade_path = tmp + "/src/_hks_ffi.rs"
    match write_file(facade_path.clone(), facade_rust.clone()) [
        Ok(_w) -> [
        ]
        Err(e) -> [
            elog(ffi_plain("hackerc hlib build --ffi:") + " " + facade_path + ": " + e)
            end 1
        ]
    ]
    !!! lib.rs: dopisz `mod _hks_ffi;` (mod na koncu pliku jest poprawny, atrybuty wewnetrzne zostaja pierwsze)
    let lib_rs = built.main_rs_path
    match read_file(lib_rs.clone()) [
        Ok(lib_src) -> [
            match write_file(lib_rs.clone(), lib_src + "\n#[allow(dead_code, unused_imports)]\nmod _hks_ffi;\n") [
                Ok(_w2) -> [
                ]
                Err(e2) -> [
                    elog(ffi_plain("hackerc hlib build --ffi:") + " " + lib_rs + ": " + e2)
                    end 1
                ]
            ]
        ]
        Err(e3) -> [
            elog(ffi_plain("hackerc hlib build --ffi:") + " " + lib_rs + ": " + e3)
            end 1
        ]
    ]
    !!! Cargo.toml: staticlib zamiast rlib
    match read_file(built.cargo_toml_path.clone()) [
        Ok(toml) -> [
            let patched = str_replace(toml, "crate-type = [\"rlib\"]", "crate-type = [\"staticlib\"]")
            match write_file(built.cargo_toml_path.clone(), patched) [
                Ok(_w3) -> [
                ]
                Err(e4) -> [
                    elog(ffi_plain("hackerc hlib build --ffi:") + " " + built.cargo_toml_path + ": " + e4)
                    end 1
                ]
            ]
        ]
        Err(e5) -> [
            elog(ffi_plain("hackerc hlib build --ffi:") + " " + built.cargo_toml_path + ": " + e5)
            end 1
        ]
    ]

    let res = ffi_cargo_build(tmp.clone(), crate_name.clone(), target.clone())
    if not res.ok [
        elog(ffi_plain("hackerc hlib build --ffi:") + " " + res.message)
        end 1
    ]
    let triple = target
    if triple == "" [
        triple = ffi_host_triple()
    ]
    let packed = hlib_build_ex(src.clone(), "", out_hlib.clone(), lib_name.clone(), lib_version.clone(), sign_key_path.clone(), res.static_lib_path.clone(), triple, res.link_libs.clone(), exports_json.clone())
    if not keep_dir [
        let _rm = remove_dir_all_quiet(tmp.clone())
    ]
    if packed.ok [
        log(ffi_plain("hackerc hlib build --ffi:") + " " + packed.message + " (" + "eksporty, target " + triple + ")")
        end 0
    ]
    elog(ffi_plain("hackerc hlib build --ffi:") + " " + packed.message)
    end 1
]

fun ffi_host_triple() -> Str [
    let t = "x86_64-unknown-linux-gnu"
    native {Rust} [
        if let Ok(out) = std::process::Command::new("rustc").arg("-vV").output() {
            for line in String::from_utf8_lossy(&out.stdout).lines() {
                if let Some(h) = line.strip_prefix("host: ") {
                    t = h.trim().to_string();
                }
            }
        }
    ]
    end t
]

fun remove_dir_all_quiet(path: Str) -> Bool [
    let ok = false
    native {Rust} [
        ok = std::fs::remove_dir_all(&path).is_ok();
    ]
    end ok
]
