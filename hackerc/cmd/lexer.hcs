enum TokKind [
    Newline,
    Open,
    Close,
    LParen,
    RParen,
    LAngle,
    RAngle,
    Colon,
    DColon,
    Comma,
    Op,
    Number,
    StrLit,
    Ident,
    Keyword,
    DocComment,
    LineComment,
    Question,
    Eof
]

struct Token [
    kind: TokKind,
    value: Str,
    line: Int,
    col: Int,
    tight: Bool
]

fun is_digit(c: Str) -> Bool [
    end c >= "0" and c <= "9"
]

fun is_alpha(c: Str) -> Bool [
    end (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
]

fun is_alnum(c: Str) -> Bool [
    end is_alpha(c) or is_digit(c)
]

!!! Lista slow kluczowych jezyka - musi byc trzymana w zgodzie z
!!! hackerc/hackerc/lexer.py::KEYWORDS. Bez Set-literalu w tej wersji
!!! uzywamy zwyklej petli po List<Str> (patrz "Ograniczenia" - O(n) na
!!! kazde sprawdzenie, akceptowalne dla malych plikow zrodlowych .hcs).
!!! ZMIANA 0.3: `extern` PRZESTAL byc slowem kluczowym - stary zapis
!!! `extern "lib" fun nazwa(...)` (jedna deklaracja FFI naraz) zostal
!!! usuniety z jezyka. Jego miejsce zajmuje para `get <extern:sciezka>
!!! use <static|dynamic>` (zwykly `GetImportStmt`, "extern" tu jest
!!! TYLKO nazwa zrodla wewnatrz `<...>`, czytana jako tekst przez
!!! `read_angle_segment()` - NIE musi byc slowem kluczowym) + nowy blok
!!! `region [ ... ]` (nowe slowo kluczowe) z zerowa lub wieksza liczba
!!! samych sygnatur `fun nazwa(...) -> Typ` (bez ciala) - patrz
!!! `parse_region()`/`RegionBlock` i `docs/SYNTAX.md`, sekcja "FFI:
!!! extern/region/c/cpp". `use` DODANE jako nowe slowo kluczowe
!!! wylacznie dla `get <extern:...> use <tryb>` (patrz
!!! `parse_get_import()`).
!!! Slowa zarezerwowane przez Rust, ktore NIE sa slowami kluczowymi
!!! HackerScript (np. `loop`, `ref`, `move`, `type`). Uzyte jako nazwa
!!! zmiennej/pola/funkcji dawaly niepoprawny Rust (`let mut loop: i64`).
!!! Lekser dopisuje do takiej nazwy `_` (loop -> loop_) - spojnie w calym
!!! pliku, wiec program dziala bez zmian. Bloki `native {...}` sa tekstem
!!! surowym i nie sa tu przepisywane.
fun is_rust_reserved(w: Str) -> Bool [
    let kws = ["loop", "ref", "move", "mut", "static", "unsafe", "where",
               "yield", "dyn", "abstract", "become", "box", "do", "final",
               "macro", "override", "priv", "try", "typeof", "unsized",
               "virtual", "crate", "super", "extern", "trait", "type"]
    let i = 0
    while i < kws.len() [
        if kws[i] == w [
            end true
        ]
        i = i + 1
    ]
    end false
]

fun is_keyword(w: Str) -> Bool [
    let kws = ["fun", "let", "const", "if", "else", "elif", "while", "for", "in",
               "return", "end", "get", "import", "using", "direct", "manual",
               "true", "false", "null", "struct", "enum", "match", "break",
               "continue", "gc", "pub", "self", "and", "or", "not", "as",
               "impl", "include", "native", "region", "use",
               "async", "await", "spawn"]
    let i = 0
    while i < kws.len() [
        if kws[i] == w [
            end true
        ]
        i = i + 1
    ]
    end false
]

fun is_multi_op(s: Str) -> Bool [
    end s == "==" or s == "!=" or s == "<=" or s == ">=" or s == "->" or s == "::" or s == "&&" or s == "||" or s == "+=" or s == "-=" or s == "*=" or s == "/="
]

fun is_op_char(c: Str) -> Bool [
    end c == "+" or c == "-" or c == "*" or c == "/" or c == "%" or c == "=" or c == "!" or c == "." or c == "&" or c == "|" or c == "^" or c == "~"
]

!!! Znaki, po ktorych `!=` MOZE byc operatorem nierownosci (koniec
!!! wyrazenia po lewej: litera/cyfra/`_`/`)`/`]`/cudzyslow) - parytet
!!! z `_EXPR_END_CHARS` w lexer.py. Uzywane tylko przez
!!! `looks_like_operator_before`, ktore odrozniamy od `strip_multiline_comments`.
fun is_expr_end_char(c: Str) -> Bool [
    end is_alnum(c) or c == ")" or c == "]" or c == "\"" or c == "'"
]

!!! Dwuznakowy podglad od pozycji `i` (albo pojedynczy znak, gdy `i` to
!!! ostatnia pozycja w zrodle) - uzywane do rozpoznawania operatorow
!!! wieloznakowych (`==`, `->`, `::`, ...) bez wychodzenia poza `n`.
!!! Reczny `trim` (usuwa spacje/taby/`\r` z obu koncow) - napisany na
!!! `char_at`/`slice`, BEZ uzycia Rustowego `.trim()` (ktory zwraca
!!! `&str`, nie `String` - podstawienie go pod `Str` skompilowaloby
!!! sie do niezgodnosci typow w wygenerowanym Rust, niewykrywalnej
!!! przez dzisiejszy Pythonowy `typecheck.py`, ktory nie sledzi tego
!!! konkretnego metod-callu - patrz "Ograniczenia").
fun trim_str(s: Str) -> Str [
    let n = s.len()
    let start = 0
    while start < n and (s.char_at(start) == " " or s.char_at(start) == "\t" or s.char_at(start) == "\r") [
        start = start + 1
    ]
    let stop = n
    while stop > start and (s.char_at(stop - 1) == " " or s.char_at(stop - 1) == "\t" or s.char_at(stop - 1) == "\r") [
        stop = stop - 1
    ]
    end s.slice(start, stop)
]

!!! `two_char_at` (pobieranie 2 znakow na pozycji `i`) BYLO tu, ale
!!! zostalo USUNIETE - wywolywanie GO jako osobnej funkcji z ciasnej
!!! petli `tokenize`/`strip_multiline_comments` bylo prawdziwym zrodlem
!!! O(n^2) w calym bootstrapie (WIEKSZYM niz brak cache'owania
!!! `.char_at`/`.slice`, ktore naprawiono wczesniej w tej samej sesji):
!!! kazde wywolanie `two_char_at(source, i, n)` materializowalo WLASNA,
!!! SWIEZA kopie `Vec<char>` z CALEGO `source` (bo `char_indexed_str_params`
!!! widzi 2+ uzycia `.char_at`/`.slice` na `source` W CIELE `two_char_at`
!!! i include cache'owanie TAM) - dla pliku ktory sam siebie kompiluje
!!! (np. `codegen.hcs`, ~137KB), wywolywane TYSIACE razy w petli
!!! `tokenize`, dawalo to O(n) PRZY KAZDYM WYWOLANIU zamiast O(1).
!!! Cache'owanie dziala TYLKO W OBREBIE JEDNEJ funkcji - nie przenosi
!!! sie przez granice wywolania. Naprawa: kazde miejsce wywolania
!!! `two_char_at(source, i, n) == "XY"` zastapione WPROST przez
!!! `i + 1 < n and source.char_at(i) == "X" and source.char_at(i + 1) == "Y"`
!!! (dwa BEZPOSREDNIE `.char_at()` na JUZ zcache'owanej zmiennej
!!! WEWNATRZ tokenize/strip_multiline_comments, oba O(1)) - patrz
!!! bootstrap/README.md za pelny opis. Bug znaleziony przy uzyciu
!!! skompilowanego stage1 (samo-hostowanego hackerc) do zbudowania
!!! DUZYCH plikow samego siebie w tej sesji.

!!! `looks_like_operator_before` (cofanie sie od `pos` przez spacje/taby
!!! i sprawdzanie czy poprzedni niebialy znak konczy wyrazenie, patrz
!!! `is_expr_end_char`) BYLO tu jako osobna funkcja - USUNIETE i
!!! wcielone WPROST do `strip_multiline_comments` (jedynego wywolujacego)
!!! z tego samego powodu co `two_char_at` wyzej: wywolywanie oddzielnej
!!! funkcji przyjmujacej `source: Str` z ciasnej petli niweczylo
!!! cache'owanie `.char_at`/`.slice` (dziala TYLKO w obrebie jednej
!!! funkcji) - patrz duzy komentarz przy `two_char_at` i
!!! bootstrap/README.md.

!!! Usuwa komentarze `!> ... <!` (wieloliniowe), zamieniajac cala ich
!!! tresc na TA SAMA liczbe znakow `\n` (zeby numery linii sie nie
!!! przesunely dla reszty tokenizacji) - parytet ze `strip_comments`
!!! w lexer.py. Stringi i komentarze `!!`/`!!!` (do konca linii) sa
!!! kopiowane 1:1 BEZ interpretacji PRZED testem `!>` - bug znaleziony
!!! w POPRZEDNICH sesjach (patrz docs/ROADMAP.md): `!>`/`<!` WEWNATRZ
!!! stringa albo wewnatrz TRESCI takiego komentarza nie moze
!!! (nie)otwierac komentarza wieloliniowego.
!!!
!!! `!=` to WYLACZNIE operator nierownosci (nigdy komentarz) - odkad
!!! komentarze wieloliniowe otwiera `!>` (nie `!=` jak wczesniej), nie
!!! ma juz zadnej dwuznacznosci wymagajacej heurystyki
!!! `is_expr_end_char`/cofania sie przez biale znaki (uzywanej w
!!! poprzedniej wersji tej funkcji, dla starej skladni `!=`/`=!`).
fun strip_multiline_comments(source: Str) -> Str [
    end scan_comments_and_styles(source, 0)
]

!!! ROZBUDOWA 0.6 - bloki `style { ... }` i `head { ... }` w `use <mode:website>`
!!! (docs/WEBSITE.md).
!!!
!!! `style {` / `head {` na POCZATKU linii otwiera blok z surowa trescia (CSS albo
!!! HTML do <head>), zamkniety pasujacym `}` (z uwzglednieniem stringow i
!!! komentarzy `/* */`). `style(.klasa) {` to CSS ZAKRESOWY: kazdy selektor dostaje
!!! przedrostek `.klasa ` (patrz `css_scope`).
!!! Dla lexera/parsera blok jest "niewidzialny" - zamieniany na te sama
!!! liczbe `\n`, jak komentarz `!> <!` - wiec `check`/`build`/`lsp` w ogole
!!! go nie widza. Tresc blokow zbieraja `collect_style_css` / `collect_head_html`.
!!!
!!! Zwraca indeks pierwszego znaku PO `{` albo 0, gdy w `i` nie zaczyna sie
!!! blok `kw {` (przed `kw` w linii moga byc tylko biale znaki). Dla `style`
!!! dozwolony jest zakres w nawiasach: `style(.karta) {`.
fun block_open_kw(source: Str, i: Int, kw: Str) -> Int [
    let n = source.len()
    let kl = kw.len()
    if i + kl + 1 > n [
        end 0
    ]
    if source.slice(i, i + kl) != kw [
        end 0
    ]
    let ok = true
    let scanning = true
    let b = i
    while b > 0 and scanning [
        b = b - 1
        let pc = source.char_at(b)
        if pc == "\n" [
            scanning = false
        ] elif pc != " " and pc != "\t" and pc != "\r" [
            ok = false
            scanning = false
        ]
    ]
    if not ok [
        end 0
    ]
    let j = i + kl
    while j < n and (source.char_at(j) == " " or source.char_at(j) == "\t") [
        j = j + 1
    ]
    if kw == "style" and j < n and source.char_at(j) == "(" [
        let depth = 0
        let closed = false
        while j < n and not closed and source.char_at(j) != "\n" [
            let pc2 = source.char_at(j)
            if pc2 == "(" [
                depth = depth + 1
            ]
            if pc2 == ")" [
                depth = depth - 1
                if depth == 0 [
                    closed = true
                ]
            ]
            j = j + 1
        ]
        if not closed [
            end 0
        ]
        while j < n and (source.char_at(j) == " " or source.char_at(j) == "\t") [
            j = j + 1
        ]
    ]
    if j < n and source.char_at(j) == "{" [
        end j + 1
    ]
    end 0
]

fun style_block_open(source: Str, i: Int) -> Int [
    end block_open_kw(source, i, "style")
]

!!! `start` = indeks pierwszego znaku po `{`. Zwraca indeks ZA pasujacym `}`
!!! albo 0, gdy blok nie jest zamkniety (wtedy nie traktujemy go jako bloku
!!! stylu i parser zglosi zwykly blad skladni).
fun style_block_close(source: Str, start: Int) -> Int [
    let n = source.len()
    let depth = 1
    let j = start
    while j < n and depth > 0 [
        let c = source.char_at(j)
        if c == "\"" or c == "'" [
            let q = c
            j = j + 1
            while j < n and source.char_at(j) != q and source.char_at(j) != "\n" [
                if source.char_at(j) == "\\" [
                    j = j + 2
                ] else [
                    j = j + 1
                ]
            ]
            if j < n [
                j = j + 1
            ]
        ] elif c == "/" and j + 1 < n and source.char_at(j + 1) == "*" [
            j = j + 2
            while j + 1 < n and not (source.char_at(j) == "*" and source.char_at(j + 1) == "/") [
                j = j + 1
            ]
            j = j + 2
        ] elif c == "{" [
            depth = depth + 1
            j = j + 1
        ] elif c == "}" [
            depth = depth - 1
            j = j + 1
        ] else [
            j = j + 1
        ]
    ]
    if depth > 0 [
        end 0
    ]
    end j
]

!!! Obciecie bialych znakow z obu stron (lexer nie importuje std:string).
fun css_trim(s: Str) -> Str [
    let a = 0
    let b = s.len()
    while a < b and (s.char_at(a) == " " or s.char_at(a) == "\n" or s.char_at(a) == "\t" or s.char_at(a) == "\r") [
        a = a + 1
    ]
    while b > a and (s.char_at(b - 1) == " " or s.char_at(b - 1) == "\n" or s.char_at(b - 1) == "\t" or s.char_at(b - 1) == "\r") [
        b = b - 1
    ]
    end s.slice(a, b)
]

!!! Dodaje `scope` jako przedrostek KAZDEGO selektora z listy `a, b > c`.
!!! `:root`, `html`, `body` i `&` oznaczaja sam element zakresu.
fun css_scope_selectors(sel: Str, scope: Str) -> Str [
    let out = ""
    let cur = ""
    let depth = 0
    let i = 0
    let n = sel.len()
    while i <= n [
        let at_end = i == n
        let c = ""
        if not at_end [
            c = sel.char_at(i)
        ]
        if c == "(" or c == "[" [
            depth = depth + 1
        ]
        if c == ")" or c == "]" [
            depth = depth - 1
        ]
        if at_end or (c == "," and depth == 0) [
            let part = css_trim(cur.clone())
            if part.len() > 0 [
                let scoped = scope + " " + part
                if part == ":root" or part == "html" or part == "body" [
                    scoped = scope
                ] elif part.char_at(0) == "&" [
                    scoped = scope + part.slice(1, part.len())
                ] elif part.len() > 5 and part.slice(0, 5) == ":root" [
                    scoped = scope + part.slice(5, part.len())
                ]
                if out != "" [
                    out = out + ", "
                ]
                out = out + scoped
            ]
            cur = ""
        ] else [
            cur = cur + c
        ]
        i = i + 1
    ]
    end out
]

!!! CSS zakresowy: przedrostek `scope` przed selektorami regul; reguly wewnatrz
!!! @media/@supports/@container/@layer tez; @keyframes, @font-face, @import itp.
!!! zostaja bez zmian. Tresc deklaracji kopiowana doslownie.
fun css_scope(css: Str, scope: Str) -> Str [
    let out = ""
    let n = css.len()
    let i = 0
    while i < n [
        let sel_start = i
        let found_brace = false
        let found_semi = false
        while i < n and not found_brace and not found_semi [
            let c = css.char_at(i)
            if c == "/" and i + 1 < n and css.char_at(i + 1) == "*" [
                i = i + 2
                while i + 1 < n and not (css.char_at(i) == "*" and css.char_at(i + 1) == "/") [
                    i = i + 1
                ]
                i = i + 2
            ] elif c == "{" [
                found_brace = true
            ] elif c == ";" [
                found_semi = true
            ] else [
                i = i + 1
            ]
        ]
        if i > n [
            i = n
        ]
        if found_semi [
            out = out + css.slice(sel_start, i + 1)
            i = i + 1
        ] elif found_brace [
            let header = css_trim(css.slice(sel_start, i))
            let body_start = i + 1
            let body_end = style_block_close(css, body_start)
            if body_end == 0 [
                out = out + css.slice(sel_start, n)
                i = n
            ] else [
                let body = css.slice(body_start, body_end - 1)
                if header.len() > 0 and header.char_at(0) == "@" [
                    let nested = header.len() > 6 and (header.slice(0, 6) == "@media" or header.slice(0, 6) == "@layer")
                    if header.len() > 9 and header.slice(0, 9) == "@supports" [
                        nested = true
                    ]
                    if header.len() > 10 and header.slice(0, 10) == "@container" [
                        nested = true
                    ]
                    if nested [
                        out = out + header + " {" + css_scope(body, scope) + "}"
                    ] else [
                        out = out + header + " {" + body + "}"
                    ]
                ] else [
                    out = out + css_scope_selectors(header, scope) + " {" + body + "}"
                ]
                i = body_end
            ]
        ] else [
            out = out + css.slice(sel_start, n)
            i = n
        ]
    ]
    end out
]

!!! Tresc wszystkich blokow `style { ... }` zrodla (bez zewnetrznych `{ }`),
!!! rozdzielona pustym wierszem; bloki `style(.klasa)` sa juz przepisane przez
!!! `css_scope`. Pusty napis = brak blokow.
fun collect_style_css(source: Str) -> Str [
    end scan_comments_and_styles(source, 1)
]

!!! Tresc wszystkich blokow `head { ... }` (HTML wstawiany do <head>).
fun collect_head_html(source: Str) -> Str [
    end scan_comments_and_styles(source, 2)
]

!!! Bloki `style`/`head` dokladnie tak, jak zapisano w zrodle (z naglowkiem
!!! `style(.x) {`), po jednym na akapit - uzywa tego `hackerc fmt`.
fun collect_site_blocks_raw(source: Str) -> Str [
    end scan_comments_and_styles(source, 3)
]

!!! Wspolna petla. `mode`: 0 -> zrodlo bez komentarzy wieloliniowych i blokow
!!! `style`/`head` (to widzi lexer); 1 -> zebrany CSS; 2 -> zebrany HTML z
!!! `head`; 3 -> bloki w oryginalnej postaci (dla `fmt`).
fun scan_comments_and_styles(source: Str, mode: Int) -> Str [
    let out = ""
    let css = ""
    let head_html = ""
    let raw_blocks = ""
    let i = 0
    let n = source.len()
    while i < n [
        let c = source.char_at(i)
        let is_bang_bang = c == "!" and i + 1 < n and source.char_at(i + 1) == "!"
        let is_open = c == "!" and i + 1 < n and source.char_at(i + 1) == ">"
        let style_open = 0
        let style_end = 0
        let kw = "style"
        !! 0.6 (wydajnosc) - `block_open_kw` materializuje caly zrodlowy Vec<char> przy
        !! KAZDYM wywolaniu; wolamy ja tylko przy faktycznym slowie `style` / `head`.
        if c == "s" and i + 5 < n and source.slice(i, i + 5) == "style" [
            style_open = block_open_kw(source, i, "style")
        ] elif c == "h" and i + 4 < n and source.slice(i, i + 4) == "head" [
            kw = "head"
            style_open = block_open_kw(source, i, "head")
        ]
        if style_open > 0 [
            style_end = style_block_close(source, style_open)
            if style_end == 0 [
                style_open = 0
            ]
        ]
        if style_open > 0 [
            let body = source.slice(style_open, style_end - 1)
            if kw == "head" [
                if head_html != "" [
                    head_html = head_html + "\n"
                ]
                head_html = head_html + body
            ] else [
                let header = css_trim(source.slice(i + 5, style_open - 1))
                let piece = body
                if header.len() > 2 and header.char_at(0) == "(" [
                    piece = css_scope(body, css_trim(header.slice(1, header.len() - 1)))
                ]
                if css != "" [
                    css = css + "\n"
                ]
                css = css + piece
            ]
            if raw_blocks != "" [
                raw_blocks = raw_blocks + "\n"
            ]
            raw_blocks = raw_blocks + source.slice(i, style_end)
            let sblock = source.slice(i, style_end)
            let sk = 0
            while sk < sblock.len() [
                if sblock.char_at(sk) == "\n" [
                    out = out + "\n"
                ]
                sk = sk + 1
            ]
            i = style_end
        ] elif c == "\"" or c == "'" [
            let quote = c
            let j = i + 1
            while j < n and source.char_at(j) != quote and source.char_at(j) != "\n" [
                if source.char_at(j) == "\\" and j + 1 < n [
                    j = j + 2
                ] else [
                    j = j + 1
                ]
            ]
            if j < n and source.char_at(j) == quote [
                j = j + 1
            ]
            out = out + source.slice(i, j)
            i = j
        ] elif is_bang_bang [
            let j = i
            while j < n and source.char_at(j) != "\n" [
                j = j + 1
            ]
            out = out + source.slice(i, j)
            i = j
        ] elif is_open [
            let j = i + 2
            let found = false
            while j < n and not found [
                if j + 1 < n and source.char_at(j) == "<" and source.char_at(j + 1) == "!" [
                    found = true
                ] else [
                    j = j + 1
                ]
            ]
            let block = source.slice(i, j)
            let k = 0
            while k < block.len() [
                if block.char_at(k) == "\n" [
                    out = out + "\n"
                ]
                k = k + 1
            ]
            i = j + 2
        ] else [
            out = out + c
            i = i + 1
        ]
    ]
    if mode == 1 [
        end css
    ]
    if mode == 2 [
        end head_html
    ]
    if mode == 3 [
        end raw_blocks
    ]
    end out
]

!!! Zamienia jeden znak escape'u (bez `\`) na jego realna wartosc, np.
!!! `n` -> nowa linia. `""` (pusty Str) sygnalizuje "nierozpoznany
!!! escape" - wywolujacy (`tokenize`) w tym przypadku zachowuje OBA
!!! znaki doslownie (`\` + znak), tak jak `_STRING_ESCAPES.get(esc)`
!!! zwracajace `None` w lexer.py.
fun resolve_escape(c: Str) -> Str [
    if c == "n" [
        end "\n"
    ]
    if c == "t" [
        end "\t"
    ]
    if c == "r" [
        end "\r"
    ]
    if c == "\\" [
        end "\\"
    ]
    !! DODANE: `\e` -> ESC (0x1B, 27) - potrzebne do kodow ANSI
    !! (kolory/kursor w std:term, patrz libs/std/lib/term.hcs). Ponizej
    !! miedzy cudzyslowami jest DOSLOWNY bajt 0x1B (nie sekwencja
    !! `\x1b`/`\u{1b}` - ten bootstrap ich jeszcze nie ma, patrz
    !! reszta tej funkcji) - `codegen.hcs::rust_string_literal` wypisze
    !! go dalej jako `\x1b` w wygenerowanym Rust (patrz tam). Komentarz
    !! celowo `!!` (nie `!!!`) - patrz docs/ROADMAP.md, sekcja 0.5.3.
    if c == "e" [
        end ""
    ]
    if c == "\"" [
        end "\""
    ]
    if c == "'" [
        end "'"
    ]
    if c == "0" [
        end "\0"
    ]
    end ""
]

!!! Tokenizuje zrodlo HackerScript. Zwraca liste tokenow zakonczona
!!! zawsze tokenem Eof. Woa `strip_multiline_comments` jako pierwszy
!!! krok (parytet z `tokenize(source)` w lexer.py, ktore rowniez
!!! zaczyna od `strip_comments(source)`).
fun tokenize(source: Str) -> List<Token> [
    let src = strip_multiline_comments(source)
    let tokens: List<Token> = []
    let i = 0
    let n = src.len()
    let line = 1
    let line_start = 0

    while i < n [
        let col = (i - line_start) + 1
        let c = src.char_at(i)
        let prev_is_space = i > 0 and (src.char_at(i - 1) == " " or src.char_at(i - 1) == "\t" or src.char_at(i - 1) == "\n" or src.char_at(i - 1) == "\r")
        let is_tight = i > 0 and not prev_is_space

        if c == "\n" [
            tokens.push(Token(Newline, c, line, col, false))
            i = i + 1
            line = line + 1
            line_start = i
        ] elif c == " " or c == "\t" or c == "\r" [
            i = i + 1
        ] elif c == "!" and i + 1 < n and src.char_at(i + 1) == "!" and i + 2 < n and src.char_at(i + 2) == "!" [
            let j = i + 3
            while j < n and src.char_at(j) != "\n" [
                j = j + 1
            ]
            tokens.push(Token(DocComment, trim_str(src.slice(i + 3, j)), line, col, false))
            i = j
        ] elif c == "!" and i + 1 < n and src.char_at(i + 1) == "!" [
            let j = i + 2
            while j < n and src.char_at(j) != "\n" [
                j = j + 1
            ]
            tokens.push(Token(LineComment, trim_str(src.slice(i + 2, j)), line, col, false))
            i = j
        ] elif is_digit(c) [
            let j = i
            while j < n and (is_digit(src.char_at(j)) or src.char_at(j) == ".") [
                j = j + 1
            ]
            tokens.push(Token(Number, src.slice(i, j), line, col, false))
            i = j
        ] elif c == "\"" or c == "'" [
            let quote = c
            let j = i + 1
            let buf = ""
            while j < n and src.char_at(j) != quote and src.char_at(j) != "\n" [
                if src.char_at(j) == "\\" and j + 1 < n [
                    let esc = src.char_at(j + 1)
                    let resolved = resolve_escape(esc)
                    if resolved == "" [
                        buf = buf + "\\" + esc
                    ] else [
                        buf = buf + resolved
                    ]
                    j = j + 2
                ] else [
                    buf = buf + src.char_at(j)
                    j = j + 1
                ]
            ]
            if j < n and src.char_at(j) == quote [
                j = j + 1
            ]
            tokens.push(Token(StrLit, buf, line, col, false))
            i = j
        ] elif is_alpha(c) [
            let j = i
            while j < n and is_alnum(src.char_at(j)) [
                j = j + 1
            ]
            let text = src.slice(i, j)
            if is_keyword(text) [
                tokens.push(Token(Keyword, text, line, col, false))
            ] elif is_rust_reserved(text) [
                tokens.push(Token(Ident, text + "_", line, col, false))
            ] else [
                tokens.push(Token(Ident, text, line, col, false))
            ]
            i = j
        ] elif c == "[" [
            tokens.push(Token(Open, c, line, col, is_tight))
            i = i + 1
        ] elif c == "]" [
            tokens.push(Token(Close, c, line, col, false))
            i = i + 1
        ] elif c == "(" [
            tokens.push(Token(LParen, c, line, col, false))
            i = i + 1
        ] elif c == ")" [
            tokens.push(Token(RParen, c, line, col, false))
            i = i + 1
        ] elif c == "," [
            tokens.push(Token(Comma, c, line, col, false))
            i = i + 1
        ] elif i + 1 < n and src.char_at(i) == ":" and src.char_at(i + 1) == ":" [
            tokens.push(Token(DColon, "::", line, col, false))
            i = i + 2
        ] elif c == ":" [
            tokens.push(Token(Colon, c, line, col, false))
            i = i + 1
        ] elif i + 1 < n and src.char_at(i) == "<" and src.char_at(i + 1) == "=" [
            tokens.push(Token(Op, "<=", line, col, false))
            i = i + 2
        ] elif c == "<" [
            tokens.push(Token(LAngle, c, line, col, false))
            i = i + 1
        ] elif i + 1 < n and src.char_at(i) == ">" and src.char_at(i + 1) == "=" [
            tokens.push(Token(Op, ">=", line, col, false))
            i = i + 2
        ] elif c == ">" [
            tokens.push(Token(RAngle, c, line, col, false))
            i = i + 1
        ] elif c == "?" [
            tokens.push(Token(Question, c, line, col, false))
            i = i + 1
        ] elif is_op_char(c) [
            let two = c
            if i + 1 < n [
                two = c + src.char_at(i + 1)
            ]
            if is_multi_op(two) [
                tokens.push(Token(Op, two, line, col, false))
                i = i + 2
            ] else [
                tokens.push(Token(Op, c, line, col, false))
                i = i + 1
            ]
        ] else [
            !! Nieznany znak - w tej wersji po prostu pomijamy (docelowo:
            !! `LexError` jak w lexer.py - patrz "Ograniczenia": jezyk
            !! samo-hostowanego bootstrapu nie ma jeszcze wyjatkow/`panic`
            !! z komunikatem, tylko `log`+`end`, wiec prawdziwe
            !! zglaszanie bledow zostaje na etap `diagnostics.hcs`).
            i = i + 1
        ]
    ]

    tokens.push(Token(Eof, "", line, (i - line_start) + 1, false))
    end tokens
]

!!! Demonstracyjne uzycie - tokenizuje fragment HackerScript zawierajacy
!!! string z escape'em, `!!`/`!` komentarz, `?` i operator `!=`,
!!! zaszyty w kodzie (bez I/O plikowego), i wypisuje liczbe tokenow.
fun main() [
    let sample = "!! doc\n! line\nfun main() [\n    let x = 1 + 2\n    let s = \"a\\nb\"\n    if x != 3 [\n        log(x?)\n    ]\n]\n"
    let tokens = tokenize(sample)
    log("tokens:", tokens.len())
]
