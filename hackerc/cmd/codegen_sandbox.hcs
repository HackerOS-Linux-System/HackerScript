fun sandbox_emit_lines(cmd_literal: Str) -> List<Str> [
    let out: List<Str> = []
    out.push("{")
    out.push("    let __hks_cmd: String = " + cmd_literal + ".to_string();")
    out.push("    let __hks_mode = std::env::var(\"HKS_SANDBOX\").unwrap_or_default().to_lowercase();")
    out.push("    let __hks_env_u64 = |n: &str| -> Option<u64> { std::env::var(n).ok().and_then(|v| v.trim().parse::<u64>().ok()) };")
    out.push("    let mut __hks_limits: Vec<(i32, u64)> = Vec::new();")
    out.push("    if let Some(v) = __hks_env_u64(\"HKS_SANDBOX_CPU\") { __hks_limits.push((libc::RLIMIT_CPU as i32, v)); }")
    out.push("    if let Some(v) = __hks_env_u64(\"HKS_SANDBOX_MEM_MB\") { __hks_limits.push((libc::RLIMIT_AS as i32, v.saturating_mul(1024 * 1024))); }")
    out.push("    if let Some(v) = __hks_env_u64(\"HKS_SANDBOX_NPROC\") { __hks_limits.push((libc::RLIMIT_NPROC as i32, v)); }")
    out.push("    if let Some(v) = __hks_env_u64(\"HKS_SANDBOX_FSIZE_MB\") { __hks_limits.push((libc::RLIMIT_FSIZE as i32, v.saturating_mul(1024 * 1024))); }")
    out.push("    if let Some(v) = __hks_env_u64(\"HKS_SANDBOX_NOFILE\") { __hks_limits.push((libc::RLIMIT_NOFILE as i32, v)); }")
    out.push("    let __hks_filter: Vec<libc::sock_filter> = if std::env::var(\"HKS_SANDBOX_SECCOMP\").map(|v| v.to_lowercase() == \"off\").unwrap_or(false) { Vec::new() } else {")
    out.push("        let __arch: u32 = if cfg!(target_arch = \"x86_64\") { 0xC000_003E } else if cfg!(target_arch = \"aarch64\") { 0xC000_00B7 } else { 0 };")
    out.push("        if __arch == 0 { Vec::new() } else {")
    out.push("            let __deny: Vec<u32> = vec![")
    out.push("                libc::SYS_ptrace as u32, libc::SYS_mount as u32, libc::SYS_umount2 as u32, libc::SYS_pivot_root as u32,")
    out.push("                libc::SYS_chroot as u32, libc::SYS_reboot as u32, libc::SYS_kexec_load as u32, libc::SYS_init_module as u32,")
    out.push("                libc::SYS_finit_module as u32, libc::SYS_delete_module as u32, libc::SYS_swapon as u32, libc::SYS_swapoff as u32,")
    out.push("                libc::SYS_bpf as u32, libc::SYS_perf_event_open as u32, libc::SYS_setns as u32, libc::SYS_unshare as u32,")
    out.push("                libc::SYS_keyctl as u32, libc::SYS_add_key as u32, libc::SYS_request_key as u32, libc::SYS_process_vm_readv as u32,")
    out.push("                libc::SYS_process_vm_writev as u32, libc::SYS_userfaultfd as u32, libc::SYS_open_by_handle_at as u32,")
    out.push("                libc::SYS_acct as u32, libc::SYS_settimeofday as u32, libc::SYS_clock_settime as u32, libc::SYS_syslog as u32,")
    out.push("            ];")
    out.push("            let __n = __deny.len();")
    out.push("            let __ins = |code: u16, jt: u8, jf: u8, k: u32| libc::sock_filter { code, jt, jf, k };")
    out.push("            let mut __f: Vec<libc::sock_filter> = Vec::new();")
    out.push("            __f.push(__ins(0x20, 0, 0, 4));")
    out.push("            __f.push(__ins(0x15, 1, 0, __arch));")
    out.push("            __f.push(__ins(0x06, 0, 0, 0x8000_0000));")
    out.push("            __f.push(__ins(0x20, 0, 0, 0));")
    out.push("            if cfg!(target_arch = \"x86_64\") { __f.push(__ins(0x35, (__n + 1) as u8, 0, 0x4000_0000)); }")
    out.push("            for (i, nr) in __deny.iter().enumerate() { __f.push(__ins(0x15, (__n - i) as u8, 0, *nr)); }")
    out.push("            __f.push(__ins(0x06, 0, 0, 0x7FFF_0000));")
    out.push("            __f.push(__ins(0x06, 0, 0, 0x0005_0001));")
    out.push("            __f")
    out.push("        }")
    out.push("    };")
    out.push("    let __hks_run = |__lvl: u8| -> std::io::Result<std::process::ExitStatus> {")
    out.push("        use std::os::unix::process::CommandExt;")
    out.push("        let mut __c = if __lvl == 3 {")
    out.push("            let mut __b = std::process::Command::new(\"bwrap\");")
    out.push("            __b.args([\"--unshare-net\", \"--ro-bind\", \"/\", \"/\", \"--dev\", \"/dev\", \"--proc\", \"/proc\", \"sh\", \"-c\"]).arg(&__hks_cmd);")
    out.push("            __b")
    out.push("        } else {")
    out.push("            let mut __s = std::process::Command::new(\"sh\");")
    out.push("            __s.arg(\"-c\").arg(&__hks_cmd);")
    out.push("            __s")
    out.push("        };")
    out.push("        if !__hks_limits.is_empty() {")
    out.push("            let __lim = __hks_limits.clone();")
    out.push("            unsafe {")
    out.push("                __c.pre_exec(move || {")
    out.push("                    for (r, v) in __lim.iter() {")
    out.push("                        let rl = libc::rlimit { rlim_cur: *v as libc::rlim_t, rlim_max: *v as libc::rlim_t };")
    out.push("                        if libc::setrlimit(*r as _, &rl) != 0 {")
    out.push("                            return Err(std::io::Error::last_os_error());")
    out.push("                        }")
    out.push("                    }")
    out.push("                    Ok(())")
    out.push("                });")
    out.push("            }")
    out.push("        }")
    out.push("        if __lvl == 1 || __lvl == 2 {")
    out.push("            let __uid = unsafe { libc::geteuid() };")
    out.push("            let __gid = unsafe { libc::getegid() };")
    out.push("            let __uid_map = format!(\"{} {} 1\", __uid, __uid).into_bytes();")
    out.push("            let __gid_map = format!(\"{} {} 1\", __gid, __gid).into_bytes();")
    out.push("            let __sf = __hks_filter.clone();")
    out.push("            unsafe {")
    out.push("                __c.pre_exec(move || {")
    out.push("                    unsafe fn __w(path: &[u8], data: &[u8]) -> bool {")
    out.push("                        let fd = libc::open(path.as_ptr() as *const libc::c_char, libc::O_WRONLY);")
    out.push("                        if fd < 0 { return false; }")
    out.push("                        let n = libc::write(fd, data.as_ptr() as *const libc::c_void, data.len());")
    out.push("                        libc::close(fd);")
    out.push("                        n == data.len() as isize")
    out.push("                    }")
    out.push("                    if __lvl == 1 {")
    out.push("                        if libc::unshare(libc::CLONE_NEWNET) != 0 || libc::unshare(libc::CLONE_NEWNS) != 0 {")
    out.push("                            return Err(std::io::Error::last_os_error());")
    out.push("                        }")
    out.push("                    } else {")
    out.push("                        if libc::unshare(libc::CLONE_NEWUSER | libc::CLONE_NEWNET | libc::CLONE_NEWNS) != 0 {")
    out.push("                            return Err(std::io::Error::last_os_error());")
    out.push("                        }")
    out.push("                        if !__w(b\"/proc/self/setgroups\\0\", b\"deny\") || !__w(b\"/proc/self/uid_map\\0\", &__uid_map) || !__w(b\"/proc/self/gid_map\\0\", &__gid_map) {")
    out.push("                            return Err(std::io::Error::last_os_error());")
    out.push("                        }")
    out.push("                    }")
    out.push("                    let __root = b\"/\\0\";")
    out.push("                    if libc::mount(__root.as_ptr() as *const libc::c_char, __root.as_ptr() as *const libc::c_char, std::ptr::null(), libc::MS_BIND | libc::MS_REC, std::ptr::null()) != 0")
    out.push("                        || libc::mount(std::ptr::null(), __root.as_ptr() as *const libc::c_char, std::ptr::null(), libc::MS_REMOUNT | libc::MS_BIND | libc::MS_RDONLY, std::ptr::null()) != 0 {")
    out.push("                        return Err(std::io::Error::last_os_error());")
    out.push("                    }")
    out.push("                    if !__sf.is_empty() {")
    out.push("                        if libc::prctl(38, 1 as libc::c_ulong, 0 as libc::c_ulong, 0 as libc::c_ulong, 0 as libc::c_ulong) != 0 {")
    out.push("                            return Err(std::io::Error::last_os_error());")
    out.push("                        }")
    out.push("                        let __prog = libc::sock_fprog { len: __sf.len() as u16, filter: __sf.as_ptr() as *mut libc::sock_filter };")
    out.push("                        if libc::prctl(22, 2 as libc::c_ulong, &__prog as *const libc::sock_fprog as libc::c_ulong, 0 as libc::c_ulong, 0 as libc::c_ulong) != 0 {")
    out.push("                            return Err(std::io::Error::last_os_error());")
    out.push("                        }")
    out.push("                    }")
    out.push("                    Ok(())")
    out.push("                });")
    out.push("            }")
    out.push("        }")
    out.push("        __c.status()")
    out.push("    };")
    out.push("    let mut __hks_done = false;")
    out.push("    let mut __hks_errs: Vec<String> = Vec::new();")
    out.push("    if __hks_mode != \"off\" {")
    out.push("        for __lvl in [1u8, 2u8, 3u8] {")
    out.push("            if __lvl == 3 {")
    out.push("                let __ok = std::process::Command::new(\"bwrap\").args([\"--unshare-net\", \"--ro-bind\", \"/\", \"/\", \"true\"]).stdout(std::process::Stdio::null()).stderr(std::process::Stdio::null()).status().map(|s| s.success()).unwrap_or(false);")
    out.push("                if !__ok {")
    out.push("                    __hks_errs.push(\"bwrap: niedostepny albo nie dziala\".to_string());")
    out.push("                    continue;")
    out.push("                }")
    out.push("            }")
    out.push("            match __hks_run(__lvl) {")
    out.push("                Ok(_) => { __hks_done = true; break; }")
    out.push("                Err(e) => { __hks_errs.push(format!(\"metoda {}: {}\", __lvl, e)); }")
    out.push("            }")
    out.push("        }")
    out.push("    }")
    out.push("    if !__hks_done {")
    out.push("        if __hks_mode == \"off\" || __hks_mode == \"best-effort\" {")
    out.push("            eprintln!(\"[hackerc-sandbox] OSTRZEZENIE: uruchamiam polecenie BEZ izolacji (HKS_SANDBOX={}). Proby: {:?}\", __hks_mode, __hks_errs);")
    out.push("            std::process::Command::new(\"sh\").arg(\"-c\").arg(&__hks_cmd).status().expect(\"$ ... $ (Zero-Cost Sandbox) blok: nie udalo sie uruchomic polecenia\");")
    out.push("        } else {")
    out.push("            panic!(\"$ ... $ (Zero-Cost Sandbox) blok: izolacja niedostepna w tym srodowisku ({:?}) - polecenie NIE zostalo uruchomione (fail-closed). Mozesz jawnie zezwolic na uruchomienie bez izolacji: HKS_SANDBOX=best-effort. Patrz docs/SANDBOX.md\", __hks_errs);")
    out.push("        }")
    out.push("    }")
    out.push("}")
    end out
]
