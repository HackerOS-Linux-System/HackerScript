    l.push("const hks_eff_stack = [];\nconst hks_pending = new Set();\nlet hks_flush_queued = false;\nfunction hks_schedule() {\n    if (hks_flush_queued) return;\n    hks_flush_queued = true;\n    Promise.resolve().then(sig_flush);\n}\nfunction sig_flush() {\n    hks_flush_queued = false;\n    let guard = 0;\n    while (hks_pending.size > 0) {\n        if (++guard > 1000) { hks_pending.clear(); hks_report(new Error(\"hks panic: cykl w signal/effect (ponad 1000 przebiegow)\")); return; }\n        const batch = Array.from(hks_pending);\n        hks_pending.clear();\n        for (const e of batch) hks_run_effect(e);\n    }\n}\nfunction hks_run_effect(e) {\n    if (e.dead) return;\n    for (const d of e.deps) d.subs.delete(e);\n    e.deps.clear();\n    hks_eff_stack.push(e);\n    try {\n        const r = e.f();\n        if (r && typeof r.catch === \"function\") r.catch(hks_report);\n    } catch (x) {\n        hks_report(x);\n    } finally {\n        hks_eff_stack.pop();\n    }\n}\nfunction signal(v) { return { $sig: true, v: v, subs: new Set() }; }\nfunction sig_get(s) {\n    const cur = hks_eff_stack[hks_eff_stack.length - 1];\n    if (cur) { s.subs.add(cur); cur.deps.add(s); }\n    return s.v;\n}\nfunction sig_peek(s) { return s.v; }\nfunction sig_set(s, v) {\n    if (s.v === v && (v === null || typeof v !== \"object\")) return;\n    s.v = v;\n    for (const e of Array.from(s.subs)) hks_pending.add(e);\n    if (hks_pending.size > 0) hks_schedule();\n}\nfunction sig_update(s, f) { sig_set(s, f(s.v)); }\nfunction sig_push(s, x) { const a = Array.isArray(s.v) ? s.v.slice() : []; a.push(x); sig_set(s, a); }\nfunction sig_remove_at(s, i) { const a = Array.isArray(s.v) ? s.v.slice() : []; if (i >= 0 && i < a.length) a.splice(i, 1); sig_set(s, a); }\nfunction effect(f) {\n    const e = { f: f, deps: new Set(), dead: false };\n    hks_run_effect(e);\n    return e;\n}\nfunction effect_stop(e) {\n    e.dead = true;\n    for (const d of e.deps) d.subs.delete(e);\n    e.deps.clear();\n    hks_pending.delete(e);\n}\nfunction computed(f) {\n    const s = signal(undefined);\n    let first = true;\n    effect(() => {\n        const v = f();\n        if (first) { s.v = v; first = false; } else { sig_set(s, v); }\n    });\n    return s;\n}\nfunction bind_text(el, s) { return effect(() => { el.textContent = String(sig_get(s)); }); }\nfunction bind_attr(el, name, s) { return effect(() => { el.setAttribute(name, String(sig_get(s))); }); }\nfunction bind_class(el, cls, s) { return effect(() => { el.classList.toggle(cls, !!sig_get(s)); }); }\nfunction bind_show(el, s) { return effect(() => { el.style.display = sig_get(s) ? \"\" : \"none\"; }); }\nfunction bind_value(el, s) {\n    el.addEventListener(\"input\", () => { sig_set(s, el.value); });\n    return effect(() => { const v = String(sig_get(s)); if (el.value !== v) el.value = v; });\n}\nfunction bind_checked(el, s) {\n    el.addEventListener(\"change\", () => { sig_set(s, !!el.checked); });\n    return effect(() => { el.checked = !!sig_get(s); });\n}\nfunction bind_list(parent, s, render) {\n    return effect(() => {\n        const items = sig_get(s);\n        parent.textContent = \"\";\n        if (!items) return;\n        for (let i = 0; i < items.length; i++) {\n            const node = render(items[i], i);\n            if (node) parent.appendChild(node);\n        }\n    });\n}\n")
