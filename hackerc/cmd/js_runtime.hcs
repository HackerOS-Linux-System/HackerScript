    l.push("function hks_listeners(el) { if (!el.__hks_l) el.__hks_l = []; return el.__hks_l; }\nfunction dom_on_event(el, ev, f) {\n    const w = (e) => { hks_call(f, [e]); };\n    hks_listeners(el).push({ ev: ev, f: f, w: w });\n    el.addEventListener(ev, w);\n    return f;\n}\nfunction dom_on(el, ev, f) { return dom_on_event(el, ev, f); }\nfunction dom_off(el, ev, f) {\n    const ls = hks_listeners(el);\n    for (let i = ls.length - 1; i >= 0; i--) {\n        if (ls[i].ev === ev && (f === undefined || ls[i].f === f)) {\n            el.removeEventListener(ev, ls[i].w);\n            ls.splice(i, 1);\n        }\n    }\n}\nfunction dom_delegate(parent, selector, ev, f) {\n    const w = (e) => {\n        const t = e.target && e.target.closest ? e.target.closest(selector) : null;\n        if (t && parent.contains(t)) hks_call(f, [e, t]);\n    };\n    hks_listeners(parent).push({ ev: ev, f: f, w: w });\n    parent.addEventListener(ev, w);\n    return f;\n}\nfunction event_type(e) { return e && e.type ? String(e.type) : \"\"; }\nfunction event_key(e) { return e && e.key !== undefined ? String(e.key) : \"\"; }\nfunction event_code(e) { return e && e.code !== undefined ? String(e.code) : \"\"; }\nfunction event_prevent(e) { if (e && typeof e.preventDefault === \"function\") e.preventDefault(); }\nfunction event_stop(e) { if (e && typeof e.stopPropagation === \"function\") e.stopPropagation(); }\nfunction event_target(e) { return e ? e.target : null; }\nfunction event_current(e) { return e ? e.currentTarget : null; }\nfunction event_value(e) { const t = e && e.target; return t && t.value !== undefined ? String(t.value) : \"\"; }\nfunction event_checked(e) { const t = e && e.target; return !!(t && t.checked); }\nfunction event_mod(e, name) {\n    if (!e) return false;\n    if (name === \"ctrl\") return !!e.ctrlKey;\n    if (name === \"shift\") return !!e.shiftKey;\n    if (name === \"alt\") return !!e.altKey;\n    if (name === \"meta\") return !!e.metaKey;\n    return false;\n}\n")
