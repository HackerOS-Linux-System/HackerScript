    l.push("let hks_http_status = 0;\nlet hks_http_body = \"\";\nasync function http_request(method, url, headers, body) {\n    try {\n        const m = String(method).toUpperCase();\n        const init = { method: m };\n        if (headers) {\n            const h = {};\n            if (headers instanceof Map) { for (const [k, v] of headers) h[k] = String(v); } else { Object.assign(h, headers); }\n            init.headers = h;\n        }\n        if (body !== undefined && body !== null && body !== \"\" && m !== \"GET\" && m !== \"HEAD\") init.body = body;\n        const r = await fetch(url, init);\n        const t = await r.text();\n        hks_http_status = r.status;\n        hks_http_body = t;\n        return r.ok ? ok(t) : err(\"HTTP \" + r.status);\n    } catch (e) {\n        hks_http_status = 0;\n        hks_http_body = \"\";\n        return err(String(e && e.message ? e.message : e));\n    }\n}\nasync function http_get(url) { return http_request(\"GET\", url); }\nasync function http_post(url, body) { return http_request(\"POST\", url, undefined, body); }\nasync function http_post_json(url, body) {\n    return http_request(\"POST\", url, { \"Content-Type\": \"application/json\" }, body);\n}\nasync function http_json(url) {\n    const r = await http_request(\"GET\", url, { \"Accept\": \"application/json\" });\n    if (r.is_err()) return r;\n    try { JSON.parse(r.unwrap()); return r; } catch (e) { return err(\"JSON: \" + String(e && e.message ? e.message : e)); }\n}\nfunction http_last_status() { return hks_http_status; }\nfunction http_last_body() { return hks_http_body; }\nfunction http_error_code(e) {\n    const m = /^HTTP (\\d+)/.exec(String(e));\n    return m ? parseInt(m[1], 10) : 0;\n}\nfunction json_get(text, path) {\n    let v;\n    try { v = JSON.parse(text); } catch (e) { return none(); }\n    const parts = String(path).split(\".\").filter((s) => s !== \"\");\n    for (const p of parts) {\n        if (v === null || typeof v !== \"object\" || !(p in v)) return none();\n        v = v[p];\n    }\n    if (v === null || v === undefined) return none();\n    return some(typeof v === \"object\" ? JSON.stringify(v) : String(v));\n}\nconst hks_mem = { local: new Map(), session: new Map() };\nconst hks_stores = { local: undefined, session: undefined };\nfunction hks_st(kind) {\n    if (hks_stores[kind] === undefined) {\n        let s = null;\n        try {\n            s = kind === \"session\" ? window.sessionStorage : window.localStorage;\n            s.setItem(\"__hks_probe__\", \"1\");\n            s.removeItem(\"__hks_probe__\");\n        } catch (e) { s = null; }\n        hks_stores[kind] = s;\n    }\n    return hks_stores[kind];\n}\nfunction hks_st_get(kind, k) {\n    const s = hks_st(kind);\n    if (s) { try { return s.getItem(k); } catch (e) {} }\n    return hks_mem[kind].has(k) ? hks_mem[kind].get(k) : null;\n}\nfunction hks_st_set(kind, k, v) {\n    const s = hks_st(kind);\n    if (s) { try { s.setItem(k, v); return; } catch (e) {} }\n    hks_mem[kind].set(k, v);\n}\nfunction hks_st_del(kind, k) {\n    const s = hks_st(kind);\n    if (s) { try { s.removeItem(k); } catch (e) {} }\n    hks_mem[kind].delete(k);\n}\nfunction hks_st_clear(kind) {\n    const s = hks_st(kind);\n    if (s) { try { s.clear(); } catch (e) {} }\n    hks_mem[kind].clear();\n}\nfunction storage_get(k) { const v = hks_st_get(\"local\", String(k)); return v === null || v === undefined ? none() : some(v); }\nfunction storage_set(k, v) { hks_st_set(\"local\", String(k), String(v)); }\nfunction storage_remove(k) { hks_st_del(\"local\", String(k)); }\nfunction storage_clear() { hks_st_clear(\"local\"); }\nfunction storage_available() { return hks_st(\"local\") !== null; }\nfunction session_get(k) { const v = hks_st_get(\"session\", String(k)); return v === null || v === undefined ? none() : some(v); }\nfunction session_set(k, v) { hks_st_set(\"session\", String(k), String(v)); }\nfunction session_remove(k) { hks_st_del(\"session\", String(k)); }\nfunction session_clear() { hks_st_clear(\"session\"); }\n")
