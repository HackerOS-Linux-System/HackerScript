    l.push("const hks_routes = [];\nlet hks_route_404 = null;\nlet hks_route_params = {};\nlet hks_route_query = {};\nlet hks_route_path = \"/\";\nlet hks_route_raw_cur = null;\nlet hks_route_mode = \"hash\";\nlet hks_route_layouts = [];\nlet hks_route_before = [];\nlet hks_route_leave = [];\nlet hks_route_outlet_el = null;\nlet hks_route_gen = 0;\nlet hks_route_guard = false;\nconst hks_nav_links = [];\nconst hks_base = (function () {\n    try {\n        const s = document.currentScript;\n        if (s && s.src) return new URL(\".\", s.src).pathname.replace(/\\/$/, \"\");\n    } catch (e) {}\n    return \"\";\n})();\nfunction route(path, handler) { hks_routes.push({ parts: path.split(\"/\").filter((s) => s !== \"\"), handler: handler }); }\nfunction route_not_found(handler) { hks_route_404 = handler; }\nfunction route_layout(prefix, f) { hks_route_layouts.push({ parts: String(prefix).split(\"/\").filter((s) => s !== \"\"), f: f }); }\nfunction before_route(f) { hks_route_before.push(f); }\nfunction on_leave(f) { hks_route_leave.push(f); }\nfunction route_mode(m) {\n    hks_route_mode = (String(m) === \"history\" && typeof location !== \"undefined\" && location.protocol !== \"file:\") ? \"history\" : \"hash\";\n}\nfunction route_current() { return hks_route_path; }\nfunction route_param(name) { return Object.prototype.hasOwnProperty.call(hks_route_params, name) ? some(hks_route_params[name]) : none(); }\nfunction route_rest() { return route_param(\"*\"); }\nfunction route_query(name) { return Object.prototype.hasOwnProperty.call(hks_route_query, name) ? some(hks_route_query[name]) : none(); }\nfunction route_outlet() { return hks_route_outlet_el || document.getElementById(\"route-outlet\") || app_root(); }\nfunction route_set_outlet(el) { hks_route_outlet_el = el; }\nfunction route_href(path) { return hks_route_mode === \"history\" ? hks_base + path : \"#\" + path; }\nfunction hks_route_split(raw) {\n    let p = raw, q = \"\";\n    const i = raw.indexOf(\"?\");\n    if (i >= 0) { p = raw.slice(0, i); q = raw.slice(i + 1); }\n    return [p === \"\" ? \"/\" : p, q];\n}\nfunction hks_route_parse_query(q) {\n    const o = {};\n    if (!q) return o;\n    for (const part of q.split(\"&\")) {\n        if (part === \"\") continue;\n        const k = part.indexOf(\"=\");\n        let n = k < 0 ? part : part.slice(0, k);\n        let v = k < 0 ? \"\" : part.slice(k + 1);\n        try { n = decodeURIComponent(n.replace(/\\+/g, \" \")); v = decodeURIComponent(v.replace(/\\+/g, \" \")); } catch (e) {}\n        o[n] = v;\n    }\n    return o;\n}\nfunction hks_route_read() {\n    if (hks_route_mode === \"history\") {\n        let p = location.pathname;\n        if (hks_base && p.startsWith(hks_base)) p = p.slice(hks_base.length);\n        return (p === \"\" ? \"/\" : p) + location.search;\n    }\n    const h = location.hash.replace(/^#/, \"\");\n    return h === \"\" ? \"/\" : h;\n}\nfunction hks_route_write(raw, replace) {\n    hks_route_guard = true;\n    if (hks_route_mode === \"history\") {\n        if (replace) history.replaceState(null, \"\", hks_base + raw); else history.pushState(null, \"\", hks_base + raw);\n    } else {\n        if (replace) { history.replaceState(null, \"\", location.pathname + location.search + \"#\" + raw); } else { location.hash = \"#\" + raw; }\n    }\n    setTimeout(() => { hks_route_guard = false; }, 0);\n}\nfunction hks_route_match(parts, segs) {\n    const params = {};\n    for (let i = 0; i < parts.length; i++) {\n        const p = parts[i];\n        if (p === \"*\") { params[\"*\"] = segs.slice(i).join(\"/\"); return params; }\n        if (i >= segs.length) return null;\n        if (p.startsWith(\":\")) {\n            try { params[p.slice(1)] = decodeURIComponent(segs[i]); } catch (e) { params[p.slice(1)] = segs[i]; }\n        } else if (p !== segs[i]) {\n            return null;\n        }\n    }\n    return parts.length === segs.length ? params : null;\n}\nfunction hks_nav_active(a) {\n    const target = a.getAttribute(\"data-hks-link\") || \"\";\n    const tp = target.split(\"?\")[0];\n    const cur = hks_route_path;\n    const on = tp === \"/\" ? cur === \"/\" : (cur === tp || cur.startsWith(tp + \"/\"));\n    a.classList.toggle(\"active\", on);\n    if (on) a.setAttribute(\"aria-current\", \"page\"); else a.removeAttribute(\"aria-current\");\n}\nfunction hks_nav_refresh() {\n    for (let i = hks_nav_links.length - 1; i >= 0; i--) {\n        if (!hks_nav_links[i].isConnected) { hks_nav_links.splice(i, 1); continue; }\n        hks_nav_active(hks_nav_links[i]);\n    }\n}\nfunction nav_link(path, text) {\n    const a = document.createElement(\"a\");\n    a.textContent = text === undefined ? String(path) : String(text);\n    a.setAttribute(\"data-hks-link\", String(path));\n    a.setAttribute(\"href\", route_href(String(path)));\n    a.className = \"nav-link\";\n    hks_nav_links.push(a);\n    hks_nav_active(a);\n    return a;\n}\nfunction nav_child(parent, path, text) { const a = nav_link(path, text); parent.appendChild(a); return a; }\nasync function hks_route_render() {\n    const gen = ++hks_route_gen;\n    const raw = hks_route_read();\n    const sp = hks_route_split(raw);\n    const h = sp[0];\n    const old = hks_route_raw_cur;\n    if (old !== null) {\n        for (const f of hks_route_before) {\n            let r = f(h, hks_route_split(old)[0]);\n            if (r && typeof r.then === \"function\") r = await r;\n            if (r === false) { hks_route_write(old, true); return; }\n        }\n        for (const f of hks_route_leave) { await f(hks_route_split(old)[0]); }\n    }\n    hks_route_raw_cur = raw;\n    hks_route_path = h;\n    hks_route_query = hks_route_parse_query(sp[1]);\n    const segs = h.split(\"/\").filter((s) => s !== \"\");\n    let found = null;\n    hks_route_params = {};\n    for (const r of hks_routes) {\n        const m = hks_route_match(r.parts, segs);\n        if (m !== null) { found = r.handler; hks_route_params = m; break; }\n    }\n    if (found === null) found = hks_route_404;\n    hks_route_outlet_el = null;\n    const base = document.getElementById(\"route-outlet\") || app_root();\n    dom_clear(base);\n    const layouts = hks_route_layouts\n        .filter((l) => l.parts.length <= segs.length && l.parts.every((p, i) => p === segs[i]))\n        .sort((a, b) => a.parts.length - b.parts.length);\n    for (const l of layouts) {\n        await l.f();\n        if (gen !== hks_route_gen) return;\n    }\n    const out = route_outlet();\n    if (layouts.length === 0) dom_clear(out);\n    if (found !== null) { await found(); }\n    else { dom_text(out, \"404: \" + h); }\n    if (gen !== hks_route_gen) return;\n    hks_nav_refresh();\n}\nfunction navigate(path) {\n    const p = String(path);\n    if (hks_route_mode === \"history\") { hks_route_write(p, false); hks_route_render().catch(hks_report); } else { location.hash = \"#\" + p; }\n}\nfunction navigate_replace(path) {\n    const p = String(path);\n    hks_route_write(p, true);\n    hks_route_render().catch(hks_report);\n}\nfunction hks_router_start() {\n    if (hks_routes.length === 0) return;\n    if (hks_route_mode === \"history\") {\n        try {\n            const r = sessionStorage.getItem(\"hks_redirect\");\n            if (r) { sessionStorage.removeItem(\"hks_redirect\"); history.replaceState(null, \"\", hks_base + r); }\n        } catch (e) {}\n        window.addEventListener(\"popstate\", () => { hks_route_render().catch(hks_report); });\n    } else {\n        window.addEventListener(\"hashchange\", () => { if (!hks_route_guard) hks_route_render().catch(hks_report); });\n    }\n    document.addEventListener(\"click\", (e) => {\n        const a = e.target && e.target.closest ? e.target.closest(\"a[data-hks-link]\") : null;\n        if (!a || e.defaultPrevented || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;\n        if (hks_route_mode === \"history\") { e.preventDefault(); navigate(a.getAttribute(\"data-hks-link\")); }\n    });\n    return hks_route_render();\n}\nif (typeof window !== \"undefined\") { window.__hks_route_info = function () { return { mode: hks_route_mode, routes: hks_routes.map((r) => r.parts) }; }; }\n")
