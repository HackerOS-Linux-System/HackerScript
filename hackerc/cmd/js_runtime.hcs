    l.push("function hks_report(e) {\n    console.error(e);\n    try { if (typeof window !== \"undefined\" && typeof window.hks_dev_report === \"function\") window.hks_dev_report(e); } catch (_e) {}\n}\nfunction hks_call(f, args) {\n    try {\n        const r = f.apply(null, args);\n        if (r && typeof r.catch === \"function\") r.catch(hks_report);\n        return r;\n    } catch (e) { hks_report(e); }\n}\nfunction app_root() { const a = document.getElementById(\"app\"); if (a && a.hasAttribute(\"data-hks-ssr\")) { a.removeAttribute(\"data-hks-ssr\"); a.textContent = \"\"; } return a; }\nfunction dom_get(id) { return document.getElementById(id); }\nfunction dom_query(sel) { return document.querySelector(sel); }\nfunction dom_query_all(sel) { return Array.from(document.querySelectorAll(sel)); }\nfunction dom_create(tag) { return document.createElement(tag); }\nfunction dom_text(el, t) { el.textContent = String(t); }\nfunction dom_html(el, h) { el.innerHTML = h; }\nfunction html_escape(s) {\n    return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\").replace(/'/g, \"&#39;\");\n}\nfunction dom_attr(el, k, v) { el.setAttribute(k, String(v)); }\nfunction dom_get_attr(el, k) { return el.hasAttribute(k) ? some(el.getAttribute(k)) : none(); }\nfunction dom_remove_attr(el, k) { el.removeAttribute(k); }\nfunction dom_style(el, k, v) { el.style[k] = v; }\nfunction dom_class(el, c) { el.classList.add(c); }\nfunction dom_class_remove(el, c) { el.classList.remove(c); }\nfunction dom_class_toggle(el, c, force) { return force === undefined ? el.classList.toggle(c) : el.classList.toggle(c, !!force); }\nfunction dom_class_has(el, c) { return el.classList.contains(c); }\nfunction dom_append(p, c) { p.appendChild(c); }\nfunction dom_remove(el) { if (el && el.parentNode) el.parentNode.removeChild(el); }\nfunction dom_clear(el) { el.textContent = \"\"; }\nfunction dom_focus(el) { el.focus(); }\nfunction dom_value(el) { return el.value; }\nfunction dom_set_value(el, v) { el.value = String(v); }\nfunction dom_checked(el) { return !!el.checked; }\nfunction dom_set_checked(el, v) { el.checked = !!v; }\nfunction el(tag, text) { const e = document.createElement(tag); if (text !== undefined) e.textContent = String(text); return e; }\nfunction child(parent, tag, text) { const e = el(tag, text); parent.appendChild(e); return e; }\nfunction page_title(t) { document.title = String(t); }\nfunction page_css(css) { const s = document.createElement(\"style\"); s.textContent = css; document.head.appendChild(s); }\nfunction page_lang(l) { document.documentElement.setAttribute(\"lang\", String(l)); }\nfunction page_meta(name, content) {\n    let m = document.head.querySelector('meta[name=\"' + name + '\"]');\n    if (!m) { m = document.createElement(\"meta\"); m.setAttribute(\"name\", name); document.head.appendChild(m); }\n    m.setAttribute(\"content\", String(content));\n}\nfunction page_og(prop, content) {\n    let m = document.head.querySelector('meta[property=\"og:' + prop + '\"]');\n    if (!m) { m = document.createElement(\"meta\"); m.setAttribute(\"property\", \"og:\" + prop); document.head.appendChild(m); }\n    m.setAttribute(\"content\", String(content));\n}\nfunction page_theme_color(c) { page_meta(\"theme-color\", c); }\nfunction page_favicon(href) {\n    let l = document.head.querySelector('link[rel=\"icon\"]');\n    if (!l) { l = document.createElement(\"link\"); l.setAttribute(\"rel\", \"icon\"); document.head.appendChild(l); }\n    l.setAttribute(\"href\", String(href));\n}\nfunction set_timeout(f, ms) { return setTimeout(() => { hks_call(f, []); }, ms); }\nfunction set_interval(f, ms) { return setInterval(() => { hks_call(f, []); }, ms); }\nfunction clear_timeout(id) { clearTimeout(id); }\nfunction clear_interval(id) { clearInterval(id); }\nfunction alert(m) { window.alert(String(m)); }\nfunction now_ms() { return Date.now(); }\nfunction sleep(ms) { return new Promise((r) => setTimeout(r, ms)); }\nfunction random() { return Math.random(); }\n")
