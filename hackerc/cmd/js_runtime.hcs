fun js_runtime_chunks() -> List<Str> [
    let l: List<Str> = []
    l.push("core_div")
    l.push("hks_idiv hks_div")
    l.push("function hks_idiv(a, b) {\n    if (b === 0) throw new Error(\"hks panic: dzielenie przez zero\");\n    return Math.trunc(a / b);\n}\nfunction hks_div(a, b) {\n    if (Number.isInteger(a) && Number.isInteger(b)) return hks_idiv(a, b);\n    return a / b;\n}\n")
    l.push("core_ix")
    l.push("hks_ix hks_at")
    l.push("function hks_at(xs, i) { return xs[hks_ix(xs, i)]; }\nfunction hks_ix(xs, i) {\n    const n = xs.length;\n    if (!Number.isInteger(i) || i < 0 || i >= n) {\n        throw new Error(\"hks panic: indeks \" + i + \" poza zakresem (dlugosc \" + n + \")\");\n    }\n    return i;\n}\n")
    l.push("core_adt")
    l.push("HksOption HksResult some( none( ok( err( hks_try hks_pop hks_fetch hks_str_to")
    l.push("class HksOption {\n    constructor(t, v) { this.$ = t; this.v = v; }\n    is_some() { return this.$ === \"Some\"; }\n    is_none() { return this.$ === \"None\"; }\n    unwrap() { if (this.$ !== \"Some\") throw new Error(\"hks panic: unwrap() na None\"); return this.v[0]; }\n    unwrap_or(d) { return this.$ === \"Some\" ? this.v[0] : d; }\n}\nclass HksResult {\n    constructor(t, v) { this.$ = t; this.v = v; }\n    is_ok() { return this.$ === \"Ok\"; }\n    is_err() { return this.$ === \"Err\"; }\n    unwrap() { if (this.$ !== \"Ok\") throw new Error(\"hks panic: unwrap() na Err(\" + this.v[0] + \")\"); return this.v[0]; }\n    unwrap_or(d) { return this.$ === \"Ok\" ? this.v[0] : d; }\n}\nfunction some(x) { return new HksOption(\"Some\", [x]); }\nfunction none() { return new HksOption(\"None\", []); }\nfunction ok(x) { return new HksResult(\"Ok\", [x]); }\nfunction err(e) { return new HksResult(\"Err\", [e]); }\nclass HksRet { constructor(v) { this.v = v; } }\nfunction hks_try(x) {\n    if (x.$ === \"Some\" || x.$ === \"Ok\") return x.v[0];\n    throw new HksRet(x);\n}\n")
    l.push("core_coll")
    l.push("hks_len hks_clone hks_eq hks_contains hks_insert hks_remove hks_clear hks_sort hks_truncate hks_char_at hks_pop hks_fetch dict(")
    l.push("function dict() { return new Map(); }\nfunction hks_len(t) {\n    if (typeof t === \"string\") {\n        if (/^[\\x00-\\x7f]*$/.test(t)) return t.length;\n        return new TextEncoder().encode(t).length;\n    }\n    if (t instanceof Map) return t.size;\n    return t.length;\n}\nfunction hks_clone(v) {\n    if (v === null || typeof v !== \"object\") return v;\n    if (Array.isArray(v)) return v.map(hks_clone);\n    if (v instanceof Map) { const m = new Map(); for (const [k, x] of v) m.set(k, hks_clone(x)); return m; }\n    if (typeof HksChan !== \"undefined\" && v instanceof HksChan) return v;\n    const o = Object.create(Object.getPrototypeOf(v));\n    for (const k of Object.keys(v)) o[k] = hks_clone(v[k]);\n    return o;\n}\nfunction hks_eq(a, b) {\n    if (a === b) return true;\n    if (a === null || b === null || typeof a !== \"object\" || typeof b !== \"object\") return false;\n    if (Array.isArray(a)) {\n        if (!Array.isArray(b) || a.length !== b.length) return false;\n        for (let i = 0; i < a.length; i++) if (!hks_eq(a[i], b[i])) return false;\n        return true;\n    }\n    if (a instanceof Map) {\n        if (!(b instanceof Map) || a.size !== b.size) return false;\n        for (const [k, x] of a) { if (!b.has(k) || !hks_eq(x, b.get(k))) return false; }\n        return true;\n    }\n    const ka = Object.keys(a), kb = Object.keys(b);\n    if (ka.length !== kb.length) return false;\n    for (const k of ka) if (!hks_eq(a[k], b[k])) return false;\n    return true;\n}\nfunction hks_contains(t, x) {\n    if (typeof t === \"string\") return t.includes(x);\n    if (t instanceof Map) return t.has(x);\n    for (const e of t) if (hks_eq(e, x)) return true;\n    return false;\n}\nfunction hks_insert(t, a, b) {\n    if (t instanceof Map) { t.set(a, b); return; }\n    if (!Number.isInteger(a) || a < 0 || a > t.length) throw new Error(\"hks panic: insert poza zakresem\");\n    t.splice(a, 0, b);\n}\nfunction hks_remove(t, x) {\n    if (t instanceof Map) { return t.delete(x); }\n    if (!Number.isInteger(x) || x < 0 || x >= t.length) throw new Error(\"hks panic: remove poza zakresem\");\n    return t.splice(x, 1)[0];\n}\nfunction hks_clear(t) { if (t instanceof Map) t.clear(); else t.length = 0; }\nfunction hks_sort(t) { t.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0)); }\nfunction hks_truncate(t, n) { if (n < t.length) t.length = n; }\nfunction hks_char_at(s, i) {\n    const cs = Array.from(s);\n    if (!Number.isInteger(i) || i < 0 || i >= cs.length) throw new Error(\"hks panic: char_at poza zakresem\");\n    return cs[i];\n}\nfunction hks_pop(xs) { return xs.length > 0 ? some(xs.pop()) : none(); }\nfunction hks_fetch(m, k) { return m.has(k) ? some(m.get(k)) : none(); }\n")
    l.push("core_async")
    l.push("hks_spawn HksChan chan(")
    l.push("function hks_spawn(f) { return (async () => f())(); }\nclass HksChan {\n    constructor(cap) { this.cap = Math.max(1, cap | 0); this.q = []; this.closed = false; this.recvq = []; this.sendq = []; }\n    async send(v) {\n        if (this.closed) throw new Error(\"hks panic: send na zamknietym kanale\");\n        if (this.recvq.length > 0) { this.recvq.shift()(some(v)); return true; }\n        if (this.q.length < this.cap) { this.q.push(v); return true; }\n        await new Promise((res) => this.sendq.push([v, res]));\n        return true;\n    }\n    async recv() {\n        if (this.q.length > 0) {\n            const v = this.q.shift();\n            if (this.sendq.length > 0) { const [sv, res] = this.sendq.shift(); this.q.push(sv); res(); }\n            return some(v);\n        }\n        if (this.sendq.length > 0) { const [sv, res] = this.sendq.shift(); res(); return some(sv); }\n        if (this.closed) return none();\n        return await new Promise((res) => this.recvq.push(res));\n    }\n    close() { this.closed = true; for (const r of this.recvq) r(none()); this.recvq = []; }\n    clone() { return this; }\n}\nfunction chan(n) { return new HksChan(n === undefined ? 1 : n); }\n")
    l.push("std_str")
    l.push("str_join( str_split( str_trim( str_starts_with( str_ends_with( str_replace( str_contains( str_to_int( str_to_float( str_index_of(")
    l.push("function str_join(xs, sep) { return xs.join(sep); }\nfunction str_split(s, sep) { return s.split(sep); }\nfunction str_trim(s) { return s.trim(); }\nfunction str_starts_with(s, p) { return s.startsWith(p); }\nfunction str_ends_with(s, p) { return s.endsWith(p); }\nfunction str_replace(s, a, b) { return s.split(a).join(b); }\nfunction str_contains(s, p) { return s.includes(p); }\nfunction str_to_int(s) { return /^-?[0-9]+$/.test(s.trim()) ? some(parseInt(s.trim(), 10)) : none(); }\nfunction str_to_float(s) { const t = s.trim(); return t !== \"\" && !isNaN(Number(t)) ? some(Number(t)) : none(); }\nfunction str_index_of(s, n) { const i = s.indexOf(n); return i >= 0 ? some(i) : none(); }\n")
    l.push("std_math")
    l.push("math_abs_int( math_abs_float( math_min_int( math_max_int( math_min_float( math_max_float( math_pow_int( math_pow_float( math_sqrt( math_floor( math_ceil( math_round(")
    l.push("function math_abs_int(x) { return Math.abs(x); }\nfunction math_abs_float(x) { return Math.abs(x); }\nfunction math_min_int(a, b) { return Math.min(a, b); }\nfunction math_max_int(a, b) { return Math.max(a, b); }\nfunction math_min_float(a, b) { return Math.min(a, b); }\nfunction math_max_float(a, b) { return Math.max(a, b); }\nfunction math_pow_int(b, e) { let r = 1; for (let i = 0; i < e; i++) r *= b; return r; }\nfunction math_pow_float(b, e) { return Math.pow(b, e); }\nfunction math_sqrt(x) { return Math.sqrt(x); }\nfunction math_floor(x) { return Math.floor(x); }\nfunction math_ceil(x) { return Math.ceil(x); }\nfunction math_round(x) { return Math.round(x); }\n")
    l.push("node_io")
    l.push("args( exit( read_file( write_file( file_readable( now_ms( sleep(")
    l.push("function args() { return process.argv.slice(2); }\nfunction exit(c) { process.exit(c); }\nfunction read_file(p) { try { return ok(require(\"fs\").readFileSync(p, \"utf8\")); } catch (e) { return err(String(e.message)); } }\nfunction write_file(p, t) { try { require(\"fs\").writeFileSync(p, t); return ok(true); } catch (e) { return err(String(e.message)); } }\nfunction file_readable(p) { try { require(\"fs\").accessSync(p, require(\"fs\").constants.R_OK); return true; } catch (e) { return false; } }\nfunction now_ms() { return Date.now(); }\nfunction sleep(ms) { return new Promise((r) => setTimeout(r, ms)); }\n")
    l.push("web_dom")
    l.push("dom_ page_ app_root child( el( http_ storage_ set_timeout( set_interval( alert( now_ms( sleep( random(")
    l.push("function app_root() { return document.getElementById(\"app\"); }\nfunction dom_get(id) { return document.getElementById(id); }\nfunction dom_query(sel) { return document.querySelector(sel); }\nfunction dom_create(tag) { return document.createElement(tag); }\nfunction dom_text(el, t) { el.textContent = String(t); }\nfunction dom_html(el, h) { el.innerHTML = h; }\nfunction dom_attr(el, k, v) { el.setAttribute(k, String(v)); }\nfunction dom_style(el, k, v) { el.style[k] = v; }\nfunction dom_class(el, c) { el.classList.add(c); }\nfunction dom_append(p, c) { p.appendChild(c); }\nfunction dom_clear(el) { el.textContent = \"\"; }\nfunction dom_value(el) { return el.value; }\nfunction dom_set_value(el, v) { el.value = String(v); }\nfunction dom_on(el, ev, f) { el.addEventListener(ev, (e) => { const r = f(); if (r && typeof r.catch === \"function\") r.catch((x) => console.error(x)); }); }\nfunction el(tag, text) { const e = document.createElement(tag); if (text !== undefined) e.textContent = String(text); return e; }\nfunction child(parent, tag, text) { const e = el(tag, text); parent.appendChild(e); return e; }\nfunction page_title(t) { document.title = String(t); }\nfunction page_css(css) { const s = document.createElement(\"style\"); s.textContent = css; document.head.appendChild(s); }\nasync function http_get(url) { try { const r = await fetch(url); const t = await r.text(); return r.ok ? ok(t) : err(\"HTTP \" + r.status); } catch (e) { return err(String(e.message || e)); } }\nasync function http_post(url, body) { try { const r = await fetch(url, { method: \"POST\", body: body }); const t = await r.text(); return r.ok ? ok(t) : err(\"HTTP \" + r.status); } catch (e) { return err(String(e.message || e)); } }\nfunction storage_get(k) { const v = localStorage.getItem(k); return v === null ? none() : some(v); }\nfunction storage_set(k, v) { localStorage.setItem(k, String(v)); }\nfunction set_timeout(f, ms) { return setTimeout(f, ms); }\nfunction set_interval(f, ms) { return setInterval(f, ms); }\nfunction alert(m) { window.alert(String(m)); }\nfunction now_ms() { return Date.now(); }\nfunction sleep(ms) { return new Promise((r) => setTimeout(r, ms)); }\nfunction random() { return Math.random(); }\n")
    end l
]
