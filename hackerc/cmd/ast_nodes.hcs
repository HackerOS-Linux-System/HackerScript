struct TypeRef [
    name: Str,
    generic: Option<TypeRef>,
    generic2: Option<TypeRef>
]

!!! Wyrazenia. Warianty odwolujace sie do `Expr` BEZPOSREDNIO (nie przez
!!! `List<Expr>`) tworza cykl rozmiaru i dostaja automatyczny `Box` -
!!! (`BinOp`/`UnaryOp`/`Call.callee`/`Index`/`Cast.target`/`TryOp`/
!!! `Attr.target`) - zweryfikowane w wygenerowanym Rust.
enum Expr [
    NumberLit(Str),
    StringLit(Str, Bool),
    BoolLit(Bool),
    NullLit,
    IdentExpr(Str),
    BinOp(Str, Expr, Expr),
    UnaryOp(Str, Expr),
    Call(Expr, List<Expr>),
    Index(Expr, Expr),
    Cast(Expr, TypeRef),
    TryOp(Expr),
    Attr(Expr, Str),
    ListLit(List<Expr>)
]

!!! Jeden parametr `fun`/pole `struct` - `type_ref`/`default_expr` sa
!!! `Option`, bo NIE KAZDY parametr ma jawna adnotacje typu (`self`) czy
!!! wartosc domyslna (parytet z `type_: Optional[TypeRef]`/`default: Any
!!! = None` w Param z ast_nodes.py - nazwy pol zmienione na
!!! `type_ref`/`default_expr`, bo `type`/`default` sa juz uzywane
!!! gdzie indziej jako nazwy - patrz "Ograniczenia").
struct Param [
    name: Str,
    type_ref: Option<TypeRef>,
    default_expr: Option<Expr>
]

!!! Jedna sygnatura wewnatrz `region [ ... ]` (0.3) - odpowiednik
!!! pojedynczej deklaracji `fun nazwa(params) -> Typ` BEZ ciala,
!!! przywiazanej do biblioteki zadeklarowanej poprzedzajacym
!!! `get <extern:sciezka> use <tryb>` (patrz `RegionBlock` w `Stmt`
!!! ponizej oraz `parse_region()`/`gen_region()`). Zastepuje stare,
!!! jedno-funkcyjne `ExternFunDecl` z wersji < 0.3.
struct ExternSig [
    name: Str,
    params: List<Param>,
    ret_type: Option<TypeRef>
]

!!! Jedna galaz `elif cond [ body ]` - w Pythonie to `tuple[Expr,
!!! list]` w `IfStmt.elifs`, tu WLASNY struct (HackerScript nie ma
!!! generycznych tupli).
struct ElifArm [
    cond: Expr,
    body: List<Stmt>
]

!!! Jeden wariant `enum` - `Nazwa` (jednostkowy, `fields` puste) albo
!!! `Nazwa(Typ, Typ2, ...)` (krotkowy).
struct EnumVariant [
    name: Str,
    fields: List<TypeRef>
]

!!! Jedna galaz `match`: `Wariant(bind1, bind2) -> [ ... ]` albo
!!! `_ -> [ ... ]` (wildcard, `variant == "_"`).
struct MatchArm [
    variant: Str,
    binds: List<Str>,
    body: List<Stmt>
]

!!! Instrukcje/deklaracje - WSZYSTKO, co moze zwrocic `parse_statement`
!!! w parser.py, w JEDNYM enum (tak jak w Pythonie WSZYSTKIE te klasy
!!! dziedzicza po `Node` i po prostu ladują w tej samej liscie
!!! `Program.body`). Zaden wariant nie odwoluje sie do `Stmt`
!!! BEZPOSREDNIO (tylko przez `List<Stmt>`/`List<ElifArm>`/
!!! `List<MatchArm>` - wszystkie posrednie) - `Stmt` NIE POTRZEBUJE
!!! `Box` w zadnym wariancie, zweryfikowane w wygenerowanym Rust.
!!! `IncludeStmt(Str)` - `include <sciezka>`, odpowiednik Rustowego
!!! `mod`, WZGLEDEM katalogu biezacego pliku (patrz
!!! project.hcs::resolve_include_path). Osobny od `GetImportStmt`/
!!! `get <source:name>`, ktory pozostaje nietkniety - `include` nie ma
!!! zrodla/wersji/`import <details>`, tylko jeden segment sciezki.
!!! NOWOSC 0.4: drugi ksztalt tego samego wariantu,
!!! `include <work:czlonek[::plik]>` (Str zaczyna sie od dokladnie
!!! `"work:"`) - "prawdziwe" statyczne linkowanie zrodla INNEGO
!!! czlonka workspace (bez kopiowania plikow), rozwiazywane WZGLEDEM
!!! KORZENIA WORKSPACE zamiast katalogu biezacego pliku - patrz
!!! `parse_include()` w parser.hcs i `resolve_include_path()` w
!!! project.hcs. W odroznieniu od `get <work:...>` (ktory TAKZE
!!! importuje ten sam plik, ale jako WLASNY, nazwany podmodul), efekt
!!! koncowy na poziomie Rust jest identyczny (`use crate::<flat>::*;`
!!! - patrz `gen_include`/`gen_get_import` w codegen.hcs) - roznica to
!!! WYLACZNIE nazwa wygenerowanego modulu (prefiks `_hks_inc_` zamiast
!!! `_hks_`) i brak `import <wybrane_nazwy>` w `include`.
enum Stmt [
    LetStmt(Str, Option<TypeRef>, Option<Expr>, Bool),
    AssignStmt(Expr, Str, Expr),
    FunDecl(Str, List<Param>, Option<TypeRef>, List<Stmt>, Bool, List<Str>),
    RegionBlock(List<ExternSig>),
    IfStmt(Expr, List<Stmt>, List<ElifArm>, Option<List<Stmt>>),
    WhileStmt(Expr, List<Stmt>),
    ForStmt(Str, Expr, List<Stmt>),
    ReturnStmt(Option<Expr>),
    BreakStmt,
    ContinueStmt,
    ExprStmt(Expr),
    !! ZMIANA 0.3: dla `source == "extern"` trzecie pole (pierwotnie
    !! `::wersja`) trzyma zamiast tego tryb linkowania z `use <tryb>`
    !! ("static"/"dynamic") - `get <extern:...>` nie ma wersji, wiec
    !! slot jest bezpiecznie ponownie uzyty zamiast dodawania nowego
    !! wariantu `Stmt` (patrz `parse_get_import()`/`gen_get_import()`).
    !! Dla kazdego innego `source` czwarte pole (`version`) znaczy
    !! dokladnie to co wczesniej.
    GetImportStmt(Str, Str, Option<Str>, List<Str>),
    IncludeStmt(Str),
    UsingStmt(Str),
    DirectBlock(List<Str>),
    ManualBlock(List<Stmt>),
    GcPragma(Str),
    StructDecl(Str, List<Param>, List<Str>),
    EnumDecl(Str, List<EnumVariant>, List<Str>),
    MatchStmt(Expr, List<MatchArm>),
    ImplDecl(Str, List<Stmt>, List<Str>)
]

!!! Caly program - lista instrukcji/deklaracji najwyzszego poziomu.
struct Program [
    body: List<Stmt>
]

!!! Demonstracyjne uzycie - buduje reczne AST dla `fun add(a: Int, b:
!!! Int) -> Int [ end a + b ]` (bez przechodzenia przez parser.hcs -
!!! ten plik jest samodzielny, testowany osobno) i wypisuje liczbe
!!! instrukcji.
fun main() [
    let int_type = TypeRef("Int", none(), none())
    let a_param = Param("a", some(int_type.clone()), none())
    let b_param = Param("b", some(int_type.clone()), none())
    let body: List<Stmt> = [ReturnStmt(some(BinOp("+", IdentExpr("a"), IdentExpr("b"))))]
    let f = FunDecl("add", [a_param, b_param], some(int_type), body, false, [])
    let prog = Program([f])
    log("instrukcje w programie:", prog.body.len())
]
