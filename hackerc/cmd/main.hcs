const VERSION: Str = "0.4"

!!! DODANE w tej rundzie (patrz docs/ROADMAP.md) - `hackerc` byl do tej
!!! pory calkowicie monochromatyczny (`log("hackerc: ...", ...)`).
!!! `cmd_build` ma teraz 4 kroki zliczane wprost (parsowanie, sygnatury
!!! projektu, sprawdzanie typow, generowanie crate'a Rust) - ta stala
!!! jest jedynym miejscem, ktore trzeba zmienic, gdyby kroki sie
!!! zmienily.
const BUILD_STEP_COUNT: Int = 4

!!! `parse()` ale z tym samym preprocessingiem `direct [ ... ]` I
!!! `native` `{Silnik}` `[ ... ]` co transpilacja - inaczej pliki z
!!! `direct[...]`/`native{...}[...]` psulyby `check`/`lint` mylacym
!!! bledem parsera (`direct`/`native` sa normalnymi slowami
!!! kluczowymi TYLKO na etapie preprocessingu, patrz transpiler.hcs).
!!! Parytet z `_parse_with_direct`.
fun parse_with_direct(source: Str, src_path: Str) -> Program [
    let fast_direct_extraction = extract_fast_direct_blocks(source)
    let extraction = extract_direct_blocks(fast_direct_extraction.stripped_source)
    let native_extraction = extract_native_blocks(extraction.stripped_source, native_dirname(src_path))
    let sandbox_extraction = extract_sandbox_blocks(native_extraction.stripped_source)
    let hot_extraction = extract_hot_reload_markers(sandbox_extraction.stripped_source)
    end parse(hot_extraction.stripped_source)
]

!!! DODANE (ta runda, patrz docs/ROADMAP.md sekcja 1 - "ParseError") -
!!! jak `parse_with_direct` wyzej, ale przez `parse_checked()` zamiast
!!! `parse()` - zwraca tez `List<Diagnostic>` bledow parsera zamiast je
!!! gubic. Uzywane przez `cmd_check`/`cmd_build`/`cmd_emit_module`
!!! (patrz tam) - raportuja te bledy PRZED typecheckiem (kolorowo,
!!! przez ten sam `render_many`), zamiast pozwolic im utonac w
!!! surowym `log()` pomiedzy zwyklym wyjsciem builda.
fun parse_with_direct_checked(source: Str, src_path: Str) -> ParseResult [
    let fast_direct_extraction = extract_fast_direct_blocks(source)
    let extraction = extract_direct_blocks(fast_direct_extraction.stripped_source)
    let native_extraction = extract_native_blocks(extraction.stripped_source, native_dirname(src_path))
    let sandbox_extraction = extract_sandbox_blocks(native_extraction.stripped_source)
    let hot_extraction = extract_hot_reload_markers(sandbox_extraction.stripped_source)
    end parse_checked(hot_extraction.stripped_source)
]

!!! Wypisuje diagnostyki (opcjonalnie przefiltrowane po `severity`) i
!!! zwraca LICZBE bledow (`severity == "error"`) - parytet z
!!! `_print_diagnostics`. `only_severity == ""` znaczy "bez filtra"
!!! (HackerScript nie ma `str | None` - `Option<Str>` uzyty tylko tam,
!!! gdzie brak wartosci jest semantycznie inny niz pusty string).
fun print_diagnostics(source: Str, filename: Str, diags: List<Diagnostic>, only_severity: Str) -> Int [
    let filtered: List<Diagnostic> = []
    let i = 0
    let n = diags.len()
    while i < n [
        let d = diags[i].clone()
        if only_severity == "" or d.severity == only_severity [
            filtered.push(d)
        ]
        i = i + 1
    ]
    if filtered.len() == 0 [
        end 0
    ]
    log(render_many(source, filename, filtered.clone()))
    let errors = 0
    let j = 0
    let fn_ = filtered.len()
    while j < fn_ [
        if filtered[j].severity == "error" [
            errors = errors + 1
        ]
        j = j + 1
    ]
    end errors
]

!!! `hackerc check <plik>` - tylko diagnostyka (typecheck), bez
!!! zapisu. Zwraca kod wyjscia (0 = sukces). Parytet z `cmd_check`.
fun cmd_check(src_path: Str) -> Int [
    if not file_readable(src_path.clone()) [
        elog(c_red("hackerc:") + " nie znaleziono pliku " + src_path)
        end 1
    ]
    match read_file(src_path.clone()) [
        Ok(source) -> [
            let parse_result = parse_with_direct_checked(source.clone(), src_path.clone())
            if parse_result.errors.len() > 0 [
                log(render_many(source, src_path.clone(), parse_result.errors.clone()))
                log(render_diagnostic_summary(parse_result.errors.len(), 0))
                end 1
            ]
            let program = parse_result.program
            let diags = check_program(program, [], source.clone())
            let errors = print_diagnostics(source, src_path.clone(), diags.clone(), "")
            let warn_count = diags.len() - errors
            if diags.len() > 0 [
                log(render_diagnostic_summary(errors, warn_count))
            ]
            if errors > 0 [
                end 1
            ]
            log(c_bold_green("hackerc check:") + " " + src_path + " OK (" + (diags.len() as Str) + " warning(ow))")
            end 0
        ]
        Err(e) -> [
            elog(c_red("hackerc:") + " " + src_path + ": " + e)
            end 1
        ]
    ]
]

!!! ROZBUDOWA 0.5 - `hackerc kotlin <plik.hcs> [-o Main.kt]`: backend Kotlina
!!! (`use <lang:kotlin>`, eksperymentalny - patrz kotlin_backend.hcs).
fun cmd_kotlin(src_path: Str, out_path: Str) -> Int [
    if not file_readable(src_path.clone()) [
        elog(c_red("hackerc:") + " nie znaleziono pliku " + src_path)
        end 1
    ]
    match read_file(src_path.clone()) [
        Ok(source) -> [
            let parse_result = parse_with_direct_checked(source.clone(), src_path.clone())
            if parse_result.errors.len() > 0 [
                log(render_many(source, src_path.clone(), parse_result.errors.clone()))
                end 1
            ]
            match transpile_kotlin(parse_result.program) [
                Ok(kt) -> [
                    let dest = out_path.clone()
                    if dest == "" [
                        dest = "Main.kt"
                    ]
                    match write_file(dest.clone(), kt) [
                        Ok(_w) -> [
                            log(c_bold_green("hackerc kotlin:") + " " + dest)
                            end 0
                        ]
                        Err(e) -> [
                            elog(c_red("hackerc:") + " " + dest + ": " + e)
                            end 1
                        ]
                    ]
                ]
                Err(msgs) -> [
                    elog(c_red("hackerc kotlin:") + " " + src_path)
                    elog(msgs)
                    end 1
                ]
            ]
        ]
        Err(e) -> [
            elog(c_red("hackerc:") + " " + src_path + ": " + e)
            end 1
        ]
    ]
]

!!! `hackerc lint <plik>` - tylko warningi (podzbior `check`). Parytet
!!! z `cmd_lint`.

!!! ROZBUDOWA 0.6 - `use <lang:javascript>` i `use <mode:website>`
!!! (docs/JAVASCRIPT.md, docs/WEBSITE.md). Backend: javascript_backend.hcs.

struct JsLoader [
    visited: List<Str>,
    errors: List<Str>
]

fun js_dirname(p: Str) -> Str [
    let i = p.len()
    while i > 0 [
        i = i - 1
        if p.char_at(i) == "/" [
            end p.slice(0, i)
        ]
    ]
    end "."
]

!!! Nazwa pliku bez katalogu i bez `.hcs`.
fun js_stem(p: Str) -> Str [
    let start = 0
    let i = 0
    while i < p.len() [
        if p.char_at(i) == "/" [
            start = i + 1
        ]
        i = i + 1
    ]
    let name: Str = p.slice(start, p.len())
    if str_ends_with(name.clone(), ".hcs") [
        name = name.slice(0, name.len() - 4)
    ]
    end name
]

impl JsLoader [
    !!! Wczytuje plik i rozwija `include <nazwa>` (pliki siostrzane `.hcs`).
    fun load(self, path: Str) -> List<Stmt> [
        let out: List<Stmt> = []
        if js_list_has(self.visited.clone(), path.clone()) [
            end out
        ]
        self.visited.push(path.clone())
        match read_file(path.clone()) [
            Err(e) -> [
                self.errors.push(path.clone() + ": " + e)
                end out
            ]
            Ok(source) -> [
                let pr = parse_with_direct_checked(source.clone(), path.clone())
                if pr.errors.len() > 0 [
                    self.errors.push(render_many(source.clone(), path.clone(), pr.errors.clone()))
                    end out
                ]
                let dir = js_dirname(path.clone())
                let i = 0
                while i < pr.program.body.len() [
                    let st = pr.program.body[i].clone()
                    match st.clone() [
                        IncludeStmt(rel) -> [
                            let sub = self.load(dir.clone() + "/" + rel + ".hcs")
                            let k = 0
                            while k < sub.len() [
                                out.push(sub[k].clone())
                                k = k + 1
                            ]
                        ]
                        _ -> [
                            out.push(st.clone())
                        ]
                    ]
                    i = i + 1
                ]
                end out
            ]
        ]
    ]
]

!!! Cel budowania wg dyrektyw `use` pliku wejsciowego: "website",
!!! "javascript" albo "" (domyslnie: Rust).
fun js_build_target(path: Str) -> Str [
    match read_file(path.clone()) [
        Err(e) -> [
            end ""
        ]
        Ok(source) -> [
            let pr = parse_with_direct_checked(source.clone(), path.clone())
            if pr.errors.len() > 0 [
                end ""
            ]
            let target = ""
            let i = 0
            while i < pr.program.body.len() [
                match pr.program.body[i].clone() [
                    UseStmt(k, v) -> [
                        let val = ""
                        match v.clone() [
                            Some(x) -> [
                                val = x
                            ]
                            None -> [
                                let unused = 0
                            ]
                        ]
                        if k == "mode" and val == "website" [
                            target = "website"
                        ]
                        if k == "lang" and (val == "javascript" or val == "js") and target != "website" [
                            target = "javascript"
                        ]
                    ]
                    _ -> [
                        let unused2 = 0
                    ]
                ]
                i = i + 1
            ]
            end target
        ]
    ]
]

fun site_index_html(title: Str) -> Str [
    let l: List<Str> = []
    l.push("<!doctype html>")
    l.push("<html lang=\"pl\">")
    l.push("<head>")
    l.push("<meta charset=\"utf-8\">")
    l.push("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
    l.push("<title>" + title + "</title>")
    l.push("<style>body { font-family: system-ui, sans-serif; margin: 0; line-height: 1.5; } #app { max-width: 52rem; margin: 0 auto; padding: 1rem; }</style>")
    l.push("</head>")
    l.push("<body>")
    l.push("<div id=\"app\"></div>")
    l.push("<script src=\"app.js\"></script>")
    l.push("</body>")
    l.push("</html>")
    end str_join(l, "\n") + "\n"
]

!!! `hackerc js <plik.hcs> [-o wynik.js]` (lang:javascript) oraz
!!! `hackerc website <plik.hcs> [-o katalog]` (mode:website).
fun cmd_js(src_path: Str, out_path: Str, site: Bool) -> Int [
    if not file_readable(src_path.clone()) [
        elog(c_red("hackerc:") + " nie znaleziono pliku " + src_path)
        end 1
    ]
    let loader = JsLoader([], [])
    let body = loader.load(src_path.clone())
    if loader.errors.len() > 0 [
        log(str_join(loader.errors.clone(), "\n"))
        end 1
    ]
    let dw = 0
    while dw < body.len() [
        match body[dw].clone() [
            UseStmt(dk, dv) -> [
                let dval = ""
                match dv.clone() [
                    Some(x) -> [
                        dval = x
                    ]
                    None -> [
                        let unused = 0
                    ]
                ]
                if dk == "mode" and dval != "website" [
                    elog(c_red("hackerc:") + " nieznana wartosc `use <mode:" + dval + ">` - znane: website")
                ]
                if dk == "lang" and dval != "kotlin" and dval != "javascript" and dval != "js" [
                    elog(c_red("hackerc:") + " nieznana wartosc `use <lang:" + dval + ">` - znane: kotlin, javascript")
                ]
                if dk != "mode" and dk != "lang" and dk != "crosscompile" and dk != "arc" [
                    elog(c_red("hackerc:") + " nieznana dyrektywa `use <" + dk + ">`")
                ]
            ]
            _ -> [
                let unused2 = 0
            ]
        ]
        dw = dw + 1
    ]
    match transpile_js(Program(body), site) [
        Err(msgs) -> [
            elog(c_red("hackerc js:") + " " + src_path)
            elog(msgs)
            end 1
        ]
        Ok(js) -> [
            let stem = js_stem(src_path.clone())
            if not site [
                let dest = out_path.clone()
                if dest == "" [
                    dest = js_dirname(src_path.clone()) + "/" + stem + ".js"
                ]
                match write_file(dest.clone(), js) [
                    Ok(_w) -> [
                        log(c_bold_green("hackerc js:") + " " + dest + "  (uruchom: node " + dest + ")")
                        end 0
                    ]
                    Err(e) -> [
                        elog(c_red("hackerc:") + " " + dest + ": " + e)
                        end 1
                    ]
                ]
            ]
            let dir = out_path.clone()
            if dir == "" [
                dir = js_dirname(src_path.clone()) + "/" + stem + "-site"
            ]
            if not create_dir_ok(dir.clone()) [
                elog(c_red("hackerc:") + " nie mozna utworzyc katalogu " + dir)
                end 1
            ]
            match write_file(dir.clone() + "/app.js", js) [
                Ok(_w1) -> [
                    let unused = 0
                ]
                Err(e1) -> [
                    elog(c_red("hackerc:") + " " + dir + "/app.js: " + e1)
                    end 1
                ]
            ]
            match write_file(dir.clone() + "/index.html", site_index_html(stem.clone())) [
                Ok(_w2) -> [
                    let unused2 = 0
                ]
                Err(e2) -> [
                    elog(c_red("hackerc:") + " " + dir + "/index.html: " + e2)
                    end 1
                ]
            ]
            log(c_bold_green("hackerc website:") + " " + dir + "/index.html  (otworz w przegladarce)")
            end 0
        ]
    ]
]

fun cmd_lint(src_path: Str) -> Int [
    if not file_readable(src_path.clone()) [
        elog(c_red("hackerc:") + " nie znaleziono pliku " + src_path)
        end 1
    ]
    match read_file(src_path.clone()) [
        Ok(source) -> [
            let parse_result_lint = parse_with_direct_checked(source.clone(), src_path.clone())
            if parse_result_lint.errors.len() > 0 [
                log(render_many(source, src_path.clone(), parse_result_lint.errors.clone()))
                log(render_diagnostic_summary(parse_result_lint.errors.len(), 0))
                end 1
            ]
            let program = parse_result_lint.program
            let diags = check_program(program, [], source.clone())
            let warnings: List<Diagnostic> = []
            let i = 0
            let n = diags.len()
            while i < n [
                if diags[i].severity == "warning" [
                    warnings.push(diags[i].clone())
                ]
                i = i + 1
            ]
            if warnings.len() == 0 [
                log(c_bold_green("hackerc lint:") + " " + src_path + " - brak uwag")
                end 0
            ]
            log(render_many(source, src_path, warnings))
            log(render_diagnostic_summary(0, warnings.len()))
            end 0
        ]
        Err(e) -> [
            elog(c_red("hackerc:") + " " + src_path + ": " + e)
            end 1
        ]
    ]
]

!!! `hackerc emit-module <plik> -o <plik.rs> --module-name <nazwa>` -
!!! NOWOSC (ta runda, patrz docs/MULTI_VERSION.md). Transpiluje JEDEN
!!! plik `.hcs` do JEDNEGO modulu Rust, BEZ zadnej wiedzy o reszcie
!!! projektu (pusty `empty_extra_signatures()` - brak sygnatur z innych
!!! plikow, WIEC odwolania do funkcji/structow zdefiniowanych GDZIE
!!! INDZIEJ w projekcie moga tu dac falszywe "nieznana funkcja" -
!!! udokumentowane ograniczenie). Ten tryb ISTNIEJE WYLACZNIE, zeby
!!! `Discovery::parse_and_add` w project.hcs (INNEJ, zwykle nowszej,
!!! wersji `hackerc`) mogl zdelegowac do TEJ (starszej/innej) binarki
!!! pojedynczy plik deklarujacy `using <ta-wersja>` w projekcie
!!! zbudowanym domyslnie inna wersja - patrz tam. Zwraca kod wyjscia
!!! (0 = sukces, plik `.rs` zapisany), > 0 = blad na stderr.
fun cmd_emit_module(src_path: Str, out_path: Str, module_name: Str) -> Int [
    if not file_readable(src_path.clone()) [
        elog(c_red("hackerc emit-module:") + " nie znaleziono pliku " + src_path)
        end 1
    ]
    match read_file(src_path.clone()) [
        Ok(source) -> [
            let fast_direct_extraction = extract_fast_direct_blocks(source.clone())
            let extraction = extract_direct_blocks(fast_direct_extraction.stripped_source)
            let native_extraction = extract_native_blocks(extraction.stripped_source, native_dirname(src_path))
            let sandbox_extraction = extract_sandbox_blocks(native_extraction.stripped_source)
            let hot_extraction = extract_hot_reload_markers(sandbox_extraction.stripped_source)
            let wasm_extraction = extract_wasm_export_markers(hot_extraction.stripped_source)
            let parse_result_em = parse_checked(wasm_extraction.stripped_source)
            if parse_result_em.errors.len() > 0 [
                log(render_many(source, src_path.clone(), parse_result_em.errors.clone()))
                log(render_diagnostic_summary(parse_result_em.errors.len(), 0))
                end 1
            ]
            let program = parse_result_em.program
            let diags = check_program(program.clone(), [], source.clone())
            let errors = print_diagnostics(source, src_path.clone(), diags.clone(), "error")
            if errors > 0 [
                log(render_diagnostic_summary(errors, 0))
                end 1
            ]
            let r = transpile_program_with_extra(program, extraction.blocks, native_extraction.blocks, native_extraction.engines, sandbox_extraction.blocks, hot_extraction.names, wasm_extraction.names, src_path.clone(), empty_extra_signatures(), fast_direct_extraction.blocks, fast_direct_extraction.backends, none())
            match write_file(out_path.clone(), r.rust_code) [
                Ok(_v) -> [
                    end 0
                ]
                Err(e) -> [
                    elog(c_red("hackerc emit-module:") + " nie mozna zapisac " + out_path + ": " + e)
                    end 1
                ]
            ]
        ]
        Err(e) -> [
            elog(c_red("hackerc emit-module:") + " " + src_path + ": " + e)
            end 1
        ]
    ]
]


!!! `get <std/core/selfhost:...>` rekurencyjnie. Parytet z `cmd_build`.
!!! `out_dir`/`crate_name` juz rozpakowane (patrz uwaga na gorze pliku
!!! o braku argv) - `out_dir`/`out_dir + "/src"` MUSZA JUZ ISTNIEC,
!!! patrz to samo ograniczenie udokumentowane przy `build_project` w
!!! project.hcs. `bit_root` DODANE w tej rundzie (patrz
!!! `project.hcs::find_bit_cache_root`) - `none()` = auto-wykrywanie.
!!! ROZBUDOWA (ta runda, patrz docs/MULTI_VERSION.md) - `version_binaries`
!!! na koncu (domyslnie `dict()` u wywolania bez `--version-map` -
!!! pelna zgodnosc wsteczna). Przekazywane do `collect_project_signatures`/
!!! `build_project` (patrz tam) - pozwala plikom `using <inna-wersja>`
!!! delegowac swoja transpilacje do wlasciwej binarki.
fun cmd_build(src_path: Str, out_dir: Str, crate_name: Str, libs_root: Option<Str>, bootstrap_root: Option<Str>, bit_root: Option<Str>, force_library: Bool, bin_name: Option<Str>, version_binaries: Dict<Str, Str>) -> Int [
    if not file_readable(src_path.clone()) [
        elog(c_red("hackerc:") + " nie znaleziono pliku " + src_path)
        end 1
    ]
    match read_file(src_path.clone()) [
        Ok(source) -> [
            print_progress_line("Kompilacja " + src_path, 1, BUILD_STEP_COUNT, "parsowanie", true)
            let parse_result_build = parse_with_direct_checked(source.clone(), src_path.clone())
            if parse_result_build.errors.len() > 0 [
                log(render_many(source, src_path.clone(), parse_result_build.errors.clone()))
                log(render_diagnostic_summary(parse_result_build.errors.len(), 0))
                end 1
            ]
            let program = parse_result_build.program

            !!! Sygnatury calego projektu PRZED check_program - inaczej
            !!! konstruktor wariantu z zaimportowanego 'enum' (np.
            !!! `get <selfhost:ast_nodes> import <Expr>` + `Var(...)`)
            !!! dawalby spurious ostrzezenie "nieznana funkcja", bo
            !!! `check_program` widzi domyslnie tylko JEDEN plik -
            !!! parytet z komentarzem w cmd_build (Python).
            print_progress_line("Kompilacja " + src_path, 2, BUILD_STEP_COUNT, "zbieranie sygnatur projektu", false)
            let ps = collect_project_signatures(src_path.clone(), libs_root.clone(), bootstrap_root.clone(), bit_root.clone(), VERSION.to_string(), version_binaries.clone())
            let extra_variants: List<Str> = []
            let ei = 0
            let en = ps.sigs.enum_names.len()
            while ei < en [
                match ps.sigs.enums.fetch(ps.sigs.enum_names[ei].clone()) [
                    Some(estmt) -> [
                        match estmt [
                            EnumDecl(ename, variants, type_params) -> [
                                let vi = 0
                                let vn = variants.len()
                                while vi < vn [
                                    extra_variants.push(variants[vi].name.clone())
                                    vi = vi + 1
                                ]
                            ]
                            _ -> [
                            ]
                        ]
                    ]
                    None -> [
                    ]
                ]
                ei = ei + 1
            ]

            print_progress_line("Kompilacja " + src_path, 3, BUILD_STEP_COUNT, "sprawdzanie typow", false)
            let diags = check_program(program, extra_variants, source.clone())
            let errors = print_diagnostics(source, src_path.clone(), diags.clone(), "")
            if errors > 0 [
                log(render_diagnostic_summary(errors, diags.len() - errors))
                end 1
            ]

            print_progress_line("Kompilacja " + src_path, 4, BUILD_STEP_COUNT, "generowanie crate'a Rust", false)
            let result = build_project(src_path, out_dir, libs_root, bootstrap_root, bit_root, crate_name, force_library, bin_name, VERSION.to_string(), version_binaries.clone())

            !!! NAPRAWA (ta runda) - ostrzezenia projektu (np. "nie
            !!! znaleziono czlonka workspace...", patrz Discovery.warnings
            !!! w project.hcs) byly kolorowane NA CZERWONO
            !!! (`c_bold_red`) mimo etykiety "uwaga" - myllace, czerwony
            !!! sugeruje blad/przerwanie, a to sa TYLKO ostrzezenia
            !!! (kompilacja i tak kontynuuje). Teraz `c_bold_yellow`,
            !!! parytet z tym, jak `render_diagnostic_summary`/
            !!! `severity_tag_color` w diagnostics.hcs kolorujom
            !!! `"warning"`.
            let wi = 0
            let wn = result.warnings.len()
            while wi < wn [
                log(c_bold_yellow("hackerc build: uwaga:") + " " + result.warnings[wi])
                wi = wi + 1
            ]

            log(c_bold_green("hackerc build:") + " crate gotowy w " + c_bold_cyan(result.crate_dir) + " (uruchom `cargo build --release` tam)")
            log(c_gray("  -> ") + result.main_rs_path)
            let mi = 0
            let mn = result.module_files.len()
            while mi < mn [
                log(c_gray("  -> modul: ") + result.module_files[mi])
                mi = mi + 1
            ]
            if result.needs_pyo3 [
                log(c_bold_cyan("hackerc build:") + " wykryto direct[ ... ] -> Cargo.toml zawiera zaleznosc pyo3 (auto-initialize)")
            ]
            if result.needs_native_js [
                log(c_bold_cyan("hackerc build:") + " wykryto blok inline JavaScript (native) -> Cargo.toml zawiera zaleznosc rquickjs")
            ]
            if result.needs_sandbox [
                log(c_bold_cyan("hackerc build:") + " wykryto $ ... $ (Zero-Cost Sandbox) -> Cargo.toml zawiera zaleznosc libc")
            ]
            if result.needs_hot_reload [
                log(c_bold_cyan("hackerc build:") + " wykryto @hot_reload -> utworzono " + out_dir + "/hotlib/ (zbuduj osobno: cargo build --release --manifest-path " + out_dir + "/hotlib/Cargo.toml), ustaw HKS_HOT_OUT_DIR=" + out_dir + " przed uruchomieniem")
            ]
            if result.needs_native_cpp [
                log(c_bold_cyan("hackerc build:") + " wykryto blok kompilowanego build-time C++ (native) -> Cargo.toml zawiera zaleznosc budujaca 'cc' ([build-dependencies])")
            ]
            match result.extern_links_path [
                Some(lp) -> [
                    log(c_bold_cyan("hackerc build:") + " wykryto get <extern:...>/get <c:...>/get <cpp:...> -> zapisano " + lp + " (przeczyta 'bit build', patrz build_wire_extern_dependencies)")
                ]
                None -> [
                ]
            ]
            if result.crates_deps_names.len() > 0 [
                log(c_bold_cyan("hackerc build:") + " zaleznosci Cargo z get<crates:...>: " + join_str_list(result.crates_deps_names, ", "))
            ]
            end 0
        ]
        Err(e) -> [
            elog(c_red("hackerc:") + " " + src_path + ": " + e)
            end 1
        ]
    ]
]

!!! Proste narzedzia string na potrzeby `cmd_hlib` - budowane iteracyjnie
!!! po znakach (`char_at`), tak jak `replace_dash` w project.hcs, zeby
!!! nie zakladac dostepnosci operatora wycinania podciagow.
fun base_name_of(path: Str) -> Str [
    let last_slash = 0 - 1
    let i = 0
    let n = path.len()
    while i < n [
        if path.char_at(i) == "/" [
            last_slash = i
        ]
        i = i + 1
    ]
    let out = ""
    let j = last_slash + 1
    while j < n [
        out = out + path.char_at(j)
        j = j + 1
    ]
    end out
]

fun strip_hcs_ext(name: Str) -> Str [
    let n = name.len()
    if n > 4 [
        if name.char_at(n-4) == "." and name.char_at(n-3) == "h" and name.char_at(n-2) == "c" and name.char_at(n-1) == "s" [
            let out = ""
            let i = 0
            while i < n - 4 [
                out = out + name.char_at(i)
                i = i + 1
            ]
            end out
        ]
    ]
    end name
]

!!! `hackerc hlib build|inspect|verify|keygen` - podkomendy do pracy z
!!! formatem `.hlib` (patrz hlib.hcs - cala logika tam, to tylko
!!! parsowanie argv i komunikaty). Zwraca kod wyjscia (0 = ok).
fun cmd_hlib(argv: List<Str>) -> Int [
    if argv.len() == 0 [
        elog(c_red("hackerc hlib:") + " oczekiwano podkomendy: build | inspect | verify | keygen")
        end 1
    ]
    let action = argv[0].clone()
    let rest = argv.clone()
    let _drop = rest.remove(0)

    if action == "build" [
        let src = first_positional(rest, ["-o", "--output", "--lib-version", "--sign"])
        if src == "" [
            elog(c_red("hackerc hlib build:") + " brak wymaganego argumentu 'source' (plik .hcs)")
            end 1
        ]
        if not file_readable(src.clone()) [
            elog(c_red("hackerc hlib build:") + " nie znaleziono pliku " + src)
            end 1
        ]
        let lib_name = src
        !! wytnij katalogi i rozszerzenie ".hcs" z nazwy pliku, zeby dostac nazwe biblioteki
        match find_flag_value(rest, "", "--name") [
            Some(v) -> [ lib_name = v ]
            None -> [ lib_name = strip_hcs_ext(base_name_of(src.clone())) ]
        ]
        let out_hlib = "build/" + lib_name + ".hlib"
        match find_flag_value(rest, "-o", "--output") [
            Some(v) -> [ out_hlib = v ]
            None -> [ ]
        ]
        let lib_version = "0.1.0"
        match find_flag_value(rest, "", "--lib-version") [
            Some(v) -> [ lib_version = v ]
            None -> [ ]
        ]
        let sign_key_path = ""
        match find_flag_value(rest, "", "--sign") [
            Some(v) -> [ sign_key_path = v ]
            None -> [ ]
        ]

        !!! v1: `.hlib` HackerScript-owe pakuje ZRODLO (artefakt `ast` =
        !!! pelny tekst `.hcs`, patrz naglowek hlib.hcs) - bez natywnego
        !!! `.so`. To wystarcza w 100% dla `get <hlib:x>` (splice
        !!! zrodla, zero `extern`) - jedynego wymaganego trybu w tej
        !!! rundzie. Dolaczanie skompilowanego `.so` (dla konsumentow
        !!! spoza HackerScript, przez naglowek/`region`) to udokumentowane
        !!! rozszerzenie na potem (manifest/hlib_build juz to obslugujom
        !!! - parametr `so_path` - brakuje tylko wpiecia go tutaj w CLI
        !!! do istniejacego `build_project()`/cargo).
        let result = hlib_build(src, "", out_hlib, lib_name, lib_version, sign_key_path)
        if result.ok [
            log(c_bold_green("hackerc hlib build:") + " " + result.message)
            end 0
        ] else [
            elog(c_red("hackerc hlib build:") + " " + result.message)
            end 1
        ]
    ]

    if action == "inspect" [
        let path = first_positional(rest, [])
        if path == "" [
            elog(c_red("hackerc hlib inspect:") + " brak wymaganego argumentu 'plik .hlib'")
            end 1
        ]
        let manifest_json = hlib_read_manifest(path)
        if manifest_json == "" [
            end 1
        ]
        log(manifest_json)
        end 0
    ]

    if action == "verify" [
        let path = first_positional(rest, ["--pubkey"])
        if path == "" [
            elog(c_red("hackerc hlib verify:") + " brak wymaganego argumentu 'plik .hlib'")
            end 1
        ]
        let pubkey = ""
        match find_flag_value(rest, "", "--pubkey") [
            Some(v) -> [ pubkey = v ]
            None -> [ ]
        ]
        if hlib_verify(path, pubkey) [
            log(c_bold_green("hackerc hlib verify:") + " OK")
            end 0
        ] else [
            elog(c_red("hackerc hlib verify:") + " weryfikacja nie powiodla sie")
            end 1
        ]
    ]

    if action == "keygen" [
        let out = "hlib_signing.key"
        match find_flag_value(rest, "-o", "--out") [
            Some(v) -> [ out = v ]
            None -> [ ]
        ]
        let pubkey = hlib_keygen(out)
        if pubkey == "" [
            elog(c_red("hackerc hlib keygen:") + " nie udalo sie wygenerowac klucza")
            end 1
        ]
        log(c_bold_green("hackerc hlib keygen:") + " klucz prywatny zapisany do " + out + " (nie udostepniaj go!)")
        log("  klucz publiczny: " + pubkey)
        end 0
    ]

    elog(c_red("hackerc hlib:") + " nieznana podkomenda '" + action + "' (oczekiwano: build | inspect | verify | keygen)")
    end 1
]

fun join_str_list(items: List<Str>, sep: Str) -> Str [
    let out = ""
    let i = 0
    let n = items.len()
    while i < n [
        if i > 0 [
            out = out + sep
        ]
        out = out + items[i]
        i = i + 1
    ]
    end out
]

!!! Domyslny katalog wyjsciowy dla `hackerc build <src>` (bez `-o`) -
!!! "target-hcs" jako SASIAD pliku zrodlowego, WEWNATRZ jego katalogu
!!! nadrzednego - parytet z Python `src_path.parent / "target-hcs"`
!!! (hackerc/hackerc/cli.py).
!!!
!!! NAPRAWA BUGA: poprzednia wersja liczyla to jako `src + "/../target-
!!! hcs"` (zwykla konkatenacja stringow) - dla `src = "cli.hcs"" dawalo
!!! to doslownie "cli.hcs/../target-hcs", co przy przekazaniu do
!!! wywolan systemu plikow probuje WEJSC do "cli.hcs" jak do KATALOGU
!!! (podczas gdy to zwykly plik) - stad bledy "Not a directory" i seria
!!! bledow po nich (include/libs/ nie znalezione, bo katalog wyjsciowy
!!! byl kompletnie zly). Ta wersja poprawnie znajduje katalog
!!! NADRZEDNY pliku (ostatni "/" w `src`) i dokleja "target-hcs" DO
!!! NIEGO - dla "cli.hcs" (bez "/") daje po prostu "target-hcs"
!!! (katalog biezacy), a dla "cmd/main.hcs" daje "cmd/target-hcs".
fun default_build_out_dir(src: Str) -> Str [
    let n = src.len()
    let idx = 0 - 1
    let i = n
    while i > 0 [
        i = i - 1
        if src.char_at(i) == "/" [
            idx = i
            break
        ]
    ]
    if idx < 0 [
        end "target-hcs"
    ]
    end src.slice(0, idx) + "/target-hcs"
]

!!! `hackerc fmt <plik> [-o plik] [--check]` - formatuje kod `.hcs`.
!!! Parytet z `cmd_fmt`. `check_only`: `true` -> tylko sprawdz (nie
!!! zapisuj), zwraca 1 jesli plik nie jest sformatowany.
!!! `dest_path == ""` -> zapisz w miejscu (parytet z `dest = src_path`
!!! gdy `args.output` brak).
fun cmd_fmt(src_path: Str, dest_path: Str, check_only: Bool) -> Int [
    if not file_readable(src_path.clone()) [
        elog(c_red("hackerc:") + " nie znaleziono pliku " + src_path)
        end 1
    ]
    match read_file(src_path.clone()) [
        Ok(source) -> [
            let formatted = format_source(source.clone(), src_path.clone())
            if check_only [
                if formatted != source [
                    elog(c_bold_red("hackerc fmt --check:") + " " + src_path + " NIE jest sformatowany")
                    end 1
                ]
                log(c_bold_green("hackerc fmt --check:") + " " + src_path + " OK")
                end 0
            ]
            let dest = src_path.clone()
            if dest_path != "" [
                dest = dest_path
            ]
            match write_file(dest.clone(), formatted) [
                Ok(_v) -> [
                    log(c_bold_green("hackerc fmt:") + " sformatowano " + dest)
                    end 0
                ]
                Err(e) -> [
                    elog(c_red("hackerc:") + " " + dest + ": " + e)
                    end 1
                ]
            ]
        ]
        Err(e) -> [
            elog(c_red("hackerc:") + " " + src_path + ": " + e)
            end 1
        ]
    ]
]

!!! Tryb kompatybilnosci wstecznej: transpiluje JEDEN plik `.hcs` do
!!! `.rs`, bez rozwiazywania `get <std/core:...>` (to robi tylko
!!! `build`). Parytet z `cmd_transpile_legacy`. `out_path == ""` ->
!!! wypisz kod Rust zamiast zapisywac (parytet z `else: ... print(
!!! result.rust_code)` gdy `args.output` brak).
fun cmd_transpile_legacy(src_path: Str, out_path: Str) -> Int [
    if not file_readable(src_path.clone()) [
        elog(c_red("hackerc:") + " nie znaleziono pliku " + src_path)
        end 1
    ]
    if out_path != "" [
        match transpile_file(src_path.clone(), out_path.clone(), "module") [
            Ok(_result) -> [
                end 0
            ]
            Err(e) -> [
                log("error: " + e)
                end 1
            ]
        ]
    ]
    match read_file(src_path.clone()) [
        Ok(source) -> [
            let result = transpile_source_full(source, src_path.clone(), "module", empty_extra_signatures())
            log(result.rust_code)
            end 0
        ]
        Err(e) -> [
            log("hackerc: " + src_path + ": " + e)
            end 1
        ]
    ]
]

!!! Demonstracyjne uzycie - `cmd_check` na maly, poprawny program
!!! wbudowany bezposrednio jako string (nie na prawdziwym pliku, zeby
!!! demo dzialalo wszedzie bez przygotowanego wejscia) - patrz duza
!!! uwaga na gorze pliku o braku prawdziwego `argv`. `main()` samo w
!!! sobie NIE odczytuje linii polecen.
!!! Wypisuje banner `usage`/`--help` - parytet z
!!! `build_parser().print_help()` (Python, argparse).
fun print_usage() [
    log("usage: hackerc [-h] [--version] {check,lint,build,fmt,lsp,hlib,emit-module} ...")
    log("")
    log("Transpilator HackerScript -> Rust")
    log("")
    log("positional arguments:")
    log("  {check,lint,build,fmt,lsp,hlib,emit-module}")
    log("    check               typecheck bez generowania kodu")
    log("    lint                tylko warningi (podzbior 'check')")
    log("    build               pelny crate Rust (Cargo.toml + src/) [--version-map w1=p1;w2=p2 - patrz docs/MULTI_VERSION.md]")
    log("    fmt                 formatuje kod .hcs")
    log("    lsp                 Language Server (LSP) po stdio - patrz docs/LSP.md (Etap 2a: diagnostyka)")
    log("    hlib                buduj/sprawdzaj archiwa .hlib (HackerOS Lib) - patrz hlib.hcs")
    log("      hlib build <plik.hcs> [-o wyjscie.hlib] [--lib-version W] [--sign klucz]")
    log("      hlib inspect <plik.hlib>")
    log("      hlib verify <plik.hlib> [--pubkey HEX]")
    log("      hlib keygen [-o klucz.key]")
    log("    emit-module         transpiluje JEDEN plik do JEDNEGO modulu .rs, bez wiedzy o reszcie projektu - uzywane WEWNETRZNIE przez `bit build` przy `using <inna-wersja>`, patrz docs/MULTI_VERSION.md")
    log("      emit-module <plik.hcs> -o <plik.rs> --module-name <nazwa>")
    log("")
    log("options:")
    log("  -h, --help            show this help message and exit")
    log("  --version             pokaz wersje hackerc")
]

!!! Znajduje wartosc flagi `-short wartosc` / `--long wartosc`
!!! (rozdzielone spacja - w odroznieniu od argparse ten bootstrap NIE
!!! obsluguje skladni `--long=wartosc`, patrz "Ograniczenia").
fun find_flag_value(argv: List<Str>, short: Str, long: Str) -> Option<Str> [
    let i = 0
    let n = argv.len()
    while i < n [
        let tok = argv[i]
        if (short != "" and tok == short) or tok == long [
            if i + 1 < n [
                end some(argv[i + 1])
            ]
        ]
        i = i + 1
    ]
    end none()
]

fun has_flag(argv: List<Str>, long: Str) -> Bool [
    let i = 0
    let n = argv.len()
    while i < n [
        if argv[i] == long [
            end true
        ]
        i = i + 1
    ]
    end false
]

fun starts_with_dash(s: Str) -> Bool [
    end s.len() > 0 and s.char_at(0) == "-"
]

fun cli_list_contains_str(items: List<Str>, target: Str) -> Bool [
    let i = 0
    let n = items.len()
    while i < n [
        if items[i] == target [
            end true
        ]
        i = i + 1
    ]
    end false
]

!!! Pierwszy argument pozycyjny (nie zaczyna sie od `-`) - pomija
!!! kazda flage z `value_flags` WRAZ Z JEJ WARTOSCIA (parytet z tym, co
!!! argparse robi automatycznie rozpoznajac zadeklarowane flagi).
fun first_positional(argv: List<Str>, value_flags: List<Str>) -> Str [
    let i = 0
    let n = argv.len()
    while i < n [
        let tok = argv[i]
        if starts_with_dash(tok) [
            if cli_list_contains_str(value_flags, tok) [
                i = i + 1
            ]
        ] else [
            end tok
        ]
        i = i + 1
    ]
    end ""
]

!!! Punkt wejscia - parytet z `main(argv)` (cli.py), WLACZAJAC
!!! rzeczywisty odczyt argv przez `args()` (patrz "Roznica
!!! architektoniczna" na gorze pliku - TERAZ juz zaimplementowana,
!!! dzieki `args()`/`exit()` w codegen.py/codegen.hcs).
fun main() [
    let argv = args()

    if argv.len() == 0 [
        print_usage()
        exit(1)
    ]

    let first = argv[0].clone()

    if first == "--version" [
        log("hackerc " + VERSION)
        exit(0)
    ]
    if first == "-h" or first == "--help" [
        print_usage()
        exit(0)
    ]

    !! ROZBUDOWA (ta runda, patrz docs/LSP.md) - `hackerc lsp` NIE
    !! bierze pliku wejsciowego jako argument (w odroznieniu od
    !! check/lint/build/fmt nizej) - dziala jako dlugozyjacy proces,
    !! czytajacy sciezki plikow z komunikatow JSON-RPC edytora
    !! (`textDocument/didOpen`/`didChange`), nie z linii polecen.
    !! `lsp_run()` konczy proces sam (przez `exit(...)`), wiec nie ma
    !! tu `exit(...)` po jej wywolaniu.
    if first == "lsp" [
        lsp_run()
    ]

    !! DODANE (ta runda, patrz docs/MULTI_VERSION.md) - `emit-module`
    !! ma WLASNY, prostszy ksztalt argumentow (brak trybu
    !! `check/lint/build/fmt` typu "pierwszy pozycyjny to plik +
    !! wspolne flagi") - wlasny blok, analogicznie do `lsp` powyzej.
    if first == "emit-module" [
        let _rest_em = argv.remove(0)
        let value_flags_em: List<Str> = ["-o", "--output", "--module-name"]
        let src_em = first_positional(argv, value_flags_em)
        if src_em == "" [
            log("hackerc emit-module: brak wymaganego argumentu 'source'")
            exit(1)
        ]
        let out_em = ""
        match find_flag_value(argv, "-o", "--output") [
            Some(v) -> [
                out_em = v
            ]
            None -> [
            ]
        ]
        if out_em == "" [
            log("hackerc emit-module: brak wymaganej flagi -o/--output")
            exit(1)
        ]
        let mod_name_em = "mod"
        match find_flag_value(argv, "", "--module-name") [
            Some(v) -> [
                mod_name_em = v
            ]
            None -> [
            ]
        ]
        exit(cmd_emit_module(src_em, out_em, mod_name_em))
    ]

    if first == "kotlin" [
        let _rest_k = argv.remove(0)
        let src_k = first_positional(argv, ["-o", "--output"])
        if src_k == "" [
            log("hackerc kotlin: brak wymaganego argumentu 'source'")
            exit(1)
        ]
        let out_k = ""
        match find_flag_value(argv, "-o", "--output") [
            Some(v) -> [
                out_k = v
            ]
            None -> [
            ]
        ]
        exit(cmd_kotlin(src_k, out_k))
    ]

    if first == "js" or first == "website" [
        let _rest_j = argv.remove(0)
        let src_j = first_positional(argv, ["-o", "--output"])
        if src_j == "" [
            log("hackerc " + first + ": brak wymaganego argumentu 'source'")
            exit(1)
        ]
        let out_j = ""
        match find_flag_value(argv, "-o", "--output") [
            Some(v) -> [
                out_j = v
            ]
            None -> [
                let unused = 0
            ]
        ]
        exit(cmd_js(src_j, out_j, first == "website"))
    ]

    if first == "check" or first == "lint" or first == "build" or first == "fmt" [
        let _rest = argv.remove(0)
        let value_flags: List<Str> = ["-o", "--output", "--crate-name", "--libs-root", "--bootstrap-root", "--bin-name"]
        let src = first_positional(argv, value_flags)
        if src == "" [
            log("hackerc " + first + ": brak wymaganego argumentu 'source'")
            exit(1)
        ]

        if first == "check" [
            exit(cmd_check(src))
        ]
        if first == "lint" [
            exit(cmd_lint(src))
        ]
        if first == "fmt" [
            let dest = ""
            match find_flag_value(argv, "-o", "--output") [
                Some(v) -> [
                    dest = v
                ]
                None -> [
                ]
            ]
            exit(cmd_fmt(src, dest, has_flag(argv, "--check")))
        ]
        !!! `use <lang:javascript>` / `use <mode:website>` w pliku wejsciowym
        !!! zmieniaja cel `build` (JavaScript / strona zamiast crate'a Rust).
        let js_target = js_build_target(src.clone())
        if js_target != "" [
            let js_out = ""
            match find_flag_value(argv, "-o", "--output") [
                Some(v) -> [
                    js_out = v
                ]
                None -> [
                    let unused = 0
                ]
            ]
            exit(cmd_js(src.clone(), js_out, js_target == "website"))
        ]
        !!! first == "build"
        let out_dir = default_build_out_dir(src.clone())
        match find_flag_value(argv, "-o", "--output") [
            Some(v) -> [
                out_dir = v
            ]
            None -> [
            ]
        ]
        let crate_name = "hackerscript_app"
        match find_flag_value(argv, "", "--crate-name") [
            Some(v) -> [
                crate_name = v
            ]
            None -> [
            ]
        ]
        let libs_root: Option<Str> = none()
        match find_flag_value(argv, "", "--libs-root") [
            Some(v) -> [
                libs_root = some(v)
            ]
            None -> [
            ]
        ]
        let bootstrap_root: Option<Str> = none()
        match find_flag_value(argv, "", "--bootstrap-root") [
            Some(v) -> [
                bootstrap_root = some(v)
            ]
            None -> [
            ]
        ]
        !! DODANE w tej rundzie (patrz project.hcs::find_bit_cache_root) -
        !! analogiczne do --libs-root/--bootstrap-root, none() = auto-wykrywanie.
        let bit_root: Option<Str> = none()
        match find_flag_value(argv, "", "--bit-root") [
            Some(v) -> [
                bit_root = some(v)
            ]
            None -> [
            ]
        ]
        !! ROZBUDOWA (ta runda) - `hackerc build --library` (przekazywane
        !! przez `bit build --library`, patrz TargetLibrary w
        !! `bit`) - `[lib] crate-type = ["rlib"]` zamiast
        !! `[[bin]]`, patrz `project.hcs::cargo_toml_text`.
        let force_library = has_flag(argv, "--library")
        !! ROZBUDOWA (ta runda) - `--bin-name <nazwa>` (przekazywane
        !! przez `bit build`, patrz `docs/BIT.md`, "Plan:
        !! multi-binarki na czlonka") - pisze do `src/bin/<nazwa>.rs` i
        !! DOPISUJE `[[bin]]` do juz istniejacego Cargo.toml, zamiast
        !! generowac calosc od nowa (patrz `project.hcs::build_project`).
        let bin_name: Option<Str> = none()
        match find_flag_value(argv, "", "--bin-name") [
            Some(v) -> [
                bin_name = some(v)
            ]
            None -> [
            ]
        ]
        !! DODANE (ta runda, patrz docs/MULTI_VERSION.md) - `--version-map
        !! "0.4=/sciezka1;0.5=/sciezka2"`, wstawiane WYLACZNIE przez
        !! `bit build` (patrz bit) - reczne
        !! wywolanie `hackerc build` bez tej flagi dziala DOKLADNIE jak
        !! dotad (`dict()` pusty = brak delegacji miedzywersyjnej).
        let version_binaries: Dict<Str, Str> = dict()
        match find_flag_value(argv, "", "--version-map") [
            Some(vm) -> [
                version_binaries = parse_version_map(vm)
            ]
            None -> [
            ]
        ]
        exit(cmd_build(src, out_dir, crate_name, libs_root, bootstrap_root, bit_root, force_library, bin_name, version_binaries))
    ]

    if first == "hlib" [
        let _rest = argv.remove(0)
        exit(cmd_hlib(argv))
    ]

    !!! Tryb kompatybilnosci wstecznej (parytet z `legacy` ArgumentParser
    !!! w Pythonie) - `first` nie jest zadna znana podkomenda, wiec
    !!! traktujemy CALE argv jako "plik [-o wyjscie]" tryb legacy.
    if has_flag(argv, "--version") [
        log("hackerc " + VERSION)
        exit(0)
    ]
    let legacy_src = first_positional(argv, ["-o", "--output"])
    if legacy_src == "" [
        print_usage()
        exit(1)
    ]
    let legacy_out = ""
    match find_flag_value(argv, "-o", "--output") [
        Some(v) -> [
            legacy_out = v
        ]
        None -> [
        ]
    ]
    exit(cmd_transpile_legacy(legacy_src, legacy_out))
]
