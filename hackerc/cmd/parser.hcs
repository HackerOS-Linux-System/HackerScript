include <lexer>
include <ast_nodes>
include <diagnostics>

struct Parser [
    toks: List<Token>,
    pos: Int,
    !! DODANE (ta runda, patrz docs/ROADMAP.md sekcja 1 - "brak
    !! prawdziwego ParseError"). Kazdy `expect()`/inny punkt bledu
    !! parsera DOPISUJE tutaj `Diagnostic` (severity "error") oprocz
    !! (albo, docelowo, zamiast) samego `log()` na stdout. Parser SAM W
    !! SOBIE nadal robi odzyskiwanie po bledzie best-effort (nie
    !! przerywa w miejscu - jak dotad, jak wiekszosc prawdziwych
    !! parserow z odzyskiwaniem po bledach, np. `rustc`), ale te bledy
    !! sa TERAZ prawdziwymi, ustrukturyzowanymi diagnostykami z
    !! poprawnym `line`/`col` (Token JUZ je ma od dawna - `struct Token`
    !! w lexer.hcs - brakowalo tylko przekazania ich DALEJ zamiast
    !! zgubienia w golym `log()`), a nie tylko tekstem na konsoli.
    !! Uzyte przez nowe `parse_checked()`/`ParseResult` nizej -
    !! wywolujacy MOZE je teraz wykryc i pokazac przez `render_many`
    !! (ten sam kolorowy renderer co bledy typechecka), zamiast je
    !! przeoczyc pomiedzy zwyklym `log()` budowy.
    errors: List<Diagnostic>,
    stmt_lines: List<Int>,
    stmt_cols: List<Int>,
    stmt_tags: List<Str>,
    !! (0.7) instrukcje dopisane przez desugaring (np. `let (a, b) = e`) - petle
    !! blokow oprozniaja je zaraz po instrukcji, która je wytworzyła.
    pending: List<Stmt>,
    tmp_counter: Int
]

impl Parser [
    fun cur(self) -> Token [
        end self.toks[self.pos]
    ]

    fun at_end(self) -> Bool [
        end self.cur().kind == Eof
    ]

    fun advance(self) -> Token [
        let t = self.toks[self.pos]
        if self.pos < self.toks.len() - 1 [
            self.pos = self.pos + 1
        ]
        end t
    ]

    !!! `value: Option<Str>` odpowiada Pythonowemu `value: str | None =
    !!! None` - `none()` = "dopasuj tylko po `kind`", `some(x)` = "i
    !!! po wartosci". `kind.clone()` PONIZEJ jest KONIECZNE, nie
    !!! kosmetyczne: `kind: TokKind` to ZNANY enum, wiec ten codegen
    !!! ZAWSZE przekazuje go jako `&TokKind` (patrz `_is_refable` w
    !!! codegen.py - kazdy enum/struct/Str/List jest "refable"), a
    !!! porownanie `t.kind != kind` bylo by wtedy `TokKind != &TokKind`
    !!! - PRAWDZIWA niezgodnosc typow w Rust (derive'owany `PartialEq`
    !!! daje TYLKO `PartialEq<Self>`, nie `PartialEq<&Self>`), znaleziona
    !!! i naprawiona w TEJ sesji. `.clone()` na referencji auto-derefuje
    !!! sie (w przeciwienstwie do operatorow `==`/`!=`, wywolania metod
    !!! W RUST auto-derefuja odbiornik) i zwraca WLASCIWY, owned
    !!! `TokKind`.
    fun check(self, kind: TokKind, value: Option<Str>) -> Bool [
        let t = self.cur()
        if t.kind != kind.clone() [
            end false
        ]
        match value [
            Some(v) -> [
                end t.value == v
            ]
            None -> [
                end true
            ]
        ]
    ]

    fun match_tok(self, kind: TokKind, value: Option<Str>) -> Option<Token> [
        if self.check(kind, value) [
            end some(self.advance())
        ]
        end none()
    ]

    !!! DODANE (ta runda) - jeden wspolny punkt zapisu bledu parsera:
    !!! dopisuje `Diagnostic("error", "E0100", ...)` do `self.errors`
    !!! (patrz `Parser.errors` wyzej) I zachowuje stary `log()` (parytet
    !!! wsteczny - istniejacy kod/testy polegajace na tym, ze komunikat
    !!! ladowal na stdout, nadal dostaja to samo, teraz DODATKOWO
    !!! ustrukturyzowane). `length` - dlugosc podswietlenia w
    !!! `render_many` (patrz diagnostics.hcs); dla pojedynczego tokenu
    !!! to zwykle po prostu dlugosc jego tekstu.
    fun push_error(self, message: Str, line: Int, col: Int, length: Int) [
        self.errors.push(Diagnostic("error", "E0100", message, line, col, max_int(1, length), ""))
        elog("[hackerc-self] parser: " + message + " w linii " + (line as Str) + ", kolumna " + (col as Str))
    ]

    !!! Bez prawdziwego `ParseError`/wyjatkow w tej wersji bootstrapu
    !!! (patrz "Ograniczenia") - gdy oczekiwany token nie wystepuje,
    !!! `log`-uje ostrzezenie i i tak KONSUMUJE biezacy token (best-effort,
    !!! nie zatrzymuje parsowania) zamiast rzucac `ParseError` jak w
    !!! parser.py.
    fun expect(self, kind: TokKind, value: Option<Str>) -> Token [
        if not self.check(kind, value) [
            let bad = self.cur()
            self.push_error("nieoczekiwany token '" + bad.value + "'", bad.line, bad.col, bad.value.len())
        ]
        end self.advance()
    ]

    fun skip_newlines(self) [
        while self.check(Newline, none()) or self.check(LineComment, none()) [
            self.advance()
        ]
    ]

    !!! Jak `skip_newlines`, ale ZWRACA tekst napotkanych komentarzy `!`
    !!! (w kolejnosci wystapienia) zamiast je odrzucac - wywolujacy
    !!! doczepia je do nastepnej instrukcji (patrz "Ograniczenia":
    !!! `_leading_comments`/`hackerc fmt` nie sa jeszcze uzyte tutaj,
    !!! sam mechanizm zbierania jest juz gotowy).
    fun skip_newlines_collect_comments(self) -> List<Str> [
        let comments: List<Str> = []
        while true [
            if self.check(Newline, none()) [
                self.advance()
            ] elif self.check(LineComment, none()) [
                comments.push(self.advance().value)
            ] else [
                break
            ]
        ]
        end comments
    ]

    !!! -- program --------------------------------------------------------

    fun parse_program(self) -> Program [
        let body: List<Stmt> = []
        self.skip_newlines_collect_comments()
        while not self.at_end() [
            let stmt = self.parse_statement()
            body.push(stmt)
            self.drain_pending(body)
            self.skip_newlines_collect_comments()
        ]
        end Program(body, self.stmt_lines.clone(), self.stmt_cols.clone(), self.stmt_tags.clone())
    ]

    !!! -- instrukcje -------------------------------------------------------

    fun drain_pending(self, into: List<Stmt>) [
        if self.pending.len() > 0 [
            let k = 0
            while k < self.pending.len() [
                into.push(self.pending[k].clone())
                k = k + 1
            ]
            self.pending = []
        ]
    ]

    fun parse_block(self) -> List<Stmt> [
        self.expect(Open, none())
        self.skip_newlines_collect_comments()
        let stmts: List<Stmt> = []
        while not self.check(Close, none()) and not self.at_end() [
            let stmt = self.parse_statement()
            stmts.push(stmt)
            self.drain_pending(stmts)
            self.skip_newlines_collect_comments()
        ]
        self.expect(Close, none())
        end stmts
    ]

    !!! 0.6: opakowanie zapisujace pozycje instrukcji (pre-order). Slot jest
    !!! rezerwowany PRZED parsowaniem, wiec zagniezdzone instrukcje trafiaja po
    !!! swoim rodzicu; tag uzupelniany po zbudowaniu wezla.
    fun parse_statement(self) -> Stmt [
        let first = self.cur()
        let slot = self.stmt_lines.len()
        self.stmt_lines.push(first.line)
        self.stmt_cols.push(first.col)
        self.stmt_tags.push("")
        let parsed = self.parse_statement_inner()
        self.stmt_tags[slot] = stmt_tag(parsed.clone())
        end parsed
    ]

    fun parse_statement_inner(self) -> Stmt [
        let t = self.cur()

        if t.kind == DocComment [
            self.advance()
            end ExprStmt(StringLit(t.value, true))
        ]

        if t.kind == Keyword [
            let kw = t.value
            if kw == "using" [
                end self.parse_using()
            ]
            if kw == "get" [
                end self.parse_get_import()
            ]
            !! ROZBUDOWA - `use <lang:kotlin>`/`use <crosscompile>`/`use <arc:...>`
            if kw == "use" [
                end self.parse_use_directive()
            ]
            !! ROZBUDOWA (async) - `async fun nazwa(...) [ ... ]`
            if kw == "async" [
                self.advance()
                if self.check(Keyword, some("pub")) [
                    self.advance()
                    let inner_a = self.parse_fun_ex(true)
                    match inner_a [
                        FunDecl(an, ap, ar, ab, aip, atp, aia) -> [
                            end FunDecl(an, ap, ar, ab, true, atp, aia)
                        ]
                        _ -> [
                            end inner_a
                        ]
                    ]
                ]
                end self.parse_fun_ex(true)
            ]
            if kw == "include" [
                end self.parse_include()
            ]
            if kw == "let" [
                end self.parse_let(false)
            ]
            if kw == "const" [
                end self.parse_let(true)
            ]
            if kw == "pub" [
                self.advance()
                !! `pub` jest czescia TEJ SAMEJ instrukcji - bez nowego slotu pozycji.
                let inner = self.parse_statement_inner()
                match inner [
                    FunDecl(name, params, ret_type, body, is_pub, type_params, fn_is_async) -> [
                        end FunDecl(name, params, ret_type, body, true, type_params, fn_is_async)
                    ]
                    _ -> [
                        end inner
                    ]
                ]
            ]
            if kw == "region" [
                end self.parse_region()
            ]
            if kw == "fun" [
                end self.parse_fun()
            ]
            if kw == "if" [
                end self.parse_if()
            ]
            if kw == "while" [
                end self.parse_while()
            ]
            if kw == "for" [
                end self.parse_for()
            ]
            if kw == "end" [
                self.advance()
                let value: Option<Expr> = none()
                if not self.check(Newline, none()) and not self.check(Close, none()) [
                    value = some(self.parse_expr())
                ]
                end ReturnStmt(value)
            ]
            if kw == "break" [
                self.advance()
                end BreakStmt
            ]
            if kw == "continue" [
                self.advance()
                end ContinueStmt
            ]
            if kw == "direct" [
                end self.parse_direct()
            ]
            if kw == "manual" [
                end self.parse_manual()
            ]
            if kw == "gc" [
                end self.parse_gc_pragma()
            ]
            if kw == "struct" [
                end self.parse_struct()
            ]
            if kw == "enum" [
                end self.parse_enum()
            ]
            if kw == "impl" [
                end self.parse_impl()
            ]
            if kw == "trait" [
                end self.parse_trait()
            ]
            if kw == "defer" [
                !!! (0.7) `defer [ ... ]` -> `__defer__(fn() [ ... ])` (strażnik RAII)
                self.advance()
                let dbody = self.parse_block()
                end ExprStmt(Call(IdentExpr("__defer__"), [Lambda([], none(), dbody)]))
            ]
            if kw == "match" [
                end self.parse_match()
            ]
        ]

        !! wyrazenie / przypisanie
        let expr = self.parse_expr()
        if self.cur().kind == Op and (self.cur().value == "=" or self.cur().value == "+=" or self.cur().value == "-=" or self.cur().value == "*=" or self.cur().value == "/=") [
            let op = self.advance().value
            let value = self.parse_expr()
            end AssignStmt(expr, op, value)
        ]
        end ExprStmt(expr)
    ]

    !!! ROZBUDOWA - `use <klucz>` albo `use <klucz:wartosc[::wiecej]>`.
    !!! Znane klucze (walidowane w typecheck.hcs/project.hcs, nie tu):
    !!! `lang:kotlin`, `lang:javascript`, `mode:website`, `crosscompile`,
    !!! `arc:<architektura>`.
    fun parse_use_directive(self) -> Stmt [
        self.expect(Keyword, some("use"))
        self.expect(LAngle, none())
        let key = self.read_angle_segment()
        let value: Option<Str> = none()
        if self.check(Colon, none()) [
            self.advance()
            let v = self.read_angle_segment()
            while self.check(DColon, none()) [
                self.advance()
                v = v + "::" + self.read_angle_segment()
            ]
            value = some(v)
        ]
        self.expect(RAngle, none())
        end UseStmt(key, value)
    ]

    fun parse_using(self) -> Stmt [
        self.expect(Keyword, some("using"))
        self.expect(LAngle, none())
        let version_parts = ""
        while not self.check(RAngle, none()) [
            version_parts = version_parts + self.advance().value
        ]
        self.expect(RAngle, none())
        end UsingStmt(version_parts)
    ]

    !!! Czyta tekst az do napotkania '::', '>' lub ':' (na poziomie top) -
    !!! parytet z `_read_angle_segment` w parser.py.
    fun read_angle_segment(self) -> Str [
        let parts = ""
        while not (self.check(DColon, none()) or self.check(RAngle, none()) or self.check(Colon, none())) [
            parts = parts + self.advance().value
        ]
        end parts
    ]

    fun parse_get_import(self) -> Stmt [
        self.expect(Keyword, some("get"))
        self.expect(LAngle, none())
        let source = self.read_angle_segment()
        !! 0.6 (naprawa): lekser dopisuje `_` do zarezerwowanych slow Rusta
        !! (`extern` -> `extern_`), wiec `get <extern:m>` nie rozpoznawalo
        !! zrodla (E0003 "nieznane zrodlo 'extern_'") - docs/showcase i
        !! docs/ffi-demo nie przechodzily `check`. Zrodlo to nazwa, nie
        !! identyfikator Rusta - cofamy przyrostek.
        if source == "extern_" [
            source = "extern"
        ]
        if source == "selfhost" [
            !!! `get <selfhost:...>` jest zablokowane (na wyrazne
            !!! zyczenie uzytkownika) - uzyj `include <plik>` zamiast
            !!! tego. `parser.hcs` (w odroznieniu od `parser.py`) NIE MA
            !!! wyjatkow/`Result` dla bledow parsera (patrz "Ograniczenia"
            !!! - best-effort, `log()` i kontynuacja) - to jedyny sposob
            !!! zasygnalizowania tego bledu W TYM PLIKU. `parser.py` (uzywany
            !!! dzis jako stage0) DAJE prawdziwy blad skladni (ParseError).
            self.push_error("'get <selfhost:...>' jest zablokowane - uzyj 'include <plik>' zamiast tego", self.cur().line, self.cur().col, 1)
        ]
        !!! `get <mold>` / `get <mold::1.2>` - BEZ `zrodlo:`. Zrodlo to wtedy
        !!! "auto": `Discovery::normalize_last_file` (project.hcs) przepisuje je
        !!! na "hlib" (gdy istnieje `.hlib`) albo "bit" (gdy jest biblioteka
        !!! bit) ZARAZ po sparsowaniu pliku, wiec dalsze fazy (codegen,
        !!! nazwy modulow) widza tylko prawdziwe zrodlo.
        let name = ""
        if self.check(Colon, none()) [
            self.advance()
            name = self.read_angle_segment()
        ] else [
            name = source
            source = "auto"
            if name == "" [
                self.push_error("'get <>' - oczekiwano nazwy biblioteki, np. 'get <mold>'", self.cur().line, self.cur().col, 1)
            ]
        ]
        let version: Option<Str> = none()
        if self.check(DColon, none()) [
            self.advance()
            version = some(self.read_angle_segment())
        ]
        self.expect(RAngle, none())

        !!! ZMIANA 0.3 - `get <extern:sciezka> use <static|dynamic>`:
        !!! `use <...>` istnieje TYLKO za `get <extern:...>` (inne
        !!! zrodla - std/core/crates/pypi/npm/jsr/bit/c/cpp - nie maja
        !!! trybu linkowania w tym miejscu skladni), i zapisuje tryb w
        !!! tym samym slocie co `::wersja` (patrz komentarz przy
        !!! `GetImportStmt` w ast_nodes.hcs) - `extern` nigdy nie ma
        !!! obu naraz, wiec kolizji nie ma.
        if source == "extern" and self.check(Keyword, some("use")) [
            self.advance()
            self.expect(LAngle, none())
            let link_mode = self.read_angle_segment()
            if link_mode == "static_" [
                !! (0.6) j.w.: `static` to slowo zarezerwowane Rusta -> `static_`.
                link_mode = "static"
            ]
            version = some(link_mode)
            self.expect(RAngle, none())
        ]

        let details: List<Str> = []
        if self.check(Keyword, some("import")) [
            self.advance()
            self.expect(LAngle, none())
            details.push(self.read_angle_segment())
            while self.check(DColon, none()) [
                self.advance()
                details.push(self.read_angle_segment())
            ]
            self.expect(RAngle, none())
        ]

        end GetImportStmt(source, name, version, details)
    ]

    !! `include <sciezka>` - parytet z `parse_include()` (parser.py) -
    !! prostsze niz `get`: jeden segment, bez `source:`/`::wersja`/
    !! `import <details>`. NOWOSC 0.4 - drugi ksztalt, `include
    !! <work:czlonek[::plik]>` (wykryty po natrafieniu na `Colon` PO
    !! pierwszym segmencie, dokladnie jak w `parse_get_import()`
    !! nizej) - "prawdziwe" statyczne linkowanie zrodla INNEGO czlonka
    !! workspace, bez kopiowania plikow (patrz `resolve_include_path`
    !! w project.hcs, ktora rozpoznaje ten ksztalt po prefiksie
    !! "work:" w zwroconym Str). Rekonstruujemy jeden, plaski string
    !! ("work:czlonek" albo "work:czlonek::plik") zamiast dodawac nowe
    !! pole do `IncludeStmt` - `IncludeStmt` zostaje jednym `Str`, tak
    !! jak bylo, zero zmian w kazdym innym miejscu, ktore go dopasowuje
    !! (`project.hcs`/`codegen.hcs`).
    fun parse_include(self) -> Stmt [
        self.expect(Keyword, some("include"))
        self.expect(LAngle, none())
        let first = self.read_angle_segment()
        if self.check(Colon, none()) [
            self.advance()
            let member = self.read_angle_segment()
            let raw = "work:" + member
            if self.check(DColon, none()) [
                self.advance()
                let sub = self.read_angle_segment()
                raw = raw + "::" + sub
            ]
            self.expect(RAngle, none())
            end IncludeStmt(raw)
        ]
        self.expect(RAngle, none())
        end IncludeStmt(first)
    ]

    fun parse_type(self) -> TypeRef [
        if self.check(LParen, none()) [
            !!! (0.7) typ krotki `(A, B, ...)`
            self.advance()
            let elems: List<TypeRef> = []
            while not self.check(RParen, none()) and not self.at_end() [
                elems.push(self.parse_type())
                if not self.check(Comma, none()) [
                    break
                ]
                self.advance()
            ]
            self.expect(RParen, none())
            end make_tuple_type(elems)
        ]
        if self.check(Ident, some("Fn")) and self.pos + 1 < self.toks.len() and self.toks[self.pos + 1].kind == LParen [
            !!! (0.7) typ domkniecia `Fn(A, B) -> R`
            self.advance()
            self.advance()
            let fparams: List<TypeRef> = []
            while not self.check(RParen, none()) and not self.at_end() [
                fparams.push(self.parse_type())
                if not self.check(Comma, none()) [
                    break
                ]
                self.advance()
            ]
            self.expect(RParen, none())
            let fret = TypeRef("TupleEnd", none(), none())
            if self.check(Op, some("->")) [
                self.advance()
                fret = self.parse_type()
            ]
            end TypeRef("Fn", some(make_tuple_type(fparams)), some(fret))
        ]
        let name_tok = self.advance()
        let generic: Option<TypeRef> = none()
        let generic2: Option<TypeRef> = none()
        if self.check(LAngle, none()) [
            self.advance()
            generic = some(self.parse_type())
            if self.check(Comma, none()) [
                self.advance()
                generic2 = some(self.parse_type())
            ]
            self.expect(RAngle, none())
        ]
        end TypeRef(name_tok.value, generic, generic2)
    ]

    fun parse_let(self, is_const: Bool) -> Stmt [
        self.advance()
        if self.check(LParen, none()) [
            !!! (0.7) `let (a, b) = wyrazenie` -> `let __tupN = wyrazenie` + `let a = __tupN.0` ...
            let lt = self.cur()
            self.advance()
            let names: List<Str> = []
            while not self.check(RParen, none()) and not self.at_end() [
                names.push(self.expect(Ident, none()).value)
                if not self.check(Comma, none()) [
                    break
                ]
                self.advance()
            ]
            self.expect(RParen, none())
            let tup_value: Option<Expr> = none()
            if self.check(Op, some("=")) [
                self.advance()
                tup_value = some(self.parse_expr())
            ]
            self.tmp_counter = self.tmp_counter + 1
            let tmp_name = "__tup" + (self.tmp_counter as Str)
            let k = 0
            while k < names.len() [
                self.stmt_lines.push(lt.line)
                self.stmt_cols.push(lt.col)
                self.stmt_tags.push("let")
                if names[k] != "_" [
                    self.pending.push(LetStmt(names[k].clone(), none(), some(Attr(IdentExpr(tmp_name.clone()), (k as Str))), false))
                ] else [
                    self.pending.push(LetStmt("__hks_unused" + (self.tmp_counter as Str) + "_" + (k as Str), none(), some(Attr(IdentExpr(tmp_name.clone()), (k as Str))), false))
                ]
                k = k + 1
            ]
            end LetStmt(tmp_name, none(), tup_value, false)
        ]
        let name = self.expect(Ident, none()).value
        let type_ref: Option<TypeRef> = none()
        if self.check(Colon, none()) [
            self.advance()
            type_ref = some(self.parse_type())
        ]
        let value: Option<Expr> = none()
        if self.check(Op, some("=")) [
            self.advance()
            value = some(self.parse_expr())
        ]
        end LetStmt(name, type_ref, value, is_const)
    ]

    fun parse_params(self) -> List<Param> [
        let params: List<Param> = []
        self.expect(LParen, none())
        while not self.check(RParen, none()) [
            if self.check(Keyword, some("self")) [
                self.advance()
                params.push(Param("self", none(), none()))
                if not self.check(Comma, none()) [
                    break
                ]
                self.advance()
            ] else [
                let pname = self.expect(Ident, none()).value
                let ptype: Option<TypeRef> = none()
                if self.check(Colon, none()) [
                    self.advance()
                    ptype = some(self.parse_type())
                ]
                let pdefault: Option<Expr> = none()
                if self.check(Op, some("=")) [
                    self.advance()
                    pdefault = some(self.parse_expr())
                ]
                params.push(Param(pname, ptype, pdefault))
                if not self.check(Comma, none()) [
                    break
                ]
                self.advance()
            ]
        ]
        self.expect(RParen, none())
        end params
    ]

    !!! Opcjonalna lista parametrow generycznych `<T, U>` po nazwie
    !!! struct/fun/enum/impl.
    fun parse_type_params(self) -> List<Str> [
        let params: List<Str> = []
        if not self.check(LAngle, none()) [
            end params
        ]
        self.advance()
        while not self.check(RAngle, none()) [
            let pname = self.expect(Ident, none()).value
            params.push(pname.clone())
            if self.check(Colon, none()) [
                !!! (0.7) ograniczenia: `<T: Show + Clone>`
                self.advance()
                let bound = self.expect(Ident, none()).value
                while self.check(Op, some("+")) [
                    self.advance()
                    bound = bound + "+" + self.expect(Ident, none()).value
                ]
                params.push("@bound:" + pname + ":" + bound)
            ]
            if not self.check(Comma, none()) [
                break
            ]
            self.advance()
        ]
        self.expect(RAngle, none())
        end params
    ]

    fun parse_fun(self) -> Stmt [
        end self.parse_fun_ex(false)
    ]

    !! ROZBUDOWA (async) - wspolna implementacja dla `fun` i `async fun`.
    fun parse_fun_ex(self, is_async: Bool) -> Stmt [
        self.expect(Keyword, some("fun"))
        let name = self.expect(Ident, none()).value
        let type_params = self.parse_type_params()
        let params = self.parse_params()
        let ret_type: Option<TypeRef> = none()
        if self.check(Op, some("->")) [
            self.advance()
            ret_type = some(self.parse_type())
        ]
        let body = self.parse_block()
        end FunDecl(name, params, ret_type, body, false, type_params, is_async)
    ]

    fun parse_if(self) -> Stmt [
        self.expect(Keyword, some("if"))
        let cond = self.parse_expr()
        let body = self.parse_block()
        let elifs: List<ElifArm> = []
        let else_body: Option<List<Stmt>> = none()
        self.skip_newlines_soft()
        while self.check(Keyword, some("elif")) [
            self.advance()
            let econd = self.parse_expr()
            let ebody = self.parse_block()
            elifs.push(ElifArm(econd, ebody))
            self.skip_newlines_soft()
        ]
        if self.check(Keyword, some("else")) [
            self.advance()
            else_body = some(self.parse_block())
        ]
        end IfStmt(cond, body, elifs, else_body)
    ]

    !!! Podglada czy po newline'ach jest `elif`/`else` (zeby obsluzyc
    !!! `else` na nowej linii po `]`) - cofa sie jesli nie.
    fun skip_newlines_soft(self) [
        let save = self.pos
        while self.check(Newline, none()) or self.check(LineComment, none()) [
            self.advance()
        ]
        if not (self.check(Keyword, some("elif")) or self.check(Keyword, some("else"))) [
            self.pos = save
        ]
    ]

    fun parse_while(self) -> Stmt [
        self.expect(Keyword, some("while"))
        let cond = self.parse_expr()
        let body = self.parse_block()
        end WhileStmt(cond, body)
    ]

    fun parse_for(self) -> Stmt [
        self.expect(Keyword, some("for"))
        let var = self.expect(Ident, none()).value
        if self.check(Comma, none()) [
            !! (0.6) `for k, v in dict.items()` - dwie zmienne, zapisane w
            !! `ForStmt` jako jedna nazwa `"k, v"` (patrz `for_var_names`).
            self.advance()
            let second = self.expect(Ident, none()).value
            var = var + ", " + second
        ]
        self.expect(Keyword, some("in"))
        let iterable = self.parse_expr()
        let body = self.parse_block()
        end ForStmt(var, iterable, body)
    ]

    !!! ZMIANA 0.3 - `region [ ... ]` zastepuje stare `extern "lib" fun
    !!! nazwa(...)`. Jedna deklaracja `region` moze niesc DOWOLNIE
    !!! WIELE sygnatur (zamiast jednej naraz jak wczesniej) i jest
    !!! zwiazana z ostatnim poprzedzajacym `get <extern:...> use
    !!! <tryb>` w tym samym pliku (wiazanie robione dopiero w
    !!! `codegen.hcs::gen_region`, patrz `pending_extern_lib`/
    !!! `pending_extern_mode` - parser NIE sprawdza tego powiazania,
    !!! best-effort jak reszta bootstrapu, patrz "Ograniczenia").
    !!! Kazda linia wewnatrz to goła sygnatura `fun nazwa(params) ->
    !!! Typ` (typ zwracany opcjonalny) BEZ ciala i bez `[ ... ]` -
    !!! parytet skladniowy z `parse_params()`/`parse_type()`
    !!! uzywanymi normalnie w `parse_fun()`.
    fun parse_region(self) -> Stmt [
        self.expect(Keyword, some("region"))
        self.expect(Open, none())
        self.skip_newlines()
        let sigs: List<ExternSig> = []
        while not self.check(Close, none()) and not self.at_end() [
            self.expect(Keyword, some("fun"))
            let name = self.expect(Ident, none()).value
            let params = self.parse_params()
            let ret_type: Option<TypeRef> = none()
            if self.check(Op, some("->")) [
                self.advance()
                ret_type = some(self.parse_type())
            ]
            sigs.push(ExternSig(name, params, ret_type))
            self.skip_newlines()
        ]
        self.expect(Close, none())
        end RegionBlock(sigs)
    ]

    !!! `direct[]` jest wyjatkowe: w prawdziwym hackerc surowy tekst
    !!! pomiedzy `[`/`]` jest wyciagany PRZED tokenizacja (patrz
    !!! transpiler.py::`_extract_direct_blocks`) - Parser normalnie
    !!! NIGDY nie widzi tokenow `direct` (parytet: `parse_direct` w
    !!! parser.py TEZ tylko rzuca `ParseError` mowiacy "to powinno byc
    !!! obsluzone na etapie preprocessing"). Ta metoda jest wiec
    !!! siecia bezpieczenstwa, nie realna implementacja - patrz
    !!! "Ograniczenia".
    fun parse_direct(self) -> Stmt [
        self.advance()
        self.push_error("'direct' powinno byc wyciagniete na etapie preprocessing, nie parsowane", self.cur().line, self.cur().col, 1)
        end DirectBlock([])
    ]

    fun parse_manual(self) -> Stmt [
        self.expect(Keyword, some("manual"))
        let body = self.parse_block()
        end ManualBlock(body)
    ]

    !! Skladnia pragmy to `gc:use::tryb` (patrz `gen_toplevel`/
    !! `fmt_stmt` -> `"gc:use::" + mode` w codegen.hcs/formatter.hcs) -
    !! `Colon` (":"), DOWOLNY token (typowo identyfikator "use", ale
    !! parser go nie sprawdza - patrz `self.advance()` bez `expect`),
    !! potem `DColon` ("::") i dopiero `tryb`.
    fun parse_gc_pragma(self) -> Stmt [
        self.expect(Keyword, some("gc"))
        self.expect(Colon, none())
        self.advance()
        self.expect(DColon, none())
        let mode = self.advance().value
        end GcPragma(mode)
    ]

    fun parse_struct(self) -> Stmt [
        self.expect(Keyword, some("struct"))
        let name = self.expect(Ident, none()).value
        let type_params = self.parse_type_params()
        self.expect(Open, none())
        self.skip_newlines()
        let fields: List<Param> = []
        while not self.check(Close, none()) and not self.at_end() [
            let fname = self.expect(Ident, none()).value
            self.expect(Colon, none())
            let ftype = self.parse_type()
            fields.push(Param(fname, some(ftype), none()))
            if self.check(Comma, none()) [
                self.advance()
            ]
            self.skip_newlines()
        ]
        self.expect(Close, none())
        end StructDecl(name, fields, type_params)
    ]

    fun parse_enum(self) -> Stmt [
        self.expect(Keyword, some("enum"))
        let name = self.expect(Ident, none()).value
        let type_params = self.parse_type_params()
        self.expect(Open, none())
        self.skip_newlines()
        let variants: List<EnumVariant> = []
        while not self.check(Close, none()) and not self.at_end() [
            let vname = self.expect(Ident, none()).value
            let vfields: List<TypeRef> = []
            if self.check(LParen, none()) [
                self.advance()
                while not self.check(RParen, none()) [
                    vfields.push(self.parse_type())
                    if not self.check(Comma, none()) [
                        break
                    ]
                    self.advance()
                ]
                self.expect(RParen, none())
            ]
            variants.push(EnumVariant(vname, vfields))
            if self.check(Comma, none()) [
                self.advance()
            ]
            self.skip_newlines()
        ]
        self.expect(Close, none())
        end EnumDecl(name, variants, type_params)
    ]

    !!! `impl Nazwa [ fun metoda(self, ...) -> Typ [ ... ] ... ]`.
    !!! Komentarze `!!` przed metoda sa dziś ZBIERANE (`pending_doc`,
    !!! parytet z `pending_doc` w parser.py), ale NIE MA gdzie ich
    !!! doczepic (`FunDecl` w tym AST nie ma pola
    !!! `_leading_doc_comments`, patrz "Ograniczenia" w ast_nodes.hcs) -
    !!! sa wiec dzis odrzucane po zebraniu, TYLKO zeby nie wywolac
    !!! `expect(Keyword, "fun")` na tokenie `DocComment` i nie
    !!! wyprodukowac spurious ostrzezenia.
    fun parse_impl(self) -> Stmt [
        self.expect(Keyword, some("impl"))
        let struct_name = self.expect(Ident, none()).value
        let impl_trait = ""
        if self.check(Keyword, some("for")) [
            !!! (0.7) `impl Trait for Typ [ ... ]`
            self.advance()
            impl_trait = struct_name.clone()
            struct_name = self.expect(Ident, none()).value
        ]
        let type_params = self.parse_type_params()
        if impl_trait != "" [
            type_params.push("@trait:" + impl_trait)
        ]
        self.expect(Open, none())
        self.skip_newlines()
        let methods: List<Stmt> = []
        while not self.check(Close, none()) and not self.at_end() [
            if self.check(DocComment, none()) [
                self.advance()
                self.skip_newlines()
            ] else [
                !! NAPRAWIONE (wykryte przez `docs/showcase/cmd/main.hcs` - `pub fun`
                !! w `impl` konczylo sie kaskada "nieoczekiwany token")
                !! - w przeciwienstwie do najwyzszego poziomu (patrz
                !! obsluga "pub" w `parse_statement()`), ta petla
                !! wolala `parse_fun()` BEZPOSREDNIO (z pominieciem
                !! `parse_statement()`), wiec wiodace `pub` nie bylo w
                !! ogole konsumowane.
                !! 0.6 (pozycje AST): metoda jest instrukcja drzewa (`FunDecl` w `ImplDecl`),
                !! ale parsowana tu BEZPOSREDNIO - slot pozycji rezerwujemy recznie, od
                !! pierwszego tokenu (`pub`/`async`/`fun`), tak jak robi to `parse_statement`.
                let first_tok = self.cur()
                let method_slot = self.stmt_lines.len()
                self.stmt_lines.push(first_tok.line)
                self.stmt_cols.push(first_tok.col)
                self.stmt_tags.push("fun")
                let is_pub_method = false
                if self.check(Keyword, some("pub")) [
                    self.advance()
                    is_pub_method = true
                ]
                let method_async = false
                if self.check(Keyword, some("async")) [
                    self.advance()
                    method_async = true
                ]
                let m = self.parse_fun_ex(method_async)
                if is_pub_method [
                    match m [
                        FunDecl(name, params, ret_type, body, mip, type_params2, m_is_async) -> [
                            m = FunDecl(name, params, ret_type, body, true, type_params2, m_is_async)
                        ]
                        _ -> [
                        ]
                    ]
                ]
                methods.push(m)
                self.skip_newlines()
            ]
        ]
        self.expect(Close, none())
        end ImplDecl(struct_name, methods, type_params)
    ]

    !!! (0.7) `trait Nazwa [ fun m(self) -> Int  fun d(self) [ ... ] ]`; metoda bez ciala dostaje
    !!! znacznik `[ExprStmt(NullLit)]` (= wymagana).
    fun parse_trait(self) -> Stmt [
        self.expect(Keyword, some("trait"))
        let tname = self.expect(Ident, none()).value
        self.expect(Open, none())
        self.skip_newlines()
        let methods: List<Stmt> = []
        while not self.check(Close, none()) and not self.at_end() [
            if self.check(DocComment, none()) [
                self.advance()
                self.skip_newlines()
            ] else [
                let first_tok = self.cur()
                self.stmt_lines.push(first_tok.line)
                self.stmt_cols.push(first_tok.col)
                self.stmt_tags.push("fun")
                if self.check(Keyword, some("pub")) [
                    self.advance()
                ]
                self.expect(Keyword, some("fun"))
                let mname = self.expect(Ident, none()).value
                let mtp = self.parse_type_params()
                let mparams = self.parse_params()
                let mret: Option<TypeRef> = none()
                if self.check(Op, some("->")) [
                    self.advance()
                    mret = some(self.parse_type())
                ]
                let mbody: List<Stmt> = [ExprStmt(NullLit)]
                if self.check(Open, none()) [
                    mbody = self.parse_block()
                ]
                methods.push(FunDecl(mname, mparams, mret, mbody, true, mtp, false))
                self.skip_newlines()
            ]
        ]
        self.expect(Close, none())
        end ImplDecl("@trait:" + tname, methods, [])
    ]

    !!! `match wyrazenie [ Wariant(bind, ...) -> [ ... ] ... _ -> [...] ]`.
    fun parse_match(self) -> Stmt [
        self.expect(Keyword, some("match"))
        let subject = self.parse_expr()
        self.expect(Open, none())
        self.skip_newlines()
        let arms: List<MatchArm> = []
        while not self.check(Close, none()) and not self.at_end() [
            let vname = self.expect(Ident, none()).value
            let binds: List<Str> = []
            if self.check(LParen, none()) [
                self.advance()
                while not self.check(RParen, none()) [
                    binds.push(self.expect(Ident, none()).value)
                    if not self.check(Comma, none()) [
                        break
                    ]
                    self.advance()
                ]
                self.expect(RParen, none())
            ]
            self.expect(Op, some("->"))
            let body = self.parse_block()
            arms.push(MatchArm(vname, binds, body))
            self.skip_newlines()
        ]
        self.expect(Close, none())
        end MatchStmt(subject, arms)
    ]

    !!! -- wyrazenia (precedence climbing) --------------------------------

    fun parse_expr(self) -> Expr [
        end self.parse_or()
    ]

    fun parse_or(self) -> Expr [
        let left = self.parse_and()
        while self.check(Keyword, some("or")) or self.check(Op, some("||")) [
            self.advance()
            let right = self.parse_and()
            left = BinOp("or", left, right)
        ]
        end left
    ]

    fun parse_and(self) -> Expr [
        let left = self.parse_not()
        while self.check(Keyword, some("and")) or self.check(Op, some("&&")) [
            self.advance()
            let right = self.parse_not()
            left = BinOp("and", left, right)
        ]
        end left
    ]

    fun parse_not(self) -> Expr [
        if self.check(Keyword, some("not")) or self.check(Op, some("!")) [
            self.advance()
            let operand = self.parse_not()
            end UnaryOp("not", operand)
        ]
        end self.parse_comparison()
    ]

    fun parse_comparison(self) -> Expr [
        let left = self.parse_additive()
        while (self.check(Op, none()) and (self.cur().value == "==" or self.cur().value == "!=" or self.cur().value == "<=" or self.cur().value == ">=")) or self.check(LAngle, none()) or self.check(RAngle, none()) [
            let op = self.advance().value
            let right = self.parse_additive()
            left = BinOp(op, left, right)
        ]
        end left
    ]

    fun parse_additive(self) -> Expr [
        let left = self.parse_mult()
        while self.check(Op, none()) and (self.cur().value == "+" or self.cur().value == "-") [
            let op = self.advance().value
            let right = self.parse_mult()
            left = BinOp(op, left, right)
        ]
        end left
    ]

    fun parse_mult(self) -> Expr [
        let left = self.parse_unary()
        while self.check(Op, none()) and (self.cur().value == "*" or self.cur().value == "/" or self.cur().value == "%") [
            let op = self.advance().value
            let right = self.parse_unary()
            left = BinOp(op, left, right)
        ]
        end left
    ]

    fun parse_unary(self) -> Expr [
        !! ROZBUDOWA (async/coroutines) - `await wyrazenie` i `spawn wywolanie`
        !! (kodowane jako `UnaryOp("await"|"spawn", ...)` - bez nowych wariantow Expr).
        if self.check(Keyword, some("await")) [
            self.advance()
            let awaited = self.parse_unary()
            end UnaryOp("await", awaited)
        ]
        if self.check(Keyword, some("spawn")) [
            self.advance()
            let spawned = self.parse_unary()
            end UnaryOp("spawn", spawned)
        ]
        if self.check(Op, none()) and (self.cur().value == "-" or self.cur().value == "+") [
            let op = self.advance().value
            let operand = self.parse_unary()
            end UnaryOp(op, operand)
        ]
        end self.parse_postfix()
    ]

    !!! Lancuch postfiksowy: wywolania `f(...)`, `.pole`, `as Typ`, `?`,
    !!! `[indeks]` - w DOWOLNEJ kolejnosci i liczbie, np. `f().pole?[0]`.
    !!! `x[i]` jest dozwolone TYLKO gdy `[` jest "tight" (bez bialej
    !!! spacji przed nim, patrz `Token.tight` w lexer.hcs) - to
    !!! odrozniamy od nowego bloku (`if x [ ... ]`) juz na poziomie
    !!! lexera, wiec tutaj nie ma juz niejednoznacznosci.
    fun parse_postfix(self) -> Expr [
        let expr = self.parse_primary()
        while true [
            if self.check(LParen, none()) [
                self.advance()
                let args: List<Expr> = []
                while not self.check(RParen, none()) [
                    args.push(self.parse_expr())
                    if not self.check(Comma, none()) [
                        break
                    ]
                    self.advance()
                ]
                self.expect(RParen, none())
                expr = Call(expr, args)
            ] elif self.check(Op, some(".")) [
                self.advance()
                if self.check(Number, none()) [
                    !!! (0.7) `t.0`, `t.0.1` (lekser skleja `0.1` w jeden Number)
                    let numtok = self.advance().value
                    let parts = for_num_parts(numtok)
                    let pi = 0
                    while pi < parts.len() [
                        expr = Attr(expr, parts[pi].clone())
                        pi = pi + 1
                    ]
                ] else [
                    let name = self.expect(Ident, none()).value
                    expr = Attr(expr, name)
                ]
            ] elif self.check(LAngle, none()) and self.looks_like_type_args() [
                !!! (0.7) `nazwa<Typ, ...>(...)` - jawne argumenty typu
                self.advance()
                let targs: List<TypeRef> = []
                while not self.check(RAngle, none()) and not self.at_end() [
                    targs.push(self.parse_type())
                    if not self.check(Comma, none()) [
                        break
                    ]
                    self.advance()
                ]
                self.expect(RAngle, none())
                expr = TypeApp(expr, targs)
            ] elif self.check(Keyword, some("as")) [
                self.advance()
                let cast_type = self.parse_type()
                expr = Cast(expr, cast_type)
            ] elif self.check(Question, none()) [
                self.advance()
                expr = TryOp(expr)
            ] elif self.check(Open, none()) and self.cur().tight [
                self.advance()
                let index = self.parse_expr()
                self.expect(Close, none())
                expr = Index(expr, index)
            ] else [
                break
            ]
        ]
        end expr
    ]

    !!! (0.7) Podglad: czy od biezacego `<` (BEZ spacji przed nim) idzie
    !!! `<Typ[, Typ]...>(` - wtedy to jawne argumenty typu, a nie porownanie.
    fun looks_like_type_args(self) -> Bool [
        if not self.prev_is_ident_tight() [
            end false
        ]
        let depth = 0
        let k = self.pos
        let guard = 0
        while k < self.toks.len() and guard < 64 [
            let tk = self.toks[k].clone()
            if tk.kind == LAngle [
                depth = depth + 1
            ] elif tk.kind == RAngle [
                depth = depth - 1
                if depth == 0 [
                    if k + 1 < self.toks.len() and self.toks[k + 1].kind == LParen [
                        end true
                    ]
                    end false
                ]
            ] elif tk.kind == Ident or tk.kind == Comma or tk.kind == LParen or tk.kind == RParen [
                depth = depth + 0
            ] else [
                end false
            ]
            k = k + 1
            guard = guard + 1
        ]
        end false
    ]

    fun prev_is_ident_tight(self) -> Bool [
        if self.pos == 0 [
            end false
        ]
        let prev = self.toks[self.pos - 1].clone()
        let cur = self.toks[self.pos].clone()
        end prev.kind == Ident and prev.line == cur.line and prev.col + prev.value.len() == cur.col
    ]

    !!! (0.7) `f"a {x} b {y + 1}"` -> `"" + "a " + (x as Str) + ...`. `{{`/`}}` = literalne nawiasy.
    fun parse_interpolated(self, content: Str, line: Int, col: Int) -> Expr [
        let result: Expr = StringLit("", false)
        let lit = ""
        let i = 0
        let n = content.len()
        while i < n [
            let c = content.char_at(i)
            if c == "{" and i + 1 < n and content.char_at(i + 1) == "{" [
                lit = lit + "{"
                i = i + 2
            ] elif c == "}" and i + 1 < n and content.char_at(i + 1) == "}" [
                lit = lit + "}"
                i = i + 2
            ] elif c == "{" [
                let depth = 1
                let j = i + 1
                while j < n and depth > 0 [
                    if content.char_at(j) == "{" [
                        depth = depth + 1
                    ] elif content.char_at(j) == "}" [
                        depth = depth - 1
                    ]
                    j = j + 1
                ]
                if depth != 0 [
                    self.push_error("niezamkniety `{` w interpolowanym napisie", line, col, 1)
                    i = n
                ] else [
                    if lit != "" [
                        result = BinOp("+", result, StringLit(lit, false))
                        lit = ""
                    ]
                    let inner = content.slice(i + 1, j - 1)
                    let sub = Parser(tokenize(inner), 0, [], [], [], [], [], 0)
                    let sub_expr = sub.parse_expr()
                    let ei = 0
                    while ei < sub.errors.len() [
                        self.errors.push(sub.errors[ei].clone())
                        ei = ei + 1
                    ]
                    result = BinOp("+", result, Cast(sub_expr, TypeRef("Str", none(), none())))
                    i = j
                ]
            ] else [
                lit = lit + c
                i = i + 1
            ]
        ]
        if lit != "" [
            result = BinOp("+", result, StringLit(lit, false))
        ]
        end result
    ]

    !!! (0.7) `fn(x: Int) -> Int [ ... ]` / `fn(x: Int) -> Int = x + 1` / `fn(x) = x`.
    fun parse_lambda(self) -> Expr [
        self.advance()
        let params = self.parse_params()
        let ret_type: Option<TypeRef> = none()
        if self.check(Op, some("->")) [
            self.advance()
            ret_type = some(self.parse_type())
        ]
        if self.check(Op, some("=")) [
            self.advance()
            let body_expr = self.parse_expr()
            end Lambda(params, ret_type, [ReturnStmt(some(body_expr))])
        ]
        !!! cialo blokowe: instrukcje wewnatrz domkniecia nie wchodza do tabeli pozycji
        let keep_l = self.stmt_lines.len()
        let body = self.parse_block()
        while self.stmt_lines.len() > keep_l [
            self.stmt_lines.pop()
            self.stmt_cols.pop()
            self.stmt_tags.pop()
        ]
        end Lambda(params, ret_type, body)
    ]

    fun parse_primary(self) -> Expr [
        let t = self.cur()
        if t.kind == Keyword and t.value == "fn" [
            end self.parse_lambda()
        ]
        if t.kind == Number [
            self.advance()
            end NumberLit(t.value)
        ]
        if t.kind == FStrLit [
            self.advance()
            end self.parse_interpolated(t.value.clone(), t.line, t.col)
        ]
        if t.kind == StrLit [
            self.advance()
            end StringLit(t.value, false)
        ]
        if t.kind == Keyword and (t.value == "true" or t.value == "false") [
            self.advance()
            end BoolLit(t.value == "true")
        ]
        if t.kind == Keyword and t.value == "null" [
            self.advance()
            end NullLit
        ]
        if t.kind == Keyword and t.value == "self" [
            self.advance()
            end IdentExpr("self")
        ]
        if t.kind == Ident [
            self.advance()
            end IdentExpr(t.value)
        ]
        if t.kind == LParen [
            self.advance()
            let e = self.parse_expr()
            if self.check(Comma, none()) [
                !!! (0.7) krotka `(a, b, ...)`
                let items: List<Expr> = [e]
                while self.check(Comma, none()) [
                    self.advance()
                    if self.check(RParen, none()) [
                        break
                    ]
                    items.push(self.parse_expr())
                ]
                self.expect(RParen, none())
                end TupleLit(items)
            ]
            self.expect(RParen, none())
            end e
        ]
        if t.kind == Open [
            self.advance()
            let items: List<Expr> = []
            self.skip_newlines()
            while not self.check(Close, none()) and not self.at_end() [
                items.push(self.parse_expr())
                self.skip_newlines()
                if not self.check(Comma, none()) [
                    self.skip_newlines()
                    break
                ]
                self.advance()
                self.skip_newlines()
            ]
            self.expect(Close, none())
            end ListLit(items)
        ]
        self.push_error("nieoczekiwany token '" + t.value + "'", t.line, t.col, t.value.len())
        self.advance()
        end NullLit
    ]
]

!!! (0.7) "0.1" -> ["0", "1"] (indeksy krotek zagniezdzonych `t.0.1`).
fun for_num_parts(num: Str) -> List<Str> [
    let out: List<Str> = []
    let cur = ""
    let i = 0
    while i < num.len() [
        let c = num.char_at(i)
        if c == "." [
            out.push(cur.clone())
            cur = ""
        ] else [
            cur = cur + c
        ]
        i = i + 1
    ]
    if cur != "" [
        out.push(cur.clone())
    ]
    end out
]

!!! `parse(source)` - odpowiednik wolnej funkcji `parse()` w parser.py
!!! (tokenizuje, potem `Parser(tokens, 0).parse_program()`). Bledy
!!! parsera (patrz `Parser.errors`) sa tu NADAL gubione (tylko `log()`
!!! przez `push_error()`) - PARYTET WSTECZNY, zeby nie zlamac zadnego
!!! z istniejacych wywolan `parse()` (formatter.hcs/project.hcs/
!!! transpiler.hcs/playground.hcs - patrz docs/ROADMAP.md). Wywolujacy,
!!! ktorzy CHCA prawdziwych, ustrukturyzowanych bledow parsera (dzis:
!!! `hackerc check`/`build`/`emit-module` w main.hcs), uzywaja NOWEGO
!!! `parse_checked()` ponizej zamiast tego.
fun parse(source: Str) -> Program [
    let tokens = tokenize(source)
    let p = Parser(tokens, 0, [], [], [], [], [], 0)
    end p.parse_program()
]

!!! DODANE (ta runda, patrz docs/ROADMAP.md sekcja 1 - "ParseError").
struct ParseResult [
    program: Program,
    errors: List<Diagnostic>
]

!!! Jak `parse()` wyzej, ale ZWRACA rowniez `Parser.errors` (patrz
!!! `Parser` struct/`push_error()`) zamiast je gubic - realny,
!!! ustrukturyzowany `ParseError` (Diagnostic z prawdziwym
!!! `line`/`col`, nie tylko tekst na stdout). Wywolujacy powinien
!!! sprawdzic `result.errors` PRZED uzyciem `result.program` do
!!! dalszych krokow (typecheck/codegen) - przy bledach parsera AST
!!! moze byc niekompletny/best-effort (parser NADAL robi odzyskiwanie
!!! po bledzie zamiast przerywac w miejscu, jak `rustc`), wiec dalsze
!!! diagnostyki typechecka na TAKIM AST moga byc mylace/wtorne wobec
!!! bledu parsera - patrz uzycie w `main.hcs::cmd_check`/`cmd_build`
!!! (raportuje `result.errors` i PRZERYWA przed typecheckiem, gdy
!!! niepuste).
fun parse_checked(source: Str) -> ParseResult [
    let tokens = tokenize(source)
    let p = Parser(tokens, 0, [], [], [], [], [], 0)
    let prog = p.parse_program()
    end ParseResult(prog, p.errors)
]

!!! Demonstracyjne uzycie: parsuje maly, ale reprezentatywny fragment
!!! HackerScript zawierajacy struct+impl+fun+if+match+wywolanie
!!! metody+`?` - sprawdza, ze cala gramatyka spina sie w jeden dzialajacy
!!! pipeline `Str -> tokenize -> Parser -> Program`.
fun main() [
    let src = "struct Point [\n    x: Int,\n    y: Int\n]\n\nimpl Point [\n    fun sum(self) -> Int [\n        end self.x + self.y\n    ]\n]\n\nfun classify(n: Int) -> Str [\n    if n > 0 [\n        end \"pozytywne\"\n    ] elif n < 0 [\n        end \"negatywne\"\n    ] else [\n        end \"zero\"\n    ]\n]\n\nfun main() [\n    let p = Point(1, 2)\n    log(p.sum())\n    log(classify(p.x)?)\n]\n"
    let prog = parse(src)
    log("instrukcje najwyzszego poziomu:", prog.body.len())
]
