fun async_runtime_lines() -> List<Str> [
    let out: List<Str> = []
    out.push("//! HackerScript - runtime async/await + coroutines + channels.")
    out.push("//! Plik generowany przez `hackerc` (zrodlo: hackerc/rt/hks_async_rt.rs).")
    out.push("//! Wymaga crate'a `tokio` (features: rt-multi-thread, sync, time) - dopisywany")
    out.push("//! do Cargo.toml AUTOMATYCZNIE, tylko gdy program uzywa async/spawn/Chan.")
    out.push("#![allow(dead_code, unused_imports)]")
    out.push("")
    out.push("use std::future::Future;")
    out.push("use std::pin::Pin;")
    out.push("use std::sync::{Arc, OnceLock};")
    out.push("use std::task::{Context, Poll};")
    out.push("")
    out.push("static HKS_RT: OnceLock<tokio::runtime::Runtime> = OnceLock::new();")
    out.push("")
    out.push("/// Globalny, wielowatkowy runtime (lekkie koroutyny = zadania tokio).")
    out.push("pub fn hks_rt() -> &'static tokio::runtime::Runtime {")
    out.push("    HKS_RT.get_or_init(|| {")
    out.push("        tokio::runtime::Builder::new_multi_thread()")
    out.push("            .enable_all()")
    out.push("            .thread_name(\"hks-coroutine\")")
    out.push("            .build()")
    out.push("            .expect(\"hackerc: nie mozna utworzyc runtime async\")")
    out.push("    })")
    out.push("}")
    out.push("")
    out.push("/// `await` w kontekscie synchronicznym - blokuje biezacy watek do konca `f`.")
    out.push("/// Bezpieczne takze wewnatrz koroutyny (uzywa `block_in_place`).")
    out.push("pub fn hks_block_on<F: Future>(f: F) -> F::Output {")
    out.push("    match tokio::runtime::Handle::try_current() {")
    out.push("        Ok(h) => tokio::task::block_in_place(move || h.block_on(f)),")
    out.push("        Err(_) => hks_rt().block_on(f),")
    out.push("    }")
    out.push("}")
    out.push("")
    out.push("/// Uchwyt koroutyny (`spawn f(x)`); `await uchwyt` zwraca wynik `f`.")
    out.push("pub struct HksTask<T>(tokio::task::JoinHandle<T>);")
    out.push("")
    out.push("impl<T> Future for HksTask<T> {")
    out.push("    type Output = T;")
    out.push("    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<T> {")
    out.push("        match Pin::new(&mut self.0).poll(cx) {")
    out.push("            Poll::Ready(Ok(v)) => Poll::Ready(v),")
    out.push("            Poll::Ready(Err(e)) => panic!(\"koroutyna zakonczyla sie panika: {}\", e),")
    out.push("            Poll::Pending => Poll::Pending,")
    out.push("        }")
    out.push("    }")
    out.push("}")
    out.push("")
    out.push("impl<T> HksTask<T> {")
    out.push("    pub fn abort(&self) {")
    out.push("        self.0.abort();")
    out.push("    }")
    out.push("    pub fn is_done(&self) -> bool {")
    out.push("        self.0.is_finished()")
    out.push("    }")
    out.push("}")
    out.push("")
    out.push("pub fn hks_spawn<F>(f: F) -> HksTask<F::Output>")
    out.push("where")
    out.push("    F: Future + Send + 'static,")
    out.push("    F::Output: Send + 'static,")
    out.push("{")
    out.push("    HksTask(hks_rt().spawn(f))")
    out.push("}")
    out.push("")
    out.push("/// `spawn` zwyklej (synchronicznej) funkcji - uruchamiana w puli blokujacej.")
    out.push("pub fn hks_spawn_blocking<F, R>(f: F) -> HksTask<R>")
    out.push("where")
    out.push("    F: FnOnce() -> R + Send + 'static,")
    out.push("    R: Send + 'static,")
    out.push("{")
    out.push("    HksTask(hks_rt().spawn_blocking(f))")
    out.push("}")
    out.push("")
    out.push("pub async fn hks_join_all<T>(tasks: Vec<HksTask<T>>) -> Vec<T> {")
    out.push("    let mut out = Vec::with_capacity(tasks.len());")
    out.push("    for t in tasks {")
    out.push("        out.push(t.await);")
    out.push("    }")
    out.push("    out")
    out.push("}")
    out.push("")
    out.push("pub async fn hks_sleep_ms(ms: i64) {")
    out.push("    tokio::time::sleep(std::time::Duration::from_millis(if ms < 0 { 0 } else { ms as u64 })).await;")
    out.push("}")
    out.push("")
    out.push("struct HksChanInner<T> {")
    out.push("    tx: std::sync::Mutex<Option<tokio::sync::mpsc::Sender<T>>>,")
    out.push("    rx: tokio::sync::Mutex<tokio::sync::mpsc::Receiver<T>>,")
    out.push("}")
    out.push("")
    out.push("/// Kanal w stylu Go (wielu nadawcow / wielu odbiorcow). `chan(n)` = bufor `n`")
    out.push("/// (`chan()` = 1 - tokio nie ma kanalu bez bufora). Klonowanie = ten sam kanal.")
    out.push("pub struct HksChan<T> {")
    out.push("    inner: Arc<HksChanInner<T>>,")
    out.push("}")
    out.push("")
    out.push("impl<T> Clone for HksChan<T> {")
    out.push("    fn clone(&self) -> Self {")
    out.push("        HksChan { inner: self.inner.clone() }")
    out.push("    }")
    out.push("}")
    out.push("")
    out.push("impl<T> HksChan<T> {")
    out.push("    pub fn new(cap: i64) -> Self {")
    out.push("        let cap = if cap < 1 { 1 } else { cap as usize };")
    out.push("        let (tx, rx) = tokio::sync::mpsc::channel(cap);")
    out.push("        HksChan {")
    out.push("            inner: Arc::new(HksChanInner {")
    out.push("                tx: std::sync::Mutex::new(Some(tx)),")
    out.push("                rx: tokio::sync::Mutex::new(rx),")
    out.push("            }),")
    out.push("        }")
    out.push("    }")
    out.push("")
    out.push("    /// Wysyla wartosc; `false` gdy kanal zamkniety. Zawiesza koroutyne, gdy bufor pelny.")
    out.push("    pub async fn send(&self, v: T) -> bool {")
    out.push("        let tx = self.inner.tx.lock().unwrap().clone();")
    out.push("        match tx {")
    out.push("            Some(tx) => tx.send(v).await.is_ok(),")
    out.push("            None => false,")
    out.push("        }")
    out.push("    }")
    out.push("")
    out.push("    /// Odbiera wartosc; `None` gdy kanal zamkniety i oproznony.")
    out.push("    pub async fn recv(&self) -> Option<T> {")
    out.push("        self.inner.rx.lock().await.recv().await")
    out.push("    }")
    out.push("")
    out.push("    /// Zamyka kanal (jak `close(ch)` w Go) - odbiorcy dostana `None` po oproznieniu bufora.")
    out.push("    pub fn close(&self) {")
    out.push("        self.inner.tx.lock().unwrap().take();")
    out.push("    }")
    out.push("}")
    end out
]

fun async_runtime_text() -> Str [
    let lines = async_runtime_lines()
    let text = ""
    let i = 0
    while i < lines.len() [
        text = text + lines[i] + "\n"
        i = i + 1
    ]
    end text
]
