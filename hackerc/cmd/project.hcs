include <ast_nodes>
include <parser>
include <codegen>
include <transpiler>
include <hlib>
get <std:io> import <file_readable>
get <std:string> import <str_join::str_split::str_trim::str_starts_with>

const CARGO_TOML_HEADER: Str = "[package]\nname = \""
const CARGO_TOML_MID: Str = "\"\nversion = \"0.0.1\"\nedition = \"2021\"\n\n[[bin]]\nname = \""
const CARGO_TOML_TAIL: Str = "\"\npath = \"src/main.rs\"\n\n[dependencies]\n"
!! NOWOSC 0.4 - wariant `[lib]` (cdylib+rlib) zamiast `[[bin]]`, dla
!! `@wasm_export`/`virus build --wasm` (patrz `cargo_toml_text()` nizej
!! i `virus/cmd/build.hcs`). "rlib" obok "cdylib" pozwala TEZ uzyc
!! tego samego crate'a jako zwyklej zaleznosci Rust (np. w testach
!! poza wasm) - "cdylib" samo jest wymagane przez `wasm-bindgen`. Bez
!! `name = "..."` (w odroznieniu od `[[bin]]` wyzej) - Cargo domyslnie
!! nazywa `[lib]` jak `[package]` (z myslnikami zamienionymi na `_`),
!! wiec crate_name jest tu potrzebny TYLKO RAZ (w `[package] -> name`).
const CARGO_TOML_WASM_MID: Str = "\"\nversion = \"0.0.1\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\", \"rlib\"]\npath = \"src/lib.rs\"\n\n[dependencies]\n"

!! ROZBUDOWA (ta runda) - `[lib]` z SAMYM "rlib" (bez "cdylib"), dla
!! `virus build --library` (`TargetLibrary`, patrz
!! `virus/cmd/build.hcs`). W odroznieniu od wariantu WASM wyzej, to
!! NIE jest przeznaczone do zaladowania jako biblioteka dynamiczna z
!! innego jezyka - to zwykly crate Rust-owy, docelowo konsumowany przez
!! inny crate Rust przez `get <work:czlonek>` (patrz docs/SYNTAX.md) -
!! stad tylko "rlib".
const CARGO_TOML_LIBRARY_MID: Str = "\"\nversion = \"0.0.1\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"rlib\"]\npath = \"src/lib.rs\"\n\n[dependencies]\n"

!!! Splaszczona, deterministyczna nazwa modulu Rust dla `get <std:...>`
!!! / `get <core:...>` / `get <selfhost:...>`. MUSI byc identyczna po
!!! obu stronach (patrz `codegen.hcs::gen_get_import`) - to jest cala
!!! "umowa" systemu modulow. Musi tez byc poprawnym identyfikatorem
!!! Rusta (snake_case) - `-` zamieniane na `_`.
fun flat_module_name(source: Str, name: Str, version: Option<Str>) -> Str [
    let out = "_hks_" + replace_dash(source) + "_" + replace_dash(name)
    match version [
        Some(v) -> [
            out = out + "_" + replace_dash(v)
        ]
        None -> [
        ]
    ]
    end out
]

fun replace_dash(s: Str) -> Str [
    let out = ""
    let i = 0
    let n = s.len()
    while i < n [
        let c = s.char_at(i)
        !! ROZBUDOWA (ta runda, znalezione realnym buildem - patrz
        !! docs/ROADMAP.md) - `name` w `get <std:podkatalog/plik>`
        !! (np. `get <std:cybersecurity/entropy>`) moze zawierac "/" -
        !! bez tej gałęzi `flat_module_name` (nizej) produkowalby
        !! nazwe pliku Rust z LITERALNYM "/" w srodku (np.
        !! "_hks_std_cybersecurity/entropy.rs"), co `write_file`
        !! probuje zapisac jako plik W PODKATALOGU, ktory nigdy nie
        !! zostal utworzony - stad "No such file or directory".
        if c == "-" or c == "/" [
            out = out + "_"
        ] else [
            out = out + c
        ]
        i = i + 1
    ]
    end out
]

!!! `<libs_root>/<source>/lib/<name>[/<version>].hcs`.
fun module_file_path(libs_root: Str, source: Str, name: Str, version: Option<Str>) -> Str [
    let path = libs_root + "/" + source + "/lib/" + name
    match version [
        Some(v) -> [
            path = path + "/" + v
        ]
        None -> [
        ]
    ]
    end path + ".hcs"
]

!!! Jak `module_file_path`, ale dla `get <selfhost:...>` - pliki
!!! `bootstrap/hackerc-self/*.hcs` leza PLASKO (bez zagniezdzenia
!!! `<source>/lib/`), bo to nie jest "prawdziwa" biblioteka tylko
!!! kolekcja modulow samo-hostowanego kompilatora - patrz
!!! bootstrap/README.md.
fun selfhost_module_file_path(bootstrap_root: Str, name: Str, version: Option<Str>) -> Str [
    let path = bootstrap_root + "/" + name
    match version [
        Some(v) -> [
            path = path + "/" + v
        ]
        None -> [
        ]
    ]
    end path + ".hcs"
]

!!! Odcina ostatni segment `/segment` ze sciezki - `"/a/b" -> "/a"`,
!!! `"/a" -> "/"`, `"a/b" -> "a"`, `"a" -> ""` (pusty wynik = juz nie
!!! ma dokad isc w gore, parytet z `d.parent == d` w Pythonie na
!!! korzeniu filesystemu).
fun path_parent(p: Str) -> Str [
    let n = p.len()
    let i = n
    while i > 0 and p.char_at(i - 1) != "/" [
        i = i - 1
    ]
    if i == 0 [
        end ""
    ]
    let end_i = i - 1
    if end_i == 0 [
        end "/"
    ]
    end p.slice(0, end_i)
]

!!! Szuka katalogu `libs/` (z podkatalogiem `core/`) zaczynajac od
!!! `start` i idac w gore drzewa katalogow - tak jak `virus` szuka
!!! `Virus.hk`. Uzywa PRAWDZIWEGO sprawdzenia katalogu (`dir_exists`,
!!! `get <std:fs>` - dodane w tej sesji), NIE JUZ sondowania przez
!!! plik-znacznik jak wczesniej (patrz historia w bootstrap/README.md).
!!! Rozwiazuje `d` do sciezki BEZWZGLEDNEJ (parytet z Python `.resolve()`)
!!! - NAPRAWA BUGA: bez tego, dla `d` bedacego "gola" wzgledna nazwa
!!! pliku (np. "main.hcs") lub pustym stringiem (patrz `path_parent`),
!!! `find_libs_root`/`find_bootstrap_root` moglyby sprawdzic co
!!! najwyzej JEDEN katalog wzgledem CWD i sie poddac - zamiast
!!! faktycznie wejsc w gore PRAWDZIWEGO drzewa katalogow az do korzenia
!!! systemu plikow (patrz historia w bootstrap/README.md).
fun to_absolute_dir(d: Str) -> Str [
    if d.len() > 0 and d.char_at(0) == "/" [
        end d
    ]
    match current_dir() [
        Ok(cwd) -> [
            if d.len() == 0 [
                end cwd
            ]
            end cwd + "/" + d
        ]
        Err(_e) -> [
            end d
        ]
    ]
]

fun find_libs_root(start: Str) -> Option<Str> [
    let d = to_absolute_dir(start)
    let prev_d = "\0no-such-dir"
    while d != prev_d [
        let candidate = path_join_safe(d.clone(), "libs/core")
        if dir_exists(candidate) [
            end some(path_join_safe(d, "libs"))
        ]
        prev_d = d.clone()
        d = path_parent(d)
    ]
    end none()
]

!!! Jak `find_libs_root`, ale szuka `bootstrap/hackerc-self/`. UWAGA:
!!! od kiedy `get <selfhost:...>` jest zablokowane (patrz
!!! `parser.hcs::parse_get_import` i bootstrap/README.md) - `include
!!! <sciezka>` NIE UZYWA `bootstrap_root` wcale (rozwiazuje sie
!!! WZGLEDEM pliku z `include`, nie od globalnego korzenia) - ta
!!! funkcja i parametr `bootstrap_root` w `build_project`/
!!! `collect_project_signatures` sa wiec dzis PRAKTYCZNIE MARTWE,
!!! zachowane tylko dla zgodnosci sygnatur (i na wypadek przyszlego
!!! `get <selfhost:...>`, gdyby kiedys mial wrocic w innej roli).
fun find_bootstrap_root(start: Str) -> Option<Str> [
    let d = to_absolute_dir(start)
    let prev_d = "\0no-such-dir"
    while d != prev_d [
        let candidate = path_join_safe(d.clone(), "bootstrap/hackerc-self")
        if dir_exists(candidate.clone()) [
            end some(candidate)
        ]
        prev_d = d.clone()
        d = path_parent(d)
    ]
    end none()
]

!!! Jak `find_libs_root`, ale szuka `cache/libs/vira/` - katalog
!!! tworzony przez `virus install vira <nazwa>` (patrz
!!! `virus/cmd/vira.hcs`/`virus/cmd/cache.hcs::cache_lib_path`).
!!! DODANE w tej rundzie - odblokowuje `get <vira:nazwa[::plik]>` dla
!!! bibliotek Vira typu "git" (kod zrodlowy .hcs) - `static-lib`/
!!! `shared-lib`/`rust-lib` sa uzywane INACZEJ: od 0.3 przez
!!! `get <extern:nazwa> use <static|dynamic>` + `region [ ... ]`
!!! (patrz `gen_region`/`RegionBlock` w codegen.hcs/ast_nodes.hcs;
!!! zastepuje stare, jedno-funkcyjne `extern "nazwa" fun ...`/
!!! `gen_extern`/`ExternFunDecl` sprzed 0.3) PO automatycznym
!!! podlinkowaniu przez `virus build` (patrz
!!! `virus/cmd/build.hcs::build_wire_extern_dependencies` - przemianowane
!!! z `build_wire_vira_dependencies` w 0.3), NIE przez
!!! `get <vira:...>` - `git`-type to jedyny typ Vira bedacy prawdziwym
!!! zrodlem .hcs do wspolnego skompilowania z projektem. Analogicznie,
!!! `get <c:nazwa>`/`get <cpp:nazwa>` (0.3) deklaruja zaleznosc od
!!! biblioteki C/C++ budowanej przez `cc`, rowniez wywolywanej przez
!!! `get <extern:...> use <...>` + `region [ ... ]`, NIGDY jako .hcs
!!! do sparsowania - stad rowniez pomijane w kolejce ponizej.
fun find_vira_cache_root(start: Str) -> Option<Str> [
    let d = to_absolute_dir(start)
    let prev_d = "\0no-such-dir"
    while d != prev_d [
        let candidate = path_join_safe(d.clone(), "cache/libs/vira")
        if dir_exists(candidate.clone()) [
            end some(candidate)
        ]
        prev_d = d.clone()
        d = path_parent(d)
    ]
    end none()
]

!!! `<vira_root>/<name>/<wersja-jako-plik>.hcs`, gdzie `wersja` (z
!!! `get <vira:nazwa::plik>`) to sciezka DO KONKRETNEGO pliku WEWNATRZ
!!! sklonowanego repo `<vira_root>/<nazwa>/` - brak `::` (samo `get
!!! <vira:nazwa>`) domyslnie szuka `<vira_root>/<nazwa>/mod.hcs`,
!!! DOKLADNIE tak jak `get <std:nazwa>` bez `::` laduje w
!!! `libs/std/lib/nazwa.hcs`, a `get <std:nazwa>` na CALY PAKIET (bez
!!! podsciezki) odpowiadaloby `libs/std/lib/mod.hcs` - biblioteki Vira
!!! typu "git" MUSZA wiec miec `mod.hcs` w korzeniu repo, zeby byly
!!! importowalne jako `get <vira:nazwa>` bez `::` (udokumentowana
!!! konwencja, patrz docs/ROADMAP.md i naglowek vira.hcs).
fun vira_module_file_path(vira_root: Str, name: Str, version: Option<Str>) -> Str [
    let path = vira_root + "/" + name + "/"
    match version [
        Some(v) -> [
            path = path + v
        ]
        None -> [
            path = path + "mod"
        ]
    ]
    end path + ".hcs"
]

!!! NOWOSC 0.4 - szuka korzenia CALEGO workspace dla
!!! `get <work:member[::plik]>` (analog Rustowego `use
!!! nazwa_membera::modul::*;` dla czlonka `cargo`-owego workspace,
!!! patrz docs/SYNTAX.md), zaczynajac od `start` i idac w gore. W
!!! przeciwienstwie do `find_libs_root` (zawsze szuka JEDNEGO,
!!! ustalonego katalogu `libs/core`) tu szukana nazwa (`member_name`)
!!! jest DOWOLNA - wiec sprawdzamy, dla kazdego kandydata na korzen
!!! `d`, czy `<d>/<member_name>/lib` istnieje jako katalog - TA SAMA
!!! lekka heurystyka "sondowania katalogu", bez parsowania Virus.hk
!!! (celowo - `hackerc` moze byc wywolywany samodzielnie, bez `virus`,
!!! wiec nie moze zakladac jego obecnosci ani konkretnego ksztaltu
!!! manifestu; parsowanie PRAWDZIWEGO `[workspace] -> members` -
!!! zeby wychwycic pomylki w nazwie czy pozwolic/zabronic importu -
!!! jest zadaniem `virus`, patrz `virus/cmd/manifest.hcs` i
!!! `virus/cmd/cache.hcs::workspace_claims_member`).
!!!
!!! Konwencja: czlonek workspace jest importowalny przez
!!! `get <work:...>` WTEDY I TYLKO WTEDY, gdy ma `<czlonek>/lib/mod.hcs`
!!! (DOKLADNIE ten sam ksztalt co `libs/core`/`libs/std` - ktore same
!!! sa zreszta importowalne TEZ przez `get <work:core>`/
!!! `get <work:std>`, `find_libs_root` zostaje jako krotszy,
!!! dedykowany alias dla nich dwoch). Czlonek z samym `cmd/main.hcs`
!!! (binarka, patrz `find_cmd_entry` w virus/cmd/manifest.hcs) NIE jest
!!! importowalny w ten sposob - to swiadomy podzial (jak w opisie
!!! [workspace] w Virus.hk): "binarki" sa budowane osobno, "biblioteki"
!!! sa wspoldzielone przez `get <work:...>`; czlonek MOZE miec oba
!!! ksztalty naraz (wlasny `cmd/main.hcs` I `lib/mod.hcs`), jesli ma
!!! byc jednoczesnie samodzielnym narzedziem i biblioteka dla innych.
fun find_workspace_root(start: Str, member_name: Str) -> Option<Str> [
    let d = to_absolute_dir(start)
    let prev_d = "\0no-such-dir"
    while d != prev_d [
        let candidate = path_join_safe(d.clone(), member_name.clone() + "/lib")
        if dir_exists(candidate) [
            end some(d)
        ]
        prev_d = d.clone()
        d = path_parent(d)
    ]
    end none()
]

!!! `<workspace_root>/<member>/lib/<wersja-jako-plik>.hcs` - analog
!!! `vira_module_file_path`, dla `get <work:member[::plik]>`. Brak `::`
!!! (samo `get <work:member>`) laduje w `<member>/lib/mod.hcs` -
!!! DOKLADNIE parytet z tym, jak `get <std:nazwa>` bez `::` lądowałoby
!!! w `libs/std/lib/mod.hcs`.
fun work_module_file_path(workspace_root: Str, member: Str, version: Option<Str>) -> Str [
    let path = workspace_root + "/" + member + "/lib/"
    match version [
        Some(v) -> [
            path = path + v
        ]
        None -> [
            path = path + "mod"
        ]
    ]
    end path + ".hcs"
]

!!! Szuka archiwum `.hlib` dla `get <hlib:name[::version]>`, w tej
!!! kolejnosci:
!!!   1. `<vira_root>/<name>/<name>.hlib` i `<vira_root>/<name>/dist/<name>.hlib`
!!!      - paczka Vira MOZE dostarczac prekompilowany `.hlib` obok (albo
!!!        zamiast) surowego `.hcs` - to jest "liby vira jako hlib"
!!!   2. `<base_dir_lub_przodek>/hlibs/<name>.hlib` - wlasne `.hlib`
!!!      projektu, szukane w gore drzewa katalogow (jak `bytes ->` w H#)
!!!   3. `<libs_root>/hlib/<name>.hlib` - globalny slot obok `std`/`core`
!!!   4. `/usr/lib/HackerOS/HackerScript/hlibs/<name>.hlib` - systemowy
!!! Kazdy krok probuje najpierw `<name>-<version>.hlib` (jesli podano
!!! wersje), potem `<name>.hlib`.
fun find_hlib_file_path(name: Str, version: Option<Str>, base_dir: Str, vira_root: Option<Str>, libs_root: Option<Str>) -> Option<Str> [
    let filenames: List<Str> = []
    match version.clone() [
        Some(v) -> [ filenames.push(name + "-" + v + ".hlib") ]
        None -> [ ]
    ]
    filenames.push(name + ".hlib")

    let dirs: List<Str> = []
    match vira_root.clone() [
        Some(vr) -> [
            dirs.push(vr + "/" + name)
            dirs.push(vr + "/" + name + "/dist")
        ]
        None -> [ ]
    ]

    let d = to_absolute_dir(base_dir)
    let prev_d = "\0no-such-dir"
    while d != prev_d [
        dirs.push(path_join_safe(d.clone(), "hlibs"))
        prev_d = d.clone()
        d = path_parent(d)
    ]

    match libs_root.clone() [
        Some(lr) -> [ dirs.push(lr + "/hlib") ]
        None -> [ ]
    ]
    dirs.push("/usr/lib/HackerOS/HackerScript/hlibs")

    let di = 0
    while di < dirs.len() [
        let fi = 0
        while fi < filenames.len() [
            let candidate = path_join_safe(dirs[di].clone(), filenames[fi].clone())
            if file_readable(candidate.clone()) [
                end some(candidate)
            ]
            fi = fi + 1
        ]
        di = di + 1
    ]
    end none()
]


!!! katalog PLIKU, w ktorym sie znajduje (potrzebny WYLACZNIE dla
!!! `IncludeStmt`, rozwiazywanego wzgledem tego katalogu - `GetImportStmt`
!!! ignoruje `base_dir`, zawsze szuka od libs_root/bootstrap_root).
!!! HackerScript nie ma tupli, wiec wlasny struct - parytet z parami
!!! `(stmt, base_dir)` w `module_stmts()` (project.py).
struct QueueItem [
    stmt: Stmt,
    base_dir: Str
]

!!! Doklejenie `rest` DO `base` jako sciezka - jak Python `pathlib.Path
!!! (base) / rest` (ktorego uzywa oryginal - `project.py`): dla PUSTEGO
!!! `base` (plik zrodlowy bez katalogu, np. `src = "main.hcs"` -
!!! `path_parent` zwraca `""`) zwraca `rest` WPROST (BEZ wiodacego "/"),
!!! zamiast naiwnej konkatenacji `base + "/" + rest`, ktora dla pustego
!!! `base` dawalaby BLEDNIE `"/" + rest` - SCIEZKE BEZWZGLEDNA OD
!!! KORZENIA SYSTEMU PLIKOW zamiast wzglednej do biezacego katalogu.
!!! NAPRAWA BUGA: patrz historia w bootstrap/README.md - `include <...>`
!!! szukalo w "/nazwa.hcs" zamiast we wlasciwym katalogu, gdy plik
!!! zrodlowy byl podany BEZ katalogu (np. `hackerc build main.hcs`
!!! uruchomione z wewnatrz `bootstrap/hackerc-self/`).
fun path_join_safe(base: Str, rest: Str) -> Str [
    if base.len() == 0 [
        end rest
    ]
    end base + "/" + rest
]

!!! Indeks pierwszego wystapienia `needle` w `s`, albo `-1` - reczny
!!! skan znak po znaku (jezyk nie ma jeszcze wbudowanego
!!! `str.find()`/`str_index_of` dostepnego bez `get <std:string>`,
!!! ktorego ten plik (`hackerc`, nie `virus`) celowo nie importuje -
!!! patrz uwaga przy `find_libs_root` o "sondowaniu katalogu bez
!!! zaleznosci od virus"). Uzywana WYLACZNIE przez
!!! `resolve_include_path` do rozbicia `"czlonek::plik"` na dwie
!!! czesci dla `include <work:...>` (NOWOSC 0.4).
fun find_substr(s: Str, needle: Str) -> Int [
    let sn = s.len()
    let nn = needle.len()
    if nn == 0 or nn > sn [
        end -1
    ]
    let i = 0
    while i <= sn - nn [
        let j = 0
        let matched = true
        while j < nn [
            if s.char_at(i + j) != needle.char_at(j) [
                matched = false
                j = nn
            ]
            j = j + 1
        ]
        if matched [
            end i
        ]
        i = i + 1
    ]
    end -1
]

!!! Parytet z `resolve_include_path` (project.py) - rozwiazuje `include
!!! <raw_path>` na prawdziwy plik `.hcs`, WZGLEDEM `base_dir`. Kolejnosc
!!! jak Rustowe `mod nazwa;` (plik przed katalogiem).
!!! NOWOSC 0.4 - drugi ksztalt: `raw_path` zaczynajacy sie od `"work:"`
!!! (patrz `parse_include()` w parser.hcs) to `include
!!! <work:czlonek[::plik]>` - "prawdziwe" statyczne linkowanie zrodla
!!! INNEGO czlonka workspace BEZ kopiowania plikow. W odroznieniu od
!!! zwyklego `include <sciezka>` (zawsze wzgledem `base_dir`, czyli
!!! katalogu PLIKU z tym `include`), ten ksztalt jest rozwiazywany
!!! WZGLEDEM KORZENIA WORKSPACE - dokladnie ta sama para funkcji, co
!!! `get <work:...>` uzywa: `find_workspace_root` (szuka w gore
!!! `<przodek>/<czlonek>/lib`, zaczynajac od `base_dir`) +
!!! `work_module_file_path` (`<korzen>/<czlonek>/lib/<plik lub
!!! "mod">.hcs`) - patrz definicje obu przy `find_libs_root` powyzej.
!!! Przyklad: `playground/lib/mod.hcs` z `include <work:hackerc::
!!! ast_nodes>` dostaje PRAWDZIWY `hackerc/cmd/ast_nodes.hcs`
!!! wkompilowany do WLASNEGO crate'a playground (jeden binarny plik
!!! wynikowy/`.wasm`, zero duplikacji zrodla) - tak jak `mod` w Rust
!!! moze wskazywac na plik spoza wlasnego katalogu przez `#[path =
!!! "..."]`, tylko bez potrzeby takiej adnotacji.
fun resolve_include_path(raw_path: Str, base_dir: Str) -> Option<Str> [
    if raw_path.len() >= 5 and raw_path.slice(0, 5) == "work:" [
        let rest = raw_path.slice(5, raw_path.len())
        let member = rest
        let subpath: Option<Str> = none()
        let sep = find_substr(rest, "::")
        if sep >= 0 [
            member = rest.slice(0, sep)
            subpath = some(rest.slice(sep + 2, rest.len()))
        ]
        match find_workspace_root(base_dir, member.clone()) [
            Some(wr) -> [
                let candidate = work_module_file_path(wr, member, subpath)
                if file_readable(candidate.clone()) [
                    end some(candidate)
                ]
                end none()
            ]
            None -> [
                end none()
            ]
        ]
    ]
    if raw_path.len() >= 4 and raw_path.slice(raw_path.len() - 4, raw_path.len()) == ".hcs" [
        let candidate = path_join_safe(base_dir, raw_path)
        if file_readable(candidate.clone()) [
            end some(candidate)
        ]
        end none()
    ]
    let file_candidate = path_join_safe(base_dir.clone(), raw_path.clone() + ".hcs")
    if file_readable(file_candidate.clone()) [
        end some(file_candidate)
    ]
    let dir_candidate = path_join_safe(base_dir, raw_path + "/mod.hcs")
    if file_readable(dir_candidate.clone()) [
        end some(dir_candidate)
    ]
    end none()
]

!!! Parytet z `flat_include_module_name` (project.py) - MUSI byc
!!! identyczna jak kopia w codegen.hcs (ta sama "umowa" co
!!! `flat_module_name`, patrz tam).
fun flat_include_module_name(path: Str) -> Str [
    let p = path
    if p.len() >= 4 and p.slice(p.len() - 4, p.len()) == ".hcs" [
        p = p.slice(0, p.len() - 4)
    ]
    let out = ""
    let i = 0
    let n = p.len()
    while i < n [
        let c = p.char_at(i)
        !! ZMIANA 0.4: ":" dopisane do zamienianych znakow - potrzebne
        !! dla nowego "work:czlonek::plik" (patrz resolve_include_path/
        !! parse_include), ktore inaczej wygenerowaloby nazwe modulu
        !! zawierajaca dwukropki - NIEPOPRAWNA jako identyfikator Rust.
        if c == "-" or c == "/" or c == ":" [
            out = out + "_"
        ] else [
            out = out + c
        ]
        i = i + 1
    ]
    end "_hks_inc_" + out
]

struct DiscoveredFile [
    path: Str,
    flat_name: Str,
    source: Str,
    program: Program,
    blocks: List<Str>,
    native_blocks: List<Str>,
    native_engines: List<Str>,
    sandbox_blocks: List<Str>,
    hot_reload_names: List<Str>,
    !! NOWOSC 0.4 - patrz `extract_wasm_export_markers()` w
    !! transpiler.hcs, parytet z `hot_reload_names` obok.
    wasm_export_names: List<Str>,
    !! ROZBUDOWA (ta runda, patrz docs/FAST_DIRECT.md) - `fast direct
    !! {backend} [ ... ]`, parytet z `blocks`/`native_engines` wyzej.
    fast_direct_blocks: List<Str>,
    fast_direct_backends: List<Str>
]

struct ProjectResult [
    crate_dir: Str,
    main_rs_path: Str,
    module_files: List<Str>,
    cargo_toml_path: Str,
    needs_pyo3: Bool,
    needs_native_js: Bool,
    needs_sandbox: Bool,
    needs_hot_reload: Bool,
    crates_deps_names: List<Str>,
    crates_deps_versions: List<Str>,
    warnings: List<Str>,
    !! ZMIANA 0.3 - patrz `TranspileResult::needs_native_cpp`/
    !! `extern_link_specs` w transpiler.hcs.
    needs_native_cpp: Bool,
    extern_links_path: Option<Str>,
    !! NOWOSC 0.4 - parytet z `needs_hot_reload` powyzej, ale dla
    !! `@wasm_export`/`wasm-bindgen`. `virus/cmd/build.hcs` czyta to
    !! przy `virus build --wasm`, zeby ostrzec, gdy w calym projekcie
    !! nie ma ani jednej `@wasm_export` funkcji (crate zbudowalby sie,
    !! ale eksportowalby zero funkcji do JS - prawie na pewno pomylka
    !! uzytkownika, nie celowy wybor).
    needs_wasm_bindgen: Bool
]

!!! Wewnetrzny akumulator odkrytych plikow + kolejki BFS importow -
!!! wlasny struct zamiast kilku osobnych `let`-ow przekazywanych
!!! recznie (HackerScript nie ma domkniec/closures mutujacych otoczenie
!!! poza `self`, patrz docs/SYNTAX.md) - parytet z lokalnymi zmiennymi
!!! `files`/`seen`/`queue` w `_resolve_project_files` (Python).
struct Discovery [
    files: List<DiscoveredFile>,
    seen_flat_names: Dict<Str, Bool>,
    warnings: List<Str>
]

impl Discovery [
    !!! Parsuje jeden plik (po wyciagnieciu `direct[...]`, jak wszedzie
    !!! indziej) i dodaje go do `self.files`. Zwraca `true` przy
    !!! sukcesie.
    fun parse_and_add(self, path: Str, flat_name: Str, source_tag: Str) -> Bool [
        match read_file(path.clone()) [
            Ok(source) -> [
                let fast_direct_extraction = extract_fast_direct_blocks(source.clone())
                let extraction = extract_direct_blocks(fast_direct_extraction.stripped_source)
                let native_extraction = extract_native_blocks(extraction.stripped_source, native_dirname(path))
                let sandbox_extraction = extract_sandbox_blocks(native_extraction.stripped_source)
                let hot_extraction = extract_hot_reload_markers(sandbox_extraction.stripped_source)
                let wasm_extraction = extract_wasm_export_markers(hot_extraction.stripped_source)
                let prog = parse(wasm_extraction.stripped_source)
                self.files.push(DiscoveredFile(path, flat_name, source_tag, prog, extraction.blocks, native_extraction.blocks, native_extraction.engines, sandbox_extraction.blocks, hot_extraction.names, wasm_extraction.names, fast_direct_extraction.blocks, fast_direct_extraction.backends))
                end true
            ]
            Err(e) -> [
                self.warnings.push(path + ": " + e)
                end false
            ]
        ]
    ]

    !!! Faza 1 (discovery): parsuje `entry` + rekurencyjnie kazdy
    !!! zaimportowany modul `std`/`core`/`selfhost`/`vira`/`work` - BFS
    !!! po `GetImportStmt`. Parytet z `_resolve_project_files`.
    !!! `vira_root` DODANE w tej rundzie (patrz `find_vira_cache_root`).
    !!! `work` (NOWOSC 0.4, patrz `find_workspace_root`) NIE dostaje
    !!! wlasnego parametru "root" tutaj - w przeciwienstwie do
    !!! `vira_root`/`libs_root`/`bootstrap_root` (policzonych RAZ dla
    !!! calego `entry`), korzen workspace zalezy od NAZWY CZLONKA (innej
    !!! dla kazdego `get <work:...>`), wiec jest liczony na biezaco w
    !!! petli nizej.
    fun resolve(self, entry: Str, libs_root: Option<Str>, bootstrap_root: Option<Str>, vira_root: Option<Str>) [
        let added = self.parse_and_add(entry.clone(), "main", "main")
        if not added [
            end
        ]

        let queue: List<QueueItem> = []
        let entry_prog = self.files[0].program.clone()
        collect_module_imports(entry_prog, path_parent(entry.clone()), queue)

        while queue.len() > 0 [
            let item = queue.remove(0)
            let imp = item.stmt
            let base_dir = item.base_dir
            match imp [
                GetImportStmt(isource, iname, iversion, idetails) -> [
                    let flat = flat_module_name(isource.clone(), iname.clone(), iversion.clone())
                    if not self.seen_flat_names.contains(flat.clone()) [
                        self.seen_flat_names.insert(flat.clone(), true)

                        let mod_file = ""
                        let have_root = false
                        if isource == "selfhost" [
                            match bootstrap_root.clone() [
                                Some(br) -> [
                                    mod_file = selfhost_module_file_path(br, iname.clone(), iversion.clone())
                                    have_root = true
                                ]
                                None -> [
                                    self.warnings.push("get <selfhost:" + iname.clone() + "> - nie znaleziono katalogu bootstrap/hackerc-self/ - modul " + flat.clone() + " nie zostanie zbudowany")
                                ]
                            ]
                        ] elif isource == "vira" [
                            match vira_root.clone() [
                                Some(vr) -> [
                                    mod_file = vira_module_file_path(vr, iname.clone(), iversion.clone())
                                    have_root = true
                                ]
                                None -> [
                                    self.warnings.push("get <vira:" + iname.clone() + "> - nie znaleziono katalogu cache/libs/vira/ - uruchom `virus install vira " + iname.clone() + "` (modul " + flat.clone() + " nie zostanie zbudowany)")
                                ]
                            ]
                        ] elif isource == "work" [
                            !!! NOWOSC 0.4 - w odroznieniu od `vira_root`/
                            !!! `libs_root` (policzone RAZ, dla calego
                            !!! `entry`, przed petla), korzen workspace
                            !!! zalezy tu od `iname` (nazwy CZLONKA) -
                            !!! wiec liczymy go na biezaco, per import,
                            !!! zaczynajac szukanie od katalogu pliku,
                            !!! ktory ten import napisal (`base_dir`) -
                            !!! dziala wiec tak samo z dowolnego miejsca
                            !!! w workspace, nie tylko z korzenia.
                            match find_workspace_root(base_dir.clone(), iname.clone()) [
                                Some(wr) -> [
                                    mod_file = work_module_file_path(wr, iname.clone(), iversion.clone())
                                    have_root = true
                                ]
                                None -> [
                                    self.warnings.push("get <work:" + iname.clone() + "> - nie znaleziono czlonka workspace \"" + iname.clone() + "\" z wlasnym lib/mod.hcs (szukano <przodek>/" + iname.clone() + "/lib w gore od " + base_dir.clone() + ") - modul " + flat.clone() + " nie zostanie zbudowany")
                                ]
                            ]
                        ] elif isource == "hlib" [
                            let hlib_path = find_hlib_file_path(iname.clone(), iversion.clone(), base_dir.clone(), vira_root.clone(), libs_root.clone())
                            match hlib_path [
                                Some(hp) -> [
                                    let extract_dir = path_join_safe(path_parent(hp.clone()), ".hlib-extracted/" + iname.clone())
                                    let bound_file = hlib_extract_for_import(hp.clone(), iname.clone(), extract_dir)
                                    if bound_file == "" [
                                        self.warnings.push("get <hlib:" + iname.clone() + "> -> " + hp.clone() + " nie ma ani artefaktu `ast`, ani `.so` dla tego hosta - nic do zaimportowania")
                                    ] else [
                                        mod_file = bound_file
                                        have_root = true
                                    ]
                                ]
                                None -> [
                                    self.warnings.push("get <hlib:" + iname.clone() + "> - nie znaleziono .hlib. Sprawdzone: <vira>/" + iname.clone() + "/" + iname.clone() + ".hlib, hlibs/" + iname.clone() + ".hlib (w projekcie i katalogach nadrzednych), libs/hlib/" + iname.clone() + ".hlib, /usr/lib/HackerOS/HackerScript/hlibs/" + iname.clone() + ".hlib. Zbuduj jeden przez `hackerc build --hlib " + iname.clone() + ".hcs`.")
                                ]
                            ]
                        ] else [
                            match libs_root.clone() [
                                Some(lr) -> [
                                    mod_file = module_file_path(lr, isource.clone(), iname.clone(), iversion.clone())
                                    have_root = true
                                ]
                                None -> [
                                    self.warnings.push("get <" + isource.clone() + ":" + iname.clone() + "> - nie znaleziono katalogu libs/ - modul " + flat.clone() + " nie zostanie zbudowany")
                                ]
                            ]
                        ]

                        if have_root [
                            if file_readable(mod_file.clone()) [
                                let ok = self.parse_and_add(mod_file.clone(), flat, isource)
                                if ok [
                                    let last_prog = self.files[self.files.len() - 1].program.clone()
                                    collect_module_imports(last_prog, path_parent(mod_file), queue)
                                ]
                            ] else [
                                self.warnings.push("get <" + isource + ":" + iname + "> -> nie znaleziono " + mod_file)
                            ]
                        ]
                    ]
                ]
                IncludeStmt(path) -> [
                    let flat = flat_include_module_name(path.clone())
                    if not self.seen_flat_names.contains(flat.clone()) [
                        self.seen_flat_names.insert(flat.clone(), true)
                        match resolve_include_path(path.clone(), base_dir.clone()) [
                            Some(mod_file) -> [
                                let ok = self.parse_and_add(mod_file.clone(), flat, "include")
                                if ok [
                                    let last_prog = self.files[self.files.len() - 1].program.clone()
                                    collect_module_imports(last_prog, path_parent(mod_file), queue)
                                ]
                            ]
                            None -> [
                                self.warnings.push("include <" + path.clone() + "> -> nie znaleziono " + path_join_safe(base_dir.clone(), path.clone() + ".hcs") + " ani " + path_join_safe(base_dir, path + "/mod.hcs"))
                            ]
                        ]
                    ]
                ]
                _ -> [
                ]
            ]
        ]
    ]
]

!!! Dopisuje do `queue` kazdy `GetImportStmt` (dla `std`/`core`/
!!! `selfhost`/`virus`/`vira`/`work`/`hlib`) i kazdy `IncludeStmt` na
!!! najwyzszym poziomie `prog` - parytet z `module_stmts()`
!!! (project.py). `work` DODANE w 0.4 (patrz `find_workspace_root`
!!! powyzej) - `get <work:member[::plik]>`, ogolny odpowiednik Rustowego
!!! `use nazwa_membera::...;` dla DOWOLNEGO czlonka workspace majacego
!!! `lib/mod.hcs` (nie tylko `core`/`std`, ktore maja wlasne,
!!! krotsze aliasy `get <core:...>`/`get <std:...>`).
!!! `base_dir` (katalog pliku `prog` pochodzi z) jest doczepiany do
!!! kazdego elementu - potrzebny pozniej WYLACZNIE dla `IncludeStmt`.
!!! `vira` DODANE w tej rundzie - TYLKO dla bibliotek Vira typu "git"
!!! (patrz `find_vira_cache_root`) - `static-lib`/`shared-lib`/
!!! `rust-lib` (ani `get <c:...>`/`get <cpp:...>`, DODANE w 0.3) nie sa
!!! .hcs zrodlem, wiec nigdy nie trafiaja tutaj (nie ma dla nich
!!! zadnego pliku do sparsowania - sa uzywane przez
!!! `get <extern:nazwa> use <tryb>` + `region [ ... ]` po
!!! podlinkowaniu, patrz komentarz przy `find_vira_cache_root`
!!! powyzej). `hlib` DODANE w 0.4 (patrz `hlib.hcs` i
!!! `find_hlib_file_path` powyzej) - w odroznieniu od `vira`/`c`/`cpp`
!!! ZAWSZE konczy sie plikiem `.hcs` do sparsowania (badz to prawdziwym
!!! zrodlem z artefaktu `ast`, badz to WYGENEROWANYM przez
!!! `hlib_extract_for_import` stubem `get <extern:...>`+`region`) -
!!! wiec `get <hlib:x>` nigdy nie wymaga od uzytkownika pisania
!!! `extern`/`native` samemu, tylko samego `get <hlib:x>`.
fun collect_module_imports(prog: Program, base_dir: Str, queue: List<QueueItem>) [
    let i = 0
    let n = prog.body.len()
    while i < n [
        let s = prog.body[i].clone()
        match s.clone() [
            GetImportStmt(source, name, version, details) -> [
                if source == "std" or source == "core" or source == "selfhost" or source == "virus" or source == "vira" or source == "hlib" or source == "work" [
                    queue.push(QueueItem(s, base_dir.clone()))
                ]
            ]
            IncludeStmt(path) -> [
                queue.push(QueueItem(s, base_dir.clone()))
            ]
            _ -> [
            ]
        ]
        i = i + 1
    ]
]

!!! Wynik `collect_project_signatures` - `ExtraSignatures` (z
!!! transpiler.hcs) plus ostrzezenia discovery. Parytet z krotka
!!! 7-elementowa w Pythonie (`global_functions, ..., warnings`) - jeden
!!! struct zamiast tupli (HackerScript nie ma generycznych tupli).
struct ProjectSignatures [
    sigs: ExtraSignatures,
    warnings: List<Str>
]

!!! Faza 1 z `build_project` (discovery + globalny rejestr sygnatur),
!!! wydzielona do samodzielnego uzycia - parytet z
!!! `collect_project_signatures`. `libs_root`/`bootstrap_root`/
!!! `vira_root` `none()` -> auto-wykrywanie przez
!!! `find_libs_root`/`find_bootstrap_root`/`find_vira_cache_root`
!!! zaczynajac od `entry`.
fun collect_project_signatures(entry: Str, libs_root: Option<Str>, bootstrap_root: Option<Str>, vira_root: Option<Str>) -> ProjectSignatures [
    let lr = libs_root
    match lr.clone() [
        Some(_v) -> [
        ]
        None -> [
            lr = find_libs_root(entry.clone())
        ]
    ]
    let br = bootstrap_root
    match br.clone() [
        Some(_v) -> [
        ]
        None -> [
            br = find_bootstrap_root(entry.clone())
        ]
    ]
    let vr = vira_root
    match vr.clone() [
        Some(_v) -> [
        ]
        None -> [
            vr = find_vira_cache_root(entry.clone())
        ]
    ]

    let disc = Discovery([], dict(), [])
    disc.resolve(entry, lr, br, vr)

    let functions: Dict<Str, Stmt> = dict()
    let function_names: List<Str> = []
    let structs: Dict<Str, Stmt> = dict()
    let struct_names: List<Str> = []
    let enums: Dict<Str, Stmt> = dict()
    let enum_names: List<Str> = []
    let methods: Dict<Str, Stmt> = dict()
    let method_names: List<Str> = []
    let mut_params: Dict<Str, Bool> = dict()
    let method_mut_params: Dict<Str, Bool> = dict()
    !! NAPRAWIONY BUG (ta runda) - patrz komentarz przy
    !! `ExtraSignatures::extern_fn_names` w transpiler.hcs.
    let extern_fn_names: Dict<Str, Bool> = dict()
    let extern_fn_name_list: List<Str> = []

    let fi = 0
    let fn_ = disc.files.len()
    while fi < fn_ [
        let df = disc.files[fi].clone()
        let si = 0
        let sn = df.program.body.len()
        while si < sn [
            let stmt = df.program.body[si].clone()
            match stmt.clone() [
                FunDecl(name, params, ret, body, is_pub, type_params) -> [
                    functions.insert(name.clone(), stmt)
                    function_names.push(name)
                ]
                StructDecl(name, fields, type_params) -> [
                    structs.insert(name.clone(), stmt)
                    struct_names.push(name)
                ]
                EnumDecl(name, variants, type_params) -> [
                    enums.insert(name.clone(), stmt)
                    enum_names.push(name)
                ]
                ImplDecl(struct_name, impl_methods, type_params) -> [
                    let mi = 0
                    let mn = impl_methods.len()
                    while mi < mn [
                        let m = impl_methods[mi].clone()
                        match m.clone() [
                            FunDecl(mname, mparams, mret, mbody, mis_pub, mtype_params) -> [
                                let key = struct_name.clone() + "::" + mname.clone()
                                methods.insert(key.clone(), m)
                                method_names.push(key)
                            ]
                            _ -> [
                            ]
                        ]
                        mi = mi + 1
                    ]
                ]
                RegionBlock(region_sigs) -> [
                    let ri = 0
                    let rn = region_sigs.len()
                    while ri < rn [
                        let rsig = region_sigs[ri].clone()
                        if not extern_fn_names.contains(rsig.name.clone()) [
                            extern_fn_names.insert(rsig.name.clone(), true)
                            extern_fn_name_list.push(rsig.name.clone())
                        ]
                        ri = ri + 1
                    ]
                ]
                _ -> [
                ]
            ]
            si = si + 1
        ]

        let file_mut_params = compute_mut_params(df.program.clone())
        let fmi = 0
        let fmn = function_names.len()
        while fmi < fmn [
            match file_mut_params.fetch(function_names[fmi].clone()) [
                Some(v) -> [
                    mut_params.insert(function_names[fmi].clone(), v)
                ]
                None -> [
                ]
            ]
            fmi = fmi + 1
        ]

        let empty_extra: Dict<Str, Bool> = dict()
        let file_method_mut_params = compute_method_mut_params(df.program.clone(), empty_extra)
        let mmi = 0
        let mmn = method_names.len()
        while mmi < mmn [
            match file_method_mut_params.fetch(method_names[mmi].clone()) [
                Some(v) -> [
                    method_mut_params.insert(method_names[mmi].clone(), v)
                ]
                None -> [
                ]
            ]
            mmi = mmi + 1
        ]

        fi = fi + 1
    ]

    let sigs = ExtraSignatures(functions, function_names, structs, struct_names, enums, enum_names, methods, method_names, mut_params, method_mut_params, extern_fn_names, extern_fn_name_list)
    end ProjectSignatures(sigs, disc.warnings)
]

fun cargo_toml_text(crate_name: Str, needs_pyo3: Bool, needs_native_js: Bool, needs_sandbox: Bool, needs_hot_reload: Bool, needs_native_cpp: Bool, needs_wasm_bindgen: Bool, force_library: Bool, deps_names: List<Str>, deps_versions: List<Str>, needs_native_java: Bool, needs_sha256: Bool) -> Str [
    let deps_lines = ""
    if needs_pyo3 [
        deps_lines = deps_lines + "pyo3 = { version = \"0.22\", features = [\"auto-initialize\"] }\n"
    ]
    if needs_native_js [
        deps_lines = deps_lines + "rquickjs = \"0.6\"\n"
    ]
    if needs_sandbox [
        deps_lines = deps_lines + "libc = \"0.2\"\n"
    ]
    if needs_hot_reload [
        deps_lines = deps_lines + "libloading = \"0.8\"\n"
    ]
    !! NOWOSC 0.4 - `wasm-bindgen` dla `@wasm_export` (patrz
    !! `CARGO_TOML_WASM_MID` powyzej i `virus/cmd/build.hcs`, gdzie
    !! `virus build --wasm` faktycznie kompiluje ten crate na
    !! `wasm32-unknown-unknown`).
    if needs_wasm_bindgen [
        deps_lines = deps_lines + "wasm-bindgen = \"0.2\"\n"
    ]
    !! ROZBUDOWA (ta runda, patrz docs/JAVA.md) - `jni` dla `native
    !! {java}(...)` - w [dependencies] (nie [build-dependencies], w
    !! odroznieniu od `cc` przy C++) - embedded JVM zyje W RUNTIME
    !! skompilowanej binarki, nie tylko podczas budowania. Feature
    !! "invocation" wlacza tworzenie JVM z poziomu Rusta
    !! (`JavaVM::new`) - bez niej crate `jni` obsluguje tylko
    !! ODWROTNY kierunek (Java->Rust, `#[no_mangle] extern "system"
    !! fn Java_...`), ktory NIE jest tym, czego potrzebuje `native
    !! {java}(...)` (Rust->Java).
    if needs_native_java [
        deps_lines = deps_lines + "jni = { version = \"0.21\", features = [\"invocation\"] }\n"
    ]
    !! ROZBUDOWA (ta runda) - `sha256_hex(...)` - `sha2`/`hex` to juz
    !! sprawdzone zaleznosci tego bootstrapu (patrz `hlib.hcs`).
    !! NAPRAWIONY BUG (ta runda, znaleziony realnym buildem na
    !! `hackerc` samym w sobie - patrz docs/ROADMAP.md): `hlib.hcs`
    !! JUZ deklaruje `sha2`/`hex` przez `get <crates:sha2::0.10>` (w
    !! `deps_names`/`deps_versions` ponizej) - bez tego sprawdzenia
    !! dublowalibysmy wpis `[dependencies] sha2 = ...` (Cargo/TOML
    !! odrzuca zduplikowane klucze w tej samej tabeli) za KAZDYM razem,
    !! gdy projekt uzywa I `sha256_hex` (wykrywane przez skan tekstu
    !! wygenerowanego kodu, patrz transpiler.hcs), I czegokolwiek z
    !! `hlib.hcs` (albo wlasnego `get <crates:sha2...>`).
    if needs_sha256 and not list_contains_str(deps_names, "sha2") [
        deps_lines = deps_lines + "sha2 = \"0.10\"\n"
    ]
    if needs_sha256 and not list_contains_str(deps_names, "hex") [
        deps_lines = deps_lines + "hex = \"0.4\"\n"
    ]
    let i = 0
    let n = deps_names.len()
    while i < n [
        !!! `ed25519-dalek` - `hlib.hcs::hlib_keygen` wola
        !!! `SigningKey::generate(&mut OsRng)`, ktore w wersji 2.x
        !!! jest schowane za opcjonalnym feature'em `rand_core`
        !!! (`#[cfg(any(test, feature = "rand_core"))]` w
        !!! signing.rs) - bez tego `cargo build` konczy sie
        !!! `E0599: no function or associated item named 'generate'`.
        !!! `ureq` (`get <std:http>`, `libs/std/lib/http.hcs`) - domyslnie
        !!! (feature "tls") uzywa `webpki-roots`, czyli migawki
        !!! zaufanych CA WBUDOWANEJ w binarke W CHWILI KOMPILACJI - na
        !!! systemie z inna (np. starsza, przypieta pod stary `rustc`
        !!! przy budowaniu samego hackerc/virus) wersja `rustls`/
        !!! `webpki-roots` niz ta, ktorej Cargo akurat uzyje, zdarza sie
        !!! `invalid peer certificate: UnknownIssuer` mimo poprawnego,
        !!! aktualnego systemowego magazynu CA (zweryfikowane w praktyce
        !!! przy `virus install bytes/bit` na GitHub - patrz PR o
        !!! "bytes"/"bit"). Feature "native-certs" przelacza na
        !!! `rustls-native-certs` (systemowy magazyn CA, zawsze
        !!! aktualny wzgledem dystrybucji) - bezpieczniejszy domyslny
        !!! wybor dla WSZYSTKICH uzytkownikow `get <std:http>`
        !!! (pypi/crates/npm/jsr/vira/bytes/bit), nie tylko obejscie na
        !!! potrzeby jednego srodowiska.
        if deps_names[i] == "ureq" [
            deps_lines = deps_lines + deps_names[i] + " = { version = \"" + deps_versions[i] + "\", features = [\"native-certs\"] }\n"
        ] elif deps_names[i] == "ed25519-dalek" [
            deps_lines = deps_lines + deps_names[i] + " = { version = \"" + deps_versions[i] + "\", features = [\"rand_core\"] }\n"
        ] else [
            deps_lines = deps_lines + deps_names[i] + " = \"" + deps_versions[i] + "\"\n"
        ]
        i = i + 1
    ]
    !!! ZMIANA 0.3 - `native` `{C++}` `[ ... ]` (patrz `codegen.hcs::gen_native`)
    !!! wymaga kompilatora C++ dostepnego przez `cc::Build` w
    !!! `build.rs` - `cc` idzie do `[build-dependencies]` (NIE
    !!! `[dependencies]`, bo dziala TYLKO w trakcie budowy, nie w
    !!! wygenerowanym binarnym), pisany przez `virus build` po tym
    !!! pliku (patrz `virus/cmd/build.hcs::build_wire_extern_dependencies`).
    let build_deps_section = ""
    if needs_native_cpp [
        build_deps_section = "\n[build-dependencies]\ncc = \"1\"\n"
    ]
    !! NOWOSC 0.4 - `[lib]` (cdylib+rlib, `src/lib.rs`) zamiast `[[bin]]`
    !! (`src/main.rs`) gdy ten crate ma co najmniej jedna funkcje
    !! `@wasm_export` - patrz `CARGO_TOML_WASM_MID` powyzej i
    !! `build_project()` nizej (decyduje, czy pisac `src/main.rs` czy
    !! `src/lib.rs`, dokladnie w parze z ta galezia).
    if needs_wasm_bindgen [
        end CARGO_TOML_HEADER + crate_name + CARGO_TOML_WASM_MID + deps_lines + build_deps_section
    ]
    !! ROZBUDOWA (ta runda) - `--library`/`TargetLibrary`. Sprawdzane
    !! PO `needs_wasm_bindgen` celowo: gdy oba sa prawda (projekt ma
    !! `@wasm_export` I zostal zbudowany z `--library`), wygrywa WASM
    !! (jego `[lib]` juz i tak zawiera "rlib" obok "cdylib" - patrz
    !! `CARGO_TOML_WASM_MID` - wiec jest STRICT SUPERSETEM tego, co
    !! `--library` samo by dalo).
    if force_library [
        end CARGO_TOML_HEADER + crate_name + CARGO_TOML_LIBRARY_MID + deps_lines + build_deps_section
    ]
    end CARGO_TOML_HEADER + crate_name + CARGO_TOML_MID + crate_name + CARGO_TOML_TAIL + deps_lines + build_deps_section
]

!!! Wstawia `mod X;` (deklaracje modulow) do `entry_rust` PO ostatniej
!!! wiodacej linii `//`/`//!`/`#![...]`/pustej - NIGDY przed nia (Rust
!!! odrzuca atrybuty wewnetrzne, ktore nie sa pierwszymi tokenami w
!!! pliku - E0753). Bug znaleziony i naprawiony w `project.py` przy
!!! pierwszej realnej kompilacji `cargo build` wielomodulowego projektu
!!! w tej sesji (poprzednio niemozliwe bez dostepu do rustc) - ten plik
!!! implementuje to poprawnie OD RAZU, zamiast powtarzac ten sam blad.
fun insert_mod_declarations(entry_rust: Str, mod_names: List<Str>) -> Str [
    if mod_names.len() == 0 [
        end entry_rust
    ]
    let mod_header = ""
    let i = 0
    let n = mod_names.len()
    while i < n [
        mod_header = mod_header + "mod " + mod_names[i] + ";\n"
        i = i + 1
    ]

    let lines = split_lines_local(entry_rust)
    let insert_at = 0
    let j = 0
    let ln = lines.len()
    let scanning = true
    while j < ln and scanning [
        let line = lines[j]
        let is_leading = starts_with(line.clone(), "//") or starts_with(line.clone(), "#![") or trim_str(line.clone()) == ""
        if is_leading [
            insert_at = j + 1
        ] else [
            scanning = false
        ]
        j = j + 1
    ]

    let out_lines: List<Str> = []
    let k = 0
    while k < insert_at [
        out_lines.push(lines[k].clone())
        k = k + 1
    ]
    out_lines.push("")
    out_lines.push(mod_header)
    out_lines.push("")
    while k < ln [
        out_lines.push(lines[k].clone())
        k = k + 1
    ]

    let joined = ""
    let m = 0
    let mn = out_lines.len()
    while m < mn [
        joined = joined + out_lines[m]
        if m < mn - 1 [
            joined = joined + "\n"
        ]
        m = m + 1
    ]
    end joined
]

fun starts_with(s: Str, prefix: Str) -> Bool [
    let pn = prefix.len()
    if pn > s.len() [
        end false
    ]
    end s.slice(0, pn) == prefix
]

fun trim_str(s: Str) -> Str [
    let n = s.len()
    let start = 0
    while start < n and (s.char_at(start) == " " or s.char_at(start) == "\t") [
        start = start + 1
    ]
    let end_i = n
    while end_i > start and (s.char_at(end_i - 1) == " " or s.char_at(end_i - 1) == "\t") [
        end_i = end_i - 1
    ]
    end s.slice(start, end_i)
]

!!! Transpiluje `entry` + rekurencyjnie kazdy modul `std`/`core`/
!!! `selfhost`, ktory importuje, do PELNEGO crate'a Rust w `out_dir`
!!! (Cargo.toml + src/). NIE kompiluje (to robi `virus`/`cargo build`).
!!!
!!! Tworzy `out_dir + "/src"` SAMO (przez `create_dir`, patrz
!!! `get <std:fs>` - dodane w tej sesji), parytet z `out_dir.mkdir(
!!! parents=True, exist_ok=True)` w Pythonie. Jesli tworzenie katalogu
!!! sie nie uda (np. brak uprawnien), zapis kazdego pliku i tak
!!! sprobuje samodzielnie i doda `Err` do `warnings`, wiec brak
!!! twardego przerwania calej budowy.
!!! ROZBUDOWA (ta runda) - `bin_name`: `none()` = zachowanie
!!! dotychczasowe (`src/main.rs`/`src/lib.rs` + PELNY, nadpisujacy
!!! zapis `Cargo.toml`). `some(nazwa)` = multi-binarki (odpowiednik
!!! Cargo `src/bin/*.rs`, patrz `docs/VIRUS.md`, "Plan: multi-binarki
!!! na czlonka") - PISZE do `src/bin/<nazwa>.rs` i DOPISUJE (nie
!!! nadpisuje) sekcje `[[bin]]` do JUZ ISTNIEJACEGO `Cargo.toml` -
!!! wywolujacy (`virus build`/`cmd_build` w main.hcs) MUSI wiec
!!! najpierw zbudowac glowny entry (`cmd/main.hcs`, `bin_name =
!!! none()`), ktory tworzy `Cargo.toml` od zera, zanim zbuduje
!!! ktorykolwiek dodatkowy `cmd/bin/*.hcs` z `bin_name = some(...)`.
fun build_project(entry: Str, out_dir: Str, libs_root: Option<Str>, bootstrap_root: Option<Str>, vira_root: Option<Str>, crate_name: Str, force_library: Bool, bin_name: Option<Str>) -> ProjectResult [
    let src_dir = out_dir + "/src"
    let main_rs_path = src_dir + "/main.rs"
    let warnings: List<Str> = []

    match create_dir(src_dir.clone()) [
        Ok(_v) -> [
        ]
        Err(e) -> [
            warnings.push(src_dir.clone() + ": " + e)
        ]
    ]

    let lr = libs_root
    match lr.clone() [
        Some(_v) -> [
        ]
        None -> [
            lr = find_libs_root(entry.clone())
        ]
    ]
    let br = bootstrap_root
    match br.clone() [
        Some(_v) -> [
        ]
        None -> [
            br = find_bootstrap_root(entry.clone())
        ]
    ]
    let vr = vira_root
    match vr.clone() [
        Some(_v) -> [
        ]
        None -> [
            vr = find_vira_cache_root(entry.clone())
        ]
    ]

    let disc = Discovery([], dict(), [])
    disc.resolve(entry.clone(), lr.clone(), br.clone(), vr.clone())
    let i = 0
    let wn = disc.warnings.len()
    while i < wn [
        warnings.push(disc.warnings[i].clone())
        i = i + 1
    ]

    let ps = collect_project_signatures(entry, lr, br, vr)
    let extra = ps.sigs

    let needs_pyo3 = false
    let needs_native_js = false
    let needs_sandbox = false
    let needs_hot_reload = false
    !! NOWOSC 0.4 - patrz `TranspileResult::needs_wasm_bindgen`/
    !! `CodeGen::needs_wasm_bindgen` (parytet z `needs_pyo3` powyzej).
    let needs_wasm_bindgen = false
    !!! ZMIANA 0.3 - patrz `TranspileResult::needs_native_cpp`/
    !!! `extern_link_specs` (transpiler.hcs) i `collect_extern_link_specs`.
    let needs_native_cpp = false
    let extern_link_specs: List<Str> = []
    !! DODANE - patrz `CodeGen::native_cpp_sources`/`TranspileResult::native_cpp_sources`.
    let native_cpp_sources: Dict<Str, Str> = dict()
    let native_cpp_names: List<Str> = []
    !! ROZBUDOWA (ta runda) - parytet z `native_cpp_sources`/
    !! `native_cpp_names` wyzej, dla `native {java}(...)`.
    let needs_native_java = false
    let native_java_sources: Dict<Str, Str> = dict()
    let native_java_names: List<Str> = []
    !! ROZBUDOWA (ta runda) - `sha256_hex(...)`, parytet z `needs_pyo3`.
    let needs_sha256 = false
    let hot_reload_bodies: Dict<Str, Str> = dict()
    let hot_reload_order: List<Str> = []
    let hot_reload_source_path = ""
    let module_files: List<Str> = []
    let mod_names: List<Str> = []
    let crates_names: List<Str> = []
    let crates_versions: List<Str> = []
    let entry_rust = ""

    let fi = 0
    let fn_ = disc.files.len()
    while fi < fn_ [
        let df = disc.files[fi].clone()
        let r = transpile_program_with_extra(df.program.clone(), df.blocks.clone(), df.native_blocks.clone(), df.native_engines.clone(), df.sandbox_blocks.clone(), df.hot_reload_names.clone(), df.wasm_export_names.clone(), df.path.clone(), extra, df.fast_direct_blocks.clone(), df.fast_direct_backends.clone())

        if r.needs_pyo3 [
            needs_pyo3 = true
        ]
        if r.needs_sha256 [
            needs_sha256 = true
        ]
        if r.needs_native_js [
            needs_native_js = true
        ]
        if r.needs_sandbox [
            needs_sandbox = true
        ]
        if r.needs_native_cpp [
            needs_native_cpp = true
        ]
        if r.needs_wasm_bindgen [
            needs_wasm_bindgen = true
        ]
        let eli = 0
        let eln = r.extern_link_specs.len()
        while eli < eln [
            extern_link_specs.push(r.extern_link_specs[eli].clone())
            eli = eli + 1
        ]
        !! DODANE - scala `r.native_cpp_sources` (per-plikowy Dict z
        !! `TranspileResult`) do jednego, projektowego `native_cpp_sources`
        !! (klucze - nazwy `__hks_native_cpp_block_N` - sa unikalne
        !! globalnie w ramach JEDNEGO pliku, patrz `idx_text` w
        !! `codegen.hcs::gen_native`; miedzy plikami kolizja jest
        !! teoretycznie mozliwa, ale nieobslugiwana w tej rundzie,
        !! patrz docs/ROADMAP.md).
        let ncsi = 0
        let ncsn = r.native_cpp_order.len()
        while ncsi < ncsn [
            let fnname = r.native_cpp_order[ncsi].clone()
            match r.native_cpp_sources.fetch(fnname.clone()) [
                Some(src) -> [
                    native_cpp_sources.insert(fnname.clone(), src)
                    native_cpp_names.push(fnname.clone())
                    extern_link_specs.push("native_cpp\t" + fnname + "\t")
                ]
                None -> [
                ]
            ]
            ncsi = ncsi + 1
        ]
        !! ROZBUDOWA (ta runda, patrz docs/JAVA.md) - parytet z
        !! `native_cpp_sources` wyzej, ale kind "java_class" zamiast
        !! "native_cpp" (virus/cmd/build.hcs je rozroznia - `javac`
        !! zamiast `cc::Build`).
        if r.needs_native_java [
            needs_native_java = true
        ]
        let njsi = 0
        let njsn = r.native_java_order.len()
        while njsi < njsn [
            let cname = r.native_java_order[njsi].clone()
            match r.native_java_sources.fetch(cname.clone()) [
                Some(jsrc) -> [
                    native_java_sources.insert(cname.clone(), jsrc)
                    native_java_names.push(cname.clone())
                    extern_link_specs.push("java_class\t" + cname + "\t")
                ]
                None -> [
                ]
            ]
            njsi = njsi + 1
        ]
        let jcpi = 0
        let jcpn = r.java_classpath_entries.len()
        while jcpi < jcpn [
            extern_link_specs.push("java_cp\t" + r.java_classpath_entries[jcpi].clone() + "\t")
            jcpi = jcpi + 1
        ]
        if r.needs_hot_reload [
            needs_hot_reload = true
            if hot_reload_source_path == "" [
                hot_reload_source_path = df.path.clone()
            ]
            let hri = 0
            let hrn = r.hot_reload_order.len()
            while hri < hrn [
                let hrname = r.hot_reload_order[hri].clone()
                match r.hot_reload_bodies.fetch(hrname.clone()) [
                    Some(hrbody) -> [
                        hot_reload_bodies.insert(hrname.clone(), hrbody)
                        hot_reload_order.push(hrname)
                    ]
                    None -> [
                    ]
                ]
                hri = hri + 1
            ]
        ]

        let si = 0
        let sn = df.program.body.len()
        while si < sn [
            match df.program.body[si].clone() [
                GetImportStmt(isource, iname, iversion, idetails) -> [
                    if isource == "crates" [
                        crates_names.push(iname)
                        match iversion [
                            Some(v) -> [
                                crates_versions.push(v)
                            ]
                            None -> [
                                crates_versions.push("*")
                            ]
                        ]
                    ]
                ]
                _ -> [
                ]
            ]
            si = si + 1
        ]

        if df.flat_name == "main" [
            entry_rust = r.rust_code
        ] else [
            let mod_out = src_dir + "/" + df.flat_name + ".rs"
            match write_file(mod_out.clone(), r.rust_code) [
                Ok(_v) -> [
                    module_files.push(mod_out)
                    mod_names.push(df.flat_name)
                ]
                Err(e) -> [
                    warnings.push(mod_out + ": " + e)
                ]
            ]
        ]
        fi = fi + 1
    ]

    entry_rust = insert_mod_declarations(entry_rust, mod_names)
    !! NOWOSC 0.4 - `needs_wasm_bindgen` jest w pelni znane dopiero TU
    !! (po petli po wszystkich plikach) - dopiero teraz przełączamy
    !! docelowa sciezke pliku wejsciowego z `src/main.rs` na
    !! `src/lib.rs`, w parze z `cargo_toml_text(...)` nizej (ktora
    !! dostaje ten sam `needs_wasm_bindgen` i pisze `[lib] -> path =
    !! "src/lib.rs"` zamiast `[[bin]] -> path = "src/main.rs"`).
    !! ROZBUDOWA (ta runda) - `force_library` (`--library`, patrz
    !! `TargetLibrary` w `virus/cmd/build.hcs`) przelacza docelowa
    !! sciezke na `src/lib.rs` dokladnie tak samo, jak juz robi to
    !! `needs_wasm_bindgen` - `entry_rust` (kod funkcji uzytkownika) jest
    !! IDENTYCZNY w obu przypadkach, rozni sie tylko plik docelowy i
    !! sekcja Cargo.toml (patrz `cargo_toml_text` wyzej).
    if needs_wasm_bindgen or force_library [
        main_rs_path = src_dir + "/lib.rs"
    ]
    !! ROZBUDOWA (ta runda) - multi-binarki: `bin_name = some(x)`
    !! przekierowuje docelowy plik na `src/bin/<x>.rs` (WYGRYWA nad
    !! `needs_wasm_bindgen`/`force_library` powyzej - dodatkowa
    !! binarka nigdy nie jest ani `@wasm_export`-owym `[lib]`, ani
    !! `--library` samym w sobie, to zawsze zwykla binarka).
    let extra_bin_path: Option<Str> = none()
    match bin_name.clone() [
        Some(bn) -> [
            let bin_dir = src_dir + "/bin"
            match create_dir(bin_dir.clone()) [
                Ok(_v) -> [
                ]
                Err(e) -> [
                    warnings.push(bin_dir + ": " + e)
                ]
            ]
            main_rs_path = bin_dir + "/" + bn + ".rs"
            extra_bin_path = some(bn)
        ]
        None -> [
        ]
    ]
    match write_file(main_rs_path.clone(), entry_rust) [
        Ok(_v) -> [
        ]
        Err(e) -> [
            warnings.push(main_rs_path + ": " + e)
        ]
    ]

    let cargo_toml_path = out_dir + "/Cargo.toml"
    match extra_bin_path.clone() [
        Some(bn2) -> [
            !! DOPISUJEMY do Cargo.toml juz istniejacego (napisanego
            !! przez WCZESNIEJSZE wywolanie build_project z
            !! `bin_name = none()` dla `cmd/main.hcs` tego samego
            !! czlonka) - nigdy nie nadpisujemy calosci, inaczej
            !! stracilibysmy [[bin]] glownej binarki + [dependencies].
            match read_file(cargo_toml_path.clone()) [
                Ok(existing) -> [
                    let appended = existing + "\n[[bin]]\nname = \"" + bn2 + "\"\npath = \"src/bin/" + bn2 + ".rs\"\n"
                    match write_file(cargo_toml_path.clone(), appended) [
                        Ok(_v) -> [
                        ]
                        Err(e) -> [
                            warnings.push(cargo_toml_path + ": " + e)
                        ]
                    ]
                ]
                Err(e) -> [
                    warnings.push(cargo_toml_path + " (multi-binarka '" + bn2 + "' wymaga, zeby glowny 'cmd/main.hcs' byl zbudowany JAKO PIERWSZY): " + e)
                ]
            ]
        ]
        None -> [
            let cargo_text = cargo_toml_text(crate_name, needs_pyo3, needs_native_js, needs_sandbox, needs_hot_reload, needs_native_cpp, needs_wasm_bindgen, force_library, crates_names.clone(), crates_versions.clone(), needs_native_java, needs_sha256)
            match write_file(cargo_toml_path.clone(), cargo_text) [
                Ok(_v) -> [
                ]
                Err(e) -> [
                    warnings.push(cargo_toml_path + ": " + e)
                ]
            ]
        ]
    ]

    !! DODANE - materializuje kazdy `native` `{C++}` `[ ... ]` (patrz
    !! `CodeGen::native_cpp_sources`) jako `out_dir/native/<fn_name>.cpp`,
    !! zawijajac surowy kod jako cialo `extern "C" void <fn_name>()`
    !! (dokladnie to, czego oczekuje deklaracja FFI wyemitowana przez
    !! `gen_native()` w `main.rs`/module) - `virus build` kompiluje ten
    !! plik przez `cc::Build` na podstawie linii "native_cpp" w
    !! `.hks-extern-links.txt` nizej.
    let nci = 0
    let ncn = native_cpp_names.len()
    if ncn > 0 [
        let native_dir = out_dir + "/native"
        match create_dir(native_dir.clone()) [
            Ok(_v) -> [
            ]
            Err(e) -> [
                warnings.push(native_dir + ": " + e)
            ]
        ]
    ]
    while nci < ncn [
        let fnname = native_cpp_names[nci].clone()
        match native_cpp_sources.fetch(fnname.clone()) [
            Some(src) -> [
                let cpp_path = out_dir + "/native/" + fnname + ".cpp"
                !! NAPRAWIONE (wykryte przez showcase.hcs) - jesli
                !! `src` zawiera dyrektywy preprocesora (`#include`,
                !! `#define`...), nie moga one ladowac sie WEWNATRZ
                !! ciala funkcji (`extern "C" void fn() { #include
                !! <cstdio> ... }` psuje widocznosc deklaracji jak
                !! `printf` dla reszty bloku) - trzeba je wypchnac PRZED
                !! `extern "C" void ...`, na poziom pliku.
                let src_lines = str_split(src.clone(), "\n")
                let preproc_lines: List<Str> = []
                let body_lines: List<Str> = []
                let sli = 0
                let sln = src_lines.len()
                while sli < sln [
                    let line = src_lines[sli].clone()
                    if str_starts_with(str_trim(line.clone()), "#") [
                        preproc_lines.push(line)
                    ] else [
                        body_lines.push(line)
                    ]
                    sli = sli + 1
                ]
                let cpp_text = str_join(preproc_lines, "\n") + "\nextern \"C\" void " + fnname + "() {\n" + str_join(body_lines, "\n") + "\n}\n"
                match write_file(cpp_path.clone(), cpp_text) [
                    Ok(_v) -> [
                    ]
                    Err(e) -> [
                        warnings.push(cpp_path + ": " + e)
                    ]
                ]
            ]
            None -> [
            ]
        ]
        nci = nci + 1
    ]

    !! ROZBUDOWA (ta runda, patrz docs/JAVA.md) - materializuje kazdy
    !! `native {java}(...)` (`CodeGen::native_java_sources`) jako
    !! `out_dir/java/<ClassName>.java` - `virus build` kompiluje ten
    !! plik przez `javac` na podstawie linii "java_class" w
    !! `.hks-extern-links.txt` nizej. W odroznieniu od C++, zrodlo Javy
    !! (`java_src`, zbudowane juz w calosci przez
    !! `codegen.hcs::gen_native`) NIE wymaga tu zadnej dodatkowej
    !! obrobki (bez rozdzielania dyrektyw preprocesora itp.) - Java nie
    !! ma preprocesora.
    let nji = 0
    let njn = native_java_names.len()
    if njn > 0 [
        let java_dir = out_dir + "/java"
        match create_dir(java_dir.clone()) [
            Ok(_v) -> [
            ]
            Err(e) -> [
                warnings.push(java_dir + ": " + e)
            ]
        ]
    ]
    while nji < njn [
        let cname = native_java_names[nji].clone()
        match native_java_sources.fetch(cname.clone()) [
            Some(jsrc) -> [
                let java_path = out_dir + "/java/" + cname + ".java"
                match write_file(java_path.clone(), jsrc) [
                    Ok(_v) -> [
                    ]
                    Err(e) -> [
                        warnings.push(java_path + ": " + e)
                    ]
                ]
            ]
            None -> [
            ]
        ]
        nji = nji + 1
    ]

    !!! ZMIANA 0.3 - sidecar `.hks-extern-links.txt` (jedna linia
    !!! "kind\tname\ttryb" na `get <extern:...> use <...>`/
    !!! `get <c:...>`/`get <cpp:...>` znaleziony w calym module) -
    !!! jedyny kanal miedzy `hackerc` (ten plik) a `virus build`
    !!! (osobna binarka - patrz `TranspileResult::extern_link_specs`
    !!! wyzej). Pomijany calkowicie (brak pliku), jesli zaden taki
    !!! `get <...>` nie wystapil - `virus build` traktuje brak pliku
    !!! jako "nic do polaczenia", parytet z reszta best-effort/
    !!! brak-pliku-znaczy-brak-pracy tego bootstrapu.
    let extern_links_path: Option<Str> = none()
    if extern_link_specs.len() > 0 [
        let links_path = out_dir + "/.hks-extern-links.txt"
        match write_file(links_path.clone(), str_join(extern_link_specs.clone(), "\n") + "\n") [
            Ok(_v) -> [
                extern_links_path = some(links_path)
            ]
            Err(e) -> [
                warnings.push(links_path + ": " + e)
            ]
        ]
    ]

    if needs_hot_reload [
        let hotlib_dir = out_dir + "/hotlib"
        let hotlib_src_dir = hotlib_dir + "/src"
        match create_dir(hotlib_src_dir.clone()) [
            Ok(_v) -> [
            ]
            Err(e) -> [
                warnings.push(hotlib_src_dir + ": " + e)
            ]
        ]
        let hotlib_cargo_text = "[package]\nname = \"hotlib\"\nversion = \"0.0.1\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\"]\n"
        match write_file(hotlib_dir + "/Cargo.toml", hotlib_cargo_text) [
            Ok(_v) -> [
            ]
            Err(e) -> [
                warnings.push(hotlib_dir + "/Cargo.toml: " + e)
            ]
        ]
        let hotlib_lib_rs = "// Plik wygenerowany automatycznie przez hackerc - funkcje @hot_reload.\n// NIE EDYTUJ RECZNIE.\n#![allow(non_snake_case, unused_mut, dead_code)]\n\n"
        let hoi = 0
        let hon = hot_reload_order.len()
        while hoi < hon [
            let hname = hot_reload_order[hoi].clone()
            match hot_reload_bodies.fetch(hname.clone()) [
                Some(hbody) -> [
                    hotlib_lib_rs = hotlib_lib_rs + hbody + "\n"
                ]
                None -> [
                ]
            ]
            hoi = hoi + 1
        ]
        match write_file(hotlib_src_dir + "/lib.rs", hotlib_lib_rs) [
            Ok(_v) -> [
            ]
            Err(e) -> [
                warnings.push(hotlib_src_dir + "/lib.rs: " + e)
            ]
        ]
    ]

    end ProjectResult(out_dir, main_rs_path, module_files, cargo_toml_path, needs_pyo3, needs_native_js, needs_sandbox, needs_hot_reload, crates_names, crates_versions, warnings, needs_native_cpp, extern_links_path, needs_wasm_bindgen)
]

!!! Demonstracyjne uzycie - `flat_module_name`/`module_file_path` na
!!! przykladzie z komentarza na gorze pliku (bez dotykania prawdziwego
!!! systemu plikow, zeby demo dzialalo wszedzie bez przygotowanego
!!! katalogu wyjsciowego - patrz ograniczenie `build_project` powyzej).
fun main() [
    let flat = flat_module_name("core", "memory", some("arena"))
    log("flat_module_name:", flat)
    let path = module_file_path("/repo/libs", "core", "memory", some("arena"))
    log("module_file_path:", path)
]
