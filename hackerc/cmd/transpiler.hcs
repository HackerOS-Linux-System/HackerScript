include <ast_nodes>
include <parser>
include <typeinfer>
include <codegen>
get <std:string> import <str_contains>
!!! Wynik transpilacji - parytet z `@dataclass TranspileResult`.
struct TranspileResult [
    rust_code: Str,
    needs_pyo3: Bool,
    needs_native_js: Bool,
    needs_sandbox: Bool,
    needs_hot_reload: Bool,
    hot_reload_bodies: Dict<Str, Str>,
    hot_reload_order: List<Str>,
    !! ZMIANA 0.3 - `native` `{C++}` `[ ... ]`, patrz `CodeGen::needs_native_cpp`.
    needs_native_cpp: Bool,
    !! ZMIANA 0.3 - jedna linia "kind\tname\ttryb" na kazdy
    !! `get <extern:...> use <...>` / `get <c:...>` / `get <cpp:...>`
    !! znaleziony na najwyzszym poziomie TEGO pliku (patrz
    !! `collect_extern_link_specs` nizej) - `project.hcs` zbiera to ze
    !! WSZYSTKICH plikow modulu i zapisuje do sidecar
    !! `.hks-extern-links.txt` obok wygenerowanego Cargo.toml, ktory
    !! `virus build` czyta, zeby dopisac linkowanie do `build.rs`
    !! (patrz `virus/cmd/build.hcs::build_wire_extern_dependencies`) -
    !! `hackerc` i `virus` sa OSOBNYMI binarkami (`virus` woła
    !! `hackerc` przez `run_command`, patrz `hackerc_bridge.hcs`), wiec
    !! plik na dysku jest jedynym kanalem miedzy nimi (parytet z tym,
    !! jak `.vira-meta.txt` przenosi informacje o bibliotekach Vira).
    extern_link_specs: List<Str>,
    !! DODANE - patrz `CodeGen::native_cpp_sources`/`native_cpp_order`.
    native_cpp_sources: Dict<Str, Str>,
    native_cpp_order: List<Str>,
    !! NOWOSC 0.4 - patrz `CodeGen::needs_wasm_bindgen`/
    !! `extract_wasm_export_markers()` - analog `needs_pyo3` (naglowek
    !! `use wasm_bindgen::prelude::*;`), ale dla `@wasm_export`;
    !! `project.hcs::build_project` czyta to, zeby dopisac `wasm-bindgen
    !! = "0.2"` do Cargo.toml i `[lib] crate-type = ["cdylib", "rlib"]`
    !! zamiast `[[bin]]` (patrz `cargo_toml_text()`).
    needs_wasm_bindgen: Bool,
    !! ROZBUDOWA (ta runda, patrz docs/JAVA.md) - `native {java}(...)`,
    !! parytet z `needs_native_cpp`/`native_cpp_sources`/
    !! `native_cpp_order` wyzej.
    needs_native_java: Bool,
    native_java_sources: Dict<Str, Str>,
    native_java_order: List<Str>,
    !! `get <java:sciezka.jar>` - patrz `CodeGen::java_classpath_entries`.
    java_classpath_entries: List<Str>,
    !! ROZBUDOWA (ta runda) - `sha256_hex(...)`, patrz `CodeGen::needs_sha256`.
    needs_sha256: Bool
]

!!! ZMIANA 0.3 - skanuje najwyzszy poziom `prog` w poszukiwaniu
!!! `GetImportStmt` ze zrodlem "extern"/"c"/"cpp" i zwraca kazdy jako
!!! linie "kind\tname\ttryb" (tryb pusty dla "c"/"cpp" - te zrodla nie
!!! maja `use <...>` w skladni, patrz `parse_get_import`) - wejscie dla
!!! `collect_project_extern_links` w project.hcs.
fun collect_extern_link_specs(prog: Program) -> List<Str> [
    let out: List<Str> = []
    let i = 0
    let n = prog.body.len()
    while i < n [
        let s = prog.body[i].clone()
        match s [
            GetImportStmt(source, name, version, details) -> [
                if source == "extern" [
                    let mode = "dynamic"
                    match version [
                        Some(m) -> [
                            mode = m
                        ]
                        None -> [
                        ]
                    ]
                    out.push("extern\t" + name + "\t" + mode)
                ]
                if source == "c" or source == "cpp" [
                    out.push(source + "\t" + name + "\t")
                ]
            ]
            _ -> [
            ]
        ]
        i = i + 1
    ]
    end out
]

!!! Sygnatury/mut-maps "z zewnatrz" (z INNYCH plikow .hcs, zaimportowanych
!!! przez `get <std/core/selfhost:...>`) - parytet z parametrami
!!! `extra_functions`/`extra_structs`/`extra_enums`/`extra_mut_params`/
!!! `extra_methods`/`extra_method_mut_params` w `transpile_source_full`
!!! Pythona. HackerScript nie ma iteracji po `Dict` (brak `.keys()`/
!!! `.items()`, patrz "Ograniczenia" w typeinfer.hcs) - kazdy Dict tu
!!! MUSI wiec byc towarzyszony wlasna lista nazw-kluczy (`*_names`),
!!! zeby `merge_signatures_with_extra` mogl "przejrzec" jego zawartosc.
!!! Wypelnia to `project.hcs` (`collect_project_signatures`).
struct ExtraSignatures [
    functions: Dict<Str, Stmt>,
    function_names: List<Str>,
    structs: Dict<Str, Stmt>,
    struct_names: List<Str>,
    enums: Dict<Str, Stmt>,
    enum_names: List<Str>,
    methods: Dict<Str, Stmt>,
    method_names: List<Str>,
    mut_params: Dict<Str, Bool>,
    method_mut_params: Dict<Str, Bool>,
    !! NAPRAWIONY BUG (ta runda, znaleziony realnym buildem przy
    !! integracji .hlib - patrz docs/ROADMAP.md): funkcje z `region
    !! [ ... ]` TRAFIALY do `functions` (dla arity-checkow, wczesniejsza
    !! runda), ale `CodeGen::extern_fn_names` (decyduje, czy wywolanie
    !! zawinac w `unsafe { ... }`) bylo populowane WYLACZNIE w
    !! `gen_region()`, WEWNATRZ TEGO SAMEGO PLIKU co `region` - wywolanie
    !! funkcji `extern "C"` z INNEGO pliku (np. `get <hlib:...>` albo
    !! `get <work:...>` importujacego modul z `region`) generowalo kod
    !! BEZ `unsafe`, ktorego `rustc` odrzuca (E0133). Ten Dict/List
    !! niesie nazwy funkcji `extern` PROJEKTOWO (przez wszystkie pliki),
    !! parytet z `functions`/`function_names` wyzej.
    extern_fn_names: Dict<Str, Bool>,
    extern_fn_name_list: List<Str>
]

!!! `ExtraSignatures` pusty - dla wywolan `transpile_source_full` na
!!! pojedynczym pliku, bez kontekstu calego projektu (parytet z
!!! wywolaniem Pythona z domyslnymi `extra_* = None`).
fun empty_extra_signatures() -> ExtraSignatures [
    let functions: Dict<Str, Stmt> = dict()
    let structs: Dict<Str, Stmt> = dict()
    let enums: Dict<Str, Stmt> = dict()
    let methods: Dict<Str, Stmt> = dict()
    let mut_params: Dict<Str, Bool> = dict()
    let method_mut_params: Dict<Str, Bool> = dict()
    let extern_fn_names: Dict<Str, Bool> = dict()
    end ExtraSignatures(functions, [], structs, [], enums, [], methods, [], mut_params, method_mut_params, extern_fn_names, [])
]

!!! Dopisuje do `owner` mapowanie wariant -> nazwa enuma dla JEDNEGO
!!! `EnumDecl` (parytet z petla po `enum_decl.variants` w
!!! `_build_variant_registry` z codegen.py - tu wydzielone, bo ten
!!! plik musi to policzyc TEZ dla enumow pochodzacych z `extra.enums`,
!!! ktore `collect_signatures` (dzialajace tylko na LOKALNYM programie)
!!! nie widzi).
fun collect_variant_owner_for_enum(e: Stmt, owner: Dict<Str, Str>) [
    match e [
        EnumDecl(name, variants, type_params) -> [
            let k = 0
            let vn = variants.len()
            while k < vn [
                owner.insert(variants[k].name.clone(), name.clone())
                k = k + 1
            ]
        ]
        _ -> [
        ]
    ]
]

!!! Laczy `local` (Signatures policzone TYLKO dla tego pliku przez
!!! `collect_signatures`) z `extra` (globalny rejestr z reszty
!!! projektu) - LOKALNE wpisy maja PIERWSZENSTWO (parytet z Pythonowym
!!! `{**extra_functions, **gen.sigs.functions}` - drugi operand
!!! nadpisuje pierwszy w skladni `{**a, **b}`, wiec lokalne wygrywaja).
!!! Iteruje `extra.*_names` (patrz `ExtraSignatures` wyzej) zamiast
!!! iterowac Dict bezposrednio - ten bootstrap nie ma iteracji po Dict.
fun merge_signatures_with_extra(local: Signatures, extra: ExtraSignatures) -> Signatures [
    let functions = local.functions.clone()
    let function_names = local.function_names.clone()
    let fi = 0
    let fn_n = extra.function_names.len()
    while fi < fn_n [
        let name = extra.function_names[fi]
        match local.functions.fetch(name) [
            Some(_v) -> [
            ]
            None -> [
                match extra.functions.fetch(name) [
                    Some(v) -> [
                        functions.insert(name.clone(), v)
                        function_names.push(name)
                    ]
                    None -> [
                    ]
                ]
            ]
        ]
        fi = fi + 1
    ]

    let structs = local.structs.clone()
    let struct_names = local.struct_names.clone()
    let si = 0
    let st_n = extra.struct_names.len()
    while si < st_n [
        let name = extra.struct_names[si]
        match local.structs.fetch(name) [
            Some(_v) -> [
            ]
            None -> [
                match extra.structs.fetch(name) [
                    Some(v) -> [
                        structs.insert(name.clone(), v)
                        struct_names.push(name)
                    ]
                    None -> [
                    ]
                ]
            ]
        ]
        si = si + 1
    ]

    let enums = local.enums.clone()
    let enum_names = local.enum_names.clone()
    let variant_owner = local.variant_owner.clone()
    let ei = 0
    let en_n = extra.enum_names.len()
    while ei < en_n [
        let name = extra.enum_names[ei]
        match local.enums.fetch(name) [
            Some(_v) -> [
            ]
            None -> [
                match extra.enums.fetch(name) [
                    Some(v) -> [
                        enums.insert(name.clone(), v.clone())
                        enum_names.push(name)
                        collect_variant_owner_for_enum(v, variant_owner)
                    ]
                    None -> [
                    ]
                ]
            ]
        ]
        ei = ei + 1
    ]

    let methods = local.methods.clone()
    let mi = 0
    let m_n = extra.method_names.len()
    while mi < m_n [
        let name = extra.method_names[mi]
        match local.methods.fetch(name) [
            Some(_v) -> [
            ]
            None -> [
                match extra.methods.fetch(name) [
                    Some(v) -> [
                        methods.insert(name.clone(), v)
                    ]
                    None -> [
                    ]
                ]
            ]
        ]
        mi = mi + 1
    ]

    end Signatures(functions, structs, enums, methods, variant_owner, struct_names, enum_names, function_names)
]

!!! Laczy `local_mut_params` (policzone przez `compute_mut_params` TYLKO
!!! dla tego pliku) z `extra.mut_params` - lokalne wygrywaja, parytet z
!!! `{**extra_mut_params, **gen.mut_params}` w `generate()` (codegen.py).
fun merge_mut_params_with_extra(local_mut: Dict<Str, Bool>, extra: ExtraSignatures) -> Dict<Str, Bool> [
    let out = local_mut.clone()
    let i = 0
    let n = extra.function_names.len()
    while i < n [
        let name = extra.function_names[i]
        match local_mut.fetch(name) [
            Some(_v) -> [
            ]
            None -> [
                match extra.mut_params.fetch(name) [
                    Some(v) -> [
                        out.insert(name, v)
                    ]
                    None -> [
                    ]
                ]
            ]
        ]
        i = i + 1
    ]
    end out
]

!!! Sklada `direct_blocks` (Dict<Int-jako-Str, Str> zebrane przez
!!! `extract_direct_blocks` nizej) na `Dict<Str, Str>` wymagany przez
!!! `codegen.hcs::new_codegen` - `idx` jest juz `Str` w tym module
!!! (patrz `extract_direct_blocks`), wiec to zwykle "przepisanie 1:1",
!!! wydzielone jako wlasna funkcja dla czytelnosci wywolan nizej.
fun direct_blocks_to_dict(blocks: List<Str>) -> Dict<Str, Str> [
    let out: Dict<Str, Str> = dict()
    let i = 0
    let n = blocks.len()
    while i < n [
        out.insert(i as Str, blocks[i].clone())
        i = i + 1
    ]
    end out
]

fun names_to_bool_dict(names: List<Str>) -> Dict<Str, Bool> [
    let out: Dict<Str, Bool> = dict()
    let i = 0
    let n = names.len()
    while i < n [
        out.insert(names[i].clone(), true)
        i = i + 1
    ]
    end out
]

!!! Lokalny odpowiednik `lexer.hcs::trim_str` - NIE Rustowego
!!! `.trim()` (ktory zwraca `&str`, niezgodne z `Str` w wygenerowanym
!!! kodzie) - ten sam wzorzec duplikacji malych helperow per-plik co
!!! reszta bootstrapu (patrz `lexer.hcs`/`project.hcs`).
fun trim_str_local(s: Str) -> Str [
    let n = s.len()
    let start = 0
    while start < n and (s.char_at(start) == " " or s.char_at(start) == "\t" or s.char_at(start) == "\r" or s.char_at(start) == "\n") [
        start = start + 1
    ]
    let stop = n
    while stop > start and (s.char_at(stop - 1) == " " or s.char_at(stop - 1) == "\t" or s.char_at(stop - 1) == "\r" or s.char_at(stop - 1) == "\n") [
        stop = stop - 1
    ]
    end s.slice(start, stop)
]

fun is_direct_ident_char(c: Str) -> Bool [
    if c >= "a" and c <= "z" [
        end true
    ]
    if c >= "A" and c <= "Z" [
        end true
    ]
    if c >= "0" and c <= "9" [
        end true
    ]
    if c == "_" [
        end true
    ]
    end false
]

!!! Reczny odpowiednik minimalnego wciecia wspolnego dla wszystkich
!!! NIEPUSTYCH linii (parytet z `textwrap.dedent` - UPROSZCZONY: liczy
!!! DLUGOSC wiodacych spacji/tabow, nie porownuje same znaki litera po
!!! literze jak prawdziwy `textwrap.dedent` - wystarczajace dla kodu
!!! `.hcs`, ktory zawsze uzywa spacji konsekwentnie, patrz
!!! "Ograniczenia" na koncu pliku).
fun common_leading_whitespace(lines: List<Str>) -> Int [
    let min_indent = -1
    let i = 0
    let n = lines.len()
    while i < n [
        let line = lines[i]
        let llen = line.len()
        let blank = true
        let j = 0
        while j < llen [
            let c = line.char_at(j)
            if not (c == " " or c == "\t") [
                blank = false
            ]
            j = j + 1
        ]
        if not blank [
            let indent = 0
            let k = 0
            while k < llen [
                let c = line.char_at(k)
                if c == " " or c == "\t" [
                    indent = indent + 1
                ] else [
                    k = llen
                ]
                k = k + 1
            ]
            if min_indent == -1 or indent < min_indent [
                min_indent = indent
            ]
        ]
        i = i + 1
    ]
    if min_indent == -1 [
        end 0
    ]
    end min_indent
]

fun dedent_text(raw: Str) -> Str [
    let lines = split_lines_local(raw)
    let indent = common_leading_whitespace(lines)
    let out_lines: List<Str> = []
    let i = 0
    let n = lines.len()
    while i < n [
        let line = lines[i]
        let llen = line.len()
        if indent >= llen [
            out_lines.push("")
        ] else [
            out_lines.push(line.slice(indent, llen))
        ]
        i = i + 1
    ]
    let joined = ""
    let j = 0
    let jn = out_lines.len()
    while j < jn [
        if j > 0 [
            joined = joined + "\n"
        ]
        joined = joined + out_lines[j]
        j = j + 1
    ]
    end strip_newlines(joined)
]

!!! Dzieli po `\n` (BEZ pomijania `\r`, w odroznieniu od
!!! `diagnostics.hcs::split_lines` - tresc `direct [ ... ]` to Python,
!!! gdzie `\r` wewnatrz linii jest istotny/rzadki, wiec ten plik nie
!!! ryzykuje go cicho gubic tak jak `diagnostics.hcs` robi to celowo
!!! dla zrodla `.hcs`).
fun split_lines_local(source: Str) -> List<Str> [
    let lines: List<Str> = []
    let cur = ""
    let i = 0
    let n = source.len()
    while i < n [
        let c = source.char_at(i)
        if c == "\n" [
            lines.push(cur)
            cur = ""
        ] else [
            cur = cur + c
        ]
        i = i + 1
    ]
    lines.push(cur)
    end lines
]

!!! Parytet z Pythonowym `.strip("\n")` - usuwa TYLKO wiodace/koncowe
!!! znaki `\n` (nie inne bialе znaki, w odroznieniu od goleg `.strip()`).
fun strip_newlines(s: Str) -> Str [
    let n = s.len()
    let start = 0
    while start < n and s.char_at(start) == "\n" [
        start = start + 1
    ]
    let end_i = n
    while end_i > start and s.char_at(end_i - 1) == "\n" [
        end_i = end_i - 1
    ]
    end s.slice(start, end_i)
]

!!! Wynik `extract_direct_blocks` - HackerScript nie ma generycznych
!!! tupli, wiec `(Str, Dict<Int,Str>)` z Pythona staje sie wlasnym
!!! struct (parytet z `ElifArm`/`Edge` gdzie indziej w bootstrapie).
struct DirectExtraction [
    stripped_source: Str,
    blocks: List<Str>
]

!!! Zamienia kazdy blok `direct [ ... ]` na wyrazenie `__direct__(N)` i
!!! zwraca (nowe_zrodlo, lista_surowych_blokow_w_kolejnosci) - parytet
!!! z `_extract_direct_blocks` (transpiler.py). `blocks[N]` odpowiada
!!! Pythonowemu `blocks[N]` (indeksy 0..len-1 w kolejnosci wystapienia).
!!!
!!! Reczne skanowanie zamiast `re.compile(r"\bdirect\b").search` -
!!! sprawdza znak przed/po dopasowaniu przez `is_direct_ident_char`
!!! (parytet granicy slowa `\b` dla `[a-zA-Z0-9_]`).
fun extract_direct_blocks(source: Str) -> DirectExtraction [
    let blocks: List<Str> = []
    let out = ""
    let i = 0
    let n = source.len()
    while i < n [
        let found_at = -1
        let scan = i
        while scan < n and found_at == -1 [
            if scan + 6 <= n and source.slice(scan, scan + 6) == "direct" [
                let before_ok = scan == 0 or not is_direct_ident_char(source.char_at(scan - 1))
                let after_ok = scan + 6 >= n or not is_direct_ident_char(source.char_at(scan + 6))
                if before_ok and after_ok [
                    found_at = scan
                ]
            ]
            scan = scan + 1
        ]
        if found_at == -1 [
            out = out + source.slice(i, n)
            i = n
        ] else [
            let start = found_at
            out = out + source.slice(i, start)
            let j = start + 6
            while j < n and (source.char_at(j) == " " or source.char_at(j) == "\t") [
                j = j + 1
            ]
            if j >= n or source.char_at(j) != "[" [
                out = out + source.slice(start, j)
                i = j
            ] else [
                let depth = 0
                let k = j
                let closed_at = -1
                while k < n and closed_at == -1 [
                    let c = source.char_at(k)
                    if c == "[" [
                        depth = depth + 1
                    ] elif c == "]" [
                        depth = depth - 1
                        if depth == 0 [
                            closed_at = k
                        ]
                    ]
                    k = k + 1
                ]
                if closed_at == -1 [
                    log("[transpiler.hcs] niezamkniety blok direct [ ... ]")
                    i = n
                ] else [
                    let raw = source.slice(j + 1, closed_at)
                    let dedented = dedent_text(raw)
                    let idx = blocks.len()
                    blocks.push(dedented)
                    out = out + "__direct__(" + (idx as Str) + ")"
                    i = closed_at + 1
                ]
            ]
        ]
    ]
    end DirectExtraction(out, blocks)
]

!!! Wynik `extract_native_blocks` - analogicznie do `DirectExtraction`,
!!! ale kazdy blok ma tez `engine` (tresc `{Engine}` przed `[...]`),
!!! wiec dwie rownolegle listy (`blocks[i]` <-> `engines[i]`) zamiast
!!! jednej - HackerScript nie ma generycznych tupli (patrz komentarz
!!! przy `DirectExtraction`).
!!! Lokalny join/dirname dla importu plikow w `native` `{X}` `<sciezka>` -
!!! ten sam wzorzec duplikacji co `trim_str_local` (patrz tam) zamiast
!!! ciagnac `get <std:path>` do samego bootstrapu kompilatora.
fun native_join_path(base_dir: Str, rel: Str) -> Str [
    if rel.len() > 0 and rel.char_at(0) == "/" [
        end rel
    ]
    if base_dir.len() == 0 [
        end rel
    ]
    if base_dir.char_at(base_dir.len() - 1) == "/" [
        end base_dir + rel
    ]
    end base_dir + "/" + rel
]

!!! ROZBUDOWA (ta runda, patrz docs/FAST_DIRECT.md) - odpowiednik
!!! `NativeExtraction`, dla `fast direct {backend}(...)`. Dwie
!!! rownolegle listy (`blocks[i]` <-> `backends[i]`), tak samo jak
!!! `NativeExtraction.engines` - ten sam powod (brak tupli w tym
!!! bootstrapie).
struct FastDirectExtraction [
    stripped_source: Str,
    blocks: List<Str>,
    backends: List<Str>
]

!!! Analog `extract_direct_blocks`/`extract_native_blocks` dla `fast
!!! direct {backend} [ ... ]` - PROSTSZY niz `native` (brak wariantu
!!! `<import_pliku>`, patrz docs/FAST_DIRECT.md - to tylko Etap
!!! pilotazowy, `{pypy}`/`{numpy}`). Wymaga DOKLADNIE: `fast`
!!! (granica slowa), potem (po bialych znakach) `direct` (granica
!!! slowa), potem `{backend}`, potem `[ ... ]` - kazdy inny uklad
!!! (np. `fast` bez `direct` zaraz po) zostawia tekst NIETKNIETY
!!! (parser go i tak odrzuci jako blad skladni, dokladnie jak
!!! niedopasowane `native`/`direct` wyzej).
fun extract_fast_direct_blocks(source: Str) -> FastDirectExtraction [
    let blocks: List<Str> = []
    let backends: List<Str> = []
    let out = ""
    let i = 0
    let n = source.len()
    while i < n [
        let found_at = -1
        let scan = i
        while scan < n and found_at == -1 [
            if scan + 4 <= n and source.slice(scan, scan + 4) == "fast" [
                let before_ok = scan == 0 or not is_direct_ident_char(source.char_at(scan - 1))
                let after_ok = scan + 4 >= n or not is_direct_ident_char(source.char_at(scan + 4))
                if before_ok and after_ok [
                    found_at = scan
                ]
            ]
            scan = scan + 1
        ]
        if found_at == -1 [
            out = out + source.slice(i, n)
            i = n
        ] else [
            let start = found_at
            out = out + source.slice(i, start)
            let j = start + 4
            while j < n and (source.char_at(j) == " " or source.char_at(j) == "\t") [
                j = j + 1
            ]
            let has_direct = j + 6 <= n and source.slice(j, j + 6) == "direct" and (j + 6 >= n or not is_direct_ident_char(source.char_at(j + 6)))
            if not has_direct [
                !! `fast` bez `direct` zaraz po - nie nasz blok (np.
                !! zmienna o nazwie "fast"), zostaw tekst i szukaj dalej
                !! ZA slowem "fast", nie od poczatku - inaczej petla
                !! zapetlilaby sie na tym samym "fast" w nieskonczonosc.
                out = out + source.slice(start, start + 4)
                i = start + 4
            ] else [
                let j2 = j + 6
                while j2 < n and (source.char_at(j2) == " " or source.char_at(j2) == "\t") [
                    j2 = j2 + 1
                ]
                if j2 >= n or source.char_at(j2) != "{" [
                    out = out + source.slice(start, j2)
                    i = j2
                ] else [
                    let brace_start = j2 + 1
                    let brace_end = -1
                    let bk = brace_start
                    while bk < n and brace_end == -1 [
                        if source.char_at(bk) == "}" [
                            brace_end = bk
                        ]
                        bk = bk + 1
                    ]
                    if brace_end == -1 [
                        log("[transpiler.hcs] niezamkniety '{' po 'fast direct' (brak '}')")
                        i = n
                    ] else [
                        let backend = trim_str_local(source.slice(brace_start, brace_end))
                        let k2 = brace_end + 1
                        while k2 < n and (source.char_at(k2) == " " or source.char_at(k2) == "\t" or source.char_at(k2) == "\n" or source.char_at(k2) == "\r") [
                            k2 = k2 + 1
                        ]
                        if k2 >= n or source.char_at(k2) != "[" [
                            out = out + source.slice(start, k2)
                            i = k2
                        ] else [
                            let depth = 0
                            let k = k2
                            let closed_at = -1
                            while k < n and closed_at == -1 [
                                let c = source.char_at(k)
                                if c == "[" [
                                    depth = depth + 1
                                ] elif c == "]" [
                                    depth = depth - 1
                                    if depth == 0 [
                                        closed_at = k
                                    ]
                                ]
                                k = k + 1
                            ]
                            if closed_at == -1 [
                                !! Jak w formatter.hcs::fmt_fast_direct_block -
                        !! " " + "{" jako OSOBNE literaly, zeby wlasny
                        !! tekst TEGO PLIKU nie zawieral rozpoznawalnego
                        !! wzorca "fast direct {...}" plus "[" przy przyszlej
                        !! samo-kompilacji hackerc (patrz docs/ROADMAP.md
                        !! - ten sam mechanizm zepsul wczesniejsza wersje
                        !! komunikatu bledu w codegen.hcs::gen_fast_direct,
                        !! znalezione i naprawione realnym buildem).
                        log("[transpiler.hcs] niezamkniety blok fast direct " + "{" + backend + "}" + " [ ... ]")
                                i = n
                            ] else [
                                let raw = source.slice(k2 + 1, closed_at)
                                let dedented = dedent_text(raw)
                                let idx = blocks.len()
                                blocks.push(dedented)
                                backends.push(backend)
                                out = out + "__fast_direct__(" + (idx as Str) + ")"
                                i = closed_at + 1
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ]
    end FastDirectExtraction(out, blocks, backends)
]

struct NativeExtraction [
    stripped_source: Str,
    blocks: List<Str>,
    engines: List<Str>
]

!!! Analog `extract_direct_blocks` dla `native` `{Silnik}` `[ ... ]`.
!!! Roznica: po slowie kluczowym `native` oczekiwany jest `{nazwa}`
!!! (silnik wykonawczy - dzis: `JavaScript`) PRZED blokiem `[ ... ]`.
!!! Dwie formy:
!!!   native` `{JavaScript}` `[ ... ]              - inline
!!!   native` `{JavaScript}` `<sciezka/do/pliku.js> - import calego pliku
!!!   native` `{JavaScript}` `<sciezka.js>` `[ ... ]  - import + inline PO
!!!     nim (inline moze wywolywac funkcje zdefiniowane w pliku)
!!! `base_dir` to katalog pliku .hcs (dla wzglednych sciezek importu)
!!! - `project.hcs::parse_and_add` przekazuje katalog `path`, a
!!! `transpile_source_full` (pojedynczy plik bez projektu) katalog
!!! `filename`. Zamienia caly blok na `__native__(N)`, tak samo jak
!!! `direct [ ... ]` na `__direct__(N)` - `codegen.hcs::gen_native`
!!! odczytuje `engines[N]` zeby wybrac silnik (dzis: tylko QuickJS
!!! przez `rquickjs`, statycznie linkowany - patrz docs/ROADMAP.md).
fun extract_native_blocks(source: Str, base_dir: Str) -> NativeExtraction [
    let blocks: List<Str> = []
    let engines: List<Str> = []
    let out = ""
    let i = 0
    let n = source.len()
    while i < n [
        let found_at = -1
        let scan = i
        while scan < n and found_at == -1 [
            if scan + 6 <= n and source.slice(scan, scan + 6) == "native" [
                let before_ok = scan == 0 or not is_direct_ident_char(source.char_at(scan - 1))
                let after_ok = scan + 6 >= n or not is_direct_ident_char(source.char_at(scan + 6))
                if before_ok and after_ok [
                    found_at = scan
                ]
            ]
            scan = scan + 1
        ]
        if found_at == -1 [
            out = out + source.slice(i, n)
            i = n
        ] else [
            let start = found_at
            out = out + source.slice(i, start)
            let j = start + 6
            while j < n and (source.char_at(j) == " " or source.char_at(j) == "\t") [
                j = j + 1
            ]
            if j >= n or source.char_at(j) != "{" [
                !! Brak `{Silnik}` po `native` - nie nasz blok, zostaw
                !! tekst jak jest, parser go i tak odrzuci.
                out = out + source.slice(start, j)
                i = j
            ] else [
                let brace_start = j + 1
                let brace_end = -1
                let bk = brace_start
                while bk < n and brace_end == -1 [
                    if source.char_at(bk) == "}" [
                        brace_end = bk
                    ]
                    bk = bk + 1
                ]
                if brace_end == -1 [
                    log("[transpiler.hcs] niezamkniety '{' po 'native' (brak '}')")
                    i = n
                ] else [
                    let engine = trim_str_local(source.slice(brace_start, brace_end))
                    let k2 = brace_end + 1
                    while k2 < n and (source.char_at(k2) == " " or source.char_at(k2) == "\t") [
                        k2 = k2 + 1
                    ]
                    let imported = ""
                    let has_import = false
                    let bail = false
                    if k2 < n and source.char_at(k2) == "<" [
                        has_import = true
                        let path_start = k2 + 1
                        let gt_at = -1
                        let gk = path_start
                        while gk < n and gt_at == -1 [
                            if source.char_at(gk) == ">" [
                                gt_at = gk
                            ]
                            gk = gk + 1
                        ]
                        if gt_at == -1 [
                            log("[transpiler.hcs] niezamkniety '<' po native {" + engine + "} (brak '>')")
                            i = n
                            bail = true
                        ] else [
                            let rel_path = trim_str_local(source.slice(path_start, gt_at))
                            let full_path = native_join_path(base_dir, rel_path)
                            match read_file(full_path) [
                                Ok(content) -> [
                                    imported = content
                                ]
                                Err(e) -> [
                                    log("[transpiler.hcs] native {" + engine + "} <" + rel_path + "> - nie udalo sie wczytac (" + full_path + "): " + e)
                                    imported = "// [hackerc] BLAD IMPORTU: " + full_path
                                ]
                            ]
                            k2 = gt_at + 1
                            while k2 < n and (source.char_at(k2) == " " or source.char_at(k2) == "\t" or source.char_at(k2) == "\n" or source.char_at(k2) == "\r") [
                                k2 = k2 + 1
                            ]
                        ]
                    ]
                    if bail [
                        !! juz obsluzone wyzej (niezamkniety '<') - petla
                        !! glowna konczy sie po tej iteracji (i = n)
                    ] elif k2 >= n or source.char_at(k2) != "[" [
                        if has_import [
                            !! sam import, bez bloku inline - koniec
                            !! bloku `native` konczy sie zaraz po '>'
                            let idx = blocks.len()
                            blocks.push(imported)
                            engines.push(engine)
                            out = out + "__native__(" + (idx as Str) + ")"
                            i = k2
                        ] else [
                            out = out + source.slice(start, k2)
                            i = k2
                        ]
                    ] else [
                        let depth = 0
                        let k = k2
                        let closed_at = -1
                        while k < n and closed_at == -1 [
                            let c = source.char_at(k)
                            if c == "[" [
                                depth = depth + 1
                            ] elif c == "]" [
                                depth = depth - 1
                                if depth == 0 [
                                    closed_at = k
                                ]
                            ]
                            k = k + 1
                        ]
                        if closed_at == -1 [
                            log("[transpiler.hcs] niezamkniety blok native {...} [ ... ]")
                            i = n
                        ] else [
                            let raw = source.slice(k2 + 1, closed_at)
                            let dedented = dedent_text(raw)
                            let combined = dedented
                            if has_import [
                                combined = imported + "\n" + dedented
                            ]
                            let idx = blocks.len()
                            blocks.push(combined)
                            engines.push(engine)
                            out = out + "__native__(" + (idx as Str) + ")"
                            i = closed_at + 1
                        ]
                    ]
                ]
            ]
        ]
    ]
    end NativeExtraction(out, blocks, engines)
]

struct HotReloadExtraction [
    stripped_source: Str,
    names: List<Str>
]

!!! `@hot_reload` przed `fun nazwa() [ ... ]` na najwyzszym poziomie.
!!! CELOWO NIE dotyka `FunDecl` w AST (arnosc uzywana w 25+ miejscach
!!! dopasowan w calym kompilatorze - patrz docs/ROADMAP.md) - zamiast
!!! tego, tak jak `direct`/`native`/`$`, dziala na surowym tekscie
!!! PRZED tokenizacja: usuwa `@hot_reload` ze zrodla i osobno
!!! zapamietuje NAZWE funkcji ktora po nim nastepuje (skanujac do
!!! najblizszego `fun <ident>(`). `codegen.hcs::gen_fun` dostaje ta
!!! liste jako zwykly `Dict<Str,Bool>` (parytet ze sposobem w jaki
!!! `direct_blocks`/`native_blocks` sa przekazywane) i sam decyduje
!!! jak wyemitowac cialo - AST FunDecl pozostaje CALKOWICIE
!!! nieswiadome hot-reloadu.
!!! v1 OGRANICZENIE (jawne): tylko funkcje BEZ parametrow i BEZ
!!! wartosci zwracanej (`Void`) na najwyzszym poziomie - patrz
!!! `codegen.hcs::gen_fun` gdzie to jest wymuszane z fallbackiem
!!! (normalna kompilacja + komentarz ostrzegawczy), NIE cichym
!!! zignorowaniem.
!!! Ogolny skaner markera (slowo z granica) POMIJAJACY `"..."` i
!!! `!!`/`!!!` - wyciagniety z `sandbox_dollar_scan` po tym, jak
!!! (w TEJ SESJI) dokladnie ten sam brak swiadomosci komentarzy dwa
!!! razy z rzedu popsul WLASNY kod kompilatora przy self-hostingu:
!!! najpierw `$ ... $` w komentarzu o Zero-Cost Sandbox, potem
!!! `@hot_reload` we WLASNYM komunikacie logu ponizej ("wykryto
!!! @hot_reload -> ...") zostalo zjedzone jako fantomowy marker.
!!! Uzywany teraz przez `extract_hot_reload_markers` - `direct`/
!!! `native`/`$` maja WLASNE, starsze skanowanie (dzialajace, bo byly
!!! pisane PRZED odkryciem tego wzorca bledu) - nieujednolicone
!!! celowo, zeby nie ryzykowac zmiany czegos co juz dziala i jest
!!! zweryfikowane, w pospiechu koncowki sesji.
fun text_marker_scan(source: Str, from: Int, marker: Str) -> Int [
    let n = source.len()
    let mlen = marker.len()
    let in_string = false
    let escape_next = false
    let k = from
    while k < n [
        let c = source.char_at(k)
        if in_string [
            if escape_next [
                escape_next = false
            ] elif c == "\\" [
                escape_next = true
            ] elif c == "\"" [
                in_string = false
            ]
        ] else [
            if c == "\"" [
                in_string = true
            ] elif c == "!" and k + 1 < n and source.char_at(k + 1) == "!" [
                let eol = k
                while eol < n and source.char_at(eol) != "\n" [
                    eol = eol + 1
                ]
                k = eol
            ] elif k + mlen <= n and source.slice(k, k + mlen) == marker [
                let before_ok = k == 0 or not is_direct_ident_char(source.char_at(k - 1))
                let after_ok = k + mlen >= n or not is_direct_ident_char(source.char_at(k + mlen))
                if before_ok and after_ok [
                    end k
                ]
            ]
        ]
        k = k + 1
    ]
    end -1
]

fun extract_hot_reload_markers(source: Str) -> HotReloadExtraction [
    let names: List<Str> = []
    let out = ""
    let i = 0
    let n = source.len()
    let marker = "@hot_reload"
    let mlen = marker.len()
    while i < n [
        let found_at = text_marker_scan(source, i, marker)
        if found_at == -1 [
            out = out + source.slice(i, n)
            i = n
        ] else [
            out = out + source.slice(i, found_at)
            let after = found_at + mlen
            !! Szukamy "fun <ident>(" zaraz po markerze (pomijajac
            !! biale znaki/nowe linie) - to jest NAZWA funkcji ktora
            !! ma byc hot-reloadowalna. Sam marker jest usuwany ze
            !! zrodla (parser go nie zna).
            let fk = after
            while fk < n and (source.char_at(fk) == " " or source.char_at(fk) == "\t" or source.char_at(fk) == "\n" or source.char_at(fk) == "\r") [
                fk = fk + 1
            ]
            if fk + 3 <= n and source.slice(fk, fk + 3) == "fun" and (fk + 3 >= n or not is_direct_ident_char(source.char_at(fk + 3))) [
                let nk = fk + 3
                while nk < n and (source.char_at(nk) == " " or source.char_at(nk) == "\t") [
                    nk = nk + 1
                ]
                let name_start = nk
                while nk < n and is_direct_ident_char(source.char_at(nk)) [
                    nk = nk + 1
                ]
                if nk > name_start [
                    names.push(source.slice(name_start, nk))
                ] else [
                    log("[transpiler.hcs] @hot_reload: nie znaleziono nazwy funkcji po 'fun'")
                ]
            ] else [
                log("[transpiler.hcs] @hot_reload: oczekiwano 'fun <nazwa>(...)' zaraz po markerze")
            ]
            i = after
        ]
    ]
    end HotReloadExtraction(out, names)
]

struct WasmExportExtraction [
    stripped_source: Str,
    names: List<Str>
]

!!! NOWOSC 0.4 - `@wasm_export` przed `fun nazwa(...) [ ... ]` na
!!! najwyzszym poziomie - CELOWY, DOKLADNY klon
!!! `extract_hot_reload_markers` powyzej (ten sam `text_marker_scan`,
!!! tylko inny `marker`/inny typ wyniku): tak jak `@hot_reload`, dziala
!!! na surowym tekscie PRZED tokenizacja - usuwa `@wasm_export` ze
!!! zrodla i zapamietuje nazwe funkcji, ktora po nim nastepuje.
!!! `codegen.hcs::gen_fun` dostaje ta liste jako `Dict<Str,Bool>`
!!! (parytet z `hot_reload_names`) i, dla kazdej funkcji na tej
!!! liscie, dokleja `#[wasm_bindgen]` PRZED wygenerowanym `pub fn` -
!!! patrz `codegen.hcs::gen_fun`/`CodeGen.needs_wasm_bindgen`. W
!!! odroznieniu od `@hot_reload`, `@wasm_export` NIE ma ogranicznia co
!!! do parametrow/typu zwracanego (v1 wspiera funkcje o sygnaturach,
!!! ktore `wasm-bindgen` umie odwzorowac 1:1 - `Str`/`Int`/`Float`/
!!! `Bool`/`Void` - to samo ograniczenie co realny `wasm-bindgen` ma
!!! zawsze, nie dodatkowe od nas; zlozone typy (`struct`/`enum`/
!!! `List`/`Dict`) NIE sa dzis odwzorowywane - kompiluja sie normalnie
!!! (jak przy `@hot_reload` v1), ale `wasm-bindgen` odrzuci je na
!!! etapie `cargo build --target wasm32-unknown-unknown`, nie
!!! wczesniej - patrz `docs/ROADMAP.md`).
fun extract_wasm_export_markers(source: Str) -> WasmExportExtraction [
    let names: List<Str> = []
    let out = ""
    let i = 0
    let n = source.len()
    let marker = "@wasm_export"
    let mlen = marker.len()
    while i < n [
        let found_at = text_marker_scan(source, i, marker)
        if found_at == -1 [
            out = out + source.slice(i, n)
            i = n
        ] else [
            out = out + source.slice(i, found_at)
            let after = found_at + mlen
            let fk = after
            while fk < n and (source.char_at(fk) == " " or source.char_at(fk) == "\t" or source.char_at(fk) == "\n" or source.char_at(fk) == "\r") [
                fk = fk + 1
            ]
            if fk + 3 <= n and source.slice(fk, fk + 3) == "fun" and (fk + 3 >= n or not is_direct_ident_char(source.char_at(fk + 3))) [
                let nk = fk + 3
                while nk < n and (source.char_at(nk) == " " or source.char_at(nk) == "\t") [
                    nk = nk + 1
                ]
                let name_start = nk
                while nk < n and is_direct_ident_char(source.char_at(nk)) [
                    nk = nk + 1
                ]
                if nk > name_start [
                    names.push(source.slice(name_start, nk))
                ] else [
                    log("[transpiler.hcs] @wasm_export: nie znaleziono nazwy funkcji po 'fun'")
                ]
            ] else [
                log("[transpiler.hcs] @wasm_export: oczekiwano 'fun <nazwa>(...)' zaraz po markerze")
            ]
            i = after
        ]
    ]
    end WasmExportExtraction(out, names)
]

struct SandboxExtraction [
    stripped_source: Str,
    blocks: List<Str>
]

!!! `$ polecenie powloki $` - Zero-Cost Sandbox. `$` nie jest uzywany
!!! NIGDZIE indziej w gramatyce (sprawdzone - brak w lexer.hcs/
!!! parser.hcs), wiec skanowanie jest prostsze niz `direct`/`native`
!!! (brak potrzeby sprawdzania granicy slowa - `$` to symbol, nie
!!! identyfikator). Szuka NAJBLIZSZEGO kolejnego `$` jako zamkniecia -
!!! ZNANE OGRANICZENIE: samo polecenie powloki nie moze zawierac `$`
!!! (np. `$HOME`, `$(...)`) bez przedwczesnego zamkniecia bloku -
!!! patrz docs/ROADMAP.md. Zamienia na `__sandbox__(N)`, tak samo jak
!!! `direct`/`native` - `codegen.hcs::gen_sandbox` generuje
!!! `std::process::Command` z `pre_exec` wolajacym `libc::unshare()`
!!! (CLONE_NEWNET + CLONE_NEWNS) + bind-remount-ro na `/`, z
!!! bezpieczna degradacja (ostrzezenie na stderr, NIE cichy fejl) gdy
!!! brak uprawnien - zweryfikowane w tej sesji realnym testem izolacji
!!! sieci (proces w izolacji widzi TYLKO `lo`, bez `eth0`) i systemu
!!! plikow (zapis do `/` konczy sie "Read-only file system").
!!! Znaleziony samoistnie w tej sesji: bez swiadomosci cudzyslowow,
!!! `$` wewnatrz zwyklego stringu HackerScript (np. w tresci LOGA -
!!! "wykryto $ ... $ (...)") jest mylony z delimiterem sandboxa,
!!! psujac string. Naprawione ponizej: skanowanie `dollar_at` pomija
!!! `$` wewnatrz `"..."` (ze swiadomoscia `\"` escape) - NIE chroni
!!! przed `$` w komentarzach `!!`/`!!!` (waskopasmowe, rzadsze ryzyko,
!!! wciaz warte odnotowania - patrz docs/ROADMAP.md).
!!! Rozszerzone PO realnym, samoistnie znalezionym bledzie w tej
!!! sesji: pierwsza wersja chronila TYLKO `"..."` (cudzyslowy), ale
!!! NIE komentarze `!!`/`!!!` - a doc-komentarze W TYM SAMYM PLIKU
!!! opisujace skladnie `$ ... $` (jak ten tutaj) same zawieraja pare
!!! `$`, wiec przy self-hostingu zostaly potraktowane jako blok
!!! sandboxa i pozarly `struct SandboxExtraction` w calosci. Teraz
!!! skanowanie pomija TEZ `!!`/`!!!` do konca linii (tak jak prawdziwy
!!! lexer.hcs), nie tylko `"..."`.
fun sandbox_dollar_scan(source: Str, from: Int) -> Int [
    let n = source.len()
    let in_string = false
    let escape_next = false
    let k = from
    while k < n [
        let c = source.char_at(k)
        if in_string [
            if escape_next [
                escape_next = false
            ] elif c == "\\" [
                escape_next = true
            ] elif c == "\"" [
                in_string = false
            ]
        ] else [
            if c == "\"" [
                in_string = true
            ] elif c == "!" and k + 1 < n and source.char_at(k + 1) == "!" [
                !! Komentarz !!/!!! - pomijamy do konca linii (albo
                !! do konca zrodla, jesli to ostatnia linia).
                let eol = k
                while eol < n and source.char_at(eol) != "\n" [
                    eol = eol + 1
                ]
                k = eol
            ] elif c == "$" [
                end k
            ]
        ]
        k = k + 1
    ]
    end -1
]

fun extract_sandbox_blocks(source: Str) -> SandboxExtraction [
    let blocks: List<Str> = []
    let out = ""
    let i = 0
    let n = source.len()
    while i < n [
        let dollar_at = sandbox_dollar_scan(source, i)
        if dollar_at == -1 [
            out = out + source.slice(i, n)
            i = n
        ] else [
            out = out + source.slice(i, dollar_at)
            let close_at = -1
            let ck = dollar_at + 1
            while ck < n and close_at == -1 [
                if source.char_at(ck) == "$" [
                    close_at = ck
                ]
                ck = ck + 1
            ]
            if close_at == -1 [
                log("[transpiler.hcs] niezamkniety sandbox-blok (brak drugiego '$')")
                out = out + source.slice(dollar_at, n)
                i = n
            ] else [
                let raw = source.slice(dollar_at + 1, close_at)
                let dedented = trim_str_local(dedent_text(raw))
                let idx = blocks.len()
                blocks.push(dedented)
                out = out + "__sandbox__(" + (idx as Str) + ")"
                i = close_at + 1
            ]
        ]
    ]
    end SandboxExtraction(out, blocks)
]

!!! Rdzen transpilacji - parytet z `transpile_source_full` (patrz
!!! uwaga na gorze pliku co do bledow: brak `Result`, zawsze sciezka
!!! sukcesu). `extra` domyslnie `empty_extra_signatures()` dla
!!! pojedynczego pliku bez kontekstu projektu.
!!! Wspolny blok Rust (emitowany RAZ na crate, tylko gdy istnieje co
!!! najmniej jedna funkcja `@hot_reload`) - watcher-watek + load-and-
!!! swap-all + lazy-start. Kazda funkcja `@hot_reload` (patrz
!!! `codegen.hcs::gen_fun`) ma WLASNY `static HKS_HOT_PTR_<NAZWA>:
!!! AtomicPtr<()>` - ten blok je WSZYSTKIE odswieza po kazdym udanym
!!! przeladowaniu `hotlib` (jeden .so, jedna rekompilacja na zmiane,
!!! niezaleznie od liczby funkcji w nim). `default_source_path` to
!!! sciezka pliku .hcs w ktorym byl zdefiniowany PIERWSZY hot_reload
!!! (v1: watcher sledzi jeden plik - wieloplikowy hot-reload to
!!! rozszerzenie na przyszlosc, patrz docs/ROADMAP.md) - baked-in jako
!!! DOMYSLNA wartosc `HKS_HOT_SOURCE`, nadpisywalna zmienna
!!! srodowiskowa (dla przeniesienia binarki gdzie indziej niz miejsce
!!! kompilacji). `HKS_HOT_OUT_DIR` (katalog z `hotlib/`) MUSI byc
!!! ustawiony jako zmienna srodowiskowa - transpiler.hcs (ten plik)
!!! nie zna finalnego `out_dir`, to decyzja `project.hcs` podejmowana
!!! PO transpilacji, wiec nie da sie tego wpisac na sztywno tutaj bez
!!! naruszenia warstw - jawny blad startowy zamiast cichego zgadywania
!!! zlej sciezki.
!!! DOWIEDZIONE DZIALANIE (nie tylko deklaracja): identyczny mechanizm
!!! (unikalna sciezka .so per generacja + AtomicPtr + watcher na mtime)
!!! zweryfikowany w izolowanym prototypie PRZED wpisaniem tutaj -
!!! dwie kolejne podmiany kodu ZYWEGO procesu (ten sam PID), bez
!!! restartu - patrz docs/ROADMAP.md.
fun hot_reload_runtime_block(names: List<Str>, default_source_path: Str) -> List<Str> [
    let out: List<Str> = []
    out.push("")
    out.push("mod __hks_hot_reload {")
    out.push("    use std::sync::atomic::{AtomicU64, Ordering};")
    out.push("    use std::time::{Duration, SystemTime};")
    out.push("    static HKS_GEN: AtomicU64 = AtomicU64::new(0);")
    out.push("    fn hks_source_path() -> String { std::env::var(\"HKS_HOT_SOURCE\").unwrap_or_else(|_| " + python_raw_string(default_source_path) + ".to_string()) }")
    out.push("    fn hks_out_dir() -> String { std::env::var(\"HKS_HOT_OUT_DIR\").unwrap_or_else(|_| { eprintln!(\"[hackerc-hot-reload] BLAD: zmienna srodowiskowa HKS_HOT_OUT_DIR nie jest ustawiona (katalog z 'hotlib/' - ten sam co przekazany do 'hackerc build -o')\"); String::new() }) }")
    out.push("    fn hks_hackerc_path() -> String { std::env::var(\"HKS_HACKERC_PATH\").unwrap_or_else(|_| \"hackerc\".to_string()) }")
    out.push("    pub fn load_and_swap_all() -> bool {")
    out.push("        let out_dir = hks_out_dir();")
    out.push("        if out_dir.is_empty() { return false; }")
    out.push("        let gen = HKS_GEN.fetch_add(1, Ordering::SeqCst);")
    out.push("        let built = format!(\"{}/hotlib/target/release/libhotlib.so\", out_dir);")
    out.push("        let unique = format!(\"{}/hotlib/libhotlib_{}.so\", out_dir, gen);")
    out.push("        if std::fs::copy(&built, &unique).is_err() {")
    out.push("            eprintln!(\"[hackerc-hot-reload] nie udalo sie skopiowac {} -> {}\", built, unique);")
    out.push("            return false;")
    out.push("        }")
    out.push("        let mut ok = true;")
    out.push("        unsafe {")
    out.push("            match libloading::Library::new(&unique) {")
    out.push("                Ok(lib) => {")
    let i = 0
    let n = names.len()
    while i < n [
        let nm = names[i].clone()
        out.push("                    match lib.get::<extern \"C\" fn()>(b\"" + nm + "\\0\") {")
        out.push("                        Ok(sym) => { super::HKS_HOT_PTR_" + nm + ".store(*sym as *mut (), Ordering::Release); }")
        out.push("                        Err(e) => { eprintln!(\"[hackerc-hot-reload] brak symbolu " + nm + ": {:?}\", e); ok = false; }")
        out.push("                    }")
        i = i + 1
    ]
    out.push("                    std::mem::forget(lib);")
    out.push("                }")
    out.push("                Err(e) => { eprintln!(\"[hackerc-hot-reload] zaladowanie {} nie powiodlo sie: {:?}\", unique, e); ok = false; }")
    out.push("            }")
    out.push("        }")
    out.push("        if ok { eprintln!(\"[hackerc-hot-reload] przeladowano (gen {})\", gen); }")
    out.push("        ok")
    out.push("    }")
    out.push("    fn watch_loop() {")
    out.push("        let src = hks_source_path();")
    out.push("        let out_dir = hks_out_dir();")
    out.push("        let hackerc = hks_hackerc_path();")
    out.push("        let mut last: Option<SystemTime> = None;")
    out.push("        loop {")
    out.push("            if let Ok(meta) = std::fs::metadata(&src) {")
    out.push("                if let Ok(mtime) = meta.modified() {")
    out.push("                    match last {")
    out.push("                        None => { last = Some(mtime); }")
    out.push("                        Some(prev) if mtime > prev => {")
    out.push("                            last = Some(mtime);")
    out.push("                            eprintln!(\"[hackerc-hot-reload] wykryto zmiane {}, przebudowuje...\", src);")
    out.push("                            let step1 = std::process::Command::new(&hackerc).args([\"build\", src.as_str(), \"-o\", out_dir.as_str()]).status();")
    out.push("                            let step1_ok = matches!(step1, Ok(s) if s.success());")
    out.push("                            if !step1_ok { eprintln!(\"[hackerc-hot-reload] hackerc build nie powiodlo sie\"); }")
    out.push("                            else {")
    out.push("                                let manifest = format!(\"{}/hotlib/Cargo.toml\", out_dir);")
    out.push("                                let step2 = std::process::Command::new(\"cargo\").args([\"build\", \"--release\", \"--manifest-path\", manifest.as_str()]).status();")
    out.push("                                let step2_ok = matches!(step2, Ok(s) if s.success());")
    out.push("                                if !step2_ok { eprintln!(\"[hackerc-hot-reload] cargo build (hotlib) nie powiodlo sie\"); }")
    out.push("                                else { load_and_swap_all(); }")
    out.push("                            }")
    out.push("                        }")
    out.push("                        Some(_) => {}")
    out.push("                    }")
    out.push("                }")
    out.push("            }")
    out.push("            std::thread::sleep(Duration::from_millis(500));")
    out.push("        }")
    out.push("    }")
    out.push("    pub fn ensure_started() {")
    out.push("        static ONCE: std::sync::Once = std::sync::Once::new();")
    out.push("        ONCE.call_once(|| {")
    out.push("            load_and_swap_all();")
    out.push("            std::thread::spawn(watch_loop);")
    out.push("        });")
    out.push("    }")
    out.push("}")
    end out
]

fun transpile_program_with_extra(prog: Program, direct_blocks: List<Str>, native_blocks: List<Str>, native_engines: List<Str>, sandbox_blocks: List<Str>, hot_reload_names: List<Str>, wasm_export_names: List<Str>, default_source_path: Str, extra: ExtraSignatures, fast_direct_blocks: List<Str>, fast_direct_backends: List<Str>) -> TranspileResult [
    let local_sigs = collect_signatures(prog.clone())
    let sigs = merge_signatures_with_extra(local_sigs, extra)
    let local_mut = compute_mut_params(prog.clone())
    let mut_params = merge_mut_params_with_extra(local_mut, extra)
    let method_mut_params = compute_method_mut_params(prog.clone(), extra.method_mut_params.clone())
    let info = build_recursion_info(sigs.clone())
    let varity = build_variant_arity(sigs.clone())
    let ndstructs = compute_no_default_structs(sigs.clone(), info.boxed_fields.clone())
    let direct_dict = direct_blocks_to_dict(direct_blocks)
    let native_dict = direct_blocks_to_dict(native_blocks)
    let native_engine_dict = direct_blocks_to_dict(native_engines)
    let sandbox_dict = direct_blocks_to_dict(sandbox_blocks)
    let hot_reload_dict = names_to_bool_dict(hot_reload_names)
    let wasm_export_dict = names_to_bool_dict(wasm_export_names)
    let fast_direct_dict = direct_blocks_to_dict(fast_direct_blocks)
    let fast_direct_backend_dict = direct_blocks_to_dict(fast_direct_backends)
    let gen = new_codegen(sigs, info.boxed_fields, mut_params, method_mut_params, varity, ndstructs, direct_dict, native_dict, native_engine_dict, sandbox_dict, hot_reload_dict, wasm_export_dict, fast_direct_dict, fast_direct_backend_dict, extra.extern_fn_name_list)

    let i = 0
    let n = prog.body.len()
    while i < n [
        gen.gen_toplevel(prog.body[i].clone())
        i = i + 1
    ]

    let header: List<Str> = ["// Plik wygenerowany automatycznie przez hackerc (HackerScript -> Rust).", "// NIE EDYTUJ RECZNIE - edytuj zrodlo .hcs i uruchom 'virus build' ponownie.", "#![allow(non_snake_case, unused_mut, dead_code)]"]
    if gen.needs_pyo3 [
        header.push("use pyo3::prelude::*;")
    ]
    if gen.needs_wasm_bindgen [
        header.push("use wasm_bindgen::prelude::*;")
    ]
    !! ROZBUDOWA (ta runda) - `sha256_hex(...)`: w ODROZNIENIU od
    !! `needs_pyo3`/`needs_native_java`/... (ktore sa polami
    !! MUTOWANYMI przez `self.pole = true` gdzies gleboko w
    !! `gen_call`), TU celowo NIE dodano takiego pola do `CodeGen` -
    !! `gen_call` jest wywolywane (posrednio, przez `gen_expr`) przez
    !! PRAWIE KAZDA inna funkcje generujaca kod w tym pliku, a
    !! wnioskowanie mutowalnosci `self` w hackerc (`method_mut_params`)
    !! jest TRANZYTYWNE po calym grafie wywolan - jedna nowa mutacja
    !! `self.pole = true` gleboko w `gen_call` przeksztalcila ~13
    !! wczesniej `&self` metod (gen_expr, gen_binop, gen_if_stmt...) w
    !! `&mut self`, co zepsulo ISTNIEJACY (niezmieniony!) wzorzec
    !! `self.emit(&format!(..., self.gen_expr(...)))` (E0499 - Rust nie
    !! pozwala na DWA jednoczesne `&mut self` w takim zagniezdzeniu) -
    !! znalezione realnym buildem, patrz docs/ROADMAP.md. Zamiast tego:
    !! sam PRZESZUKUJEMY juz wygenerowane linie (`gen.output`, gotowe
    !! PO petli `gen_toplevel` wyzej) pod katem tekstu, ktory
    !! `gen_call` emituje TYLKO dla `sha256_hex` - zero dodatkowej
    !! mutowalnosci `self`, zero ryzyka kaskady.
    let needs_sha256 = false
    let soi = 0
    let son = gen.output.len()
    while soi < son [
        if str_contains(gen.output[soi].clone(), "Sha256::new()") [
            needs_sha256 = true
        ]
        soi = soi + 1
    ]
    if needs_sha256 [
        header.push("use sha2::{Sha256, Digest};")
    ]
    !! ROZBUDOWA (ta runda, patrz docs/JAVA.md) - `hks_get_jvm()`:
    !! WSPOLNA (per-plik, patrz UCZCIWIE w codegen.hcs::gen_native)
    !! embedded JVM, tworzona LENIWIE przy pierwszym `native
    !! {java}(...)` bloku. Classpath ustalany w RUNTIME wzgledem
    !! POLOZENIA BINARKI (`env::current_exe()` -> katalog nadrzedny ->
    !! `java_classes/`), NIE wzgledem sciezki budowania - zeby
    !! zbudowana binarka dzialala uruchomiona z DOWOLNEGO katalogu
    !! roboczego, o ile `java_classes/` (skopiowane przez `virus
    !! build` obok binarki, patrz `virus/cmd/build.hcs`) jedzie razem
    !! z nia.
    if gen.needs_native_java [
        header.push("static HKS_JVM: std::sync::OnceLock<jni::JavaVM> = std::sync::OnceLock::new();")
        header.push("fn hks_get_jvm() -> &'static jni::JavaVM {")
        header.push("    HKS_JVM.get_or_init(|| {")
        header.push("        let __hks_cp_dir = std::env::current_exe().ok().and_then(|p| p.parent().map(|d| d.join(\"java_classes\"))).map(|p| p.to_string_lossy().to_string()).unwrap_or_else(|| \"java_classes\".to_string());")
        header.push("        let __hks_cp_opt = format!(\"-Djava.class.path={}\", __hks_cp_dir);")
        header.push("        let __hks_args = jni::InitArgsBuilder::new().option(&__hks_cp_opt).build().expect(\"nieprawidlowe argumenty inicjalizacji embedded JVM\");")
        header.push("        jni::JavaVM::new(__hks_args).expect(\"nie udalo sie wystartowac embedded JVM - czy JRE/JDK (libjvm.so) jest dostepne w tym srodowisku?\")")
        header.push("    })")
        header.push("}")
    ]
    header.push("")

    let rust_lines: List<Str> = []
    let hi = 0
    let hn = header.len()
    while hi < hn [
        rust_lines.push(header[hi].clone())
        hi = hi + 1
    ]
    let oi = 0
    let on = gen.output.len()
    while oi < on [
        rust_lines.push(gen.output[oi].clone())
        oi = oi + 1
    ]

    if gen.needs_hot_reload [
        let hb = hot_reload_runtime_block(gen.hot_reload_order.clone(), default_source_path)
        let hbi = 0
        let hbn = hb.len()
        while hbi < hbn [
            rust_lines.push(hb[hbi].clone())
            hbi = hbi + 1
        ]
    ]

    let rust_code = ""
    let ri = 0
    let rn = rust_lines.len()
    while ri < rn [
        rust_code = rust_code + rust_lines[ri]
        if ri < rn - 1 [
            rust_code = rust_code + "\n"
        ]
        ri = ri + 1
    ]
    rust_code = rust_code + "\n"

    end TranspileResult(rust_code, gen.needs_pyo3, gen.needs_native_js, gen.needs_sandbox, gen.needs_hot_reload, gen.hot_reload_bodies, gen.hot_reload_order, gen.needs_native_cpp, collect_extern_link_specs(prog), gen.native_cpp_sources, gen.native_cpp_order, gen.needs_wasm_bindgen, gen.needs_native_java, gen.native_java_sources, gen.native_java_order, gen.java_classpath_entries, needs_sha256)
]

!!! Transpiluje zrodlo `.hcs` -> `TranspileResult` (kod Rust + info czy
!!! potrzebne PyO3) - parytet z `transpile_source_full`. `module_name`
!!! jest dzis przyjmowany dla zgodnosci sygnatury z Pythonem, ale
!!! (tak samo jak w `codegen.hcs::gen_program`) NIE trafia jeszcze do
!!! naglowka wygenerowanego pliku - laczenie wielu plikow/nazewnictwo
!!! modulow to zadanie `project.hcs`, ktore uzywa go osobno przy
!!! zapisie `src/{flat_name}.rs`.
!!! Katalog nadrzedny sciezki (dla wzglednych importow w
!!! `native` `{X}` `<sciezka>`) - "a/b/c.hcs" -> "a/b", "c.hcs" -> "".
fun native_dirname(p: Str) -> Str [
    let n = p.len()
    let last_slash = -1
    let i = 0
    while i < n [
        if p.char_at(i) == "/" [
            last_slash = i
        ]
        i = i + 1
    ]
    if last_slash == -1 [
        end ""
    ]
    end p.slice(0, last_slash)
]

fun transpile_source_full(source: Str, filename: Str, module_name: Str, extra: ExtraSignatures) -> TranspileResult [
    let fast_direct_extraction = extract_fast_direct_blocks(source)
    let extraction = extract_direct_blocks(fast_direct_extraction.stripped_source)
    let native_extraction = extract_native_blocks(extraction.stripped_source, native_dirname(filename))
    let sandbox_extraction = extract_sandbox_blocks(native_extraction.stripped_source)
    let hot_extraction = extract_hot_reload_markers(sandbox_extraction.stripped_source)
    let wasm_extraction = extract_wasm_export_markers(hot_extraction.stripped_source)
    let prog = parse(wasm_extraction.stripped_source)
    end transpile_program_with_extra(prog, extraction.blocks, native_extraction.blocks, native_extraction.engines, sandbox_extraction.blocks, hot_extraction.names, wasm_extraction.names, filename, extra, fast_direct_extraction.blocks, fast_direct_extraction.backends)
]

!!! Skrot: zwraca tylko kod Rust (bez `needs_pyo3`) - parytet z
!!! `transpile_source(source, filename)` (Python, domyslny `extra=None`).
fun transpile_source(source: Str, filename: Str) -> Str [
    let result = transpile_source_full(source, filename, "module", empty_extra_signatures())
    end result.rust_code
]

!!! Czyta `src_path`, transpiluje, zapisuje `.rs` do `out_path` - parytet
!!! z `transpile_file`. Uzywa wbudowanych `read_file`/`write_file`
!!! (patrz `libs/std/lib/io.hcs`) zamiast `pathlib.Path.read_text`/
!!! `write_text` - `mkdir(parents=True)` z Pythona NIE MA odpowiednika
!!! (brak prymitywu tworzenia katalogow w tym bootstrapie, patrz
!!! "Ograniczenia" ponizej i `project.hcs`) wiec `out_path` musi
!!! wskazywac na JUZ ISTNIEJACY katalog.
fun transpile_file(src_path: Str, out_path: Str, module_name: Str) -> Result<TranspileResult, Str> [
    let read_result = read_file(src_path)
    match read_result [
        Ok(source) -> [
            let result = transpile_source_full(source, src_path, module_name, empty_extra_signatures())
            let write_result = write_file(out_path, result.rust_code.clone())
            match write_result [
                Ok(_v) -> [
                    end ok(result)
                ]
                Err(e) -> [
                    end err(e)
                ]
            ]
        ]
        Err(e) -> [
            end err(e)
        ]
    ]
]

!!! Demonstracyjne uzycie - transpiluje maly program zawierajacy
!!! `direct [ ... ]`, sprawdza ze `__direct__(0)` zostal poprawnie
!!! wyciagniety i ze `needs_pyo3` jest ustawione.
fun main() [
    let src = "fun main() [\n    direct [\n        print(\"hello from python\")\n    ]\n    log(\"hello from rust\")\n]\n"
    let extra = empty_extra_signatures()
    let result = transpile_source_full(src, "<demo>", "module", extra)
    log("needs_pyo3:", result.needs_pyo3)
    log("dlugosc wygenerowanego Rusta:", result.rust_code.len())
]
