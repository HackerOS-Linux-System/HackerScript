include <diagnostics>
include <lexer>
get <std:json> import <json_escape_string>
get <std:string> import <str_trim::str_starts_with::str_join::str_split::str_ends_with::str_contains::str_index_of>
get <std:io> import <read_file_or::file_readable>

!!! LSP Etap 2b/2c (patrz docs/LSP.md) - hover, definition,
!!! completion. Implementacja OPARTA NA TEKSCIE (skan linii dokumentu),
!!! NIE na AST - AST nie ma pozycji (patrz ROADMAP, "numery linii w
!!! AST"), wiec definicje szukamy jako pierwsza linie zaczynajaca sie od
!!! `fun`/`struct`/`enum`/`const`/`let` z pasujaca nazwa. To swiadome,
!!! proste przyblizenie: brak rozroznienia zakresow (dwie funkcje o tej
!!! samej nazwie w roznych `impl` -> pierwsza). (0.6) `definition` szuka
!!! tez w plikach dolaczonych przez `include <nazwa>` (rodzenstwo na
!!! dysku); `rename`/`references` dzialaja na otwartym dokumencie.

struct DeclInfo [
    line: Int,
    col: Int,
    kind: Str,
    name: Str
]

fun lsp_is_ident_char(c: Str) -> Bool [
    end (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_"
]

!!! Identyfikator pod kursorem (`character` = pozycja PRZED znakiem, jak w
!!! LSP; kursor tuz za koncem slowa tez liczy sie jako slowo).
fun lsp_word_at(line_text: Str, character: Int) -> Str [
    let n = line_text.len()
    let pos = character
    if pos > n [
        pos = n
    ]
    let start = pos
    while start > 0 and lsp_is_ident_char(line_text.char_at(start - 1)) [
        start = start - 1
    ]
    let stop = pos
    while stop < n and lsp_is_ident_char(line_text.char_at(stop)) [
        stop = stop + 1
    ]
    if stop <= start [
        end ""
    ]
    end line_text.slice(start, stop)
]

fun lsp_leading_spaces(s: Str) -> Int [
    let i = 0
    while i < s.len() and (s.char_at(i) == " " or s.char_at(i) == "\t") [
        i = i + 1
    ]
    end i
]

fun lsp_ident_prefix(s: Str) -> Str [
    let i = 0
    while i < s.len() and lsp_is_ident_char(s.char_at(i)) [
        i = i + 1
    ]
    end s.slice(0, i)
]

!!! Jesli `text` (po wcieciu) zaczyna sie od deklaracji `fun`/`struct`/`enum`/
!!! `const`/`let` (z opcjonalnym `pub `), zwraca (rodzaj, nazwa, kolumna
!!! nazwy) jako DeclInfo z line=0; inaczej none().
fun lsp_decl_on_line(line_text: Str) -> Option<DeclInfo> [
    let lead = lsp_leading_spaces(line_text)
    let t: Str = line_text.slice(lead, line_text.len())
    let base = lead
    if str_starts_with(t, "pub ") [
        t = t.slice(4, t.len())
        base = base + 4
    ]
    let kinds: List<Str> = ["fun", "struct", "enum", "const", "let"]
    let ki = 0
    while ki < kinds.len() [
        let k: Str = kinds[ki].clone()
        let prefix: Str = k + " "
        if str_starts_with(t, prefix) [
            let rest: Str = t.slice(prefix.len(), t.len())
            let nm: Str = lsp_ident_prefix(rest)
            if nm.len() > 0 [
                end some(DeclInfo(0, base + prefix.len(), k, nm))
            ]
        ]
        ki = ki + 1
    ]
    end none()
]

fun lsp_find_decl(lines: List<Str>, word: Str) -> Option<DeclInfo> [
    let i = 0
    while i < lines.len() [
        match lsp_decl_on_line(lines[i].clone()) [
            Some(d) -> [
                if d.name == word [
                    end some(DeclInfo(i, d.col, d.kind.clone(), d.name.clone()))
                ]
            ]
            None -> [
            ]
        ]
        i = i + 1
    ]
    end none()
]

fun lsp_line_or_empty(lines: List<Str>, idx: Int) -> Str [
    if idx >= 0 and idx < lines.len() [
        end lines[idx].clone()
    ]
    end ""
]


!!! ---------------------------------------------------------------------
!!! 0.6: ZAKRESY (strukturalny skan tekstu, nadal NIE AST - AST nie ma pozycji).
!!! ---------------------------------------------------------------------
!!! Zakres to blok `fun ... [ ... ]` albo `impl Typ [ ... ]`: naglowek konczy sie
!!! `[`, a blok konczy pierwsza linia zaczynajaca sie od `]` w TYM SAMYM wcieciu
!!! (kod sformatowany przez `hackerc fmt` spelnia to zawsze). Dzieki temu:
!!!  * zmienna lokalna/parametr (`let x`, `for x in`, `Some(x) ->`, parametr
!!!    funkcji) jest szukana, zmieniana i znajdowana TYLKO w swojej funkcji;
!!!  * metoda `obiekt.nazwa` jest przypisywana do typu odbiorcy: `self` -> typ
!!!    z otaczajacego `impl`, zmienna -> typ z `let v = Typ(...)`, `let v: Typ`
!!!    albo z parametru `v: Typ`. Przy nieznanym typie odbiorcy dzialamy jak
!!!    dawniej (wszystkie metody o tej nazwie).
!!! Ograniczenia: brak wnioskowania typow (zwrot funkcji, pola, listy), wzorce
!!! zagniezdzone w `match` (`Some(Foo(x))`) nie sa rozpoznawane jako deklaracje.

struct LspScope [
    kind: Str,
    name: Str,
    start: Int,
    stop: Int
]

struct LspOccs [
    lines: List<Int>,
    cols: List<Int>
]

fun lsp_strip_prefixes(t: Str) -> Str [
    let r: Str = t
    if str_starts_with(r.clone(), "pub ") [
        r = r.slice(4, r.len())
    ]
    if str_starts_with(r.clone(), "async ") [
        r = r.slice(6, r.len())
    ]
    end r
]

!!! (rodzaj, nazwa) dla linii naglowka `fun`/`impl` zakonczonej `[`.
fun lsp_scope_header(line_text: Str) -> Option<DeclInfo> [
    let t: Str = str_trim(line_text)
    if t.len() == 0 or str_ends_with(t.clone(), "[") == false [
        end none()
    ]
    let r: Str = lsp_strip_prefixes(t)
    if str_starts_with(r.clone(), "fun ") [
        let nm: Str = lsp_ident_prefix(r.slice(4, r.len()))
        if nm.len() > 0 [
            end some(DeclInfo(0, 0, "fun", nm))
        ]
    ]
    if str_starts_with(r.clone(), "impl ") [
        let nm2: Str = lsp_ident_prefix(r.slice(5, r.len()))
        if nm2.len() > 0 [
            end some(DeclInfo(0, 0, "impl", nm2))
        ]
    ]
    end none()
]

fun lsp_scopes(lines: List<Str>) -> List<LspScope> [
    let out: List<LspScope> = []
    let n = lines.len()
    let i = 0
    while i < n [
        match lsp_scope_header(lines[i].clone()) [
            Some(h) -> [
                let ind = lsp_leading_spaces(lines[i].clone())
                let stop = n - 1
                let found = false
                let j = i + 1
                while j < n and found == false [
                    let lj: Str = lines[j].clone()
                    if lsp_leading_spaces(lj.clone()) == ind and str_starts_with(str_trim(lj.clone()), "]") [
                        stop = j
                        found = true
                    ]
                    j = j + 1
                ]
                out.push(LspScope(h.kind.clone(), h.name.clone(), i, stop))
            ]
            None -> [
            ]
        ]
        i = i + 1
    ]
    end out
]

!!! Indeks NAJWEZSZEGO zakresu danego rodzaju zawierajacego `line` (albo -1).
fun lsp_scope_idx_at(scopes: List<LspScope>, line: Int, kind: Str) -> Int [
    let best = -1
    let best_size = 1000000000
    let k = 0
    while k < scopes.len() [
        let s = scopes[k].clone()
        if s.kind == kind and s.start <= line and line <= s.stop and (s.stop - s.start) < best_size [
            best = k
            best_size = s.stop - s.start
        ]
        k = k + 1
    ]
    end best
]

!!! Nazwy w pierwszej parze nawiasow `( ... )` tekstu: czesci rozdzielone `,`,
!!! z kazdej bierzemy prefiks identyfikatora (`a: Int` -> `a`).
fun lsp_names_in_parens(text: Str) -> List<Str> [
    let out: List<Str> = []
    match str_index_of(text.clone(), "(") [
        Some(a) -> [
            let depth = 0
            let i = a
            let stop = -1
            while i < text.len() and stop < 0 [
                let c = text.char_at(i)
                if c == "(" [
                    depth = depth + 1
                ] elif c == ")" [
                    depth = depth - 1
                    if depth == 0 [
                        stop = i
                    ]
                ]
                i = i + 1
            ]
            if stop < 0 [
                stop = text.len()
            ]
            let inner: Str = text.slice(a + 1, stop)
            let parts = str_split(inner, ",")
            let k = 0
            while k < parts.len() [
                let nm: Str = lsp_ident_prefix(str_trim(parts[k].clone()))
                if nm.len() > 0 [
                    out.push(nm)
                ]
                k = k + 1
            ]
        ]
        None -> [
        ]
    ]
    end out
]

fun lsp_list_has_str(items: List<Str>, x: Str) -> Bool [
    let i = 0
    while i < items.len() [
        if items[i] == x [
            end true
        ]
        i = i + 1
    ]
    end false
]

!!! Czy linia WEWNATRZ funkcji deklaruje zmienna lokalna `word`:
!!! `let word`, `for word in`, `for k, word in`, wzorzec `Wariant(word) -> [`.
fun lsp_line_declares(line_text: Str, word: Str) -> Bool [
    let t: Str = str_trim(line_text)
    if str_starts_with(t.clone(), "let ") [
        end lsp_ident_prefix(t.slice(4, t.len())) == word
    ]
    if str_starts_with(t.clone(), "for ") [
        let rest: Str = t.slice(4, t.len())
        match str_index_of(rest.clone(), " in ") [
            Some(ix) -> [
                let names = str_split(rest.slice(0, ix), ",")
                let k = 0
                while k < names.len() [
                    if str_trim(names[k].clone()) == word [
                        end true
                    ]
                    k = k + 1
                ]
            ]
            None -> [
            ]
        ]
        end false
    ]
    if str_ends_with(t.clone(), "[") and str_contains(t.clone(), "->") and str_contains(t.clone(), "(") [
        match str_index_of(t.clone(), "->") [
            Some(ar) -> [
                end lsp_list_has_str(lsp_names_in_parens(t.slice(0, ar)), word)
            ]
            None -> [
            ]
        ]
    ]
    end false
]

!!! Linia deklaracji zmiennej lokalnej/parametru `word` w funkcji `sc` albo -1.
fun lsp_local_decl_line(lines: List<Str>, sc: LspScope, word: Str) -> Int [
    let header: Str = lsp_strip_prefixes(str_trim(lines[sc.start].clone()))
    if lsp_list_has_str(lsp_names_in_parens(header), word) [
        end sc.start
    ]
    let i = sc.start + 1
    while i <= sc.stop and i < lines.len() [
        if lsp_line_declares(lines[i].clone(), word) [
            end i
        ]
        i = i + 1
    ]
    end -1
]

fun lsp_word_start(line_text: Str, character: Int) -> Int [
    let pos = character
    if pos > line_text.len() [
        pos = line_text.len()
    ]
    let start = pos
    while start > 0 and lsp_is_ident_char(line_text.char_at(start - 1)) [
        start = start - 1
    ]
    end start
]

!!! Identyfikator odbiorcy w `odbiorca.slowo` (slowo zaczyna sie w kolumnie
!!! `start`); "" gdy slowo nie jest poprzedzone kropka.
fun lsp_receiver_before(line_text: Str, start: Int) -> Str [
    if start < 1 or line_text.char_at(start - 1) != "." [
        end ""
    ]
    let e = start - 1
    let b = e
    while b > 0 and lsp_is_ident_char(line_text.char_at(b - 1)) [
        b = b - 1
    ]
    end line_text.slice(b, e)
]

!!! Typ zmiennej `var` widocznej w linii `line`: `self` -> typ z `impl`; inaczej
!!! parametr `var: Typ`, `let var: Typ` albo `let var = Typ(...)` w tej funkcji.
fun lsp_var_type(lines: List<Str>, scopes: List<LspScope>, line: Int, var: Str) -> Str [
    if var == "self" [
        let ii = lsp_scope_idx_at(scopes.clone(), line, "impl")
        if ii >= 0 [
            end scopes[ii].name.clone()
        ]
        end ""
    ]
    let lo = 0
    let hi = lines.len() - 1
    let fi = lsp_scope_idx_at(scopes.clone(), line, "fun")
    if fi >= 0 [
        lo = scopes[fi].start
        hi = scopes[fi].stop
    ]
    let i = lo
    while i <= hi and i < lines.len() [
        let t: Str = lsp_strip_prefixes(str_trim(lines[i].clone()))
        if i == lo and fi >= 0 and str_starts_with(t.clone(), "fun ") [
            match str_index_of(t.clone(), "(") [
                Some(a) -> [
                    let parts = str_split(t.slice(a + 1, t.len()), ",")
                    let k = 0
                    while k < parts.len() [
                        let part: Str = str_trim(parts[k].clone())
                        if lsp_ident_prefix(part.clone()) == var [
                            match str_index_of(part.clone(), ":") [
                                Some(c) -> [
                                    end lsp_ident_prefix(str_trim(part.slice(c + 1, part.len())))
                                ]
                                None -> [
                                ]
                            ]
                        ]
                        k = k + 1
                    ]
                ]
                None -> [
                ]
            ]
        ]
        if str_starts_with(t.clone(), "let ") and lsp_ident_prefix(t.slice(4, t.len())) == var [
            let after: Str = t.slice(4 + var.len(), t.len())
            let a2: Str = str_trim(after)
            if str_starts_with(a2.clone(), ":") [
                end lsp_ident_prefix(str_trim(a2.slice(1, a2.len())))
            ]
            if str_starts_with(a2.clone(), "=") [
                let ctor: Str = lsp_ident_prefix(str_trim(a2.slice(1, a2.len())))
                if ctor.len() > 0 and ctor.char_at(0) >= "A" and ctor.char_at(0) <= "Z" [
                    end ctor
                ]
            ]
        ]
        i = i + 1
    ]
    end ""
]

!!! Typ docelowy metody pod kursorem: nazwa `impl`, w ktorym jest deklaracja
!!! `fun slowo`, albo typ odbiorcy `odbiorca.slowo`; "" gdy nieznany / to nie metoda.
fun lsp_member_owner(lines: List<Str>, scopes: List<LspScope>, line: Int, character: Int, word: Str) -> Str [
    let text: Str = lsp_line_or_empty(lines.clone(), line)
    let recv: Str = lsp_receiver_before(text.clone(), lsp_word_start(text.clone(), character))
    if recv != "" [
        end lsp_var_type(lines.clone(), scopes.clone(), line, recv)
    ]
    let fi = lsp_scope_idx_at(scopes.clone(), line, "fun")
    if fi >= 0 and scopes[fi].start == line and scopes[fi].name == word [
        let ii = lsp_scope_idx_at(scopes.clone(), line, "impl")
        if ii >= 0 [
            end scopes[ii].name.clone()
        ]
    ]
    end ""
]

!!! Czy kursor stoi na elemencie czlonkowskim (po kropce) albo na deklaracji metody.
fun lsp_is_member_position(lines: List<Str>, scopes: List<LspScope>, line: Int, character: Int, word: Str) -> Bool [
    let text: Str = lsp_line_or_empty(lines.clone(), line)
    if lsp_receiver_before(text.clone(), lsp_word_start(text.clone(), character)) != "" [
        end true
    ]
    let fi = lsp_scope_idx_at(scopes.clone(), line, "fun")
    if fi >= 0 and scopes[fi].start == line and scopes[fi].name == word and lsp_scope_idx_at(scopes.clone(), line, "impl") >= 0 [
        end true
    ]
    end false
]

!!! Wszystkie wystapienia slowa pod kursorem z uwzglednieniem zakresow.
fun lsp_collect_occurrences(lines: List<Str>, line: Int, character: Int) -> LspOccs [
    let occ = LspOccs([], [])
    let word = lsp_word_at(lsp_line_or_empty(lines.clone(), line), character)
    if word == "" [
        end occ
    ]
    let scopes = lsp_scopes(lines.clone())
    let member = lsp_is_member_position(lines.clone(), scopes.clone(), line, character, word.clone())
    let owner: Str = ""
    let cursor_fun = lsp_scope_idx_at(scopes.clone(), line, "fun")
    let local_range = false
    if member [
        owner = lsp_member_owner(lines.clone(), scopes.clone(), line, character, word.clone())
    ] elif cursor_fun >= 0 [
        if lsp_local_decl_line(lines.clone(), scopes[cursor_fun].clone(), word.clone()) >= 0 [
            local_range = true
        ]
    ]
    let i = 0
    while i < lines.len() [
        let text: Str = lines[i].clone()
        let cols = lsp_word_cols(text.clone(), word.clone())
        let fi = lsp_scope_idx_at(scopes.clone(), i, "fun")
        let k = 0
        while k < cols.len() [
            let c = cols[k]
            let recv: Str = lsp_receiver_before(text.clone(), c)
            let keep = false
            if member [
                if recv != "" [
                    if owner == "" [
                        keep = true
                    ] elif lsp_var_type(lines.clone(), scopes.clone(), i, recv.clone()) == owner [
                        keep = true
                    ]
                ] elif fi >= 0 and scopes[fi].start == i and scopes[fi].name == word [
                    let ii = lsp_scope_idx_at(scopes.clone(), i, "impl")
                    if ii >= 0 and (owner == "" or scopes[ii].name == owner) [
                        keep = true
                    ]
                ]
            ] elif recv == "" [
                if local_range [
                    if fi == cursor_fun [
                        keep = true
                    ]
                ] else [
                    keep = true
                    if fi >= 0 and fi != cursor_fun [
                        if lsp_local_decl_line(lines.clone(), scopes[fi].clone(), word.clone()) >= 0 [
                            keep = false
                        ]
                    ]
                ]
            ]
            if keep [
                occ.lines.push(i)
                occ.cols.push(c)
            ]
            k = k + 1
        ]
        i = i + 1
    ]
    end occ
]

!!! Deklaracja symbolu pod kursorem z uwzglednieniem zakresow (None -> uzyj
!!! starego wyszukiwania globalnego).
fun lsp_resolve_decl(lines: List<Str>, line: Int, character: Int) -> Option<DeclInfo> [
    let word = lsp_word_at(lsp_line_or_empty(lines.clone(), line), character)
    if word == "" [
        end none()
    ]
    let scopes = lsp_scopes(lines.clone())
    if lsp_is_member_position(lines.clone(), scopes.clone(), line, character, word.clone()) [
        let owner = lsp_member_owner(lines.clone(), scopes.clone(), line, character, word.clone())
        let k = 0
        let fallback = -1
        while k < scopes.len() [
            let s = scopes[k].clone()
            if s.kind == "fun" and s.name == word [
                let ii = lsp_scope_idx_at(scopes.clone(), s.start, "impl")
                if ii >= 0 [
                    if owner != "" and scopes[ii].name == owner [
                        end some(DeclInfo(s.start, lsp_word_cols(lines[s.start].clone(), word.clone())[0], "fun", word.clone()))
                    ]
                    if fallback < 0 [
                        fallback = s.start
                    ]
                ]
            ]
            k = k + 1
        ]
        if owner == "" and fallback >= 0 [
            end some(DeclInfo(fallback, lsp_word_cols(lines[fallback].clone(), word.clone())[0], "fun", word.clone()))
        ]
        end none()
    ]
    let fi = lsp_scope_idx_at(scopes.clone(), line, "fun")
    if fi >= 0 [
        let dl = lsp_local_decl_line(lines.clone(), scopes[fi].clone(), word.clone())
        if dl >= 0 [
            let cs = lsp_word_cols(lines[dl].clone(), word.clone())
            if cs.len() > 0 [
                let col0 = cs[0]
                if dl == scopes[fi].start and cs.len() > 1 [
                    col0 = cs[1]
                ]
                end some(DeclInfo(dl, col0, "local", word.clone()))
            ]
        ]
    ]
    !!! globalnie: tylko deklaracje NA POZIOMIE PLIKU (wciecie 0) - zmienna lokalna z innej funkcji
    !!! nie jest definicja nazwy uzytej gdzie indziej.
    let i = 0
    while i < lines.len() [
        if lsp_leading_spaces(lines[i].clone()) == 0 [
            match lsp_decl_on_line(lines[i].clone()) [
                Some(d) -> [
                    if d.name == word [
                        end some(DeclInfo(i, d.col, d.kind.clone(), d.name.clone()))
                    ]
                ]
                None -> [
                ]
            ]
        ]
        i = i + 1
    ]
    end none()
]

!!! textDocument/definition -> Location albo `null`.
fun lsp_definition_json(uri: Str, source: Str, line: Int, character: Int) -> Str [
    let lines = split_lines(source)
    let word = lsp_word_at(lsp_line_or_empty(lines.clone(), line), character)
    if word == "" [
        end "null"
    ]
    let resolved = lsp_resolve_decl(lines.clone(), line, character)
    match resolved [
        Some(d) -> [
            let sl = d.line as Str
            let sc = d.col as Str
            let ec = (d.col + d.name.len()) as Str
            end "{\"uri\":" + json_escape_string(uri) + ",\"range\":{\"start\":{\"line\":" + sl + ",\"character\":" + sc + "},\"end\":{\"line\":" + sl + ",\"character\":" + ec + "}}}"
        ]
        None -> [
            end "null"
        ]
    ]
]

fun lsp_builtin_doc(word: Str) -> Str [
    if word == "log" [
        end "log(x) -> Void - wypisuje na stdout (println)"
    ]
    if word == "elog" [
        end "elog(x) -> Void - wypisuje na stderr"
    ]
    if word == "dict" [
        end "dict() -> Dict<K, V> - pusty slownik (HashMap)"
    ]
    if word == "set" [
        end "set() -> Set<T> - pusty zbior (HashSet)"
    ]
    if word == "some" or word == "none" [
        end "Option<T>: some(x) / none()"
    ]
    if word == "ok" or word == "err" [
        end "Result<T, E>: ok(x) / err(e)"
    ]
    if word == "read_file" [
        end "read_file(path: Str) -> Result<Str, Str>"
    ]
    if word == "write_file" [
        end "write_file(path: Str, text: Str) -> Result<Void, Str>"
    ]
    if word == "run_command" [
        end "run_command(program: Str, args: List<Str>) -> Result<Str, Str> - stdout procesu"
    ]
    if word == "now_ms" [
        end "now_ms() -> Int - czas w ms od epoki Unix"
    ]
    if word == "target_os" [
        end "target_os() -> Str - system docelowy programu: linux | windows | macos | ios | android"
    ]
    if word == "sha256_hex" [
        end "sha256_hex(text: Str) -> Str"
    ]
    if word == "env_var" [
        end "env_var(name: Str) -> Option<Str>"
    ]
    if word == "http_get" [
        end "http_get(url: Str) -> Result<Str, Str>"
    ]
    end ""
]

fun lsp_keyword_doc(word: Str) -> Str [
    if is_keyword(word.clone()) [
        end "slowo kluczowe HackerScript: `" + word + "`"
    ]
    end ""
]

!!! Tekst hovera dla deklaracji: sygnatura funkcji (bez konczacego ` [`),
!!! albo cale ciało `struct`/`enum` (do linii `]`, max 30 linii).
fun lsp_decl_hover_text(lines: List<Str>, d: DeclInfo) -> Str [
    let first: Str = str_trim(lines[d.line].clone())
    if d.kind == "fun" [
        if first.len() >= 2 and first.slice(first.len() - 2, first.len()) == " [" [
            first = first.slice(0, first.len() - 2)
        ]
        end first
    ]
    if d.kind == "struct" or d.kind == "enum" [
        let parts: List<Str> = [lines[d.line].clone()]
        let j = d.line + 1
        while j < lines.len() and j < d.line + 30 [
            parts.push(lines[j].clone())
            if str_trim(lines[j].clone()) == "]" [
                j = lines.len()
            ]
            j = j + 1
        ]
        end str_join(parts, "\n")
    ]
    end first
]

fun lsp_hover_json(source: Str, line: Int, character: Int) -> Str [
    let lines = split_lines(source)
    let word = lsp_word_at(lsp_line_or_empty(lines.clone(), line), character)
    if word == "" [
        end "null"
    ]
    let text = ""
    let hover_decl = lsp_resolve_decl(lines.clone(), line, character)
    match hover_decl [
        Some(d) -> [
            text = "```hackerscript\n" + lsp_decl_hover_text(lines.clone(), d) + "\n```"
        ]
        None -> [
            let bd = lsp_builtin_doc(word.clone())
            if bd != "" [
                text = "```hackerscript\n" + bd + "\n```"
            ] else [
                text = lsp_keyword_doc(word.clone())
            ]
        ]
    ]
    if text == "" [
        end "null"
    ]
    end "{\"contents\":{\"kind\":\"markdown\",\"value\":" + json_escape_string(text) + "}}"
]

fun lsp_completion_item(label: Str, kind: Int, detail: Str) -> Str [
    end "{\"label\":" + json_escape_string(label) + ",\"kind\":" + (kind as Str) + ",\"detail\":" + json_escape_string(detail) + "}"
]

!!! textDocument/completion - slowa kluczowe (kind 14), wbudowane (3),
!!! oraz deklaracje z otwartego dokumentu: fun(3) struct(22) enum(13)
!!! const(21) let(6). Bez filtrowania po prefiksie (klient filtruje).
fun lsp_completion_json(source: Str) -> Str [
    let items: List<Str> = []
    let kws: List<Str> = ["fun", "let", "const", "if", "else", "elif", "while", "for", "in", "return", "end", "get", "import", "using", "direct", "true", "false", "null", "struct", "enum", "match", "break", "continue", "pub", "self", "and", "or", "not", "as", "impl", "include", "native", "region", "use"]
    let i = 0
    while i < kws.len() [
        items.push(lsp_completion_item(kws[i].clone(), 14, "slowo kluczowe"))
        i = i + 1
    ]
    let bs: List<Str> = ["log", "elog", "dict", "set", "some", "none", "ok", "err", "read_file", "write_file", "run_command", "now_ms", "target_os", "sha256_hex", "env_var", "http_get"]
    let bi = 0
    while bi < bs.len() [
        items.push(lsp_completion_item(bs[bi].clone(), 3, lsp_builtin_doc(bs[bi].clone())))
        bi = bi + 1
    ]
    let lines = split_lines(source)
    let li = 0
    let seen: Dict<Str, Bool> = dict()
    while li < lines.len() [
        match lsp_decl_on_line(lines[li].clone()) [
            Some(d) -> [
                if not seen.contains(d.name.clone()) [
                    seen.insert(d.name.clone(), true)
                    let ck = 6
                    if d.kind == "fun" [
                        ck = 3
                    ]
                    if d.kind == "struct" [
                        ck = 22
                    ]
                    if d.kind == "enum" [
                        ck = 13
                    ]
                    if d.kind == "const" [
                        ck = 21
                    ]
                    items.push(lsp_completion_item(d.name.clone(), ck, str_trim(lines[li].clone())))
                ]
            ]
            None -> [
            ]
        ]
        li = li + 1
    ]
    end "{\"isIncomplete\":false,\"items\":[" + str_join(items, ",") + "]}"
]

!!! ---------------------------------------------------------------
!!! (0.6) rename / references / documentSymbol / definition miedzy plikami
!!! ---------------------------------------------------------------

!!! Kolumny, w ktorych `word` wystepuje jako CALE slowo w linii - poza
!!! literalami napisow i komentarzami (`!!`, `!!!`). Wspolna podstawa dla
!!! `rename` i `references`.
fun lsp_word_cols(line_text: Str, word: Str) -> List<Int> [
    let out: List<Int> = []
    let n = line_text.len()
    let wl = word.len()
    if wl == 0 [
        end out
    ]
    let in_str = false
    let i = 0
    while i < n [
        let c = line_text.char_at(i)
        if in_str [
            if c == "\\" [
                i = i + 1
            ] elif c == "\"" [
                in_str = false
            ]
            i = i + 1
        ] else [
            if c == "\"" [
                in_str = true
                i = i + 1
            ] elif c == "!" and i + 1 < n and line_text.char_at(i + 1) == "!" [
                end out
            ] elif lsp_is_ident_char(c) [
                let j = i
                while j < n and lsp_is_ident_char(line_text.char_at(j)) [
                    j = j + 1
                ]
                if j - i == wl and line_text.slice(i, j) == word [
                    out.push(i)
                ]
                i = j
            ] else [
                i = i + 1
            ]
        ]
    ]
    end out
]

fun lsp_range_json(line: Int, c1: Int, c2: Int) -> Str [
    end "{\"start\":{\"line\":" + (line as Str) + ",\"character\":" + (c1 as Str) + "},\"end\":{\"line\":" + (line as Str) + ",\"character\":" + (c2 as Str) + "}}"
]

!!! Poprawna nazwa identyfikatora i nie slowo kluczowe.
fun lsp_valid_new_name(name: Str) -> Bool [
    if name.len() == 0 [
        end false
    ]
    if name.char_at(0) >= "0" and name.char_at(0) <= "9" [
        end false
    ]
    let i = 0
    while i < name.len() [
        if not lsp_is_ident_char(name.char_at(i)) [
            end false
        ]
        i = i + 1
    ]
    end not is_keyword(name)
]

!!! textDocument/rename -> WorkspaceEdit (`changes` dla otwartego
!!! dokumentu) albo `null` (brak slowa pod kursorem / niepoprawna nowa
!!! nazwa). Zmienia wszystkie wystapienia CALEGO slowa poza napisami i
!!! komentarzami. (0.6) Z analiza zasiegu - patrz `lsp_collect_occurrences`:
!!! zmienna lokalna/parametr tylko w swojej funkcji, metoda wg typu odbiorcy.
fun lsp_rename_json(uri: Str, source: Str, line: Int, character: Int, new_name: Str) -> Str [
    let lines = split_lines(source)
    let word = lsp_word_at(lsp_line_or_empty(lines.clone(), line), character)
    if word == "" or not lsp_valid_new_name(new_name.clone()) [
        end "null"
    ]
    let edits = ""
    let count = 0
    let occ = lsp_collect_occurrences(lines.clone(), line, character)
    let i = 0
    while i < occ.lines.len() [
        if count > 0 [
            edits = edits + ","
        ]
        edits = edits + "{\"range\":" + lsp_range_json(occ.lines[i], occ.cols[i], occ.cols[i] + word.len()) + ",\"newText\":" + json_escape_string(new_name.clone()) + "}"
        count = count + 1
        i = i + 1
    ]
    if count == 0 [
        end "null"
    ]
    end "{\"changes\":{" + json_escape_string(uri) + ":[" + edits + "]}}"
]

!!! textDocument/references -> lista Location (puste `[]` gdy brak).
fun lsp_references_json(uri: Str, source: Str, line: Int, character: Int) -> Str [
    let lines = split_lines(source)
    let word = lsp_word_at(lsp_line_or_empty(lines.clone(), line), character)
    if word == "" [
        end "[]"
    ]
    let out = ""
    let count = 0
    let occ = lsp_collect_occurrences(lines.clone(), line, character)
    let i = 0
    while i < occ.lines.len() [
        if count > 0 [
            out = out + ","
        ]
        out = out + "{\"uri\":" + json_escape_string(uri.clone()) + ",\"range\":" + lsp_range_json(occ.lines[i], occ.cols[i], occ.cols[i] + word.len()) + "}"
        count = count + 1
        i = i + 1
    ]
    end "[" + out + "]"
]

!!! textDocument/documentSymbol -> plaski spis `DocumentSymbol` (fun/
!!! struct/enum/const). Kinds LSP: Function=12, Struct=23, Enum=10,
!!! Constant=14. `let` pomijane (zmienne lokalne to nie symbole).
fun lsp_document_symbols_json(source: Str) -> Str [
    let lines = split_lines(source)
    let out = ""
    let count = 0
    let i = 0
    while i < lines.len() [
        match lsp_decl_on_line(lines[i].clone()) [
            Some(d) -> [
                let kind = 0
                if d.kind == "fun" [
                    kind = 12
                ] elif d.kind == "struct" [
                    kind = 23
                ] elif d.kind == "enum" [
                    kind = 10
                ] elif d.kind == "const" [
                    kind = 14
                ]
                if kind > 0 [
                    if count > 0 [
                        out = out + ","
                    ]
                    let rng = lsp_range_json(i, d.col, d.col + d.name.len())
                    out = out + "{\"name\":" + json_escape_string(d.name.clone()) + ",\"kind\":" + (kind as Str) + ",\"range\":" + rng + ",\"selectionRange\":" + rng + "}"
                    count = count + 1
                ]
            ]
            None -> [
            ]
        ]
        i = i + 1
    ]
    end "[" + out + "]"
]

!!! Katalog pliku z URI (`file:///a/b/c.hcs` -> `/a/b`).
fun lsp_dir_of_path(path: Str) -> Str [
    let i = path.len() - 1
    while i >= 0 [
        if path.char_at(i) == "/" [
            end path.slice(0, i)
        ]
        i = i - 1
    ]
    end "."
]

!!! Nazwy z linii `include <nazwa>` (bez `work:`/`std:` itd. - tylko
!!! pliki-rodzenstwo, np. `include <parser>` -> `parser`).
fun lsp_sibling_includes(lines: List<Str>) -> List<Str> [
    let out: List<Str> = []
    let i = 0
    while i < lines.len() [
        let t: Str = str_trim(lines[i].clone())
        if str_starts_with(t.clone(), "include <") [
            let rest: Str = t.slice(9, t.len())
            let j = 0
            while j < rest.len() and rest.char_at(j) != ">" [
                j = j + 1
            ]
            let nm: Str = rest.slice(0, j)
            let has_colon = false
            let q = 0
            while q < nm.len() [
                if nm.char_at(q) == ":" [
                    has_colon = true
                ]
                q = q + 1
            ]
            if nm.len() > 0 and not has_colon [
                out.push(nm)
            ]
        ]
        i = i + 1
    ]
    end out
]

!!! (0.6) `definition` rozszerzone: gdy slowa nie ma w otwartym dokumencie,
!!! szuka w plikach `include <nazwa>` lezacych obok (z dysku). Zwraca
!!! Location albo `null`.
fun lsp_definition_multi_json(uri: Str, source: Str, line: Int, character: Int) -> Str [
    let local = lsp_definition_json(uri.clone(), source.clone(), line, character)
    if local != "null" [
        end local
    ]
    let lines = split_lines(source.clone())
    let word = lsp_word_at(lsp_line_or_empty(lines.clone(), line), character)
    if word == "" [
        end "null"
    ]
    let path: Str = uri.clone()
    if str_starts_with(path.clone(), "file://") [
        path = path.slice(7, path.len())
    ]
    let dir = lsp_dir_of_path(path)
    let names = lsp_sibling_includes(lines)
    let i = 0
    while i < names.len() [
        let fpath = dir.clone() + "/" + names[i].clone() + ".hcs"
        if file_readable(fpath.clone()) [
            let text = read_file_or(fpath.clone(), "")
            let flines = split_lines(text)
            match lsp_find_decl(flines, word.clone()) [
                Some(d) -> [
                    end "{\"uri\":" + json_escape_string("file://" + fpath) + ",\"range\":" + lsp_range_json(d.line, d.col, d.col + d.name.len()) + "}"
                ]
                None -> [
                ]
            ]
        ]
        i = i + 1
    ]
    end "null"
]
