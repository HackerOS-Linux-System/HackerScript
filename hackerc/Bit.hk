[package]
-> name        => hackerc
-> version     => 0.4
-> description => Samo-hostowany transpilator HackerScript do Rusta. Komendy check, lint, build, fmt, lsp, hlib, emit-module.
-> authors     => ["HackerOS Team"]
-> license     => MIT
-> lang        => HackerScript
-> using       => 0.4

[layout]
-> cmd => cmd

[build]
-> link => static

[default-build]
-> profile => release
