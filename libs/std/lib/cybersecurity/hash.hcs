get <crates:sha1::0.10>
get <crates:sha2::0.10>
get <crates:sha3::0.10>
get <crates:blake2::0.10>
get <crates:md5::0.7>
get <crates:crc32fast::1>
get <std:result> import <unwrap_or>

!! hash - skroty kryptograficzne i sumy kontrolne (std 0.6).
!! Uzycie: get <std:cybersecurity::hash>
!!
!! Wymaga, zeby w module byl w zasiegu trait `Digest` - dodaje go
!! automatycznie `get <crates:sha2::...>` (hackerc emituje `use
!! sha2::{Sha256, Digest}`), dlatego ten plik nie importuje go sam.
!!
!! Obslugiwane algorytmy (nazwa nie rozroznia wielkosci liter ani `-`/`_`,
!! wiec "SHA-256", "sha256" i "sha_256" to to samo):
!!   md5, sha1, crc32          - NIEBEZPIECZNE kryptograficznie (kolizje) - tylko
!!                               do zgodnosci z cudzymi formatami i sum kontrolnych
!!   sha224, sha256, sha384, sha512
!!   sha3-256, sha3-384, sha3-512
!!   blake2b (512 bit), blake2s (256 bit)
!!
!! Wejscie to bajty UTF-8 napisu (`*_text_*`), lista bajtow (`List<Int>`,
!! 0..=255) albo plik czytany strumieniowo (64 KiB naraz, wiec rozmiar
!! pliku nie jest ograniczony pamiecia). Wynik to male cyfry hex.
!! Do POROWNYWANIA skrotow uzywaj `ct_eq` (std:cybersecurity::entropy)
!! albo `constant_time_eq_str` (std:cybersecurity::constant_time).

native {Rust} [
    use std::io::Read;

    pub enum HksHasher {
        Md5(md5::Context),
        Sha1(sha1::Sha1),
        Sha224(sha2::Sha224),
        Sha256(sha2::Sha256),
        Sha384(sha2::Sha384),
        Sha512(sha2::Sha512),
        Sha3_256(sha3::Sha3_256),
        Sha3_384(sha3::Sha3_384),
        Sha3_512(sha3::Sha3_512),
        Blake2b(blake2::Blake2b512),
        Blake2s(blake2::Blake2s256),
        Crc32(crc32fast::Hasher),
    }

    impl HksHasher {
        pub fn named(algo: &str) -> Option<HksHasher> {
            let key: String = algo
                .chars()
                .filter(|c| *c != '-' && *c != '_')
                .collect::<String>()
                .to_lowercase();
            Some(match key.as_str() {
                "md5" => HksHasher::Md5(md5::Context::new()),
                "sha1" => HksHasher::Sha1(sha1::Sha1::new()),
                "sha224" => HksHasher::Sha224(sha2::Sha224::new()),
                "sha256" => HksHasher::Sha256(sha2::Sha256::new()),
                "sha384" => HksHasher::Sha384(sha2::Sha384::new()),
                "sha512" => HksHasher::Sha512(sha2::Sha512::new()),
                "sha3256" => HksHasher::Sha3_256(sha3::Sha3_256::new()),
                "sha3384" => HksHasher::Sha3_384(sha3::Sha3_384::new()),
                "sha3512" => HksHasher::Sha3_512(sha3::Sha3_512::new()),
                "blake2b" => HksHasher::Blake2b(blake2::Blake2b512::new()),
                "blake2s" => HksHasher::Blake2s(blake2::Blake2s256::new()),
                "crc32" => HksHasher::Crc32(crc32fast::Hasher::new()),
                _ => return None,
            })
        }

        pub fn update(&mut self, data: &[u8]) {
            match self {
                HksHasher::Md5(h) => h.consume(data),
                HksHasher::Sha1(h) => h.update(data),
                HksHasher::Sha224(h) => h.update(data),
                HksHasher::Sha256(h) => h.update(data),
                HksHasher::Sha384(h) => h.update(data),
                HksHasher::Sha512(h) => h.update(data),
                HksHasher::Sha3_256(h) => h.update(data),
                HksHasher::Sha3_384(h) => h.update(data),
                HksHasher::Sha3_512(h) => h.update(data),
                HksHasher::Blake2b(h) => h.update(data),
                HksHasher::Blake2s(h) => h.update(data),
                HksHasher::Crc32(h) => h.update(data),
            }
        }

        pub fn finish_hex(self) -> String {
            let bytes: Vec<u8> = match self {
                HksHasher::Md5(h) => h.compute().0.to_vec(),
                HksHasher::Sha1(h) => h.finalize().to_vec(),
                HksHasher::Sha224(h) => h.finalize().to_vec(),
                HksHasher::Sha256(h) => h.finalize().to_vec(),
                HksHasher::Sha384(h) => h.finalize().to_vec(),
                HksHasher::Sha512(h) => h.finalize().to_vec(),
                HksHasher::Sha3_256(h) => h.finalize().to_vec(),
                HksHasher::Sha3_384(h) => h.finalize().to_vec(),
                HksHasher::Sha3_512(h) => h.finalize().to_vec(),
                HksHasher::Blake2b(h) => h.finalize().to_vec(),
                HksHasher::Blake2s(h) => h.finalize().to_vec(),
                HksHasher::Crc32(h) => h.finalize().to_be_bytes().to_vec(),
            };
            bytes.iter().map(|b| format!("{:02x}", b)).collect::<String>()
        }
    }
]

!! Lista kanonicznych nazw algorytmow.
fun hash_algorithms() -> List<Str> [
    end ["md5", "sha1", "sha224", "sha256", "sha384", "sha512", "sha3-256", "sha3-384", "sha3-512", "blake2b", "blake2s", "crc32"]
]

!! Skrot bajtow UTF-8 napisu `text` algorytmem `algo` (hex). Err dla
!! nieznanego algorytmu.
fun hash_text_hex(algo: Str, text: Str) -> Result<Str, Str> [
    let good = false
    let out = ""
    native {Rust} [
        match HksHasher::named(&algo) {
            Some(mut h) => {
                h.update(text.as_bytes());
                out = h.finish_hex();
                good = true;
            }
            None => { out = format!("nieznany algorytm skrotu: {}", algo); }
        }
    ]
    if good [
        end ok(out)
    ]
    end err(out)
]

!! Skrot listy bajtow (kazdy element 0..=255, inne wartosci -> Err).
fun hash_bytes_hex(algo: Str, data: List<Int>) -> Result<Str, Str> [
    let good = false
    let out = ""
    native {Rust} [
        if data.iter().any(|b| *b < 0 || *b > 255) {
            out = "bajt poza zakresem 0..=255".to_string();
        } else {
            match HksHasher::named(&algo) {
                Some(mut h) => {
                    let raw: Vec<u8> = data.iter().map(|b| *b as u8).collect();
                    h.update(&raw);
                    out = h.finish_hex();
                    good = true;
                }
                None => { out = format!("nieznany algorytm skrotu: {}", algo); }
            }
        }
    ]
    if good [
        end ok(out)
    ]
    end err(out)
]

!! Skrot zawartosci pliku `path`, czytanego strumieniowo (64 KiB naraz).
fun hash_file_hex(algo: Str, path: Str) -> Result<Str, Str> [
    let good = false
    let out = ""
    native {Rust} [
        match HksHasher::named(&algo) {
            None => { out = format!("nieznany algorytm skrotu: {}", algo); }
            Some(mut h) => {
                match std::fs::File::open(&path) {
                    Err(e) => { out = format!("nie mozna otworzyc '{}': {}", path, e); }
                    Ok(mut f) => {
                        let mut buf = vec![0u8; 65536];
                        let mut failed = false;
                        loop {
                            match f.read(&mut buf) {
                                Ok(0) => break,
                                Ok(n) => h.update(&buf[..n]),
                                Err(e) => { out = format!("blad odczytu '{}': {}", path, e); failed = true; break; }
                            }
                        }
                        if !failed {
                            out = h.finish_hex();
                            good = true;
                        }
                    }
                }
            }
        }
    ]
    if good [
        end ok(out)
    ]
    end err(out)
]

!! Skroty "na skroty" - dla poprawnie podanych algorytmow nie moze sie
!! nie udac, wiec zwracaja `Str` bez `Result`.
fun sha1_hex(text: Str) -> Str [
    end unwrap_or(hash_text_hex("sha1", text), "")
]

fun sha384_hex(text: Str) -> Str [
    end unwrap_or(hash_text_hex("sha384", text), "")
]

fun sha512_hex(text: Str) -> Str [
    end unwrap_or(hash_text_hex("sha512", text), "")
]

fun sha3_256_hex(text: Str) -> Str [
    end unwrap_or(hash_text_hex("sha3-256", text), "")
]

fun blake2b_hex(text: Str) -> Str [
    end unwrap_or(hash_text_hex("blake2b", text), "")
]

fun md5_hex(text: Str) -> Str [
    end unwrap_or(hash_text_hex("md5", text), "")
]

fun crc32_hex(text: Str) -> Str [
    end unwrap_or(hash_text_hex("crc32", text), "")
]
