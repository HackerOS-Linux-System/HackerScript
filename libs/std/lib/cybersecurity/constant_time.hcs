fun constant_time_eq(a: List<Int>, b: List<Int>) -> Int [
    if a.len() != b.len() [
        end 0
    ]
    let diff = 0
    let i = 0
    while i < a.len() [
        if a[i] != b[i] [
            diff = diff + 1
        ]
        i = i + 1
    ]
    if diff == 0 [
        end 1
    ]
    end 0
]
