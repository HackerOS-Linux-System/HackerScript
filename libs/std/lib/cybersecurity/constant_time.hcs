fun constant_time_eq(a: List<Int>, b: List<Int>) -> Int [
    if a.len() != b.len() [
        end 0
    ]
    let same = 0
    native {Rust} [
        let mut acc: i64 = 0;
        for (x, y) in a.iter().zip(b.iter()) {
            acc |= *x ^ *y;
        }
        if std::hint::black_box(acc) == 0 {
            same = 1;
        }
    ]
    end same
]

!! To samo dla napisow (porownuje bajty UTF-8) - zwraca `Bool`.
fun constant_time_eq_str(a: Str, b: Str) -> Bool [
    let equal = false
    native {Rust} [
        let xa = a.as_bytes();
        let xb = b.as_bytes();
        if xa.len() == xb.len() {
            let mut acc: u8 = 0;
            for (x, y) in xa.iter().zip(xb.iter()) {
                acc |= x ^ y;
            }
            equal = std::hint::black_box(acc) == 0;
        }
    ]
    end equal
]
