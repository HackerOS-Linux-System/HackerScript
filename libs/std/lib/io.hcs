fun read_file_or(path: Str, domyslna: Str) -> Str [
    let wynik = read_file(path)
    match wynik [
        Ok(tresc) -> [
            end tresc
        ]
        Err(_e) -> [
            end domyslna
        ]
    ]
]

!! Sprawdza, czy plik istnieje i da sie go odczytac (bez zwracania
!! tresci) - przydatne przed operacjami, ktore zakladaja jego obecnosc.
!! NAPRAWIONY BUG (ta runda, znaleziony realnym buildem przy
!! integracji .hlib - patrz docs/ROADMAP.md): poprzednia wersja
!! sprawdzala "czytelnosc" przez `read_file` (`std::fs::
!! read_to_string`, WALIDUJACE UTF-8) - dla KAZDEGO pliku binarnego
!! (kazdy `.hlib`, kazdy `.so`, obrazek, ...) zawsze zwracala `false`,
!! NAWET jesli plik naprawde istnial i byl czytelny na poziomie
!! systemu plikow - bo tresc po prostu nie jest poprawnym UTF-8.
!! `path_exists` (builtin, `Path::exists()`) sprawdza WLASCIWA rzecz -
!! obecnosc pliku, bez prob dekodowania jego tresci.
fun file_readable(path: Str) -> Bool [
    end path_exists(path)
]

!! Zapisuje `tresc` do pliku i zwraca `true` przy sukcesie, `false` przy
!! bledzie (bez propagowania szczegolow bledu) - wygodne w miejscach,
!! gdzie interesuje nas tylko czy operacja sie udala.
fun write_file_ok(path: Str, tresc: Str) -> Bool [
    let wynik = write_file(path, tresc)
    match wynik [
        Ok(_v) -> [
            end true
        ]
        Err(_e) -> [
            end false
        ]
    ]
]
