get <crates:ureq::2>

!! Jak `http_get`, ale przy niepowodzeniu opakowuje komunikat bledu
!! informacja O KTORYM URL-u chodzilo.
fun http_get_checked(url: Str) -> Result<Str, Str> [
    match http_get(url.clone()) [
        Ok(body) -> [
            end ok(body)
        ]
        Err(e) -> [
            end err("GET " + url + " nie powiodlo sie: " + e)
        ]
    ]
]

!! Czy GET na `url` powiodl sie (kod 2xx i poprawne UTF-8 cialo) -
!! ignoruje samo cialo, wygodne do prostych health-checkow.
fun http_get_ok(url: Str) -> Bool [
    match http_get(url) [
        Ok(_body) -> [
            end true
        ]
        Err(_e) -> [
            end false
        ]
    ]
]

!! ---------------------------------------------------------------------
!! Rozszerzenia 0.5: POST, wlasne naglowki, kod statusu. Zbudowane na
!! `ureq` 2 (ta sama zaleznosc co http_get). Cialo odpowiedzi MUSI byc UTF-8.
!! ---------------------------------------------------------------------

!! POST z cialem tekstowym (`Content-Type: text/plain; charset=utf-8`).
fun http_post(url: Str, body: Str) -> Result<Str, Str> [
    end http_post_typed(url, body, "text/plain; charset=utf-8")
]

!! POST z cialem JSON (`Content-Type: application/json`).
fun http_post_json(url: Str, json: Str) -> Result<Str, Str> [
    end http_post_typed(url, json, "application/json")
]

!! POST z dowolnym `Content-Type`. Kod odpowiedzi spoza 2xx daje Err("HTTP <kod>: ...").
fun http_post_typed(url: Str, body: Str, content_type: Str) -> Result<Str, Str> [
    let good = false
    let out = ""
    native {Rust} [
        match ureq::post(&url).set("Content-Type", &content_type).send_string(&body) {
            Ok(resp) => match resp.into_string() {
                Ok(s) => { good = true; out = s; }
                Err(e) => { out = format!("odpowiedz nie jest poprawnym UTF-8: {}", e); }
            },
            Err(ureq::Error::Status(code, resp)) => {
                let text = resp.into_string().unwrap_or_default();
                out = format!("HTTP {}: {}", code, text);
            }
            Err(e) => { out = format!("{}", e); }
        }
    ]
    if good [
        end ok(out)
    ]
    end err("POST " + url + " nie powiodl sie: " + out)
]

!! GET z jednym dodatkowym naglowkiem (np. `Authorization`, `Accept`).
fun http_get_with_header(url: Str, header: Str, value: Str) -> Result<Str, Str> [
    let good = false
    let out = ""
    native {Rust} [
        match ureq::get(&url).set(&header, &value).call() {
            Ok(resp) => match resp.into_string() {
                Ok(s) => { good = true; out = s; }
                Err(e) => { out = format!("odpowiedz nie jest poprawnym UTF-8: {}", e); }
            },
            Err(ureq::Error::Status(code, resp)) => {
                let text = resp.into_string().unwrap_or_default();
                out = format!("HTTP {}: {}", code, text);
            }
            Err(e) => { out = format!("{}", e); }
        }
    ]
    if good [
        end ok(out)
    ]
    end err("GET " + url + " nie powiodl sie: " + out)
]

!! Kod statusu HTTP odpowiedzi na GET (takze 4xx/5xx); 0 gdy nie udalo sie polaczyc.
fun http_status(url: Str) -> Int [
    let code = 0
    native {Rust} [
        match ureq::get(&url).call() {
            Ok(resp) => { code = resp.status() as i64; }
            Err(ureq::Error::Status(c, _)) => { code = c as i64; }
            Err(_) => { code = 0; }
        }
    ]
    end code
]

!! ---------------------------------------------------------------------
!! 0.6: strumieniowanie i dodatkowe metody. Zbudowane na `ureq` 2.
!! ---------------------------------------------------------------------

!! Pobiera `url` PROSTO DO PLIKU `path`, strumieniowo (bez wczytywania
!! calego ciala do pamieci - bezpieczne dla duzych plikow, takze
!! binarnych, w odroznieniu od `http_get`, ktore wymaga UTF-8).
!! Ok(liczba zapisanych bajtow). Kod spoza 2xx -> Err("HTTP <kod>").
fun http_download(url: Str, path: Str) -> Result<Int, Str> [
    let good = false
    let written = 0
    let why = ""
    native {Rust} [
        match ureq::get(&url).call() {
            Ok(resp) => {
                let mut reader = resp.into_reader();
                match std::fs::File::create(&path) {
                    Ok(mut f) => match std::io::copy(&mut reader, &mut f) {
                        Ok(n) => { good = true; written = n as i64; }
                        Err(e) => { why = format!("zapis do '{}': {}", path, e); }
                    },
                    Err(e) => { why = format!("nie mozna utworzyc '{}': {}", path, e); }
                }
            }
            Err(ureq::Error::Status(code, _)) => { why = format!("HTTP {}", code); }
            Err(e) => { why = format!("{}", e); }
        }
    ]
    if good [
        end ok(written)
    ]
    end err("pobieranie " + url + " nie powiodlo sie: " + why)
]

!! GET zwracajacy ciolo jako liste LINII, czytanych strumieniowo
!! (`BufRead::lines`). Przydatne dla duzych odpowiedzi tekstowych
!! (NDJSON, logi, CSV) - nie buduje jednego wielkiego Stringa.
fun http_get_lines(url: Str) -> Result<List<Str>, Str> [
    let good = false
    let why = ""
    let lines: List<Str> = []
    native {Rust} [
        use std::io::BufRead;
        match ureq::get(&url).call() {
            Ok(resp) => {
                let reader = std::io::BufReader::new(resp.into_reader());
                good = true;
                for l in reader.lines() {
                    match l {
                        Ok(t) => { lines.push(t); }
                        Err(e) => { good = false; why = format!("odczyt: {}", e); break; }
                    }
                }
            }
            Err(ureq::Error::Status(code, _)) => { why = format!("HTTP {}", code); }
            Err(e) => { why = format!("{}", e); }
        }
    ]
    if good [
        end ok(lines)
    ]
    end err("GET " + url + " nie powiodl sie: " + why)
]

!! PUT z cialem tekstowym (`Content-Type: text/plain; charset=utf-8`).
fun http_put(url: Str, body: Str) -> Result<Str, Str> [
    let good = false
    let out = ""
    native {Rust} [
        match ureq::put(&url).set("Content-Type", "text/plain; charset=utf-8").send_string(&body) {
            Ok(resp) => match resp.into_string() {
                Ok(s) => { good = true; out = s; }
                Err(e) => { out = format!("odpowiedz nie jest poprawnym UTF-8: {}", e); }
            },
            Err(ureq::Error::Status(code, resp)) => {
                let text = resp.into_string().unwrap_or_default();
                out = format!("HTTP {}: {}", code, text);
            }
            Err(e) => { out = format!("{}", e); }
        }
    ]
    if good [
        end ok(out)
    ]
    end err("PUT " + url + " nie powiodl sie: " + out)
]

!! DELETE. Ok(cialo odpowiedzi, zwykle puste) przy 2xx.
fun http_delete(url: Str) -> Result<Str, Str> [
    let good = false
    let out = ""
    native {Rust} [
        match ureq::delete(&url).call() {
            Ok(resp) => match resp.into_string() {
                Ok(s) => { good = true; out = s; }
                Err(e) => { out = format!("odpowiedz nie jest poprawnym UTF-8: {}", e); }
            },
            Err(ureq::Error::Status(code, resp)) => {
                let text = resp.into_string().unwrap_or_default();
                out = format!("HTTP {}: {}", code, text);
            }
            Err(e) => { out = format!("{}", e); }
        }
    ]
    if good [
        end ok(out)
    ]
    end err("DELETE " + url + " nie powiodl sie: " + out)
]

!! ---------------------------------------------------------------------
!! 0.7: STRUMIENIOWANIE odpowiedzi (SSE, NDJSON, duze pliki) - czytanie ciala
!! w miare nadchodzenia, bez ladowania calosci do pamieci.
!! ---------------------------------------------------------------------
!!
!!     let h = http_stream_open("http://localhost:8080/events")    !! Result<Int, Str>
!!     loop: match http_stream_read_line(h) [ Some(l) -> [ ... ] None -> [ koniec ] ]
!!     http_stream_close(h)
!!
!! Uchwyt (Int > 0) jest wspolny w procesie. Odczyt BLOKUJE do nadejscia danych
!! (limit polaczenia ureq: 30 s bez danych konczy sie koncem strumienia).

native {Rust} [
    use std::collections::HashMap;
    use std::io::{BufRead, BufReader, Read};
    use std::sync::{Mutex, OnceLock};

    pub struct HksHttpStream {
        pub reader: BufReader<Box<dyn Read + Send + Sync + 'static>>,
        pub status: i64,
    }

    pub struct HksHttpRegistry {
        pub next: i64,
        pub streams: HashMap<i64, HksHttpStream>,
    }

    pub fn hks_http_registry() -> &'static Mutex<HksHttpRegistry> {
        static REG: OnceLock<Mutex<HksHttpRegistry>> = OnceLock::new();
        REG.get_or_init(|| Mutex::new(HksHttpRegistry { next: 1, streams: HashMap::new() }))
    }

    pub fn hks_http_register(resp: ureq::Response) -> i64 {
        let status = resp.status() as i64;
        let reader = BufReader::new(resp.into_reader());
        let mut reg = hks_http_registry().lock().unwrap();
        let id = reg.next;
        reg.next += 1;
        reg.streams.insert(id, HksHttpStream { reader, status });
        id
    }
]

!! Otwiera GET i zwraca uchwyt strumienia (kod 2xx); inny kod -> `Err("HTTP <kod>")`.
fun http_stream_open(url: Str) -> Result<Int, Str> [
    let handle = 0
    let why = ""
    native {Rust} [
        match ureq::get(&url).call() {
            Ok(resp) => { handle = hks_http_register(resp); }
            Err(ureq::Error::Status(code, _resp)) => { why = format!("HTTP {}", code); }
            Err(e) => { why = format!("{}", e); }
        }
    ]
    if handle > 0 [
        end ok(handle)
    ]
    end err(why)
]

!! Jak `http_stream_open`, ale POST z cialem `body` i `Content-Type`.
fun http_stream_open_post(url: Str, body: Str, content_type: Str) -> Result<Int, Str> [
    let handle = 0
    let why = ""
    native {Rust} [
        match ureq::post(&url).set("Content-Type", &content_type).send_string(&body) {
            Ok(resp) => { handle = hks_http_register(resp); }
            Err(ureq::Error::Status(code, _resp)) => { why = format!("HTTP {}", code); }
            Err(e) => { why = format!("{}", e); }
        }
    ]
    if handle > 0 [
        end ok(handle)
    ]
    end err(why)
]

!! Kod statusu HTTP otwartego strumienia (0 = nieznany uchwyt).
fun http_stream_status(handle: Int) -> Int [
    let st = 0
    native {Rust} [
        if let Some(s) = hks_http_registry().lock().unwrap().streams.get(&handle) { st = s.status; }
    ]
    end st
]

!! Nastepna linia ciala (bez `\n`/`\r`), blokujaco. `None` po koncu strumienia,
!! bledzie albo dla nieznanego uchwytu. Bajty spoza UTF-8 sa zastepowane.
fun http_stream_read_line(handle: Int) -> Option<Str> [
    let got = false
    let line = ""
    native {Rust} [
        let mut reg = hks_http_registry().lock().unwrap();
        if let Some(s) = reg.streams.get_mut(&handle) {
            let mut buf: Vec<u8> = Vec::new();
            match s.reader.read_until(b'\n', &mut buf) {
                Ok(0) | Err(_) => {}
                Ok(_) => {
                    while buf.last() == Some(&b'\n') || buf.last() == Some(&b'\r') { buf.pop(); }
                    line = String::from_utf8_lossy(&buf).to_string();
                    got = true;
                }
            }
        }
    ]
    if got [
        end some(line)
    ]
    end none()
]

!! Do `max_bytes` (1..=1048576) surowych bajtow ciala; moze zwrocic mniej.
!! `None` po koncu strumienia/bledzie/nieznanym uchwycie.
fun http_stream_read_bytes(handle: Int, max_bytes: Int) -> Option<List<Int>> [
    if max_bytes < 1 or max_bytes > 1048576 [
        end none()
    ]
    let got = false
    let data: List<Int> = []
    native {Rust} [
        let mut reg = hks_http_registry().lock().unwrap();
        if let Some(s) = reg.streams.get_mut(&handle) {
            let mut buf = vec![0u8; max_bytes as usize];
            match s.reader.read(&mut buf) {
                Ok(0) | Err(_) => {}
                Ok(n) => { data = buf[..n].iter().map(|b| *b as i64).collect(); got = true; }
            }
        }
    ]
    if got [
        end some(data)
    ]
    end none()
]

!! Zamyka strumien i zwalnia uchwyt. `false` dla nieznanego uchwytu.
fun http_stream_close(handle: Int) -> Bool [
    let removed = false
    native {Rust} [
        removed = hks_http_registry().lock().unwrap().streams.remove(&handle).is_some();
    ]
    end removed
]
