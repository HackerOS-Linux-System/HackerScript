get <crates:ureq::2>

!! Jak `http_get`, ale przy niepowodzeniu opakowuje komunikat bledu
!! informacja O KTORYM URL-u chodzilo.
fun http_get_checked(url: Str) -> Result<Str, Str> [
    match http_get(url.clone()) [
        Ok(body) -> [
            end ok(body)
        ]
        Err(e) -> [
            end err("GET " + url + " nie powiodlo sie: " + e)
        ]
    ]
]

!! Czy GET na `url` powiodl sie (kod 2xx i poprawne UTF-8 cialo) -
!! ignoruje samo cialo, wygodne do prostych health-checkow.
fun http_get_ok(url: Str) -> Bool [
    match http_get(url) [
        Ok(_body) -> [
            end true
        ]
        Err(_e) -> [
            end false
        ]
    ]
]

!! ---------------------------------------------------------------------
!! Rozszerzenia 0.5: POST, wlasne naglowki, kod statusu. Zbudowane na
!! `ureq` 2 (ta sama zaleznosc co http_get). Cialo odpowiedzi MUSI byc UTF-8.
!! ---------------------------------------------------------------------

!! POST z cialem tekstowym (`Content-Type: text/plain; charset=utf-8`).
fun http_post(url: Str, body: Str) -> Result<Str, Str> [
    end http_post_typed(url, body, "text/plain; charset=utf-8")
]

!! POST z cialem JSON (`Content-Type: application/json`).
fun http_post_json(url: Str, json: Str) -> Result<Str, Str> [
    end http_post_typed(url, json, "application/json")
]

!! POST z dowolnym `Content-Type`. Kod odpowiedzi spoza 2xx daje Err("HTTP <kod>: ...").
fun http_post_typed(url: Str, body: Str, content_type: Str) -> Result<Str, Str> [
    let good = false
    let out = ""
    native {Rust} [
        match ureq::post(&url).set("Content-Type", &content_type).send_string(&body) {
            Ok(resp) => match resp.into_string() {
                Ok(s) => { good = true; out = s; }
                Err(e) => { out = format!("odpowiedz nie jest poprawnym UTF-8: {}", e); }
            },
            Err(ureq::Error::Status(code, resp)) => {
                let text = resp.into_string().unwrap_or_default();
                out = format!("HTTP {}: {}", code, text);
            }
            Err(e) => { out = format!("{}", e); }
        }
    ]
    if good [
        end ok(out)
    ]
    end err("POST " + url + " nie powiodl sie: " + out)
]

!! GET z jednym dodatkowym naglowkiem (np. `Authorization`, `Accept`).
fun http_get_with_header(url: Str, header: Str, value: Str) -> Result<Str, Str> [
    let good = false
    let out = ""
    native {Rust} [
        match ureq::get(&url).set(&header, &value).call() {
            Ok(resp) => match resp.into_string() {
                Ok(s) => { good = true; out = s; }
                Err(e) => { out = format!("odpowiedz nie jest poprawnym UTF-8: {}", e); }
            },
            Err(ureq::Error::Status(code, resp)) => {
                let text = resp.into_string().unwrap_or_default();
                out = format!("HTTP {}: {}", code, text);
            }
            Err(e) => { out = format!("{}", e); }
        }
    ]
    if good [
        end ok(out)
    ]
    end err("GET " + url + " nie powiodl sie: " + out)
]

!! Kod statusu HTTP odpowiedzi na GET (takze 4xx/5xx); 0 gdy nie udalo sie polaczyc.
fun http_status(url: Str) -> Int [
    let code = 0
    native {Rust} [
        match ureq::get(&url).call() {
            Ok(resp) => { code = resp.status() as i64; }
            Err(ureq::Error::Status(c, _)) => { code = c as i64; }
            Err(_) => { code = 0; }
        }
    ]
    end code
]

!! ---------------------------------------------------------------------
!! 0.6: strumieniowanie i dodatkowe metody. Zbudowane na `ureq` 2.
!! ---------------------------------------------------------------------

!! Pobiera `url` PROSTO DO PLIKU `path`, strumieniowo (bez wczytywania
!! calego ciala do pamieci - bezpieczne dla duzych plikow, takze
!! binarnych, w odroznieniu od `http_get`, ktore wymaga UTF-8).
!! Ok(liczba zapisanych bajtow). Kod spoza 2xx -> Err("HTTP <kod>").
fun http_download(url: Str, path: Str) -> Result<Int, Str> [
    let good = false
    let written = 0
    let why = ""
    native {Rust} [
        match ureq::get(&url).call() {
            Ok(resp) => {
                let mut reader = resp.into_reader();
                match std::fs::File::create(&path) {
                    Ok(mut f) => match std::io::copy(&mut reader, &mut f) {
                        Ok(n) => { good = true; written = n as i64; }
                        Err(e) => { why = format!("zapis do '{}': {}", path, e); }
                    },
                    Err(e) => { why = format!("nie mozna utworzyc '{}': {}", path, e); }
                }
            }
            Err(ureq::Error::Status(code, _)) => { why = format!("HTTP {}", code); }
            Err(e) => { why = format!("{}", e); }
        }
    ]
    if good [
        end ok(written)
    ]
    end err("pobieranie " + url + " nie powiodlo sie: " + why)
]

!! GET zwracajacy ciolo jako liste LINII, czytanych strumieniowo
!! (`BufRead::lines`). Przydatne dla duzych odpowiedzi tekstowych
!! (NDJSON, logi, CSV) - nie buduje jednego wielkiego Stringa.
fun http_get_lines(url: Str) -> Result<List<Str>, Str> [
    let good = false
    let why = ""
    let lines: List<Str> = []
    native {Rust} [
        use std::io::BufRead;
        match ureq::get(&url).call() {
            Ok(resp) => {
                let reader = std::io::BufReader::new(resp.into_reader());
                good = true;
                for l in reader.lines() {
                    match l {
                        Ok(t) => { lines.push(t); }
                        Err(e) => { good = false; why = format!("odczyt: {}", e); break; }
                    }
                }
            }
            Err(ureq::Error::Status(code, _)) => { why = format!("HTTP {}", code); }
            Err(e) => { why = format!("{}", e); }
        }
    ]
    if good [
        end ok(lines)
    ]
    end err("GET " + url + " nie powiodl sie: " + why)
]

!! PUT z cialem tekstowym (`Content-Type: text/plain; charset=utf-8`).
fun http_put(url: Str, body: Str) -> Result<Str, Str> [
    let good = false
    let out = ""
    native {Rust} [
        match ureq::put(&url).set("Content-Type", "text/plain; charset=utf-8").send_string(&body) {
            Ok(resp) => match resp.into_string() {
                Ok(s) => { good = true; out = s; }
                Err(e) => { out = format!("odpowiedz nie jest poprawnym UTF-8: {}", e); }
            },
            Err(ureq::Error::Status(code, resp)) => {
                let text = resp.into_string().unwrap_or_default();
                out = format!("HTTP {}: {}", code, text);
            }
            Err(e) => { out = format!("{}", e); }
        }
    ]
    if good [
        end ok(out)
    ]
    end err("PUT " + url + " nie powiodl sie: " + out)
]

!! DELETE. Ok(cialo odpowiedzi, zwykle puste) przy 2xx.
fun http_delete(url: Str) -> Result<Str, Str> [
    let good = false
    let out = ""
    native {Rust} [
        match ureq::delete(&url).call() {
            Ok(resp) => match resp.into_string() {
                Ok(s) => { good = true; out = s; }
                Err(e) => { out = format!("odpowiedz nie jest poprawnym UTF-8: {}", e); }
            },
            Err(ureq::Error::Status(code, resp)) => {
                let text = resp.into_string().unwrap_or_default();
                out = format!("HTTP {}: {}", code, text);
            }
            Err(e) => { out = format!("{}", e); }
        }
    ]
    if good [
        end ok(out)
    ]
    end err("DELETE " + url + " nie powiodl sie: " + out)
]
