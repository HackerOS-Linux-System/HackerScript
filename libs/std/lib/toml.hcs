get <std:string> import <str_trim::str_split::str_ends_with>
get <std:json> import <JsonValue::JsonEntry::json_is_digit::json_digit_value>

!! Jedna para klucz-wartosc odczytana z linii `klucz = wartosc`.
struct TomlKV [
    key: Str,
    value: JsonValue
]

!! Parsuje cala zawartosc pliku `.toml` (albo `.hk`-podobnego formatu
!! `klucz = wartosc` + sekcje) i zwraca drzewo jako `JsonValue`
!! (zawsze `JsonObject` na najwyzszym poziomie, gdy `Ok`).
fun toml_parse(s: Str) -> Result<JsonValue, Str> [
    let lines = str_split(s, "\n")
    let root = JsonObject([])
    let current_path: List<Str> = []
    let i = 0
    let n = lines.len()
    while i < n [
        let raw_line = lines[i].clone()
        let line = str_trim(toml_strip_comment(raw_line))
        if line.len() > 0 [
            if line.char_at(0) == "[" [
                let sec = toml_parse_section_header(line)?
                current_path = sec
                let existing = toml_find_or_empty(root.clone(), current_path.clone())
                root = toml_set_path(root, current_path.clone(), existing)
            ] else [
                let kv = toml_parse_keyvalue(line)?
                let full_path = toml_append(current_path.clone(), kv.key)
                root = toml_set_path(root, full_path, kv.value)
            ]
        ]
        i = i + 1
    ]
    end ok(root)
]

!! Usuwa komentarz (`# ...` do konca linii) - IGNORUJE `#` wewnatrz
!! stringow (`"..."`/`'...'`).
fun toml_strip_comment(line: Str) -> Str [
    let m = line.len()
    let i = 0
    let in_str = false
    let quote = "\""
    while i < m [
        let c = line.char_at(i)
        if in_str [
            if c == quote [
                in_str = false
            ]
            if c == "\\" and i + 1 < m [
                i = i + 1
            ]
        ] else [
            if c == "\"" or c == "'" [
                in_str = true
                quote = c
            ] elif c == "#" [
                end line.slice(0, i)
            ]
        ]
        i = i + 1
    ]
    end line
]

!! Parsuje naglowek sekcji `[a.b.c]` (linia MUSI zaczynac sie od `[`)
!! na liste segmentow sciezki (`["a", "b", "c"]`), odkwotowujac kazdy
!! segment jesli jest w cudzyslowie (`["a"."b c"]`).
fun toml_parse_section_header(line: Str) -> Result<List<Str>, Str> [
    if not str_ends_with(line, "]") [
        end err("toml: brak zamykajacego ']' w naglowku sekcji")
    ]
    let inner = str_trim(line.slice(1, line.len() - 1))
    if inner.len() == 0 [
        end err("toml: pusty naglowek sekcji")
    ]
    let raw_parts = str_split(inner, ".")
    let out: List<Str> = []
    let i = 0
    let n = raw_parts.len()
    while i < n [
        let seg = str_trim(raw_parts[i].clone())
        out.push(toml_unquote_key(seg))
        i = i + 1
    ]
    end ok(out)
]

!! Zdejmuje otaczajace cudzyslowy (`"`/`'`) z klucza/segmentu sekcji,
!! jesli sa obecne - w przeciwnym razie zwraca `seg` bez zmian.
fun toml_unquote_key(seg: Str) -> Str [
    let m = seg.len()
    if m >= 2 [
        let first = seg.char_at(0)
        let last = seg.char_at(m - 1)
        if first == "\"" and last == "\"" [
            end seg.slice(1, m - 1)
        ]
        if first == "'" and last == "'" [
            end seg.slice(1, m - 1)
        ]
    ]
    end seg
]

!! Indeks PIERWSZEGO `=` NIE zagniezdzonego w stringu, albo `-1` gdy
!! brak - uzywane do podzialu linii `klucz = wartosc` na dwie czesci
!! bez pomylenia `=` wewnatrz wartosci-stringa z separatorem.
fun toml_find_top_level_eq(line: Str) -> Int [
    let m = line.len()
    let i = 0
    let in_str = false
    let quote = "\""
    while i < m [
        let c = line.char_at(i)
        if in_str [
            if c == quote [
                in_str = false
            ]
            if c == "\\" and i + 1 < m [
                i = i + 1
            ]
        ] else [
            if c == "\"" or c == "'" [
                in_str = true
                quote = c
            ] elif c == "=" [
                end i
            ]
        ]
        i = i + 1
    ]
    end 0 - 1
]

!! Parsuje linie `klucz = wartosc` (BEZ naglowkow sekcji - patrz
!! `toml_parse_section_header` dla `[...]`) na `TomlKV`.
fun toml_parse_keyvalue(line: Str) -> Result<TomlKV, Str> [
    let eq = toml_find_top_level_eq(line)
    if eq < 0 [
        end err("toml: oczekiwano '=' w linii klucz-wartosc")
    ]
    let raw_key = str_trim(line.slice(0, eq))
    if raw_key.len() == 0 [
        end err("toml: pusty klucz")
    ]
    let key = toml_unquote_key(raw_key)
    let raw_value = str_trim(line.slice(eq + 1, line.len()))
    if raw_value.len() == 0 [
        end err("toml: pusta wartosc")
    ]
    let value = toml_parse_value(raw_value)?
    end ok(TomlKV(key, value))
]

!! Parsuje POJEDYNCZY token wartosci TOML (string/tablica/bool/liczba)
!! - `raw` MUSI byc juz przycietym (bez otaczajacej bialej spacji)
!! calym tokenem wartosci.
fun toml_parse_value(raw: Str) -> Result<JsonValue, Str> [
    if raw.len() == 0 [
        end err("toml: pusta wartosc")
    ]
    let c = raw.char_at(0)
    if c == "\"" or c == "'" [
        let sv = toml_parse_string_literal(raw)?
        end ok(JsonString(sv))
    ]
    if c == "[" [
        end toml_parse_array(raw)
    ]
    if raw == "true" [
        end ok(JsonBool(true))
    ]
    if raw == "false" [
        end ok(JsonBool(false))
    ]
    end toml_parse_number(raw)
]

!! Parsuje string TOML (podstawowy `"..."` z escape'ami, albo
!! literalny `'...'` bez escape'ow) - `raw` MUSI byc CALYM tokenem
!! WLACZNIE z otaczajacymi cudzyslowami.
fun toml_parse_string_literal(raw: Str) -> Result<Str, Str> [
    let m = raw.len()
    if m < 2 [
        end err("toml: niezakonczony string")
    ]
    let q = raw.char_at(0)
    if raw.char_at(m - 1) != q [
        end err("toml: niezakonczony string")
    ]
    let inner = raw.slice(1, m - 1)
    if q == "'" [
        end ok(inner)
    ]
    let out = ""
    let i = 0
    let n = inner.len()
    while i < n [
        let c = inner.char_at(i)
        if c == "\\" [
            if i + 1 >= n [
                end err("toml: niezakonczona sekwencja escape w stringu")
            ]
            let e = inner.char_at(i + 1)
            if e == "\"" [
                out = out + "\""
            ] elif e == "\\" [
                out = out + "\\"
            ] elif e == "n" [
                out = out + "\n"
            ] elif e == "t" [
                out = out + "\t"
            ] elif e == "r" [
                out = out + "\r"
            ] else [
                end err("toml: nieobslugiwana sekwencja escape w stringu (wspierane: \\\" \\\\ \\n \\t \\r)")
            ]
            i = i + 2
        ] else [
            out = out + c
            i = i + 1
        ]
    ]
    end ok(out)
]

!! Parsuje liczbe TOML (calkowita albo zmiennoprzecinkowa - oba
!! reprezentowane jako `JsonNumber`, TOML formalnie je rozroznia, ale
!! JSON/`JsonValue` nie musi) - `raw` MUSI byc CALYM tokenem liczby.
fun toml_parse_number(raw: Str) -> Result<JsonValue, Str> [
    let m = raw.len()
    let i = 0
    let neg = false
    if i < m and (raw.char_at(i) == "-" or raw.char_at(i) == "+") [
        neg = raw.char_at(i) == "-"
        i = i + 1
    ]
    let int_start = i
    while i < m and json_is_digit(raw.char_at(i)) [
        i = i + 1
    ]
    if i == int_start [
        end err("toml: nieprawidlowa liczba")
    ]
    let value = 0.0
    let k = int_start
    while k < i [
        value = value * 10.0 + (json_digit_value(raw.char_at(k)) as Float)
        k = k + 1
    ]
    if i < m and raw.char_at(i) == "." [
        i = i + 1
        let frac_start = i
        while i < m and json_is_digit(raw.char_at(i)) [
            i = i + 1
        ]
        if i == frac_start [
            end err("toml: oczekiwano cyfry po '.'")
        ]
        let frac_value = 0.0
        let scale = 1.0
        let k2 = frac_start
        while k2 < i [
            frac_value = frac_value * 10.0 + (json_digit_value(raw.char_at(k2)) as Float)
            scale = scale * 10.0
            k2 = k2 + 1
        ]
        value = value + frac_value / scale
    ]
    if i != m [
        end err("toml: nieoczekiwane znaki po liczbie")
    ]
    if neg [
        value = 0.0 - value
    ]
    end ok(JsonNumber(value))
]

!! Parsuje tablice TOML `[v1, v2, ...]` - MUSI miescic sie w JEDNEJ
!! linii (patrz ograniczenia modulu). Elementy sa dzielone na
!! przecinkach TYLKO na najwyzszym poziomie zagniezdzenia (nie wewnatrz
!! zagniezdzonych `[...]`/stringow).
fun toml_parse_array(raw: Str) -> Result<JsonValue, Str> [
    let m = raw.len()
    if raw.char_at(m - 1) != "]" [
        end err("toml: niezakonczona tablica (wieloliniowe tablice nie sa wspierane)")
    ]
    let inner = str_trim(raw.slice(1, m - 1))
    let out: List<JsonValue> = []
    if inner.len() == 0 [
        end ok(JsonArray(out))
    ]
    let items = toml_split_top_level(inner, ",")
    let i = 0
    let n = items.len()
    while i < n [
        let item = str_trim(items[i].clone())
        let v = toml_parse_value(item)?
        out.push(v)
        i = i + 1
    ]
    end ok(JsonArray(out))
]

!! Dzieli `s` na jednoznakowym `sep`, TYLKO na najwyzszym poziomie
!! zagniezdzenia `[...]` i POZA stringami - uzywane do dzielenia
!! elementow tablicy TOML.
fun toml_split_top_level(s: Str, sep: Str) -> List<Str> [
    let out: List<Str> = []
    let m = s.len()
    let depth = 0
    let in_str = false
    let quote = "\""
    let start = 0
    let i = 0
    while i < m [
        let c = s.char_at(i)
        if in_str [
            if c == quote [
                in_str = false
            ]
            if c == "\\" and i + 1 < m [
                i = i + 1
            ]
        ] else [
            if c == "\"" or c == "'" [
                in_str = true
                quote = c
            ] elif c == "[" [
                depth = depth + 1
            ] elif c == "]" [
                depth = depth - 1
            ] elif depth == 0 and c == sep [
                out.push(s.slice(start, i))
                start = i + 1
            ]
        ]
        i = i + 1
    ]
    out.push(s.slice(start, m))
    end out
]

! ---- pomocnicze operacje na drzewie JsonValue (immutable rebuild) --------
! HackerScript nie ma latwego sposobu na "mutowalna referencje do
! zagniezdzonego pola" przez wiele poziomow `List<JsonEntry>`, wiec
! aktualizacja zagniezdzonej tabeli dziala przez PRZEBUDOWE calej
! sciezki od korzenia (funkcyjny styl "set", nie mutacja w miejscu).

!! Wyciaga liste par klucz-wartosc z `v`, jesli `v` to `JsonObject` -
!! w przeciwnym razie zwraca pusta liste (uzywane, gdy sciezka jeszcze
!! nie istnieje w drzewie).
fun toml_get_object_entries(v: JsonValue) -> List<JsonEntry> [
    match v [
        JsonObject(entries) -> [
            end entries.clone()
        ]
        _ -> [
            let empty: List<JsonEntry> = []
            end empty
        ]
    ]
]

!! Szuka `key` wsrod `entries`, zwraca jego wartosc albo pusty
!! `JsonObject([])`, gdy nie znaleziono (traktujemy brakujaca
!! podtabele jako "jeszcze pusta", zgodnie z semantyka TOML - sekcja
!! nie musi byc jawnie zadeklarowana, zeby miec podklucze).
fun toml_find_in_object(entries: List<JsonEntry>, key: Str) -> JsonValue [
    let i = 0
    let n = entries.len()
    while i < n [
        let e = entries[i].clone()
        if e.key == key [
            end e.value
        ]
        i = i + 1
    ]
    end JsonObject([])
]

!! Jak `toml_find_in_object`, ale schodzi rekurencyjnie przez CALA
!! `path` (wielosegmentowa) zaczynajac od `root`.
fun toml_find_or_empty(root: JsonValue, path: List<Str>) -> JsonValue [
    if path.len() == 0 [
        end root.clone()
    ]
    let entries = toml_get_object_entries(root)
    let child = toml_find_in_object(entries, path[0].clone())
    end toml_find_or_empty(child, toml_tail(path))
]

!! `path` bez pierwszego segmentu.
fun toml_tail(path: List<Str>) -> List<Str> [
    let out: List<Str> = []
    let i = 1
    let n = path.len()
    while i < n [
        out.push(path[i].clone())
        i = i + 1
    ]
    end out
]

!! `path` z `key` dopisanym na koncu.
fun toml_append(path: List<Str>, key: Str) -> List<Str> [
    let out: List<Str> = []
    let i = 0
    let n = path.len()
    while i < n [
        out.push(path[i].clone())
        i = i + 1
    ]
    out.push(key)
    end out
]

!! Zwraca NOWA liste `entries` z `key` ustawionym na `value`
!! (nadpisuje istniejacy wpis o tym kluczu, albo dopisuje nowy na
!! koncu) - nie mutuje `entries` w miejscu.
fun toml_set_in_object(entries: List<JsonEntry>, key: Str, value: JsonValue) -> List<JsonEntry> [
    let out: List<JsonEntry> = []
    let i = 0
    let n = entries.len()
    let replaced = false
    while i < n [
        let e = entries[i].clone()
        if e.key == key [
            out.push(JsonEntry(key.clone(), value.clone()))
            replaced = true
        ] else [
            out.push(e)
        ]
        i = i + 1
    ]
    if not replaced [
        out.push(JsonEntry(key.clone(), value.clone()))
    ]
    end out
]

!! Zwraca NOWE drzewo `root` z `value` ustawiona pod (wielosegmentowa)
!! `path`, tworzac po drodze brakujace tabele-rodzice. Przebudowuje
!! (immutable) CALA sciezke od korzenia do liscia - patrz uwaga wyzej.
fun toml_set_path(root: JsonValue, path: List<Str>, value: JsonValue) -> JsonValue [
    if path.len() == 0 [
        end value.clone()
    ]
    let entries = toml_get_object_entries(root)
    let head = path[0].clone()
    if path.len() == 1 [
        end JsonObject(toml_set_in_object(entries, head, value.clone()))
    ]
    let existing_child = toml_find_in_object(entries.clone(), head.clone())
    let updated_child = toml_set_path(existing_child, toml_tail(path), value.clone())
    end JsonObject(toml_set_in_object(entries, head, updated_child))
]
