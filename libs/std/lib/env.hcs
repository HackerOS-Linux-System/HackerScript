get <std:string> import <str_split>

!! Wartosc zmiennej srodowiskowej `name`, albo `default`, jesli nie
!! jest ustawiona (lub nie jest poprawnym UTF-8).
fun env_var_or(name: Str, default: Str) -> Str [
    match env_var(name) [
        Some(v) -> [
            end v
        ]
        None -> [
            end default
        ]
    ]
]

!! Czy zmienna srodowiskowa `name` jest w ogole ustawiona (niezaleznie
!! od wartosci - nawet pusty string liczy sie jako "ustawiona").
fun env_var_present(name: Str) -> Bool [
    match env_var(name) [
        Some(_v) -> [
            end true
        ]
        None -> [
            end false
        ]
    ]
]

!! `$PATH` (albo `%PATH%`) rozbite na pojedyncze wpisy po separatorze
!! `:` (uniksowym - dla Windows uzylbys `;`, ale `virus`/`hackerc`
!! celuja w Linux, patrz nazwa projektu `HackerOS-Linux-System`).
!! Pusta lista, gdy `PATH` nie jest ustawione.
fun env_path_entries() -> List<Str> [
    end str_split(env_var_or("PATH", ""), ":")
]
