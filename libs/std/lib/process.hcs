get <std:string> import <str_trim::str_join>

!! Jak `run_command`, ale przy niepowodzeniu opakowuje komunikat
!! bledu informacja O KTORYM programie/argumentach chodzilo -
!! wygodniejsze do logowania/wyswietlania uzytkownikowi niz surowy
!! stderr bez kontekstu.
fun run_command_checked(program: Str, args: List<Str>) -> Result<Str, Str> [
    match run_command(program.clone(), args.clone()) [
        Ok(out) -> [
            end ok(out)
        ]
        Err(e) -> [
            end err("polecenie '" + program + "' nie powiodlo sie: " + str_trim(e))
        ]
    ]
]

!! Jak `run_command`, ale IGNORUJE stdout/stderr i zwraca tylko
!! sukces/porazke jako `Bool` - wygodne, gdy interesuje Cie tylko czy
!! polecenie sie udalo (np. sprawdzenie czy narzedzie jest
!! zainstalowane: `command_succeeds("rustc", ["--version"])`).
fun command_succeeds(program: Str, args: List<Str>) -> Bool [
    match run_command(program, args) [
        Ok(_out) -> [
            end true
        ]
        Err(_e) -> [
            end false
        ]
    ]
]

!! Uruchamia `program` BEZ zadnych argumentow - skrot dla
!! najczestszego przypadku (np. `run_command_simple("pwd")`).
fun run_command_simple(program: Str) -> Result<Str, Str> [
    let no_args: List<Str> = []
    end run_command(program, no_args)
]

!! `run_command_combined()` (builtin) z komunikatem OKALAJACYM
!! (`"$ program args\n" + wyjscie`) - wygodne do logowania/pokazania
!! uzytkownikowi PELNEGO przebiegu polecenia (np. `bit lint`, gdzie
!! interesuje nas i stdout, i stderr, bez wzgledu na kod wyjscia -
!! patrz uwaga przy `run_command_combined`).
fun run_command_combined_labeled(program: Str, args: List<Str>) -> Str [
    end "$ " + program.clone() + " " + str_join(args.clone(), " ") + "\n" + run_command_combined(program, args)
]

!! ROZBUDOWA (ta runda, patrz docs/BIT.md - "bit lsp") - jak
!! `run_command_inherit()` (builtin), ale zwraca `Bool` (kod wyjscia
!! 0 = sukces) zamiast surowego kodu - wygodne dla wywolujacych, ktorych
!! interesuje tylko "czy sie udalo", np. `exit(if ok { 0 } else { 1 })`
!! po stronie `bit`.
fun run_command_inherit_ok(program: Str, args: List<Str>) -> Bool [
    end run_command_inherit(program, args) == 0
]

!! ---------------------------------------------------------------------
!! Rozszerzenia 0.5: osobne stdout/stderr + kod wyjscia, stdin z tekstu.
!! ---------------------------------------------------------------------

struct CmdOutput [
    code: Int,
    stdout: Str,
    stderr: Str
]

!! Uruchamia `program` z `args` (BEZ powloki) i zwraca kod wyjscia (-1 gdy zabity
!! sygnalem) oraz osobno stdout i stderr. Err tylko gdy nie udalo sie uruchomic procesu.
fun run_capture(program: Str, args: List<Str>) -> Result<CmdOutput, Str> [
    end run_capture_input(program, args, "")
]

!! Jak `run_capture`, ale karmi stdin procesu tekstem `input` (np. `sort`, `wc -l`).
fun run_capture_input(program: Str, args: List<Str>, input: Str) -> Result<CmdOutput, Str> [
    let started = false
    let code = 0
    let so = ""
    let se = ""
    let why = ""
    native {Rust} [
        use std::io::Write;
        use std::process::{Command, Stdio};
        match Command::new(&program).args(args.iter()).stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn() {
            Ok(mut child) => {
                if let Some(mut stdin) = child.stdin.take() {
                    let data = input.clone();
                    std::thread::spawn(move || { let _ = stdin.write_all(data.as_bytes()); });
                }
                match child.wait_with_output() {
                    Ok(o) => {
                        started = true;
                        code = o.status.code().unwrap_or(-1) as i64;
                        so = String::from_utf8_lossy(&o.stdout).to_string();
                        se = String::from_utf8_lossy(&o.stderr).to_string();
                    }
                    Err(e) => { why = format!("{}", e); }
                }
            }
            Err(e) => { why = format!("{}", e); }
        }
    ]
    if started [
        end ok(CmdOutput(code, so, se))
    ]
    end err("nie udalo sie uruchomic '" + program + "': " + why)
]

!! ---------------------------------------------------------------------
!! 0.6: strumieniowanie wyjscia procesu.
!! ---------------------------------------------------------------------

!! Jak `run_capture`, ale wyjscie procesu jest PRZEKAZYWANE NA ZYWO na
!! stdout/stderr programu (jak `tee`) W TRAKCIE jego dzialania - przy
!! dlugich poleceniach (`cargo build`, `make`) widac postep, a po
!! zakonczeniu dostajemy tez pelny zapis w `CmdOutput`. stdin procesu
!! jest zamkniety. Err tylko gdy nie udalo sie uruchomic procesu.
fun run_tee(program: Str, args: List<Str>) -> Result<CmdOutput, Str> [
    let started = false
    let code = 0
    let so = ""
    let se = ""
    let why = ""
    native {Rust} [
        use std::io::{Read, Write};
        use std::process::{Command, Stdio};
        fn pump<R: Read + Send + 'static>(mut src: R, to_err: bool) -> std::thread::JoinHandle<Vec<u8>> {
            std::thread::spawn(move || {
                let mut acc: Vec<u8> = Vec::new();
                let mut buf = [0u8; 4096];
                loop {
                    match src.read(&mut buf) {
                        Ok(0) | Err(_) => break,
                        Ok(n) => {
                            if to_err {
                                let _ = std::io::stderr().write_all(&buf[..n]);
                            } else {
                                let _ = std::io::stdout().write_all(&buf[..n]);
                                let _ = std::io::stdout().flush();
                            }
                            acc.extend_from_slice(&buf[..n]);
                        }
                    }
                }
                acc
            })
        }
        match Command::new(&program).args(args.iter()).stdin(Stdio::null()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn() {
            Ok(mut child) => {
                let h_out = pump(child.stdout.take().unwrap(), false);
                let h_err = pump(child.stderr.take().unwrap(), true);
                match child.wait() {
                    Ok(st) => { started = true; code = st.code().unwrap_or(-1) as i64; }
                    Err(e) => { why = format!("{}", e); }
                }
                so = String::from_utf8_lossy(&h_out.join().unwrap_or_default()).to_string();
                se = String::from_utf8_lossy(&h_err.join().unwrap_or_default()).to_string();
            }
            Err(e) => { why = format!("{}", e); }
        }
    ]
    if started [
        end ok(CmdOutput(code, so, se))
    ]
    end err("nie udalo sie uruchomic '" + program + "': " + why)
]
