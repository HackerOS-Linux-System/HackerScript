get <crates:libc::0.2>
get <std:env> import <env_var_present::env_var_or>
get <std:string> import <str_to_int::str_trim::str_split>
get <std:process> import <run_command_inherit_ok>

!! -- kody ANSI SGR (Select Graphic Rendition) -------------------------------
!! (funkcje, NIE consts - patrz uzasadnienie na gorze pliku)

fun ansi_reset() -> Str [ end "\e[0m" ]
fun ansi_bold() -> Str [ end "\e[1m" ]
fun ansi_dim() -> Str [ end "\e[2m" ]
fun ansi_red() -> Str [ end "\e[31m" ]
fun ansi_green() -> Str [ end "\e[32m" ]
fun ansi_yellow() -> Str [ end "\e[33m" ]
fun ansi_blue() -> Str [ end "\e[34m" ]
fun ansi_magenta() -> Str [ end "\e[35m" ]
fun ansi_cyan() -> Str [ end "\e[36m" ]
fun ansi_gray() -> Str [ end "\e[90m" ]
fun ansi_bold_green() -> Str [ end "\e[1;32m" ]
fun ansi_bold_red() -> Str [ end "\e[1;31m" ]
fun ansi_bold_yellow() -> Str [ end "\e[1;33m" ]
fun ansi_bold_cyan() -> Str [ end "\e[1;36m" ]

!! Kursor o JEDNA linie w gore (`\e[1A`) + czysci CALA biezaca linie
!! (`\e[2K`) - podstawa "nadpisywanego w miejscu" paska postepu, patrz
!! `print_progress_line`.
fun ansi_cursor_up_clear() -> Str [ end "\e[1A\e[2K" ]

!!! `true` jesli terminal MOZE pokazywac kolory - respektuje TYLKO
!!! `NO_COLOR` (https://no-color.org). Ten bootstrap nie ma dostepu do
!!! `isatty()`/`termios`, wiec (w odroznieniu od np. `rustc`) NIE
!!! wykrywa automatycznie przekierowania do pliku/potoku - jesli to
!!! problem, ustaw `NO_COLOR=1` recznie w skryptach CI.
fun term_color_enabled() -> Bool [
    end not env_var_present("NO_COLOR")
]

!!! Owija `text` kodem `color` + reset, ALBO zwraca `text` bez zmian gdy
!!! `term_color_enabled()` jest `false` - wszystkie `c_*` ponizej sa
!!! cienkimi opakowaniami tej funkcji.
fun colorize(text: Str, color: Str) -> Str [
    if term_color_enabled() [
        end color + text + ansi_reset()
    ]
    end text
]

fun c_red(text: Str) -> Str [
    end colorize(text, ansi_red())
]

fun c_green(text: Str) -> Str [
    end colorize(text, ansi_green())
]

fun c_yellow(text: Str) -> Str [
    end colorize(text, ansi_yellow())
]

fun c_blue(text: Str) -> Str [
    end colorize(text, ansi_blue())
]

fun c_magenta(text: Str) -> Str [
    end colorize(text, ansi_magenta())
]

fun c_cyan(text: Str) -> Str [
    end colorize(text, ansi_cyan())
]

fun c_gray(text: Str) -> Str [
    end colorize(text, ansi_gray())
]

fun c_bold(text: Str) -> Str [
    end colorize(text, ansi_bold())
]

fun c_dim(text: Str) -> Str [
    end colorize(text, ansi_dim())
]

fun c_bold_green(text: Str) -> Str [
    end colorize(text, ansi_bold_green())
]

fun c_bold_red(text: Str) -> Str [
    end colorize(text, ansi_bold_red())
]

fun c_bold_yellow(text: Str) -> Str [
    end colorize(text, ansi_bold_yellow())
]

fun c_bold_cyan(text: Str) -> Str [
    end colorize(text, ansi_bold_cyan())
]

!! -- pasek postepu -----------------------------------------------------------

!!! Procent `current/total` jako `Int` w zakresie `[0, 100]` -
!!! `total <= 0` daje `0` zamiast dzielenia przez zero.
fun progress_percent(current: Int, total: Int) -> Int [
    if total <= 0 [
        end 0
    ]
    let pct = (current * 100) / total
    if pct > 100 [
        end 100
    ]
    if pct < 0 [
        end 0
    ]
    end pct
]

!!! Buduje SAM pasek (bez etykiety/procentu) szerokosci `width` znakow,
!!! np. `"██████████░░░░░░░░░░"` dla 50% przy `width = 20` - pelne bloki
!!! `█` (U+2588) dla ukonczonej czesci, puste `░` (U+2591) dla reszty.
fun render_bar_fill(current: Int, total: Int, width: Int) -> Str [
    let pct = progress_percent(current, total)
    let filled = (width * pct) / 100
    let bar = ""
    let i = 0
    while i < width [
        if i < filled [
            bar = bar + "█"
        ] else [
            bar = bar + "░"
        ]
        i = i + 1
    ]
    end bar
]

!!! `render_bar_fill` + kolor zalezny od postepu (zolty < 50%, cyan
!!! 50-99%, zielony przy 100%) + nawiasy kwadratowe + procent, np.
!!! `"[████████████░░░░░░░░░░░░] 50%"`.
fun render_bar(current: Int, total: Int, width: Int) -> Str [
    let pct = progress_percent(current, total)
    let fill = render_bar_fill(current, total, width)
    let colored = fill
    if pct >= 100 [
        colored = c_green(fill)
    ] elif pct >= 50 [
        colored = c_cyan(fill)
    ] else [
        colored = c_yellow(fill)
    ]
    end "[" + colored + "] " + (pct as Str) + "%"
]

!!! Cala linia paska postepu z etykieta krokow (`==>` na zielono),
!!! samym paskiem (szerokosc 24 znakow) i licznikiem `(current/total)`,
!!! np. `"==> Kompilacja  [████████░░░░░░░░░░░░░░░░] 33%  (1/3) lexer.hcs"`.
fun render_progress_line(label: Str, current: Int, total: Int, item: Str) -> Str [
    let counter = "(" + (current as Str) + "/" + (total as Str) + ")"
    let prefix = c_bold_green("==>")
    if label.len() > 0 [
        prefix = prefix + " " + label
    ]
    end prefix + "  " + render_bar(current, total, 24) + "  " + c_gray(counter) + " " + item
]

!!! Wypisuje `render_progress_line` - dla `is_first = true` po prostu
!!! `log()`-uje (pierwsza linia sekwencji, nic do nadpisania), dla
!!! kolejnych wywolan dokleja wynik `ansi_cursor_up_clear()` PRZED
!!! tresc, wiec terminal wyswietla to jako JEDNA aktualizowana w
!!! miejscu linie zamiast serii nowych linii - dziala WYLACZNIE bo
!!! `log()` zawsze konczy `println!` (patrz
!!! hackerc/cmd/codegen.hcs::gen_log): kody ANSI wewnatrz tresci linii
!!! sa interpretowane przez terminal niezaleznie od tego skad
!!! pochodza w strumieniu wyjscia.
fun print_progress_line(label: Str, current: Int, total: Int, item: Str, is_first: Bool) [
    let line = render_progress_line(label, current, total, item)
    if is_first [
        log(line)
    ] else [
        log(ansi_cursor_up_clear() + line)
    ]
]

!! -- rozmiar terminala i tryb raw ---------------------------------------
!! ROZBUDOWA (ta runda, patrz docs/ROADMAP.md sekcja 4) - dotad
!! calkowicie brakujace. Ten bootstrap NIE MA dostepu do `ioctl`/
!! `termios` (patrz uwaga przy `term_color_enabled` wyzej), wiec obie
!! funkcje ponizej dzialaja przez ZEWNETRZNE narzedzia (`tput`/`stty`,
!! standardowe w kazdym systemie uniksowym z terminalem) zamiast
!! surowych wywolan systemowych - dziala TYLKO, gdy stdin/stdout tego
!! procesu sa faktycznie podlaczone do terminala (TTY); przy
!! przekierowaniu do pliku/potoku `tput`/`stty` zwykle zglaszaja blad,
!! stad `none()`/`false` jako bezpieczny wynik w takim przypadku,
!! zamiast propagowania surowego bledu polecenia.

struct TermSize [
    cols: Int,
    rows: Int
]

!!! Rozmiar terminala (kolumny x wiersze) przez `tput cols`/`tput
!!! lines` - `none()` jesli ktorekolwiek polecenie zawiedzie (brak
!!! TTY, `tput` niedostepny) albo zwroci cos, co nie parsuje sie jako
!!! liczba calkowita.
fun term_size() -> Option<TermSize> [
    let cols_out = ""
    match run_command("tput", ["cols"]) [
        Ok(o) -> [
            cols_out = str_trim(o)
        ]
        Err(_e) -> [
            end none()
        ]
    ]
    let rows_out = ""
    match run_command("tput", ["lines"]) [
        Ok(o2) -> [
            rows_out = str_trim(o2)
        ]
        Err(_e2) -> [
            end none()
        ]
    ]
    match str_to_int(cols_out.clone()) [
        Some(c) -> [
            match str_to_int(rows_out.clone()) [
                Some(r) -> [
                    end some(TermSize(c, r))
                ]
                None -> [
                    end none()
                ]
            ]
        ]
        None -> [
            end none()
        ]
    ]
]

!! -- tryb raw (0.6, termios + RAII) -----------------------------------------
!!
!! Prawdziwy tryb raw przez `tcgetattr`/`cfmakeraw`/`tcsetattr` (libc), bez
!! podprocesu `stty`. ORYGINALNE ustawienia terminala sa zapamietane i
!! PRZYWRACANE AUTOMATYCZNIE:
!!   * przy normalnym zakonczeniu procesu (`atexit`),
!!   * przy panice (hook przywraca terminal PRZED wypisaniem komunikatu),
!!   * przy SIGINT/SIGTERM/SIGHUP wyslanych z zewnatrz (handler przywraca
!!     terminal i ponawia sygnal z domyslna obsluga).
!! Nie ratuje przed SIGKILL ani zawieszeniem procesu - wtedy `stty sane`/`reset`.
!!
!! W raw Ctrl-C przychodzi jako bajt 3 (ISIG wylaczone). Przetwarzanie
!! wyjscia (OPOST) zostaje WLACZONE, wiec `log` nadal konczy linie poprawnie
!! (bez "schodkow").

native {Rust} [
    use std::sync::{Mutex, Once};

    static HKS_TERM_ORIG: Mutex<Option<libc::termios>> = Mutex::new(None);
    static HKS_TERM_ONCE: Once = Once::new();

    fn hks_term_restore_guard(g: &mut Option<libc::termios>) -> bool {
        if let Some(t) = g.take() {
            unsafe {
                return libc::tcsetattr(0, libc::TCSAFLUSH, &t) == 0;
            }
        }
        false
    }

    pub fn hks_term_restore() -> bool {
        match HKS_TERM_ORIG.lock() {
            Ok(mut g) => hks_term_restore_guard(&mut g),
            Err(p) => hks_term_restore_guard(&mut p.into_inner()),
        }
    }

    extern "C" fn hks_term_atexit() {
        hks_term_restore();
    }

    extern "C" fn hks_term_on_signal(sig: libc::c_int) {
        // try_lock: handler nie moze blokowac, gdy sygnal przerwal zakladanie blokady
        if let Ok(mut g) = HKS_TERM_ORIG.try_lock() {
            hks_term_restore_guard(&mut g);
        }
        unsafe {
            libc::signal(sig, libc::SIG_DFL);
            libc::raise(sig);
        }
    }

    pub fn hks_term_raw_enter() -> Result<(), String> {
        let mut g = match HKS_TERM_ORIG.lock() {
            Ok(g) => g,
            Err(p) => p.into_inner(),
        };
        if g.is_some() {
            return Ok(());
        }
        unsafe {
            if libc::isatty(0) == 0 {
                return Err("stdin nie jest terminalem".to_string());
            }
            let mut t: libc::termios = std::mem::zeroed();
            if libc::tcgetattr(0, &mut t) != 0 {
                return Err("tcgetattr nie powiodlo sie".to_string());
            }
            let orig = t;
            libc::cfmakeraw(&mut t);
            t.c_oflag |= libc::OPOST;
            if libc::tcsetattr(0, libc::TCSAFLUSH, &t) != 0 {
                return Err("tcsetattr nie powiodlo sie".to_string());
            }
            *g = Some(orig);
        }
        HKS_TERM_ONCE.call_once(|| unsafe {
            libc::atexit(hks_term_atexit);
            for sig in [libc::SIGINT, libc::SIGTERM, libc::SIGHUP] {
                libc::signal(sig, hks_term_on_signal as usize as libc::sighandler_t);
            }
            let prev = std::panic::take_hook();
            std::panic::set_hook(Box::new(move |info| {
                hks_term_restore();
                prev(info);
            }));
        });
        Ok(())
    }

    pub fn hks_term_is_raw() -> bool {
        match HKS_TERM_ORIG.lock() {
            Ok(g) => g.is_some(),
            Err(p) => p.into_inner().is_some(),
        }
    }

    pub fn hks_term_ioctl_size() -> Option<(i64, i64)> {
        for fd in [1, 2, 0] {
            unsafe {
                let mut ws: libc::winsize = std::mem::zeroed();
                if libc::ioctl(fd, libc::TIOCGWINSZ, &mut ws) == 0 && ws.ws_col > 0 && ws.ws_row > 0 {
                    return Some((ws.ws_col as i64, ws.ws_row as i64));
                }
            }
        }
        None
    }

    pub fn hks_term_read_byte() -> i64 {
        let mut b = [0u8; 1];
        let n = unsafe { libc::read(0, b.as_mut_ptr() as *mut libc::c_void, 1) };
        if n == 1 { b[0] as i64 } else { -1 }
    }
]

!! Wlacza tryb raw (bez echa i kanonicznego buforowania). `Err` gdy stdin
!! nie jest terminalem albo wywolanie systemowe zawiodlo. Wielokrotne
!! wywolanie jest bezpieczne (nic nie robi, gdy raw juz wlaczony).
!! Terminal wraca do stanu poczatkowego sam - patrz opis wyzej.
fun term_raw_enter() -> Result<Bool, Str> [
    let good = false
    let msg = ""
    native {Rust} [
        match hks_term_raw_enter() {
            Ok(()) => { good = true; }
            Err(e) => { msg = e; }
        }
    ]
    if good [
        end ok(true)
    ]
    end err(msg)
]

!! Wylacza tryb raw i przywraca zapamietane ustawienia. `true` gdy cos
!! przywrocono; `false` gdy raw nie byl wlaczony przez `term_raw_enter`.
fun term_raw_leave() -> Bool [
    let r = false
    native {Rust} [
        r = hks_term_restore();
    ]
    end r
]

!! Czy tryb raw jest teraz wlaczony przez `term_raw_enter`.
fun term_is_raw() -> Bool [
    let r = false
    native {Rust} [
        r = hks_term_is_raw();
    ]
    end r
]

!! Czyta JEDEN bajt ze stdin (blokujaco). -1 przy EOF/bledzie. W trybie raw
!! daje pojedyncze klawisze (strzalki to sekwencje 3 bajtow: 27, 91, A..D).
fun term_read_byte() -> Int [
    let b = 0
    native {Rust} [
        b = hks_term_read_byte();
    ]
    end b
]

!! Rozmiar terminala przez `ioctl(TIOCGWINSZ)` (stdout, potem stderr, potem
!! stdin) - bez podprocesow i bez /dev/tty. `none()` gdy zaden deskryptor nie
!! jest terminalem.
fun term_size_ioctl() -> Option<TermSize> [
    let found = false
    let c = 0
    let r = 0
    native {Rust} [
        if let Some((cc, rr)) = hks_term_ioctl_size() {
            c = cc;
            r = rr;
            found = true;
        }
    ]
    if found [
        end some(TermSize(c, r))
    ]
    end none()
]

!!! Wlacza (`true`) albo wylacza (`false`) tryb raw. Od 0.6 oparte o
!!! `term_raw_enter`/`term_raw_leave` (termios, RAII - terminal wraca sam
!!! przy wyjsciu, panice i sygnalach). Gdy stdin nie jest terminalem, wlaczenie
!!! zwraca `false`. Wylaczenie, gdy raw nie byl wlaczony tym API, wola `stty sane`
!!! (zachowanie sprzed 0.6).
fun term_set_raw(enable: Bool) -> Bool [
    if enable [
        match term_raw_enter() [
            Ok(_v) -> [
                end true
            ]
            Err(_e) -> [
                end false
            ]
        ]
    ]
    if term_raw_leave() [
        end true
    ]
    end run_command_inherit_ok("stty", ["sane"])
]

!! ---------------------------------------------------------------------
!! Rozszerzenia 0.5: wykrywanie terminala (std::io::IsTerminal).
!! ---------------------------------------------------------------------

!! Czy stdout jest terminalem (false przy przekierowaniu do pliku/potoku).
fun term_stdout_is_tty() -> Bool [
    let t = false
    native {Rust} [
        use std::io::IsTerminal;
        t = std::io::stdout().is_terminal();
    ]
    end t
]

!! Czy stdin jest terminalem (false gdy dane przychodza z potoku).
fun term_stdin_is_tty() -> Bool [
    let t = false
    native {Rust} [
        use std::io::IsTerminal;
        t = std::io::stdin().is_terminal();
    ]
    end t
]

!! Kolory wlaczone, gdy stdout to terminal i nie ustawiono NO_COLOR.
fun term_use_color() -> Bool [
    end term_stdout_is_tty() and term_color_enabled()
]

!! 0.6 - rozmiar terminala: `COLUMNS`/`LINES` z env, potem `stty size` na /dev/tty,
!! na koncu wartosc domyslna (80x24). Zwraca dodatnie Int zawsze.
fun term_size_from_stty(index: Int) -> Int [
    match run_command("sh", ["-c", "stty size < /dev/tty 2>/dev/null"]) [
        Ok(out) -> [
            let parts = str_split(str_trim(out), " ")
            if parts.len() == 2 [
                match str_to_int(parts[index]) [
                    Some(n) -> [
                        if n > 0 [
                            end n
                        ]
                    ]
                    None -> [
                    ]
                ]
            ]
        ]
        Err(_e) -> [
        ]
    ]
    end 0
]

fun term_width() -> Int [
    match str_to_int(env_var_or("COLUMNS", "")) [
        Some(n) -> [
            if n > 0 [
                end n
            ]
        ]
        None -> [
        ]
    ]
    match term_size_ioctl() [
        Some(sz) -> [
            end sz.cols
        ]
        None -> [
        ]
    ]
    let w = term_size_from_stty(1)
    if w > 0 [
        end w
    ]
    end 80
]

fun term_height() -> Int [
    match str_to_int(env_var_or("LINES", "")) [
        Some(n) -> [
            if n > 0 [
                end n
            ]
        ]
        None -> [
        ]
    ]
    match term_size_ioctl() [
        Some(sz) -> [
            end sz.rows
        ]
        None -> [
        ]
    ]
    let h = term_size_from_stty(0)
    if h > 0 [
        end h
    ]
    end 24
]
