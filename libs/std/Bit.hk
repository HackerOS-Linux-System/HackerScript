[package]
-> name        => std
-> version     => 0.6
-> description => Biblioteka standardowa HackerScript, 100% .hcs. Importowana przez get std lub get work.
-> authors     => ["HackerOS Team"]
-> license     => MIT
-> lang        => HackerScript
-> using       => 0.6

[layout]
-> lib => lib

[lib]
-> output => hlib

[build]
-> link => static

[default-build]
-> profile => release
