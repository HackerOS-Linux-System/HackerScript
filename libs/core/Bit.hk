[package]
-> name        => core
-> version     => 0.4
-> description => Biblioteka core HackerScript, alokatory pamieci i inne systemy pamieci, 100% .hcs. Importowana przez get core lub get work.
-> authors     => ["HackerOS Team"]
-> license     => MIT
-> lang        => HackerScript
-> using       => 0.4

[layout]
-> lib => lib

[lib]
-> output => hlib

[build]
-> link => static

[default-build]
-> profile => release
